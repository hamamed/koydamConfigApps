<% if (flash) { %>
  <div class="alert alert-<%= flash.type === 'warning' ? 'warning' : flash.type === 'error' ? 'danger' : 'success' %> d-flex align-items-center gap-2 mb-4" role="alert">
    <i data-lucide="<%= flash.type === 'warning' ? 'triangle-alert' : flash.type === 'error' ? 'circle-alert' : 'circle-check' %>" width="17" height="17"></i>
    <span><%= flash.message %></span>
  </div>
<% } %>
