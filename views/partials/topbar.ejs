<%#
  The sticky frosted bar, matching the other panels.

  This used to be an ordinary flex div inside .ad-main, which meant it never
  became the 60px sticky topbar the design system defines - and, because the
  page content sat directly in .ad-main with no .ad-content wrapper, nothing on
  the page had any padding at all. It rendered flush against the sidebar and
  the top of the window.

  Title and subtitle stack inside the bar's height, the same way the Brawl
  panel does it; identity and actions sit on the right.
%>
<header class="ad-topbar">
  <button class="btn btn-kd-ghost btn-sm d-lg-none" id="scMenuToggle" type="button"
          aria-label="Open menu">
    <i data-lucide="menu" width="16" height="16"></i>
  </button>

  <div class="min-w-0">
    <h1 class="ad-page-title mb-0"><%= heading %></h1>
    <% if (typeof subheading !== 'undefined' && subheading) { %>
      <div class="ad-page-sub text-truncate"><%= subheading %></div>
    <% } %>
  </div>

  <div class="ms-auto d-flex align-items-center gap-2">
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="kd-tag d-none d-md-inline" title="<%= user.role %>"><%= user.username %></span>
    <% } %>
    <% if (typeof actions !== 'undefined' && actions) { %><%- actions %><% } %>
  </div>
</header>
