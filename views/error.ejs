<%- include('partials/head', { title }) %>
<div class="ad-login">
  <div class="ad-login-card text-center">
    <div class="ad-empty-icon mb-3">
      <i data-lucide="<%= status === 404 ? 'file-question' : 'triangle-alert' %>" width="28" height="28"></i>
    </div>
    <h1 class="ad-page-title mb-2"><%= status %></h1>
    <p class="ad-page-sub mb-4"><%= message %></p>
    <a class="btn btn-kd-ghost" href="/admin">
      <i data-lucide="arrow-left" width="15" height="15" class="me-1"></i>
      Back to dashboard
    </a>
    <% if (detail) { %>
      <pre class="ad-code text-start mt-4" style="white-space:pre-wrap;"><%= detail %></pre>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
