<%- include('partials/head', { title }) %>
<div class="sc-shell">
  <%- include('partials/sidebar') %>
  <div class="sc-scrim d-none" id="scScrim"></div>

  <main class="sc-main">
    <%- include('partials/topbar', {
      heading: 'Tags',
      subheading: 'What creators are searching for in the app'
    }) %>

    <%- include('partials/flash') %>

    <% if (tags.length === 0) { %>
      <div class="sc-card sc-empty">
        <div class="sc-empty-icon"><i data-lucide="tags" width="28" height="28"></i></div>
        <h2 class="h6 mb-1">No tags yet</h2>
        <p class="small mb-0" style="color:var(--sc-text-dim);">Tags are created when you add them to a skin.</p>
      </div>
    <% } else { %>
      <div class="sc-card sc-card-pad">
        <div class="d-flex flex-wrap gap-2">
          <% const maxUses = Math.max(...tags.map((t) => t.uses), 1); %>
          <% tags.forEach((tag) => { %>
            <%
              // Size the pill by usage — the tag cloud then tells you at a glance which styles
              // actually carry the catalogue.
              const weight = tag.uses / maxUses;
              const size = (0.76 + weight * 0.34).toFixed(2);
            %>
            <a class="sc-tag" href="/admin/skins?q=<%= encodeURIComponent(tag.name) %>"
               style="font-size:<%= size %>rem;<%= weight > 0.6 ? 'color:var(--sc-text);border-color:var(--sc-hairline-strong);' : '' %>">
              #<%= tag.name %>
              <span class="ms-2" style="color:var(--sc-text-dim);font-size:0.72em;"><%= tag.uses %></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </main>
</div>
<%- include('partials/foot') %>
