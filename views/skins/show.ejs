<%- include('../partials/head', { title }) %>
<div class="sc-shell">
  <%- include('../partials/sidebar') %>
  <div class="sc-scrim d-none" id="scScrim"></div>

  <main class="sc-main">
    <a class="btn btn-sc-ghost btn-sm mb-3" href="/admin/skins">
      <i data-lucide="arrow-left" width="14" height="14" class="me-1"></i>All skins
    </a>

    <%- include('../partials/flash') %>

    <div class="row g-3">
      <!-- Artwork -->
      <div class="col-12 col-lg-5">
        <div class="sc-card overflow-hidden mb-3">
          <img src="<%= skin.previewUrl %>" alt="<%= skin.title %> card artwork"
               style="width:100%;aspect-ratio:4/5;object-fit:cover;display:block;">
        </div>

        <div class="sc-card sc-card-pad">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 mb-0">Template</h2>
            <a class="sc-icon-btn" href="<%= skin.templateUrl %>" download
               title="Download template" aria-label="Download template">
              <i data-lucide="download" width="14" height="14"></i>
            </a>
          </div>
          <img src="<%= skin.templateUrl %>" alt="<%= skin.title %> template"
               class="sc-dropzone-preview" style="width:100%;max-height:none;">
          <% if (skin.color_hex) { %>
            <div class="d-flex justify-content-between align-items-center small mt-2">
              <span style="color:var(--sc-text-dim);">Dominant colour</span>
              <span class="d-flex align-items-center gap-2">
                <span style="width:14px;height:14px;border-radius:4px;display:inline-block;
                             background:<%= skin.color_hex %>;
                             box-shadow:inset 0 0 0 1px rgba(255,255,255,0.2);"></span>
                <span class="font-monospace"><%= skin.color_hex %></span>
              </span>
            </div>
          <% } %>
          <div class="d-flex justify-content-between small mt-2">
            <span style="color:var(--sc-text-dim);">Dimensions</span>
            <span class="fw-semibold">
              <%= skin.template_w %> × <%= skin.template_h %>
              <% if (skin.category !== 'avatar' && (skin.template_w !== 585 || skin.template_h !== 559)) { %>
                <i data-lucide="triangle-alert" width="13" height="13"
                   style="color:var(--sc-amber);" title="Not the standard 585 × 559"></i>
              <% } %>
            </span>
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="col-12 col-lg-7">
        <div class="sc-card sc-card-pad mb-3">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div style="min-width:0;">
              <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <span class="sc-badge category"><%= categoryLabels[skin.category] %></span>
                <% if (skin.isFeatured) { %>
                  <span class="sc-badge featured"><i data-lucide="sparkles" width="10" height="10"></i> Featured</span>
                <% } %>
                <% if (!skin.isPublished) { %><span class="sc-badge draft">Draft</span><% } %>
              </div>
              <h1 class="sc-page-title"><%= skin.title %></h1>
              <% if (skin.description) { %>
                <p class="sc-page-sub mt-2"><%= skin.description %></p>
              <% } %>
            </div>

            <div class="d-flex gap-2 flex-shrink-0">
              <a class="btn btn-sc-ghost btn-sm" href="/admin/skins/<%= skin.id %>/edit">
                <i data-lucide="pencil" width="14" height="14" class="me-1"></i>Edit
              </a>
            </div>
          </div>

          <!-- Quick actions -->
          <div class="d-flex flex-wrap gap-2">
            <form method="post" action="/admin/skins/<%= skin.id %>/feature" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm <%= skin.isFeatured ? 'btn-sc-primary' : 'btn-sc-ghost' %>" type="submit">
                <i data-lucide="sparkles" width="14" height="14" class="me-1"></i>
                <%= skin.isFeatured ? 'Featured' : 'Add to Featured' %>
              </button>
            </form>

            <form method="post" action="/admin/skins/<%= skin.id %>/publish" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-sc-ghost" type="submit">
                <i data-lucide="<%= skin.isPublished ? 'eye-off' : 'eye' %>" width="14" height="14" class="me-1"></i>
                <%= skin.isPublished ? 'Move to drafts' : 'Publish' %>
              </button>
            </form>

            <form method="post" action="/admin/skins/<%= skin.id %>/delete" class="m-0"
                  data-confirm="Delete “<%= skin.title %>”? This removes the files too and can't be undone.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-sc-ghost" type="submit"
                      style="color:var(--sc-danger);border-color:rgba(255,90,110,0.3);">
                <i data-lucide="trash-2" width="14" height="14" class="me-1"></i>Delete
              </button>
            </form>
          </div>
        </div>

        <!-- Metrics -->
        <div class="row g-3 mb-3">
          <div class="col-6">
            <div class="sc-card sc-card-pad h-100">
              <span class="sc-stat-icon mb-2"><i data-lucide="download" width="16" height="16"></i></span>
              <div class="sc-stat-value"><%= formatNumber(skin.downloads) %></div>
              <div class="sc-stat-label mt-1">Total downloads</div>
            </div>
          </div>
          <div class="col-6">
            <div class="sc-card sc-card-pad h-100">
              <span class="sc-stat-icon mb-2"><i data-lucide="calendar" width="16" height="16"></i></span>
              <div class="sc-stat-value"><%= formatNumber(series.reduce((sum, p) => sum + p.count, 0)) %></div>
              <div class="sc-stat-label mt-1">Last 14 days</div>
            </div>
          </div>
        </div>

        <!-- Per-skin history -->
        <div class="sc-card sc-card-pad mb-3">
          <h2 class="h6 mb-3">Download history</h2>
          <% const spark = sparklinePath(series, { width: 640, height: 90 }); %>
          <svg class="sc-chart" viewBox="0 0 640 90" preserveAspectRatio="none" style="height:90px;"
               role="img" aria-label="Downloads over the last 14 days">
            <defs>
              <linearGradient id="scStroke" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#7c5cff"/><stop offset="100%" stop-color="#2de2e6"/>
              </linearGradient>
              <linearGradient id="scFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#7c5cff" stop-opacity="0.30"/>
                <stop offset="100%" stop-color="#7c5cff" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <polygon class="sc-chart-area" points="<%= spark.area %>"/>
            <polyline class="sc-chart-line" points="<%= spark.line %>"/>
          </svg>
          <div class="d-flex justify-content-between mt-2 small" style="color:var(--sc-text-dim);">
            <span><%= formatDate(series[0].day) %></span>
            <span>peak <%= spark.max %>/day</span>
            <span><%= formatDate(series[series.length - 1].day) %></span>
          </div>
        </div>

        <!-- Reports -->
        <% if (reports.length) { %>
          <% const open = reports.filter((r) => r.status === 'open'); %>
          <div class="sc-card sc-card-pad mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <div class="d-flex align-items-center gap-2">
                <i data-lucide="flag" width="16" height="16"
                   style="color:<%= open.length ? 'var(--sc-danger)' : 'var(--sc-text-dim)' %>;"></i>
                <h2 class="h6 mb-0">Reports</h2>
              </div>
              <% if (open.length) { %>
                <form method="post" action="/admin/skins/<%= skin.id %>/reports/resolve" class="m-0">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sc-ghost btn-sm" type="submit">
                    <i data-lucide="check-check" width="14" height="14" class="me-1"></i>
                    Resolve all <%= open.length %>
                  </button>
                </form>
              <% } %>
            </div>

            <% reports.slice(0, 6).forEach((report) => { %>
              <div class="d-flex justify-content-between align-items-start gap-2 py-2"
                   style="border-top:1px solid var(--sc-hairline);">
                <div>
                  <span class="sc-reason <%= ['inappropriate','copyright'].includes(report.reason) ? 'urgent' : '' %>">
                    <%= report.reasonLabel %>
                  </span>
                  <% if (report.note) { %>
                    <p class="small mb-0 mt-1" style="color:var(--sc-text-muted);">“<%= report.note %>”</p>
                  <% } %>
                </div>
                <span class="small text-nowrap" style="color:var(--sc-text-dim);">
                  <%= timeAgo(report.created_at) %>
                </span>
              </div>
            <% }) %>
          </div>
        <% } %>

        <!-- Tags -->
        <% if (skin.tags.length) { %>
          <div class="sc-card sc-card-pad mb-3">
            <h2 class="h6 mb-3">Tags</h2>
            <div class="d-flex flex-wrap gap-2">
              <% skin.tags.forEach((tag) => { %>
                <a class="sc-tag" href="/admin/skins?q=<%= encodeURIComponent(tag) %>">#<%= tag %></a>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Everything else -->
        <div class="sc-card sc-card-pad">
          <h2 class="h6 mb-3">Details</h2>
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <tbody>
                <%
                  const rows = [
                    ['Catalogue ID', skin.id, true],
                    ['Author', skin.author || '—'],
                    ['Created', `${formatDate(skin.created_at)} · ${timeAgo(skin.created_at)}`],
                    ['Updated', `${formatDate(skin.updated_at)} · ${timeAgo(skin.updated_at)}`],
                    ['Template file', skin.template_file, true],
                    ['Preview file', skin.preview_file, true],
                    ['Storage used', formatBytes(skin.file_bytes)],
                  ];
                %>
                <% rows.forEach(([label, value, mono]) => { %>
                  <tr>
                    <td style="color:var(--sc-text-dim);width:38%;" class="small"><%= label %></td>
                    <td class="small <%= mono ? 'font-monospace' : '' %>" style="word-break:break-all;">
                      <%= value %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <hr class="sc-divider">

          <div class="d-flex align-items-center gap-2 mb-2">
            <i data-lucide="plug" width="15" height="15" style="color:var(--sc-cyan);"></i>
            <span class="small fw-semibold">API</span>
          </div>
          <code class="sc-code"><%= apiUrl %></code>

          <div class="d-flex align-items-center gap-2 mb-2 mt-3">
            <i data-lucide="link" width="15" height="15" style="color:var(--sc-cyan);"></i>
            <span class="small fw-semibold">Share link</span>
          </div>
          <code class="sc-code"><%= shareUrl %></code>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/foot') %>
