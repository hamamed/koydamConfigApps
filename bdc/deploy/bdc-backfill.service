[Unit]
Description=Marches publics — one-off full catalogue crawl
Documentation=man:systemd.service(5)
After=network-online.target bdc.service
Wants=network-online.target

[Service]
Type=oneshot
User=brawl
Group=brawl
WorkingDirectory=/opt/bdc
EnvironmentFile=/opt/bdc/.env
# The initial load, started by hand (`systemctl start bdc-backfill`), not a
# schedule.
#
# Consultations first, every page: at 50 rows a page the open listing is ~16
# pages rather than 76, and the crawl stops on its own when a page comes back
# empty. The cap is a guard, not a target.
ExecStart=/usr/bin/node bin/scrape.js --source=consultations --page-size=50 --max-pages=100 --no-details

# Awards are capped deliberately. The portal advertises ~6,300 pages of award
# history at fifty a page — the whole archive is roughly 300,000 rows and days of
# polite crawling at the delay this crawler keeps.
#
# 1500 pages is about a year: the first 200 pages held seven weeks, so the rate
# is roughly 1,400 awards a week. A year is the span that makes a price median
# mean something — the seven-week slice the panel started with was a snapshot
# being read as a trend. The listing is newest-first, so a shallower run is
# always a prefix of a deeper one; this upserts and is resumable, and re-running
# it costs time rather than correctness.
ExecStart=/usr/bin/node bin/scrape.js --source=results --page-size=50 --max-pages=1500 --no-details

# Then the detail page of every consultation that has none. This is the long
# part, and it is resumable: it picks up wherever the backlog stands.
ExecStart=/usr/bin/node bin/scrape.js --backfill
# A full catalogue with one detail page per avis takes hours at a polite pace.
TimeoutStartSec=86400

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bdc/data /opt/bdc/storage
SyslogIdentifier=bdc-backfill
