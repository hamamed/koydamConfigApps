[Unit]
Description=Marches publics — daily incremental crawl
After=network-online.target bdc.service
Wants=network-online.target

[Service]
Type=oneshot
User=brawl
Group=brawl
WorkingDirectory=/opt/bdc
EnvironmentFile=/opt/bdc/.env
# Only what the portal published in the last week, at 50 rows a page.
#
# Not "the first N pages": both listings are ordered by deadline, not by
# publication date, so a newly published avis does not appear near page 1 and a
# page-capped crawl would miss most of them. A publication-date floor asks for
# exactly what is new. The overlap of several days covers a missed run and any
# avis published while a crawl was mid-flight.
#
# The two sources are crawled separately because they need different things.
#
# The open listing is finite — about 16 pages at 50 rows — and it is ordered by
# deadline descending, so its LAST pages are the avis closing within a day. A
# 10-page cap stopped at row 500, which is precisely where every remaining avis
# closes tomorrow: roughly 200 a day were never recorded at all, and they were
# the most urgent ones to bid on and the next ones to become awards. So this
# takes the whole listing; the crawl stops on its own at the first empty page,
# and the cap is a guard rather than a target.
ExecStart=/usr/bin/node bin/scrape.js --source=consultations --page-size=50 --max-pages=30
# Awards are an archive that only grows, so recency is what matters here, not
# depth. The overlap of several days covers a missed run and anything published
# while a crawl was mid-flight.
ExecStart=/usr/bin/node bin/scrape.js --source=results --since=7 --page-size=50 --max-pages=25
# Then read the detail page of anything that still has none — the listing card
# carries no category, no nature of service and no articles.
ExecStart=/usr/bin/node bin/scrape.js --backfill --limit=300
TimeoutStartSec=5400

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bdc/data /opt/bdc/storage
SyslogIdentifier=bdc-scrape
