[Unit]
Description=Marches publics — daily incremental crawl
After=network-online.target bdc.service
Wants=network-online.target

[Service]
Type=oneshot
User=brawl
Group=brawl
WorkingDirectory=/opt/bdc
EnvironmentFile=/opt/bdc/.env
# Only what the portal published in the last week, at 50 rows a page.
#
# Not "the first N pages": both listings are ordered by deadline, not by
# publication date, so a newly published avis does not appear near page 1 and a
# page-capped crawl would miss most of them. A publication-date floor asks for
# exactly what is new. The overlap of several days covers a missed run and any
# avis published while a crawl was mid-flight.
ExecStart=/usr/bin/node bin/scrape.js --source=all --since=7 --page-size=50 --max-pages=10
# Then read the detail page of anything that still has none — the listing card
# carries no category, no nature of service and no articles.
ExecStart=/usr/bin/node bin/scrape.js --backfill --limit=300
TimeoutStartSec=5400

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bdc/data /opt/bdc/storage
SyslogIdentifier=bdc-scrape
