[Unit]
Description=Marches publics — crawl marchespublics.gov.ma
After=network-online.target bdc.service
Wants=network-online.target

[Service]
Type=oneshot
User=brawl
Group=brawl
WorkingDirectory=/opt/bdc
EnvironmentFile=/opt/bdc/.env
ExecStart=/usr/bin/node bin/scrape.js --source=all --max-pages=25
# Then close any gaps: a crawl only follows the detail page of rows it just
# created or changed, so a page that 404'd on the day, or a row seen before
# detail-reading existed, would keep its listing-only half-record forever.
# Bounded, so an unattended run cannot turn into an all-night crawl.
ExecStart=/usr/bin/node bin/scrape.js --backfill --limit=300
# A full crawl with detail pages at 2s between requests takes a while; the
# default 90s start timeout would kill it mid-run and leave the job row stuck
# in `running`, which then blocks the next scheduled crawl.
TimeoutStartSec=5400

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bdc/data /opt/bdc/storage
SyslogIdentifier=bdc-scrape
