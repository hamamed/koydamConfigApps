<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %> · <%= siteName %></title>
<meta name="description" content="<%= pageDescription %>">
<%
  /* Alternates so a search engine that finds one language finds the other two,
     and so a French reader is not served the Arabic page from a shared cache. */
%>
<% locales.forEach(function (l) { %>
<link rel="alternate" hreflang="<%= l.code %>" href="<%= canonical %>?lang=<%= l.code %>">
<% }) %>
<style>
  :root {
    --ink:#0f2c4d; --accent:#0b5394; --accent-soft:#eaf1fa;
    --bg:#f6f8fb; --card:#fff; --line:#e5e9f0; --text:#111827; --muted:#5b6675;
    --ok:#116b3a; --ok-soft:#e7f5ec; --warn:#9a4a06; --warn-soft:#fdf1e4;
    --radius:12px; --wrap:1080px;
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--text);
         font:15px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif; }
  body[dir="rtl"] { font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic","Geeza Pro",sans-serif; }
  a { color:var(--accent); text-decoration:none; }
  a:hover { text-decoration:underline; }
  .wrap { max-width:var(--wrap); margin:0 auto; padding:0 22px; }

  /* ---- header ------------------------------------------------------------ */
  header { background:var(--ink); color:#fff; }
  header .wrap { display:flex; align-items:center; gap:16px; padding-top:15px; padding-bottom:15px; }
  header a { color:#c9dcf2; }
  .brand { display:flex; align-items:center; gap:10px; font-weight:650; color:#fff; font-size:15.5px; }
  .brand small { display:block; font-weight:400; font-size:11px; color:#8fb2d8; letter-spacing:.03em; }
  .spacer { margin-inline-start:auto; }
  header nav { display:flex; gap:16px; align-items:center; font-size:13.5px; flex-wrap:wrap; }
  /* ---- language menu (shared shape with the panel's) ------------------ */
  .lang { position:relative; }
  .lang > summary { display:flex; align-items:center; gap:7px; cursor:pointer; list-style:none;
                    padding:7px 11px; border-radius:8px; font-size:13px; color:#c9dcf2;
                    border:1px solid rgba(255,255,255,.22); }
  .lang > summary::-webkit-details-marker { display:none; }
  .lang > summary:hover { background:rgba(255,255,255,.12); color:#fff; }
  .lang .caret { transition:transform .15s ease; }
  .lang[open] .caret { transform:rotate(180deg); }
  /* Opens downward here: the header sits at the top of the page, unlike the
     panel's picker which sits at the foot of a sidebar. */
  .lang-list { position:absolute; inset-block-start:calc(100% + 6px); inset-inline-end:0; min-width:172px;
               background:var(--card); border:1px solid var(--line); border-radius:10px; padding:5px;
               box-shadow:0 12px 32px rgba(15,44,77,.26); z-index:60; }
  .lang-list a { display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px;
                 color:var(--text); font-size:13.5px; }
  .lang-list a:hover { background:var(--accent-soft); text-decoration:none; }
  .lang-list a.on { background:var(--accent-soft); color:var(--accent); font-weight:600; }
  .lang-list .code { font-size:10.5px; letter-spacing:.06em; color:var(--muted);
                     border:1px solid var(--line); border-radius:5px; padding:1px 5px; min-width:26px; text-align:center; }
  .cta { display:inline-flex; align-items:center; gap:7px; background:#fff; color:var(--ink);
         padding:8px 15px; border-radius:8px; font-weight:600; font-size:13.5px; }
  .cta:hover { text-decoration:none; background:#eaf1fa; }

  /* ---- shared blocks ----------------------------------------------------- */
  main { padding:0 0 60px; }
  section { padding:44px 0; }
  h1 { font-size:34px; line-height:1.2; letter-spacing:-.02em; margin:0 0 14px; }
  h2 { font-size:21px; letter-spacing:-.01em; margin:0 0 16px; display:flex; align-items:center; gap:9px; }
  h3 { font-size:15.5px; margin:0 0 6px; }
  p { margin:0 0 14px; }
  .lede { font-size:17px; color:#334155; max-width:64ch; }
  .muted { color:var(--muted); }
  .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:20px; }
  .grid { display:grid; gap:16px; }
  .cols-3 { grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); }
  .cols-4 { grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); }
  .pill { display:inline-flex; align-items:center; gap:5px; padding:2px 9px; border-radius:999px;
          font-size:11px; background:var(--accent-soft); color:var(--accent); text-transform:uppercase;
          letter-spacing:.05em; font-weight:600; }
  .pill.ok { background:var(--ok-soft); color:var(--ok); }
  .pill.warn { background:var(--warn-soft); color:var(--warn); }
  .ic { flex:none; }
  /* References, dates and counts stay LTR on an RTL page — the same rule the
     panel carries, and for the same reason: "6/2026" otherwise renders as
     "2026/6". Direction and isolation only, never display. */
  .ltr { direction:ltr; unicode-bidi:isolate; }
  body[dir="rtl"] .flip-rtl { transform:scaleX(-1); }

  /* ---- footer ------------------------------------------------------------ */
  footer { background:#fff; border-top:1px solid var(--line); padding:26px 0 40px; font-size:13px; }
  footer .wrap { display:flex; gap:18px 26px; flex-wrap:wrap; align-items:baseline; }
  footer nav { display:flex; gap:18px; flex-wrap:wrap; }

  /* Wide tables scroll inside their card rather than taking the page with them. */
  .card table { min-width:520px; }
  .table-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }

  @media (max-width: 760px) {
    h1 { font-size:26px; }
    h2 { font-size:19px; }
    .lede { font-size:15.5px; }
    section { padding:30px 0; }
    .wrap { padding:0 16px; }
    header .wrap { flex-wrap:wrap; gap:10px 12px; }
    header nav { gap:12px; font-size:13px; width:100%; }
    .brand small { display:none; }
    .card { padding:16px; }
    .cols-4 { grid-template-columns:1fr 1fr; }
    footer .wrap { gap:12px 18px; }
    footer nav { gap:14px; }
  }

  @media (max-width: 420px) {
    h1 { font-size:23px; }
    .wrap { padding:0 13px; }
    .cols-4 { grid-template-columns:1fr 1fr; }
  }
</style>
</head>
<body dir="<%= dir %>">
<header>
  <div class="wrap">
    <a class="brand" href="/?lang=<%= locale %>">
      <%- include('icon', { name: 'file-text', size: 21 }) %>
      <span><%= siteName %><small><%= t('app.subtitle') %></small></span>
    </a>
    <nav class="spacer">
      <a href="/guide?lang=<%= locale %>"><%= t('public.nav.guide') %></a>
      <%- include('lang-menu', { variant: 'light' }) %>
      <% if (user) { %>
        <a class="cta" href="/panel?lang=<%= locale %>"><%- include('icon', { name: 'layout-dashboard', size: 15 }) %><%= content.landing.ctaPanel %></a>
      <% } else { %>
        <a class="cta" href="/login?lang=<%= locale %>"><%- include('icon', { name: 'key-round', size: 15 }) %><%= content.landing.ctaSignIn %></a>
      <% } %>
    </nav>
  </div>
</header>
<main>
