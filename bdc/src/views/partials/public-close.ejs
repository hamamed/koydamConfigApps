      <% if (contactEmail) { %><a href="mailto:<%= contactEmail %>" class="ltr"><%= contactEmail %></a><% } %>
      <a href="https://www.marchespublics.gov.ma/bdc/entreprise/consultation/" target="_blank" rel="noopener noreferrer">
        <%= t('public.nav.portal') %><%- include('icon', { name: 'external-link', size: 12 }) %>
      </a>
    </nav>
  </div>
