<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head><%- include('../partials/head', { title: consultation.reference }) %></head>
<body dir="<%= dir %>">
  <%- include('../partials/nav', { user: user, active: 'consultations' }) %>
  <main>
    <p><a href="/admin/consultations?lang=<%= locale %>"><%= t('detail.back') %></a></p>

    <div class="card">
      <h1 style="margin:0 0 6px; font-size:19px"><%= consultation.objet || '—' %></h1>
      <p class="muted" style="margin:0 0 14px">
        <code><%= consultation.reference %></code>
        <span class="pill <%= consultation.status === 'annule' ? 'warn' : consultation.status === 'awarded' ? 'ok' : '' %>"><%= t('status.' + consultation.status) %></span>
      </p>

      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
        <div><label><%= t('detail.buyer') %></label><%= consultation.acheteur || '—' %></div>
        <div><label><%= t('detail.category') %></label><%= consultation.categorie || '—' %></div>
        <div><label><%= t('detail.nature') %></label><%= consultation.nature_prestation || '—' %></div>
        <div><label><%= t('detail.place') %></label><%= consultation.lieu_execution || '—' %></div>
        <div><label><%= t('detail.published') %></label><span class="ltr"><%= consultation.date_publication || '—' %></span></div>
        <div><label><%= t('detail.deadline') %></label><span class="ltr"><%= consultation.date_limite || '—' %><%= consultation.heure_limite ? ' ' + consultation.heure_limite : '' %></span></div>
        <div><label><%= t('detail.portalId') %></label><span class="ltr"><%= consultation.source_id %></span></div>
      </div>

      <% if (consultation.date_annulation || consultation.motif_annulation) { %>
        <p class="error" style="margin-top:16px">
          <strong><%= t('detail.cancelledOn') %> <span class="ltr"><%= consultation.date_annulation || '—' %></span></strong>
          <% if (consultation.motif_annulation) { %><br><%= t('detail.cancelReason') %> : <%= consultation.motif_annulation %><% } %>
        </p>
      <% } %>

      <p style="margin:16px 0 0; display:flex; gap:8px; flex-wrap:wrap">
        <% if (consultation.detail_url) { %>
          <a class="btn" href="<%= consultation.detail_url %>" target="_blank" rel="noopener noreferrer"><%= t('detail.openOnPortal') %></a>
        <% } %>
        <button class="secondary" type="button" id="fetch-details" data-id="<%= consultation.id %>"><%= t('detail.fetchDetails') %></button>
      </p>
    </div>

    <div class="card">
      <h2 style="margin-top:0; font-size:16px"><%= t('detail.articles') %> (<span class="ltr"><%= consultation.articles.length %></span>)</h2>
      <% if (consultation.articles.length === 0) { %>
        <p class="muted"><%= t('detail.noArticles') %></p>
      <% } else { %>
        <table>
          <thead><tr>
            <th><%= t('article.number') %></th>
            <th><%= t('article.designation') %></th>
            <th><%= t('article.description') %></th>
            <th><%= t('article.quantity') %></th>
            <th><%= t('article.unit') %></th>
            <th><%= t('article.tva') %></th>
            <th><%= t('article.warranty') %></th>
          </tr></thead>
          <tbody>
            <% consultation.articles.forEach(function (a) { %>
              <tr>
                <td class="ltr"><%= a.article_number || '—' %></td>
                <td style="max-width:220px"><strong><%= a.designation %></strong></td>
                <td class="muted" style="max-width:420px"><%= a.description || '—' %></td>
                <td class="ltr"><%= a.quantity === null ? '—' : a.quantity %></td>
                <td><%= a.unit || '—' %></td>
                <td class="ltr"><%= a.tva_rate === null ? '—' : a.tva_rate %></td>
                <td><%= a.garanties || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <h2 style="margin-top:0; font-size:16px"><%= t('detail.award') %></h2>
      <% if (!consultation.result) { %>
        <p class="muted"><%= t('detail.noAward') %></p>
      <% } else { %>
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr))">
          <div><label><%= t('detail.winner') %></label><%= consultation.result.attributaire || '—' %></div>
          <div><label><%= t('detail.amount') %></label><span class="ltr"><%= consultation.result.montant_attribue === null ? '—' : consultation.result.montant_attribue + ' ' + consultation.result.currency %></span></div>
          <div><label><%= t('detail.bids') %></label><span class="ltr"><%= consultation.result.nombre_offres === null ? '—' : consultation.result.nombre_offres %></span></div>
          <div><label><%= t('detail.awardedOn') %></label><span class="ltr"><%= consultation.result.date_publication_resultat || '—' %></span></div>
          <div><label><%= t('jobs.status') %></label><%= t('status.' + (consultation.result.result_status || 'awarded')) %></div>
        </div>
      <% } %>
    </div>
  </main>

  <script>
    document.getElementById('fetch-details').addEventListener('click', async (event) => {
      const button = event.currentTarget
      button.disabled = true
      const response = await fetch('/admin/api/consultations/' + button.dataset.id + '/refresh', {
        method: 'POST',
        credentials: 'same-origin',
      })
      button.disabled = false
      if (response.ok) window.location.reload()
      else alert((await response.json()).error)
    })
  </script>
</body>
</html>
