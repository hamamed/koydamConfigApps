<!doctype html>
<html lang="fr">
<head><%- include('../partials/head', { title: 'Connexion' }) %></head>
<body>
  <main style="max-width:380px; margin-top:12vh">
    <div class="card">
      <h1 style="margin-top:0; font-size:20px">Administration</h1>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="/admin/login">
        <input type="hidden" name="next" value="<%= next %>">
        <div style="margin-bottom:12px">
          <label for="email">Adresse e-mail</label>
          <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="username">
        </div>
        <div style="margin-bottom:16px">
          <label for="password">Mot de passe</label>
          <input id="password" name="password" type="password" required autocomplete="current-password">
        </div>
        <button type="submit" style="width:100%">Se connecter</button>
      </form>
    </div>
  </main>
</body>
</html>
