<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head><%- include('../partials/head', { title: t('login.title') }) %></head>
<body dir="<%= dir %>">
  <main style="max-width:380px; margin-top:12vh">
    <div class="card">
      <h1 style="margin-top:0; font-size:20px"><%= t('login.title') %></h1>
      <p class="lang" style="margin:0 0 14px">
        <% locales.forEach(function (l) { %><a href="<%= langUrl(l.code) %>" style="border-color:var(--line); color:<%= l.code === locale ? 'var(--accent)' : 'var(--muted)' %>" hreflang="<%= l.code %>"><%= l.label %></a><% }) %>
      </p>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="/admin/login">
        <input type="hidden" name="next" value="<%= next %>">
        <div style="margin-bottom:12px">
          <label for="email"><%= t('login.email') %></label>
          <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="username" dir="ltr">
        </div>
        <div style="margin-bottom:16px">
          <label for="password"><%= t('login.password') %></label>
          <input id="password" name="password" type="password" required autocomplete="current-password" dir="ltr">
        </div>
        <button type="submit" style="width:100%"><%= t('login.submit') %></button>
      </form>
    </div>
  </main>
</body>
</html>
