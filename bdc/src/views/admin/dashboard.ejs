<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head><%- include('../partials/head', { title: t('nav.dashboard') }) %></head>
<body dir="<%= dir %>">
  <%- include('../partials/nav', { user: user, active: 'dashboard' }) %>
  <main>
    <div class="grid" style="margin-bottom:20px">
      <div class="stat"><b><%= dashboard.counts.consultations %></b><span><%= t('stats.consultations') %></span></div>
      <div class="stat"><b><%= dashboard.counts.articles %></b><span><%= t('stats.articles') %></span></div>
      <div class="stat"><b><%= dashboard.counts.results %></b><span><%= t('stats.results') %></span></div>
      <div class="stat"><b><%= dashboard.matchRate === null ? '—' : dashboard.matchRate + ' %' %></b><span><%= t('stats.matchRate') %></span></div>
      <div class="stat"><b><%= dashboard.counts.unmatchedResults %></b><span><%= t('stats.unmatched') %></span></div>
      <div class="stat"><b><%= dashboard.counts.ambiguousResults %></b><span><%= t('stats.ambiguous') %></span></div>
      <div class="stat"><b><%= dashboard.counts.pendingDetails %></b><span><%= t('stats.pendingDetails') %></span></div>
      <div class="stat"><b><%= dashboard.counts.invoices %></b><span><%= t('stats.invoices') %></span></div>
    </div>

    <div class="card">
      <h2 style="margin-top:0; font-size:16px"><%= t('scrape.title') %></h2>
      <form id="scrape-form" class="filters">
        <div>
          <label for="source"><%= t('scrape.source') %></label>
          <select id="source" name="source">
            <option value="all"><%= t('scrape.source.all') %></option>
            <option value="consultations"><%= t('scrape.source.consultations') %></option>
            <option value="results"><%= t('scrape.source.results') %></option>
          </select>
        </div>
        <div>
          <label for="maxPages"><%= t('scrape.maxPages') %></label>
          <input id="maxPages" name="maxPages" type="number" min="1" max="500" value="5" dir="ltr">
        </div>
        <div>
          <label for="acheteur"><%= t('scrape.buyerFilter') %></label>
          <input id="acheteur" name="acheteur" type="text">
        </div>
        <div>
          <label for="fetchDetails"><%= t('scrape.details') %></label>
          <select id="fetchDetails" name="fetchDetails">
            <option value="true"><%= locale === 'ar' ? 'نعم' : (locale === 'en' ? 'Yes' : 'Oui') %></option>
            <option value="false"><%= locale === 'ar' ? 'لا' : (locale === 'en' ? 'No' : 'Non') %></option>
          </select>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap">
          <button type="submit"><%= t('scrape.start') %></button>
          <button type="button" id="rematch" class="secondary"><%= t('scrape.rematch') %></button>
          <button type="button" id="backfill" class="secondary" title="<%= t('scrape.backfillHint') %>"><%= t('scrape.backfill') %></button>
        </div>
      </form>
      <p class="muted" style="margin-bottom:0"><%= t('scrape.backfillHint') %></p>
      <p id="scrape-status" class="muted" style="margin-bottom:0"></p>
    </div>

    <div class="card">
      <h2 style="margin-top:0; font-size:16px"><%= t('jobs.title') %></h2>
      <table>
        <thead><tr>
          <th>#</th><th><%= t('jobs.source') %></th><th><%= t('jobs.status') %></th>
          <th><%= t('jobs.pages') %></th><th><%= t('jobs.found') %></th><th><%= t('jobs.created') %></th>
          <th><%= t('jobs.updated') %></th><th><%= t('jobs.linked') %></th>
          <th><%= t('jobs.startedAt') %></th><th><%= t('jobs.duration') %></th>
        </tr></thead>
        <tbody>
          <% if (dashboard.recentJobs.length === 0) { %><tr><td colspan="10" class="muted"><%= t('jobs.empty') %></td></tr><% } %>
          <% dashboard.recentJobs.forEach(function (job) { %>
            <tr>
              <td class="ltr"><%= job.id %></td>
              <td><%= job.source %></td>
              <td><span class="pill <%= job.status === 'success' ? 'ok' : job.status === 'failed' ? 'warn' : '' %>"><%= job.status %></span></td>
              <td class="ltr"><%= job.pages_scraped %></td><td class="ltr"><%= job.items_found %></td><td class="ltr"><%= job.items_created %></td>
              <td class="ltr"><%= job.items_updated %></td><td class="ltr"><%= job.matches_linked %></td>
              <td class="muted ltr"><%= job.started_at %></td>
              <td class="muted ltr"><%= job.duration_ms === null ? '—' : Math.round(job.duration_ms / 1000) + ' s' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    const status = document.getElementById('scrape-status')
    const RUNNING = <%- JSON.stringify(t('scrape.running')) %>
    const post = async (url, body, button) => {
      button.disabled = true
      status.textContent = RUNNING
      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(body),
        })
        const payload = await response.json()
        status.textContent = response.ok ? JSON.stringify(payload.data) : payload.error
        if (response.ok) setTimeout(() => window.location.reload(), 2500)
      } catch (error) {
        status.textContent = error.message
      } finally {
        button.disabled = false
      }
    }

    document.getElementById('scrape-form').addEventListener('submit', (event) => {
      event.preventDefault()
      const form = new FormData(event.target)
      const acheteur = form.get('acheteur')
      post('/admin/api/scrape', {
        source: form.get('source'),
        maxPages: Number(form.get('maxPages')),
        fetchDetails: form.get('fetchDetails') === 'true',
        filters: acheteur ? { acheteur } : {},
      }, event.submitter)
    })

    document.getElementById('rematch').addEventListener('click', (event) => post('/admin/api/rematch', {}, event.target))
    document.getElementById('backfill').addEventListener('click', (event) => post('/admin/api/backfill-details', {}, event.target))
  </script>
</body>
</html>
