<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head><%- include('../partials/head', { title: t('nav.consultations') }) %></head>
<body dir="<%= dir %>">
  <%- include('../partials/nav', { user: user, active: 'consultations' }) %>
  <main>
    <div class="card">
      <form class="filters" method="get">
        <input type="hidden" name="lang" value="<%= locale %>">
        <div><label for="reference"><%= t('filters.reference') %></label><input id="reference" name="reference" value="<%= query.reference || '' %>" dir="ltr"></div>
        <div><label for="objet"><%= t('filters.objet') %></label><input id="objet" name="objet" value="<%= query.objet || '' %>"></div>
        <div><label for="acheteur"><%= t('filters.acheteur') %></label><input id="acheteur" name="acheteur" value="<%= query.acheteur || '' %>"></div>
        <div><label for="categorie"><%= t('filters.categorie') %></label><input id="categorie" name="categorie" value="<%= query.categorie || '' %>"></div>
        <div><label for="lieuExecution"><%= t('filters.lieuExecution') %></label><input id="lieuExecution" name="lieuExecution" value="<%= query.lieuExecution || '' %>"></div>
        <div><label for="datePublicationStart"><%= t('filters.publishedFrom') %></label><input id="datePublicationStart" name="datePublicationStart" type="date" value="<%= query.datePublicationStart || '' %>" dir="ltr"></div>
        <div><label for="datePublicationEnd"><%= t('filters.publishedTo') %></label><input id="datePublicationEnd" name="datePublicationEnd" type="date" value="<%= query.datePublicationEnd || '' %>" dir="ltr"></div>
        <div><button type="submit"><%= t('filters.submit') %></button></div>
      </form>
    </div>

    <div class="card">
      <p class="muted"><%= t('table.count', { count: total, page: pagination.page }) %></p>
      <table>
        <thead><tr>
          <th><%= t('table.reference') %></th><th><%= t('table.objet') %></th><th><%= t('table.acheteur') %></th>
          <th><%= t('table.categorie') %></th><th><%= t('table.deadline') %></th>
          <th><%= t('table.articles') %></th><th><%= t('table.result') %></th><th></th>
        </tr></thead>
        <tbody>
          <% if (rows.length === 0) { %><tr><td colspan="8" class="muted"><%= t('table.empty') %></td></tr><% } %>
          <% rows.forEach(function (row) { %>
            <tr data-id="<%= row.id %>">
              <td><a href="/admin/consultations/<%= row.id %>?lang=<%= locale %>"><code><%= row.reference %></code></a></td>
              <td style="max-width:320px"><a href="/admin/consultations/<%= row.id %>?lang=<%= locale %>" style="color:inherit"><%= row.objet || '—' %></a></td>
              <td><%= row.acheteur || '—' %></td>
              <td><%= row.categorie || '—' %></td>
              <td class="ltr"><%= row.date_limite || '—' %></td>
              <td class="ltr"><%= row.lots_count %></td>
              <td>
                <% if (row.result) { %>
                  <span class="pill ok"><%= row.result.attributaire || t('status.' + (row.result.result_status || 'awarded')) %></span>
                <% } else { %><span class="pill"><%= t('status.' + row.status) %></span><% } %>
              </td>
              <td style="white-space:nowrap">
                <button class="secondary refresh" type="button"><%= t('table.refresh') %></button>
                <button class="secondary remove" type="button"><%= t('table.delete') %></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div style="margin-top:14px; display:flex; gap:8px">
        <% if (pagination.page > 1) { %><a class="btn" href="?<%= new URLSearchParams(Object.assign({}, query, { page: pagination.page - 1, lang: locale })).toString() %>"><%= t('table.previous') %></a><% } %>
        <% if (pagination.page * pagination.perPage < total) { %><a class="btn" href="?<%= new URLSearchParams(Object.assign({}, query, { page: pagination.page + 1, lang: locale })).toString() %>"><%= t('table.next') %></a><% } %>
      </div>
    </div>
  </main>

  <script>
    const CONFIRM_DELETE = <%- JSON.stringify(t('table.confirmDelete')) %>
    const call = async (method, url, button) => {
      button.disabled = true
      const response = await fetch(url, { method, credentials: 'same-origin' })
      button.disabled = false
      if (response.ok) window.location.reload()
      else alert((await response.json()).error)
    }

    document.querySelectorAll('.refresh').forEach((button) =>
      button.addEventListener('click', () =>
        call('POST', '/admin/api/consultations/' + button.closest('tr').dataset.id + '/refresh', button)))

    document.querySelectorAll('.remove').forEach((button) =>
      button.addEventListener('click', () => {
        if (!confirm(CONFIRM_DELETE)) return
        call('DELETE', '/admin/api/consultations/' + button.closest('tr').dataset.id, button)
      }))
  </script>
</body>
</html>
