<%- include('../partials/public-open', { pageTitle: t('awards.title'), pageDescription: t('data.awardsLede') }) %>

<section>
  <div class="wrap">
    <h1><%- include('../partials/icon', { name: 'award', size: 22 }) %> <%= t('awards.title') %></h1>
    <p class="lede"><%= t('data.awardsLede') %></p>

    <form method="get" class="card" style="display:grid; gap:12px; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); align-items:end">
      <input type="hidden" name="lang" value="<%= locale %>">
      <div class="field">
        <label for="q"><%= t('filters.objet') %></label>
        <input id="q" name="q" value="<%= query.q || '' %>">
      </div>
      <div class="field">
        <label for="acheteur"><%= t('filters.acheteur') %></label>
        <input id="acheteur" name="acheteur" value="<%= query.acheteur || '' %>">
      </div>
      <div class="field">
        <label for="attributaire"><%= t('awards.winner') %></label>
        <input id="attributaire" name="attributaire" value="<%= query.attributaire || '' %>">
      </div>
      <div class="field">
        <label for="sort"><%= t('sort.label') %></label>
        <select id="sort" name="sort">
          <% [['date_publication_resultat:desc','sort.awardDesc'],['relevance','sort.relevance'],['montant_attribue_cents:desc','sort.amountDesc']].forEach(function (o) { %>
            <option value="<%= o[0] %>" <%= (query.sort || '') === o[0] ? 'selected' : '' %>><%= t(o[1]) %></option>
          <% }) %>
        </select>
      </div>
      <div><button type="submit" class="submit"><%= t('filters.submit') %></button></div>
    </form>

    <p class="muted" style="font-size:13px"><%= t('awards.count', { count: total, page: pagination.page }) %></p>

    <div class="card" style="padding:0; overflow-x:auto">
      <% if (rows.length === 0) { %>
        <p style="padding:26px; text-align:center; color:var(--muted)"><%= t('awards.empty') %></p>
      <% } else { %>
        <table>
          <thead><tr>
            <th><%= t('table.reference') %></th><th><%= t('table.objet') %></th><th><%= t('table.acheteur') %></th>
            <th><%= t('awards.winner') %></th><th><%= t('awards.amount') %></th>
            <th><%= t('awards.bids') %></th><th><%= t('awards.publishedOn') %></th>
          </tr></thead>
          <tbody>
            <% rows.forEach(function (row) { %>
              <tr>
                <td><code class="ltr"><%= row.reference %></code></td>
                <td style="max-width:280px"><%= row.objet || '—' %></td>
                <td><% if (row.acheteur) { %><a href="/buyers/<%= encodeURIComponent(row.acheteur) %>?lang=<%= locale %>"><%= row.acheteur %></a><% } else { %>—<% } %></td>
                <td><% if (row.attributaire) { %><a href="/companies/<%= encodeURIComponent(row.attributaire) %>?lang=<%= locale %>"><%= row.attributaire %></a><% } else { %>—<% } %></td>
                <td class="ltr"><%= row.montant_attribue === null ? '—' : row.montant_attribue %></td>
                <td class="ltr"><%= row.nombre_offres === null ? '—' : row.nombre_offres %></td>
                <td class="ltr"><%= row.date_publication_resultat || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <p style="display:flex; gap:10px; margin-top:16px">
      <% if (pagination.page > 1) { %>
        <a href="?<%= new URLSearchParams(Object.assign({}, query, { page: pagination.page - 1, lang: locale })).toString() %>"><%= t('table.previous') %></a>
      <% } %>
      <% if (pagination.page * pagination.perPage < total) { %>
        <a href="?<%= new URLSearchParams(Object.assign({}, query, { page: pagination.page + 1, lang: locale })).toString() %>"><%= t('table.next') %></a>
      <% } %>
      <span class="spacer"></span>
      <a href="/data?lang=<%= locale %>"><%= t('data.title') %></a>
    </p>
  </div>
</section>

<style>
  table { width:100%; border-collapse:collapse; font-size:13.5px; }
  th, td { text-align:start; padding:10px 12px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-weight:600; }
  tbody tr:last-child td { border-bottom:0; }
  code { direction:ltr; unicode-bidi:isolate; background:#f2f5f9; padding:1px 6px; border-radius:5px; font-size:12.5px; }
  .field label { display:block; font-size:12px; color:var(--muted); margin-bottom:5px; font-weight:500; }
  .field input, .field select { width:100%; padding:8px 10px; border:1px solid var(--line); border-radius:8px; font:inherit; font-size:13.5px; background:#fff; }
  .submit { background:var(--ink); color:#fff; border:0; padding:9px 18px; border-radius:8px; font:inherit; font-weight:600; font-size:13.5px; cursor:pointer; }
  .submit:hover { background:var(--accent); }
</style>

<%- include('../partials/public-close') %>
