<%- include('../partials/shell-open', { title: t('companies.title') }) %>

<div class="page-head">
  <h1><%- include('../partials/icon', { name: 'award', size: 19 }) %> <%= t('companies.title') %></h1>
  <span class="muted spacer">
    <% if (total === summary.companies) { %>
      <span class="ltr"><%= summary.companies %></span>
    <% } else { %>
      <span class="ltr"><%= total %></span> / <span class="ltr"><%= summary.companies %></span>
    <% } %>
  </span>
</div>

<%# Coverage first: the point of this screen is which companies we can say
    anything about beyond a name, so the counts lead. %>
<div class="grid" style="margin-bottom:14px">
  <div class="stat"><b class="ltr"><%= summary.companies %></b><span><%= t('companies.total') %></span></div>
  <div class="stat">
    <b class="ltr" style="color:var(--ok)"><%= summary.known %></b>
    <span><%- include('../partials/icon', { name: 'circle-check', size: 13 }) %><%= t('companies.known') %></span>
  </div>
  <div class="stat">
    <b class="ltr"><%= summary.companies - summary.known %></b>
    <span><%= t('companies.unknown') %></span>
  </div>
  <div class="stat">
    <b class="ltr" style="<%= summary.excluded ? 'color:#a4262c' : '' %>"><%= summary.excluded %></b>
    <span><%- include('../partials/icon', { name: 'triangle-alert', size: 13 }) %><%= t('companies.excluded') %></span>
  </div>
</div>

<div class="card">
  <form class="filters" method="get">
    <input type="hidden" name="lang" value="<%= locale %>">
    <div style="min-width:240px">
      <label for="q"><%= t('companies.search') %></label>
      <input id="q" name="q" value="<%= filters.q %>" placeholder="<%= t('companies.searchPlaceholder') %>">
    </div>
    <div>
      <label for="city"><%= t('companies.city') %></label>
      <select id="city" name="city">
        <option value=""><%= t('companies.allCities') %></option>
        <% cities.forEach(function (town) { %>
          <option value="<%= town.label %>" <%= filters.city === town.label ? 'selected' : '' %>><%= town.label %> (<%= town.total %>)</option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="filter"><%= t('companies.filter') %></label>
      <select id="filter" name="filter">
        <% [['', 'companies.filter.all'], ['known', 'companies.filter.known'], ['unknown', 'companies.filter.unknown'],
            ['qualified', 'companies.filter.qualified'], ['excluded', 'companies.filter.excluded']].forEach(function (o) { %>
          <option value="<%= o[0] %>" <%= filters.filter === o[0] ? 'selected' : '' %>><%= t(o[1]) %></option>
        <% }) %>
      </select>
    </div>
    <div><button type="submit"><%- include('../partials/icon', { name: 'search', size: 15 }) %><%= t('filters.submit') %></button></div>
    <% if (filters.q || filters.filter || filters.city) { %>
      <div><a class="btn secondary" href="/panel/companies?lang=<%= locale %>"><%= t('exclusion.clear') %></a></div>
    <% } %>
  </form>
</div>

<div class="card" style="padding:0; overflow:hidden">
  <% if (rows.length === 0) { %>
    <p class="empty"><%= t('companies.none') %></p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <th><%= t('insights.company') %></th>
          <th><%= t('companies.city') %></th>
          <th><%= t('company.awards') %></th>
          <th><%= t('company.total') %></th>
          <th><%= t('company.buyers') %></th>
          <th><%= t('companies.identity') %></th>
        </tr></thead>
        <tbody>
          <% rows.forEach(function (row) { %>
            <tr>
              <td style="max-width:300px">
                <a href="/panel/companies/<%= encodeURIComponent(row.name) %>?lang=<%= locale %>"><%= row.name %></a>
              </td>
              <td>
                <% if (row.city) { %>
                  <a href="?<%= new URLSearchParams(Object.assign({}, query, { city: row.city, page: 1, lang: locale })).toString() %>"><%= row.city %></a>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="ltr"><%= row.awards %></td>
              <td class="ltr"><%= row.total %></td>
              <td class="ltr"><%= row.buyers %></td>
              <td>
                <div class="row-actions" style="flex-wrap:wrap">
                  <% if (row.qualified) { %>
                    <span class="pill ok" title="<%= t('companies.badge.qualifiedHint') %>">
                      <%- include('../partials/icon', { name: 'map-pin', size: 12 }) %><%= t('companies.badge.qualified') %>
                    </span>
                  <% } %>
                  <% if (row.recorded) { %>
                    <span class="pill" title="<%= t('companies.badge.recordedHint') %>">
                      <%- include('../partials/icon', { name: 'circle-check', size: 12 }) %><%= t('companies.badge.recorded') %>
                    </span>
                  <% } %>
                  <% if (row.excluded) { %>
                    <span class="pill warn" title="<%= t('companies.badge.excludedHint') %>">
                      <%- include('../partials/icon', { name: 'triangle-alert', size: 12 }) %><%= t('companies.badge.excluded') %>
                    </span>
                  <% } %>
                  <% if (!row.known && !row.excluded) { %>
                    <span class="muted" style="font-size:12px"><%= t('companies.badge.nameOnly') %></span>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div style="display:flex; gap:8px; align-items:center">
  <% if (page > 1) { %>
    <a class="btn secondary" href="?<%= new URLSearchParams(Object.assign({}, query, { page: page - 1, lang: locale })).toString() %>"><%- include('../partials/icon', { name: 'chevron-left', size: 15, cls: 'flip-rtl' }) %><%= t('table.previous') %></a>
  <% } %>
  <span class="muted spacer" style="font-size:12px"><%= t('table.count', { count: total, page: page }) %></span>
  <% if (page * perPage < total) { %>
    <a class="btn secondary" href="?<%= new URLSearchParams(Object.assign({}, query, { page: page + 1, lang: locale })).toString() %>"><%= t('table.next') %><%- include('../partials/icon', { name: 'chevron-right', size: 15, cls: 'flip-rtl' }) %></a>
  <% } %>
</div>

<%- include('../partials/shell-close') %>
