<%- include('../partials/shell-open', { title: t('insights.title') }) %>

<div class="page-head"><h1><%- include('../partials/icon', { name: 'award', size: 19 }) %> <%= t('insights.title') %></h1></div>

<div class="card">
  <form class="filters" method="get">
    <input type="hidden" name="lang" value="<%= locale %>">
    <div><label for="categorie"><%= t('filters.categorie') %></label><input id="categorie" name="categorie" value="<%= query.categorie || '' %>"></div>
    <div><label for="lieuExecution"><%= t('filters.lieuExecution') %></label><input id="lieuExecution" name="lieuExecution" value="<%= query.lieuExecution || '' %>"></div>
    <div><label for="acheteur"><%= t('filters.acheteur') %></label><input id="acheteur" name="acheteur" value="<%= query.acheteur || '' %>"></div>
    <div><label for="attributaire"><%= t('awards.winner') %></label><input id="attributaire" name="attributaire" value="<%= query.attributaire || '' %>"></div>
    <div><label for="q"><%= t('filters.objet') %></label><input id="q" name="q" value="<%= query.q || '' %>"></div>
    <div><button type="submit"><%- include('../partials/icon', { name: 'search', size: 15 }) %><%= t('filters.submit') %></button></div>
  </form>
  <p class="muted" style="margin:12px 0 0; font-size:12.5px"><%= t('insights.intro') %></p>
</div>

<% if (insights.summary.awards === 0) { %>
  <div class="card"><p class="empty"><%= t('insights.empty') %></p></div>
<% } else { %>
  <div class="grid" style="margin-bottom:18px">
    <div class="stat"><b class="ltr"><%= insights.summary.awards %></b><span><%= t('insights.awards') %></span></div>
    <div class="stat" title="<%= t('insights.medianHint') %>">
      <b class="ltr"><%= insights.summary.median === null ? '—' : insights.summary.median.toLocaleString('fr-MA') %></b>
      <span><%= t('insights.median') %></span>
    </div>
    <div class="stat"><b class="ltr"><%= insights.summary.total === null ? '—' : Math.round(insights.summary.total).toLocaleString('fr-MA') %></b><span><%= t('insights.total') %></span></div>
    <div class="stat"><b class="ltr" style="font-size:15px"><%= insights.summary.min === null ? '—' : Math.round(insights.summary.min).toLocaleString('fr-MA') + ' – ' + Math.round(insights.summary.max).toLocaleString('fr-MA') %></b><span><%= t('insights.range') %></span></div>
    <div class="stat"><b class="ltr"><%= insights.summary.avgBids === null ? '—' : insights.summary.avgBids %></b><span><%= t('insights.avgBids') %></span></div>
    <div class="stat" title="<%= t('insights.unsuccessfulHint') %>"><b class="ltr"><%= insights.summary.unsuccessfulRate === null ? '—' : insights.summary.unsuccessfulRate + ' %' %></b><span><%= t('insights.unsuccessful') %></span></div>
    <div class="stat"><b class="ltr"><%= insights.summary.winners %></b><span><%= t('insights.company') %></span></div>
    <div class="stat"><b class="ltr"><%= insights.summary.buyers %></b><span><%= t('insights.buyer') %></span></div>
  </div>

  <% const bar = function (value, max) { return max > 0 ? Math.max(2, Math.round((value / max) * 100)) : 0 } %>

  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(330px,1fr)); align-items:start">
    <% [['winners','insights.winners','insights.company'],['buyers','insights.buyers','insights.buyer'],['categories','insights.categories','insights.category']].forEach(function (block) { %>
      <% const rows = insights[block[0]]; const max = rows.length ? Math.max(...rows.map(function (r) { return r.awards })) : 0 %>
      <div class="card" style="padding-bottom:8px">
        <h2><%= t(block[1]) %></h2>
        <% if (rows.length === 0) { %><p class="empty"><%= t('insights.empty') %></p><% } else { %>
          <table>
            <thead><tr><th><%= t(block[2]) %></th><th style="width:34%"><%= t('insights.count') %></th><th><%= t('insights.total') %></th></tr></thead>
            <tbody>
              <% rows.forEach(function (r) { %>
                <tr>
                  <td style="max-width:210px"><%= r.label %></td>
                  <td>
                    <span class="ltr"><%= r.awards %></span>
                    <span style="display:block; height:5px; border-radius:3px; background:var(--accent); opacity:.75; width:<%= bar(r.awards, max) %>%"></span>
                  </td>
                  <td class="ltr"><%= r.total === null ? '—' : Math.round(r.total).toLocaleString('fr-MA') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    <% }) %>
  </div>

  <div class="card" style="padding-bottom:8px">
    <h2><%- include('../partials/icon', { name: 'calendar', size: 15 }) %><%= t('insights.months') %></h2>
    <% const maxMonth = insights.months.length ? Math.max(...insights.months.map(function (m) { return m.awards })) : 0 %>
    <table>
      <thead><tr><th><%= t('insights.month') %></th><th style="width:60%"><%= t('insights.count') %></th><th><%= t('insights.total') %></th></tr></thead>
      <tbody>
        <% insights.months.forEach(function (m) { %>
          <tr>
            <td class="ltr"><%= m.month %></td>
            <td>
              <span class="ltr"><%= m.awards %></span>
              <span style="display:block; height:5px; border-radius:3px; background:var(--accent); opacity:.75; width:<%= bar(m.awards, maxMonth) %>%"></span>
            </td>
            <td class="ltr"><%= m.total === null ? '—' : Math.round(m.total).toLocaleString('fr-MA') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/shell-close') %>
