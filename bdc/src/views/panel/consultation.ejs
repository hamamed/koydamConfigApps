<%- include('../partials/shell-open', { title: consultation.reference }) %>

<div class="page-head">
  <a class="btn secondary" href="/panel?lang=<%= locale %>"><%- include('../partials/icon', { name: 'arrow-left', size: 15, cls: 'flip-rtl' }) %><%= t('detail.back') %></a>
  <span class="spacer"></span>
  <button class="star-btn" type="button" id="star" data-id="<%= consultation.id %>" aria-pressed="<%= consultation.isFavorite ? 'true' : 'false' %>"
          title="<%= consultation.isFavorite ? t('projects.untrack') : t('projects.track') %>">
    <%- include('../partials/icon', { name: 'star', size: 22, fill: consultation.isFavorite ? 'currentColor' : 'none' }) %>
  </button>
</div>

<div class="card">
  <h1 style="margin:0 0 6px; font-size:18px"><%= consultation.objet || '—' %></h1>
  <p class="muted" style="margin:0 0 16px">
    <code><%= consultation.reference %></code>
    <span class="pill <%= consultation.status === 'annule' ? 'warn' : consultation.status === 'awarded' ? 'ok' : '' %>"><%= t('status.' + consultation.status) %></span>
  </p>

  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(215px,1fr))">
    <div><label><%- include('../partials/icon', { name: 'building-2', size: 13 }) %> <%= t('detail.buyer') %></label><%= consultation.acheteur || '—' %></div>
    <div><label><%= t('detail.category') %></label><%= consultation.categorie || '—' %></div>
    <div><label><%= t('detail.nature') %></label><%= consultation.nature_prestation || '—' %></div>
    <div><label><%- include('../partials/icon', { name: 'map-pin', size: 13 }) %> <%= t('detail.place') %></label><%= consultation.lieu_execution || '—' %></div>
    <div><label><%= t('detail.published') %></label><span class="ltr"><%= consultation.date_publication || '—' %></span></div>
    <div><label><%- include('../partials/icon', { name: 'calendar', size: 13 }) %> <%= t('detail.deadline') %></label><%- include('../partials/deadline', { deadline: consultation.deadline, date: (consultation.date_limite || '') + (consultation.heure_limite ? ' ' + consultation.heure_limite : '') }) %></div>
    <div><label><%= t('detail.portalId') %></label><span class="ltr"><%= consultation.source_id %></span></div>
  </div>

  <% const cancellationDocs = consultation.documents.filter(function (d) { return d.kind === 'annulation' }) %>
  <% if (consultation.is_cancelled || consultation.date_annulation || consultation.motif_annulation) { %>
    <div class="error" style="margin-top:16px">
      <strong><%= t('detail.cancelledOn') %> <span class="ltr"><%= consultation.date_annulation || '—' %></span></strong>
      <% if (consultation.motif_annulation) { %><br><%= t('detail.cancelReason') %> : <%= consultation.motif_annulation %><% } %>
      <% cancellationDocs.forEach(function (doc) { %>
        <br><a href="<%= doc.url %>" target="_blank" rel="noopener noreferrer"><%- include('../partials/icon', { name: 'file-text', size: 13 }) %>
          <%= doc.file_name || t('detail.documentAnnulation') %></a>
      <% }) %>
    </div>
  <% } %>

  <p style="margin:16px 0 0; display:flex; gap:8px; flex-wrap:wrap">
    <% if (consultation.detail_url) { %>
      <a class="btn secondary" href="<%= consultation.detail_url %>" target="_blank" rel="noopener noreferrer"><%- include('../partials/icon', { name: 'external-link', size: 15 }) %><%= t('detail.openOnPortal') %></a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <button class="secondary" type="button" id="refresh" data-id="<%= consultation.id %>"><%- include('../partials/icon', { name: 'refresh-cw', size: 15 }) %><%= t('detail.fetchDetails') %></button>
    <% } %>
  </p>
</div>

<% if (consultation.isFavorite) { %>
  <div class="card">
    <h2><%- include('../partials/icon', { name: 'star', size: 15, fill: 'currentColor' }) %><%= t('favorites.note') %></h2>
    <form id="note-form" style="display:flex; gap:8px; align-items:flex-end">
      <div style="flex:1"><input name="note" value="<%= favorite && favorite.note ? favorite.note : '' %>" placeholder="<%= t('favorites.notePlaceholder') %>"></div>
      <button class="secondary" type="submit"><%- include('../partials/icon', { name: 'save', size: 15 }) %><%= t('favorites.saveNote') %></button>
    </form>
  </div>
<% } %>

<div class="card">
  <h2><%- include('../partials/icon', { name: 'file-text', size: 15 }) %><%= t('detail.documents') %> (<span class="ltr"><%= consultation.documents.length %></span>)</h2>
  <% if (consultation.documents.length === 0) { %>
    <p class="empty"><%= t('detail.noDocuments') %></p>
  <% } else { %>
    <ul style="margin:0; padding-inline-start:18px">
      <% consultation.documents.forEach(function (doc) { %>
        <li style="margin-bottom:6px">
          <a href="<%= doc.url %>" target="_blank" rel="noopener noreferrer"><%= doc.file_name || t('detail.document' + (doc.kind === 'annulation' ? 'Annulation' : 'Avis')) %></a>
          <span class="pill <%= doc.kind === 'annulation' ? 'warn' : '' %>"><%= t('detail.document' + (doc.kind === 'annulation' ? 'Annulation' : 'Avis')) %></span>
          <span class="muted" style="font-size:11.5px"><%- include('../partials/icon', { name: 'external-link', size: 12 }) %> <%= t('detail.onPortal') %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<div class="card" style="padding-bottom:6px">
  <h2><%- include('../partials/icon', { name: 'package', size: 15 }) %><%= t('detail.articles') %> (<span class="ltr"><%= consultation.articles.length %></span>)</h2>
  <% if (consultation.articles.length === 0) { %>
    <p class="empty"><%= t('detail.noArticles') %></p>
  <% } else { %>
    <div style="overflow-x:auto">
      <table>
        <thead><tr>
          <th><%= t('article.number') %></th><th><%= t('article.designation') %></th>
          <th><%= t('article.description') %></th><th><%= t('article.quantity') %></th>
          <th><%= t('article.unit') %></th><th><%= t('article.tva') %></th><th><%= t('article.warranty') %></th>
        </tr></thead>
        <tbody>
          <% consultation.articles.forEach(function (a) { %>
            <tr>
              <td class="ltr"><%= a.article_number || '—' %></td>
              <td style="max-width:210px"><strong><%= a.designation %></strong></td>
              <td class="muted" style="max-width:400px"><%= a.description || '—' %></td>
              <td class="ltr"><%= a.quantity === null ? '—' : a.quantity %></td>
              <td><%= a.unit || '—' %></td>
              <td class="ltr"><%= a.tva_rate === null ? '—' : a.tva_rate %></td>
              <td><%= a.garanties || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <h2><%- include('../partials/icon', { name: 'award', size: 15 }) %><%= t('detail.award') %></h2>
  <% if (!consultation.result) { %>
    <p class="empty"><%= t('detail.noAward') %></p>
  <% } else { %>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(190px,1fr))">
      <div><label><%= t('detail.winner') %></label><%= consultation.result.attributaire || '—' %></div>
      <div><label><%= t('detail.amount') %></label><span class="ltr"><%= consultation.result.montant_attribue === null ? '—' : consultation.result.montant_attribue + ' ' + consultation.result.currency %></span></div>
      <div><label><%= t('detail.bids') %></label><span class="ltr"><%= consultation.result.nombre_offres === null ? '—' : consultation.result.nombre_offres %></span></div>
      <div><label><%= t('detail.awardedOn') %></label><span class="ltr"><%= consultation.result.date_publication_resultat || '—' %></span></div>
      <div><label><%= t('jobs.status') %></label><%= t('status.' + (consultation.result.result_status || 'awarded')) %></div>
    </div>
  <% } %>
</div>

<script>
  const star = document.getElementById('star')
  star.addEventListener('click', async () => {
    const on = star.getAttribute('aria-pressed') === 'true'
    star.disabled = true
    const response = await fetch(on ? '/api/favorites/' + star.dataset.id : '/api/favorites', {
      method: on ? 'DELETE' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: on ? undefined : JSON.stringify({ consultationId: Number(star.dataset.id) }),
    })
    if (response.ok) window.location.reload()
    else { star.disabled = false; alert((await response.json()).error) }
  })

  const noteForm = document.getElementById('note-form')
  if (noteForm) {
    noteForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      const button = noteForm.querySelector('button')
      button.disabled = true
      const response = await fetch('/api/favorites', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ consultationId: Number(star.dataset.id), note: noteForm.querySelector('input').value }),
      })
      button.disabled = false
      if (!response.ok) alert((await response.json()).error)
    })
  }

  const refresh = document.getElementById('refresh')
  if (refresh) {
    refresh.addEventListener('click', async () => {
      refresh.disabled = true
      const response = await fetch('/admin/api/consultations/' + refresh.dataset.id + '/refresh', {
        method: 'POST',
        credentials: 'same-origin',
      })
      if (response.ok) window.location.reload()
      else { refresh.disabled = false; alert((await response.json()).error) }
    })
  }
</script>

<%- include('../partials/shell-close') %>
