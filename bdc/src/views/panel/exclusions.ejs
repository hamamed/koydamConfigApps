<%- include('../partials/shell-open', { title: t('exclusion.title') }) %>

<div class="page-head">
  <h1><%- include('../partials/icon', { name: 'triangle-alert', size: 19 }) %> <%= t('exclusion.title') %></h1>
  <span class="muted spacer">
    <% if (rows.length === total) { %>
      <span class="ltr"><%= num(total) %></span>
    <% } else { %>
      <span class="ltr"><%= num(rows.length) %></span> / <span class="ltr"><%= num(total) %></span>
    <% } %>
  </span>
</div>

<p class="muted" style="margin:-6px 0 16px; font-size:12.5px"><%= t('exclusion.lede') %></p>

<div class="card">
  <form class="filters" method="get">
    <input type="hidden" name="lang" value="<%= locale %>">
    <div style="min-width:240px">
      <label for="q"><%= t('exclusion.search') %></label>
      <input id="q" name="q" value="<%= filters.q %>" placeholder="<%= t('exclusion.searchPlaceholder') %>">
    </div>
    <div>
      <label for="entite"><%= t('exclusion.entity') %></label>
      <select id="entite" name="entite">
        <option value=""><%= t('exclusion.allEntities') %></option>
        <% entities.forEach(function (entity) { %>
          <option value="<%= entity.label %>" <%= filters.entite === entity.label ? 'selected' : '' %>>
            <%= entity.label.length > 52 ? entity.label.slice(0, 52) + '…' : entity.label %> (<%= num(entity.total) %>)
          </option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="statut"><%= t('jobs.status') %></label>
      <select id="statut" name="statut">
        <% [['', 'exclusion.allStatuses'], ['active', 'exclusion.inForce'], ['expired', 'exclusion.expired']].forEach(function (o) { %>
          <option value="<%= o[0] %>" <%= filters.statut === o[0] ? 'selected' : '' %>><%= t(o[1]) %></option>
        <% }) %>
      </select>
    </div>
    <div><button type="submit"><%- include('../partials/icon', { name: 'search', size: 15 }) %><%= t('filters.submit') %></button></div>
    <% if (filters.q || filters.entite || filters.statut) { %>
      <div><a class="btn secondary" href="/panel/exclusions?lang=<%= locale %>"><%= t('exclusion.clear') %></a></div>
    <% } %>
  </form>
</div>

<div class="card" style="padding:0; overflow:hidden">
  <% if (rows.length === 0) { %>
    <p class="empty"><%= total === 0 ? t('exclusion.empty') : t('exclusion.noMatch') %></p>
  <% } else { %>
    <div class="table-wrap"><table>
      <thead><tr>
        <th><%= t('exclusion.company') %></th><th><%= t('exclusion.entity') %></th>
        <th><%= t('exclusion.motif') %></th><th><%= t('exclusion.period') %></th>
        <th><%= t('exclusion.scope') %></th><th><%= t('registry.rc') %></th>
      </tr></thead>
      <tbody>
        <% rows.forEach(function (row) { %>
          <tr>
            <td style="max-width:220px">
              <a href="/panel/companies/<%= encodeURIComponent(row.raison_sociale) %>?lang=<%= locale %>"><%= row.raison_sociale %></a>
            </td>
            <td style="max-width:210px"><%= row.entite_publique || '—' %></td>
            <td style="max-width:260px"><%= row.motif || '—' %></td>
            <td class="ltr">
              <%= row.date_debut || '—' %> → <%= row.date_fin || '—' %>
              <span class="pill <%= row.active ? 'warn' : '' %>" style="margin-inline-start:6px"><%= row.active ? t('exclusion.inForce') : t('exclusion.expired') %></span>
            </td>
            <td><%= row.portee || '—' %></td>
            <td class="ltr"><%= row.registre_commerce || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>

<%- include('../partials/shell-close') %>
