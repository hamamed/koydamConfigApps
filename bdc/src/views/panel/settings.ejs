<%- include('../partials/shell-open', { title: t('settings.title') }) %>

<div class="page-head"><h1><%- include('../partials/icon', { name: 'settings', size: 19 }) %> <%= t('settings.title') %></h1></div>

<% if (error) { %><p class="error"><%= error %></p><% } %>
<% if (notice === 'saved') { %><p class="notice"><%- include('../partials/icon', { name: 'circle-check', size: 15 }) %> <%= t('settings.saved') %></p><% } %>
<p class="muted" style="margin-top:0"><%= t('settings.intro') %></p>

<form method="post" action="/panel/settings?lang=<%= locale %>">
  <% groups.forEach(function (group) { %>
    <div class="card">
      <h2><%= t('settings.group.' + group.group) %></h2>
      <div class="filters" style="align-items:start">
        <% group.entries.forEach(function (entry) { %>
          <div>
            <label for="<%= entry.key %>">
              <%= t('settings.key.' + entry.key) %>
              <% if (entry.isOverridden) { %><span class="pill" style="font-size:10px"><%= t('settings.overridden') %></span><% } %>
            </label>
            <% if (entry.type === 'boolean') { %>
              <select id="<%= entry.key %>" name="<%= entry.key %>">
                <option value="true" <%= entry.value ? 'selected' : '' %>><%= t('common.yes') %></option>
                <option value="false" <%= entry.value ? '' : 'selected' %>><%= t('common.no') %></option>
              </select>
            <% } else if (entry.type === 'select') { %>
              <select id="<%= entry.key %>" name="<%= entry.key %>">
                <% entry.options.forEach(function (option) { %>
                  <option value="<%= option %>" <%= String(entry.value) === option ? 'selected' : '' %>><%= option %></option>
                <% }) %>
              </select>
            <% } else if (entry.type === 'number') { %>
              <input id="<%= entry.key %>" name="<%= entry.key %>" type="number" value="<%= entry.value %>"
                     min="<%= entry.min %>" max="<%= entry.max %>" dir="ltr">
            <% } else { %>
              <input id="<%= entry.key %>" name="<%= entry.key %>" value="<%= entry.value %>" dir="ltr">
            <% } %>
            <small class="muted" style="font-size:11.5px"><%= t('settings.default', { value: String(entry.fallback) }) %></small>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap">
    <button type="submit"><%- include('../partials/icon', { name: 'save', size: 15 }) %><%= t('settings.save') %></button>
    <span class="muted" style="font-size:12.5px"><%- include('../partials/icon', { name: 'shield-check', size: 14 }) %> <%= t('settings.secretsNote') %></span>
  </div>
</form>

<%- include('../partials/shell-close') %>
