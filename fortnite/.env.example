# Fortnite companion service.
NODE_ENV=production
PORT=3200
HOST=127.0.0.1
PUBLIC_URL=https://fortnite.hamaprojects.com

SESSION_SECRET=change-me

# Upstream catalogue. No key is needed for the endpoints used here; set one only
# if you have a fortnite-api.com key and want its higher rate limits.
FORTNITE_API_KEY=

# How often to re-ask upstream, in minutes. The shop rotates once a day at
# 00:00 UTC, so a short interval is about noticing the turnover promptly rather
# than about the data changing underneath you.
SHOP_REFRESH_MINUTES=10
NEWS_REFRESH_MINUTES=30
COSMETICS_REFRESH_MINUTES=720

# Platform single sign-on.
PLATFORM_URL=https://config.hamaprojects.com
PLATFORM_APP_SLUG=fortnite
SERVICE_TOKEN=
ALLOWED_REDIRECT_HOSTS=
