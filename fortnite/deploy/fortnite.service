[Unit]
Description=Fortnite companion API and admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brawl
Group=brawl
WorkingDirectory=/opt/fortnite
EnvironmentFile=/opt/fortnite/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# The service writes to its database and its wallpaper gallery, and nothing
# else on the box. ProtectSystem=strict makes the whole filesystem read-only
# except what is named here — so a path left out of this list is not a
# permissions problem to debug later, it is an EROFS at the moment of writing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fortnite/data /opt/fortnite/wallpapers

[Install]
WantedBy=multi-user.target
