[Unit]
Description=Fortnite companion API and admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brawl
Group=brawl
WorkingDirectory=/opt/fortnite
EnvironmentFile=/opt/fortnite/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# The service writes to its database, its wallpaper gallery and its showcase
# clips, and nothing else on the box. ProtectSystem=strict makes the whole
# filesystem read-only except what is named here — so a path left out of this
# list is not a permissions problem to debug later, it is an EROFS at the
# moment of writing.
#
# deploy.sh does not install this file; it is written by setup.sh on a first
# install. A change here reaches a running box only by copying it into
# /etc/systemd/system and running daemon-reload.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fortnite/data /opt/fortnite/wallpapers /opt/fortnite/storage

[Install]
WantedBy=multi-user.target
