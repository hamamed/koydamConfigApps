<%- include('partials/head') %>
<link href="/assets/css/gallery.css?v=<%= assetVersion %>" rel="stylesheet">
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'Catalogue',
          subheading: Number(result.total).toLocaleString() + ' matching · mirrored from upstream, read-only'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <%- include('partials/gallery-filters', { action: '/admin/cosmetics', lockVideo: false }) %>

      <%- include('partials/gallery-grid', {
            canDelete: false,
            emptyText: 'Nothing matches. Clear a filter or search for something else.'
          }) %>
    </div>
  </main>
</div>
<%- include('partials/cosmetic-modal') %>
<script src="/assets/js/gallery.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/foot') %>
