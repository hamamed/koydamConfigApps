<%#
  One cosmetic in a gallery grid. A button, not a link: it opens the viewer on
  this page rather than going anywhere. Everything the viewer shows travels in
  data attributes, escaped here, so the script never builds markup from it.

  The delete form sits beside the button, not inside it — a form in a button is
  invalid and the click would open the viewer as well.
%>
<% const art = row.featured_url || row.icon_url || '';
   const meta = [row.type_name, row.rarity_name || row.rarity, row.set_name, row.season].filter(Boolean).join(' · '); %>
<div class="ad-skin-card-wrap">
  <button type="button" class="ad-skin-card fg-card" data-cosmetic
          data-id="<%= row.id %>" data-name="<%= row.name %>" data-meta="<%= meta %>"
          data-description="<%= row.description || '' %>" data-image="<%= art %>"
          data-clip="<%= row.clip || '' %>"
          aria-label="<%= row.name %> — open">
    <span class="ad-skin-thumb fg-thumb fg-tier-<%= row.tier %>">
      <% if (row.clip) { %>
        <%# Plays like a GIF once scrolled into view — muted, looping, no controls.
            No src until then: gallery.js sets it, so a page does not fetch 48 clips at once. %>
        <video class="fg-art fg-clip" data-autoplay-src="<%= row.clip %>" <% if (art) { %>poster="<%= art %>"<% } %>
               muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true"></video>
      <% } else if (art) { %>
        <img class="fg-art" src="<%= art %>" alt="" loading="lazy">
      <% } %>
    </span>
    <%# Only the clip is offered; the full YouTube showcase is not shown in the panel. %>
    <% if (row.clip) { %>
      <span class="ad-skin-actions">
        <span class="fg-chip"><i data-lucide="clapperboard" width="11" height="11"></i>Clip</span>
      </span>
    <% } %>
    <span class="ad-skin-body">
      <span class="ad-skin-title d-block text-truncate"><%= row.name %></span>
      <span class="ad-skin-meta d-block text-truncate"><%= [row.type_name, row.rarity_name || row.rarity].filter(Boolean).join(' · ') %></span>
    </span>
  </button>
  <% if (canDelete && row.clip) { %>
    <form method="post" action="/admin/videos/delete" class="fg-delete"
          data-confirm="Delete the rendered clip for <%= row.name %>? The YouTube video, if any, is not affected.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="id" value="<%= row.id %>">
      <input type="hidden" name="return" value="<%= returnTo %>">
      <button class="ad-icon-btn ad-icon-btn-danger" type="submit" title="Delete clip" aria-label="Delete the clip for <%= row.name %>">
        <i data-lucide="trash-2" width="14" height="14"></i>
      </button>
    </form>
  <% } %>
</div>
