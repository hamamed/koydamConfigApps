<%#
  The viewer the gallery cards open. Filled in by /assets/js/gallery.js; empty
  here so a page without the script shows nothing half-built.
%>
<div class="modal fade" id="cosmeticModal" tabindex="-1" aria-labelledby="cosmeticModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div class="min-w-0">
          <h2 class="modal-title h5 mb-0 text-truncate" id="cosmeticModalTitle" data-field="name"></h2>
          <div class="kd-faint small text-truncate" data-field="meta"></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="fg-player-tabs" data-field="sources" role="group" aria-label="What to show">
          <button type="button" class="btn btn-sm btn-kd-outline" data-source="clip">
            <i data-lucide="clapperboard" width="14" height="14"></i> Clip
          </button>
          <button type="button" class="btn btn-sm btn-kd-outline" data-source="image">
            <i data-lucide="image" width="14" height="14"></i> Picture
          </button>
        </div>
        <div class="fg-stage" data-field="stage"></div>
        <p class="small mt-3 mb-2" data-field="description"></p>
        <div class="small kd-faint d-flex flex-wrap gap-3">
          <span>ID <code data-field="id"></code></span>
          <a data-field="api" href="#" target="_blank" rel="noopener">API response</a>
          <a data-field="file" href="#" target="_blank" rel="noopener">Open clip file</a>
        </div>
      </div>
    </div>
  </div>
</div>
