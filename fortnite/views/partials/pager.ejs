<% if (result.pages > 1) { %>
  <nav class="d-flex align-items-center justify-content-between gap-2 mt-3" aria-label="Pages">
    <% if (result.page > 1) { %>
      <a class="btn btn-kd-outline btn-sm" href="<%= hrefFor(result.page - 1) %>" rel="prev">
        <i data-lucide="chevron-left" width="14" height="14"></i> Previous
      </a>
    <% } else { %>
      <span class="btn btn-kd-outline btn-sm disabled" aria-disabled="true">
        <i data-lucide="chevron-left" width="14" height="14"></i> Previous
      </span>
    <% } %>

    <span class="kd-faint small">
      Page <%= result.page %> of <%= result.pages %> · <%= Number(result.total).toLocaleString() %> in all
    </span>

    <% if (result.page < result.pages) { %>
      <a class="btn btn-kd-outline btn-sm" href="<%= hrefFor(result.page + 1) %>" rel="next">
        Next <i data-lucide="chevron-right" width="14" height="14"></i>
      </a>
    <% } else { %>
      <span class="btn btn-kd-outline btn-sm disabled" aria-disabled="true">
        Next <i data-lucide="chevron-right" width="14" height="14"></i>
      </span>
    <% } %>
  </nav>
<% } %>
