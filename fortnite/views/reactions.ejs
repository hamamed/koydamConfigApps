<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'Reactions',
          subheading: Number(summary.reactions).toLocaleString() + ' reactions from '
            + Number(summary.devices).toLocaleString() + ' devices across '
            + Number(summary.items).toLocaleString() + ' items'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <% if (byKind.length) { %>
        <div class="ad-card mb-3">
          <div class="ad-card-body">
            <div class="d-flex flex-wrap gap-4">
              <% const emoji = { fire: '🔥', love: '😍', cool: '😎', meh: '😐', trash: '🗑️' }; %>
              <% byKind.forEach((k) => { %>
                <div class="text-center">
                  <div style="font-size:26px"><%= emoji[k.kind] || '•' %></div>
                  <div class="fw-semibold fs-5"><%= Number(k.n).toLocaleString() %></div>
                  <div class="kd-faint small text-capitalize"><%= k.kind %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <div class="ad-card">
        <div class="ad-card-body p-0">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th>Item</th><th class="text-end">Reactions</th><th>Last one</th></tr></thead>
              <tbody>
                <% rows.forEach((r) => { %>
                  <tr>
                    <td><%= r.name %>
                      <div class="kd-faint small font-monospace"><%= r.item_id %></div></td>
                    <td class="text-end"><%= Number(r.total).toLocaleString() %></td>
                    <td class="kd-faint small"><%= (r.latest || '').slice(0, 16).replace('T', ' ') %></td>
                  </tr>
                <% }) %>
                <% if (!rows.length) { %>
                  <tr><td colspan="3" class="kd-faint text-center py-5">
                    No reactions yet. They appear here as people tap them in the app.
                  </td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <% if (summary.blocked) { %>
        <p class="kd-faint small mt-3">
          <%= summary.blocked %> device<%= summary.blocked === 1 ? '' : 's' %> blocked from reacting.
        </p>
      <% } %>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
