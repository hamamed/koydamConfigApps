# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env — the token is IP-locked but
# still a credential.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. From https://developer.brawlstars.com/#/account
#
# The token is locked to the IP(s) you name when creating it. Get your VPS's
# public IPv4 with:  curl -4 ifconfig.me
# A token created for the wrong IP returns 403 on every call — this is the most
# common setup failure by a wide margin.
BRAWL_API_TOKEN=

NODE_ENV=production
PORT=8080

# Bind address.
#   127.0.0.1  behind nginx (recommended — keeps the app off the public interface)
#   0.0.0.0    inside Docker, or to expose the port directly
HOST=127.0.0.1

# Optional shared secret. When set, clients must send
# `Authorization: Bearer <key>`. Must match --dart-define=BRAWL_API_KEY in the
# Flutter build. Leave blank to run the API open.
PUBLIC_API_KEY=

# Redis. Strongly recommended: it survives restarts, is shared across PM2
# workers, and is required for `npm run crawl:meta` to hand results to the
# server. Without it the service falls back to per-process memory.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=bs:

# ── Server-side cache TTLs (seconds) ────────────────────────────────────────
# Shorter than the client's TTLs on purpose: these protect your Supercell rate
# limit, the client's protect the network.
TTL_PLAYER=60
TTL_BATTLELOG=60
TTL_CLUB=300
TTL_BRAWLERS=86400
TTL_EVENTS=900
TTL_META=3600
TTL_NOT_FOUND=120

# ── Rate limiting (per client IP) ───────────────────────────────────────────
RATE_WINDOW_MS=60000
RATE_MAX=120

# ── Meta crawler ────────────────────────────────────────────────────────────
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_MIN=60

# Regions to sample. 'global' is the widest net; comma-separate ISO codes to
# weight toward specific servers (e.g. global,US,DE).
CRAWLER_REGIONS=global

# Top-N players sampled per region. This is the main cost dial — each player is
# one upstream battlelog request per cycle.
CRAWLER_PLAYERS=200
CRAWLER_CONCURRENCY=4

# Minimum appearances before a brawler is ranked in a bucket. Below ~20 the
# tier list gets noisy and off-meta picks with tiny samples float to the top.
CRAWLER_MIN_SAMPLE=20

# ── Brawler metadata ────────────────────────────────────────────────────────
# Supplies rarity, class and portraits — none of which the official API returns.
# Public, no auth.
#
# Use brawlapi.com, NOT brawlify.com: the latter's CDN returns 403 to
# non-browser clients and will fail from a VPS.
#
# Hypercharge availability is not in any free API — it's maintained by hand in
# data/hypercharge-overrides.json.
BRAWLER_META_URL=https://api.brawlapi.com/v1/brawlers
BRAWLER_META_REFRESH_H=24

# error | warn | info | debug
LOG_LEVEL=info

# ── Postgres (optional) ──────────────────────────────────────────────────────
# Durable storage for crawl output: raw sampled battles, per-run tier lists and
# the players seen. Without it the service behaves exactly as it did before —
# Redis still caches, the tier list still serves — and only /meta/brawler/:id/
# history, /meta/movers and the admin panel go quiet.
#
# Under Docker Compose this is set for you; only set it here for a Postgres that
# lives somewhere else.
# POSTGRES_URL=postgres://brawl:changeme@127.0.0.1:5432/brawl
POSTGRES_POOL=8
# How long raw battle rows are kept. They are the bulk of the database and the
# least re-read — the aggregates behind the charts are tiny and never pruned.
POSTGRES_RETENTION_DAYS=45

# Password for the bundled Compose Postgres. Change it before exposing anything.
POSTGRES_PASSWORD=changeme

# ── Admin panel ──────────────────────────────────────────────────────────────
# Long random string. Unset disables /admin entirely rather than leaving it
# open, so forgetting this fails safe.
#   openssl rand -hex 32
ADMIN_KEY=

# ── Crawler expansion ────────────────────────────────────────────────────────
# The rankings return the same top 200 every cycle, and those players don't
# produce 25 fresh matches an hour — one observed cycle added 30,000 battles,
# the next added 567. Growth comes from widening the frontier: every battle log
# names up to ~150 other players, each with a log of their own.
#
# Upstream cost per cycle ≈ CRAWLER_PLAYERS + CRAWLER_DISCOVERY + CRAWLER_SEARCHED.
# Set CRAWLER_DISCOVERY=0 to go back to rankings-only crawling.
CRAWLER_DISCOVERY=150
# Players a human searched in the app, refreshed least-recently-crawled first.
CRAWLER_SEARCHED=50

# ── Wallpapers ───────────────────────────────────────────────────────────────
# Folder of images served to the app under More -> Wallpapers. Relative paths
# resolve against the install root, so the default is /opt/brawl-vps/wallpapers.
# Subfolders become categories. See that folder's README.md.
# WALLPAPER_DIR=wallpapers
#
# How long the directory listing is cached. Short, because the whole point is
# that dropping a file in makes it appear.
TTL_WALLPAPERS=120

# ── Per-player model (migration 004) ─────────────────────────────────────────
# How long battles that know WHO played are kept. Separate from
# POSTGRES_RETENTION_DAYS, which governs the older battle_samples table.
# ~360k participant rows/day at a 60-minute crawl, ~420 bytes each with
# indexes: 180 days lands near 29GB. Doubling the crawl rate doubles that.
POSTGRES_BATTLE_RETENTION_DAYS=180

# Ceiling on battles + battle_players combined, in GB. Retention is measured in
# days but disks are measured in bytes, and the crawl rate converts between
# them — so this is the backstop. Exceed it and the crawler shortens the
# effective window and logs a warning. 0 disables the guard.
POSTGRES_DISK_BUDGET_GB=40

# Full player profiles refreshed per cycle (trophies, roster, club). Costs one
# extra upstream request each, spent only on ranked and searched players,
# rotated oldest-first. Counts toward the same budget as CRAWLER_PLAYERS +
# CRAWLER_DISCOVERY + CRAWLER_SEARCHED. 0 disables profile refreshing.
CRAWLER_PROFILES=40

# ── Analytics source (migration 004/005) ─────────────────────────────────────
# Which record the meta screens read. There are two copies of the same battles:
# battle_samples (legacy, no player tag) and battle_players (per-player model).
#
#   auto     - use battle_players once it holds enough recent data, otherwise
#              battle_samples. This is the migration path: nothing goes empty
#              while the new tables fill. The panel shows which is live.
#   battles  - force the per-player model, even if empty.
#   samples  - force the legacy table.
ANALYTICS_SOURCE=auto

# Keep writing the legacy table. Both are written during the migration so the
# fallback has something to serve. Once the panel reports "per-player data" and
# you are happy with it, set this to false: it halves the crawler's write
# volume and lets retention reclaim the old table.
WRITE_LEGACY_SAMPLES=true

# ── Single sign-on ───────────────────────────────────────────────────────────
# The admin panel has no password of its own: it accepts the session issued by
# platform-api at config.hamaprojects.com. ADMIN_KEY is gone — a key in a URL
# ends up in history, bookmarks and access logs, and could not be scoped.
#
# SERVICE_TOKEN must match the value in /opt/platform-api/.env exactly.
PLATFORM_URL=https://config.hamaprojects.com
SERVICE_TOKEN=
# Which app in the platform this panel administers. Someone needs `admin`,
# `owner`, or an app_admin grant on this slug to get in.
PLATFORM_APP_SLUG=brawl-stats
