# ── platform-api ─────────────────────────────────────────────────────────────
# Shared remote config for every app on this VPS: AdMob ids, kill switches,
# forced-update floors and feature flags.

NODE_ENV=production
PORT=8090
# Loopback only — nginx terminates TLS and proxies here. Binding 0.0.0.0 would
# expose the admin panel with no certificate in front of it.
HOST=127.0.0.1
LOG_LEVEL=info

# Its own database on the Postgres server the other services already use.
# A separate database, not shared tables: a mistaken DROP here must not be able
# to take the Brawl crawler's corpus with it.
POSTGRES_URL=postgres://platform:CHANGE_ME@127.0.0.1:5432/platform

# First owner account, created only when the users table is empty. After that
# it is inert — it cannot reset a live password or bring back a deleted owner.
BOOTSTRAP_EMAIL=you@example.com
BOOTSTRAP_PASSWORD=

# Session cookies carry the Secure flag. Set false only if you deliberately
# serve this over plain HTTP — a Secure cookie is never sent over http://, so
# leaving it true on a non-TLS box makes the dashboard impossible to log into.
SECURE_COOKIES=true

# How long clients cache a config response, in seconds. Short enough that a
# kill switch takes effect in minutes; long enough that a popular app is not
# asking on every cold start.
CLIENT_CACHE_SECONDS=300

# Per-day fetch counters. Totals only — no device or user identifiers.
TRACK_FETCHES=true

RATE_WINDOW_MS=60000
RATE_MAX=600
