# Server
PORT=3100
# Loopback only — nginx proxies to it. Change this and the app is exposed without TLS.
HOST=127.0.0.1
NODE_ENV=production

# Public base URL. Every preview_url and file_url handed to the iOS app is built from it,
# so a wrong value produces a catalogue of broken images and downloads that 404.
PUBLIC_URL=https://minebox.hamaprojects.com

# Sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created by `npm run migrate` only when no users exist yet.
# Ignored once single sign-on is wired up — deploy.sh sets PLATFORM_URL and this
# panel then has no password of its own.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Universal links. Both must match the shipping iOS app or a shared link silently
# falls back to Safari. Team ID is in the Apple Developer portal under Membership.
APPLE_TEAM_ID=TEAMID
IOS_BUNDLE_ID=com.koydam.minebox

# Storage
DATA_DIR=./data
STORAGE_DIR=./storage

# Uploads.
#
# Larger than SkinCraft's on purpose: a skin is a 6 KB PNG, but an adventure map
# is a .mcworld of tens of megabytes. Keep nginx's client_max_body_size above this.
MAX_UPLOAD_MB=64

# Comma-separated origins allowed to call the public API. Leave blank to allow all,
# which is what you want for a mobile client — apps send no Origin header.
CORS_ORIGINS=

# ── Single sign-on (set by deploy.sh, not by hand) ──────────────────────────
#
# With these three present the panel is protected by the config.hamaprojects.com
# login and has no account of its own. Without them it falls back to the local
# username and password above, which is what a local dev copy wants.
#
# PLATFORM_URL=https://config.hamaprojects.com
# SERVICE_TOKEN=
# PLATFORM_APP_SLUG=minebox
