# What platform-api owns inside the Fortnite install.
#
# Left: a path under deploy/. Right: where it lands in /opt/fortnite.
#
# The same set SkinCraft and MineBox receive, for the same reason: the panel
# authenticates against the platform rather than against itself, and it reads
# its design tokens from one place so five panels cannot drift into five
# slightly different products.

shared/platform-auth.js                     src/middleware/platform-auth.js
shared/remote-settings.js                   src/remote-settings.js
shared/css/bootstrap.min.css                public/css/bootstrap.min.css
shared/css/koydam.css                       public/css/koydam.css
shared/css/admin.css                        public/css/admin.css
shared/logo/logo.png                        public/logo/logo.png
shared/logo/logoText.png                    public/logo/logoText.png
overlays/fortnite/src/middleware/auth.js    src/middleware/auth.js
overlays/fortnite/views/partials/head.ejs   views/partials/head.ejs
