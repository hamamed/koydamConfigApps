<!doctype html>
<!-- The panel is run in Arabic, like the game it serves. -->
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/assets/favicon.png?v=<%= assetVersion %>" type="image/png">
  <title><%= title %> · لوحة شبّك</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- The game's own faces: the panel is dressed as the app, not as a generic
       dashboard, so it uses Tajawal and Lalezar rather than Inter. -->
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Lalezar&display=swap" rel="stylesheet">
  <!-- Served from this origin, not a CDN: the platform dashboard vendors its own
       Bootstrap, and a different point release here would make two panels that
       share a stylesheet render differently. -->
  <link href="/assets/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/koydam.css?v=<%= assetVersion %>" rel="stylesheet">
  <link href="/assets/css/admin.css?v=<%= assetVersion %>" rel="stylesheet">
  <link href="/assets/css/wasla.css?v=<%= assetVersion %>" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;600;800&display=swap" rel="stylesheet">
</head>
<body class="wz-ground">
