<%- include('../partials/shell-open', { title: t('nav.dashboard') }) %>

<div class="page-head"><h1><%- include('../partials/icon', { name: 'layout-dashboard', size: 19 }) %> <%= t('nav.dashboard') %></h1></div>

<div class="grid" style="margin-bottom:18px">
  <div class="stat"><b class="ltr"><%= dashboard.counts.consultations %></b><span><%- include('../partials/icon', { name: 'file-text', size: 13 }) %><%= t('stats.consultations') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.articles %></b><span><%- include('../partials/icon', { name: 'package', size: 13 }) %><%= t('stats.articles') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.results %></b><span><%- include('../partials/icon', { name: 'award', size: 13 }) %><%= t('stats.results') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.matchRate === null ? '—' : dashboard.matchRate + ' %' %></b><span><%- include('../partials/icon', { name: 'link', size: 13 }) %><%= t('stats.matchRate') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.unmatchedResults %></b><span><%= t('stats.unmatched') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.ambiguousResults %></b><span><%= t('stats.ambiguous') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.cancelled %></b><span><%= t('stats.cancelled') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.documents %></b><span><%= t('stats.documents') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.pendingDetails %></b><span><%= t('stats.pendingDetails') %></span></div>
  <div class="stat"><b class="ltr"><%= dashboard.counts.users %></b><span><%- include('../partials/icon', { name: 'users', size: 13 }) %><%= t('stats.users') %></span></div>
</div>

<%- include('../partials/checks', { report: dashboard.health, title: t('health.title'), note: t('health.why') }) %>

<div class="card">
  <h2><%- include('../partials/icon', { name: 'refresh-cw', size: 15 }) %><%= t('run.title') %></h2>
  <% const run = dashboard.lastRun %>
  <% if (!run) { %>
    <p class="empty"><%= t('run.never') %></p>
  <% } else { %>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
      <div>
        <label><%= t('run.finishedAt') %></label>
        <span class="ltr"><%= (run.finishedAt || '').replace('T', ' ').slice(0, 16) %></span>
        <% if (run.status !== 'success') { %> <span class="pill warn"><%= t('run.failed') %></span><% } %>
      </div>
      <div><label><%= t('run.duration') %></label><span class="ltr"><%= run.durationMs === null ? '—' : Math.round(run.durationMs / 1000) + ' s' %></span></div>
      <div>
        <label><%= t('run.newProjects') %></label>
        <b class="ltr" style="font-size:19px"><%= run.consultations ? run.consultations.created : '—' %></b>
        <% if (run.consultations) { %><br><small class="muted ltr"><%= t('run.pages', { pages: run.consultations.pages, found: run.consultations.found }) %></small><% } %>
      </div>
      <div>
        <label><%= t('run.newAwards') %></label>
        <b class="ltr" style="font-size:19px"><%= run.results ? run.results.created : '—' %></b>
        <% if (run.results) { %><br><small class="muted ltr"><%= t('run.pages', { pages: run.results.pages, found: run.results.found }) %></small><% } %>
      </div>
      <div><label><%= t('run.linked') %></label><b class="ltr" style="font-size:19px"><%= run.matchesLinked %></b></div>
      <div><label><%= t('run.detailsRead') %></label><span class="ltr"><%= run.backfill ? run.backfill.processed : '—' %></span></div>
    </div>
    <% if (run.error) { %><p class="error" style="margin:14px 0 0"><%= run.error %></p><% } %>
  <% } %>

  <p style="margin:16px 0 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
    <span class="pill"><%- include('../partials/icon', { name: 'calendar', size: 13 }) %>
      <%= t('run.next') %> : <span class="ltr"><%= dashboard.schedule.nextRunAt ? dashboard.schedule.nextRunAt.replace('T', ' ').slice(0, 16) : '—' %></span></span>
    <span class="muted" style="font-size:12.5px"><%= t('run.scheduleHint', { time: dashboard.schedule.runAt, days: dashboard.schedule.sinceDays }) %></span>
  </p>
  <p class="muted" style="margin:6px 0 0; font-size:11.5px"><%= t('run.scheduleNote') %></p>
</div>

<div class="card">
  <h2><%- include('../partials/icon', { name: 'play', size: 15 }) %><%= t('scrape.title') %></h2>
  <form id="scrape-form" class="filters">
    <div>
      <label for="source"><%= t('scrape.source') %></label>
      <select id="source" name="source">
        <option value="all"><%= t('scrape.source.all') %></option>
        <option value="consultations"><%= t('scrape.source.consultations') %></option>
        <option value="results"><%= t('scrape.source.results') %></option>
      </select>
    </div>
    <div><label for="maxPages"><%= t('scrape.maxPages') %></label><input id="maxPages" name="maxPages" type="number" min="1" max="500" value="5" dir="ltr"></div>
    <div><label for="acheteur"><%= t('scrape.buyerFilter') %></label><input id="acheteur" name="acheteur" type="text"></div>
    <div>
      <label for="fetchDetails"><%= t('scrape.details') %></label>
      <select id="fetchDetails" name="fetchDetails">
        <option value="true"><%= t('common.yes') %></option>
        <option value="false"><%= t('common.no') %></option>
      </select>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap">
      <button type="submit"><%- include('../partials/icon', { name: 'play', size: 15 }) %><%= t('scrape.start') %></button>
      <button type="button" id="rematch" class="secondary"><%- include('../partials/icon', { name: 'link', size: 15 }) %><%= t('scrape.rematch') %></button>
      <button type="button" id="backfill" class="secondary"><%- include('../partials/icon', { name: 'database', size: 15 }) %><%= t('scrape.backfill') %></button>
    </div>
  </form>
  <p class="muted" style="margin:12px 0 0; font-size:12.5px"><%= t('scrape.backfillHint') %></p>
  <p id="scrape-status" class="muted" style="margin:6px 0 0"></p>
</div>

<div class="card" style="padding-bottom:6px">
  <h2><%- include('../partials/icon', { name: 'database', size: 15 }) %><%= t('jobs.title') %></h2>
  <div style="overflow-x:auto">
    <div class="table-wrap"><table>
      <thead><tr>
        <th>#</th><th><%= t('jobs.source') %></th><th><%= t('jobs.status') %></th>
        <th><%= t('jobs.pages') %></th><th><%= t('jobs.found') %></th><th><%= t('jobs.created') %></th>
        <th><%= t('jobs.updated') %></th><th><%= t('jobs.linked') %></th>
        <th><%= t('jobs.startedAt') %></th><th><%= t('jobs.duration') %></th>
      </tr></thead>
      <tbody>
        <% if (dashboard.recentJobs.length === 0) { %><tr><td colspan="10" class="muted"><%= t('jobs.empty') %></td></tr><% } %>
        <% dashboard.recentJobs.forEach(function (job) { %>
          <tr>
            <td class="ltr"><%= job.id %></td>
            <td><%= job.source %></td>
            <td><span class="pill <%= job.status === 'success' ? 'ok' : job.status === 'failed' ? 'warn' : '' %>"><%= job.status %></span></td>
            <td class="ltr"><%= job.pages_scraped %></td><td class="ltr"><%= job.items_found %></td><td class="ltr"><%= job.items_created %></td>
            <td class="ltr"><%= job.items_updated %></td><td class="ltr"><%= job.matches_linked %></td>
            <td class="muted ltr"><%= (job.started_at || '').replace('T', ' ').slice(0, 16) %></td>
            <td class="muted ltr"><%= job.duration_ms === null ? '—' : Math.round(job.duration_ms / 1000) + ' s' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  </div>
</div>

<script>
  const status = document.getElementById('scrape-status')
  const RUNNING = <%- JSON.stringify(t('scrape.running')) %>
  const post = async (url, body, button) => {
    button.disabled = true
    status.textContent = RUNNING
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body),
      })
      const payload = await response.json()
      status.textContent = response.ok ? JSON.stringify(payload.data) : payload.error
      if (response.ok) setTimeout(() => window.location.reload(), 2500)
    } catch (error) {
      status.textContent = error.message
    } finally {
      button.disabled = false
    }
  }

  document.getElementById('scrape-form').addEventListener('submit', (event) => {
    event.preventDefault()
    const form = new FormData(event.target)
    const acheteur = form.get('acheteur')
    post('/admin/api/scrape', {
      source: form.get('source'),
      maxPages: Number(form.get('maxPages')),
      fetchDetails: form.get('fetchDetails') === 'true',
      filters: acheteur ? { acheteur } : {},
    }, event.submitter)
  })

  document.getElementById('rematch').addEventListener('click', (event) => post('/admin/api/rematch', {}, event.target))
  document.getElementById('backfill').addEventListener('click', (event) => post('/admin/api/backfill-details', {}, event.target))
</script>

<%- include('../partials/shell-close') %>
