<%- include('../partials/shell-open', { title: consultation.reference }) %>

<div class="page-head">
  <a class="btn secondary" href="/panel?lang=<%= locale %>"><%- include('../partials/icon', { name: 'arrow-left', size: 15, cls: 'flip-rtl' }) %><%= t('detail.back') %></a>
  <span class="spacer"></span>
  <button class="star-btn" type="button" id="star" data-id="<%= consultation.id %>" aria-pressed="<%= consultation.isFavorite ? 'true' : 'false' %>"
          title="<%= consultation.isFavorite ? t('projects.untrack') : t('projects.track') %>">
    <%- include('../partials/icon', { name: 'star', size: 22, fill: consultation.isFavorite ? 'currentColor' : 'none' }) %>
  </button>
</div>

<div class="card">
  <h1 style="margin:0 0 6px; font-size:18px"><%= consultation.objet || '—' %></h1>
  <p class="muted" style="margin:0 0 16px">
    <code><%= consultation.reference %></code>
    <span class="pill <%= consultation.status === 'annule' ? 'warn' : consultation.status === 'awarded' ? 'ok' : '' %>"><%= t('status.' + consultation.status) %></span>
  </p>

  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(215px,1fr))">
    <div><label><%- include('../partials/icon', { name: 'building-2', size: 13 }) %> <%= t('detail.buyer') %></label><% if (consultation.acheteur) { %><a href="/panel/buyers/<%= encodeURIComponent(consultation.acheteur) %>?lang=<%= locale %>" title="<%= t('buyer.profile') %>"><%= consultation.acheteur %></a><% } else { %>—<% } %></div>
    <div><label><%= t('detail.category') %></label><%= consultation.categorie || '—' %></div>
    <div><label><%= t('detail.nature') %></label><%= consultation.nature_prestation || '—' %></div>
    <div><label><%- include('../partials/icon', { name: 'map-pin', size: 13 }) %> <%= t('detail.place') %></label><%= consultation.lieu_execution || '—' %></div>
    <div><label><%= t('detail.published') %></label><span class="ltr"><%= consultation.date_publication || '—' %></span></div>
    <div><label><%- include('../partials/icon', { name: 'calendar', size: 13 }) %> <%= t('detail.deadline') %></label><%- include('../partials/deadline', { deadline: consultation.deadline, date: (consultation.date_limite || '') + (consultation.heure_limite ? ' ' + consultation.heure_limite : '') }) %></div>
    <div><label><%= t('detail.portalId') %></label><span class="ltr"><%= consultation.source_id %></span></div>
  </div>

  <% const cancellationDocs = consultation.documents.filter(function (d) { return d.kind === 'annulation' }) %>
  <% if (consultation.is_cancelled || consultation.date_annulation || consultation.motif_annulation) { %>
    <div class="error" style="margin-top:16px">
      <strong><%= t('detail.cancelledOn') %> <span class="ltr"><%= consultation.date_annulation || '—' %></span></strong>
      <% if (consultation.motif_annulation) { %><br><%= t('detail.cancelReason') %> : <%= consultation.motif_annulation %><% } %>
      <% cancellationDocs.forEach(function (doc) { %>
        <br><a href="<%= doc.url %>" target="_blank" rel="noopener noreferrer"><%- include('../partials/icon', { name: 'file-text', size: 13 }) %>
          <%= doc.file_name || t('detail.documentAnnulation') %></a>
      <% }) %>
    </div>
  <% } %>

  <p style="margin:16px 0 0; display:flex; gap:8px; flex-wrap:wrap">
    <% if (consultation.detail_url) { %>
      <a class="btn secondary" href="<%= consultation.detail_url %>" target="_blank" rel="noopener noreferrer"><%- include('../partials/icon', { name: 'external-link', size: 15 }) %><%= t('detail.openOnPortal') %></a>
    <% } %>
    <a class="btn secondary" href="/panel/reference-price?from=<%= consultation.id %>&amp;lang=<%= locale %>"><%- include('../partials/icon', { name: 'calculator', size: 15 }) %><%= t('detail.referencePrice') %></a>
    <% if (user.role === 'admin') { %>
      <button class="secondary" type="button" id="refresh" data-id="<%= consultation.id %>"><%- include('../partials/icon', { name: 'refresh-cw', size: 15 }) %><%= t('detail.fetchDetails') %></button>
    <% } %>
  </p>
</div>

<% if (consultation.isFavorite) { %>
  <div class="card">
    <h2><%- include('../partials/icon', { name: 'star', size: 15, fill: 'currentColor' }) %><%= t('favorites.note') %></h2>
    <form id="note-form" style="display:flex; gap:8px; align-items:flex-end">
      <div style="flex:1"><input name="note" value="<%= favorite && favorite.note ? favorite.note : '' %>" placeholder="<%= t('favorites.notePlaceholder') %>"></div>
      <button class="secondary" type="submit"><%- include('../partials/icon', { name: 'save', size: 15 }) %><%= t('favorites.saveNote') %></button>
    </form>
  </div>
<% } %>

<%# The same buyer, the same purchase, already published once. %>

<% if (range) { %>
  <%
    /*
      Article 44, as far as it can be taken without the competitors.

      The reference price needs the offers, and this portal publishes none. The
      band needs only the estimate and the nature of the market, and both were
      read off this consultation — so the one thing a bidder must know before
      submitting is here, on the avis, rather than behind a form.
    */
    const money = function (v) {
      return v === null || v === undefined ? '—'
        : Number(v).toLocaleString('fr-MA', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    }
  %>
  <div class="card">
    <h2><%- include('../partials/icon', { name: 'calculator', size: 15 }) %><%= t('range.title') %></h2>
    <p class="muted" style="margin:-6px 0 14px; font-size:12.5px"><%= t('range.hint') %></p>

    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
      <div><label><%= t('range.estimate') %></label><b class="ltr" style="font-size:18px"><%= money(range.estimate) %></b></div>
      <div><label><%= t('range.floor', { percent: range.band.lowPercent }) %></label><b class="ltr" style="font-size:18px"><%= money(range.low) %></b></div>
      <div><label><%= t('range.ceiling', { percent: range.band.highPercent }) %></label><b class="ltr" style="font-size:18px"><%= money(range.high) %></b></div>
      <div><label><%= t('range.kind') %></label><span class="pill"><%= t('referencePrice.kind.' + range.kind) %></span></div>
    </div>

    <p style="margin:14px 0 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
      <a class="btn secondary" href="/panel/reference-price?from=<%= consultation.id %>&amp;lang=<%= locale %>"><%- include('../partials/icon', { name: 'calculator', size: 15 }) %><%= t('range.compute') %></a>
      <%# Said plainly, because it is the limit of what anybody can automate:
          the commission's own workings are visible only to a company that bid. %>
      <span class="muted" style="font-size:12px"><%= t('range.needsOffers') %></span>
    </p>
  </div>
<% } %>

<div class="card">
  <h2><%- include('../partials/icon', { name: 'file-text', size: 15 }) %><%= t('detail.documents') %> (<span class="ltr"><%= consultation.documents.length %></span>)</h2>
  <% if (consultation.documents.length === 0) { %>
    <p class="empty"><%= t('detail.noDocuments') %></p>
  <% } else { %>
    <ul style="margin:0; padding-inline-start:18px">
      <% consultation.documents.forEach(function (doc) { %>
        <li style="margin-bottom:6px">
          <%# Labelled by what it is. The kinds are not interchangeable: the
              avis is a file that downloads, and the dossier is a request form
              — the portal wants to know who is taking it. Calling the second
              one an avis promises a download that does not happen. %>
          <a href="<%= doc.url %>" target="_blank" rel="noopener noreferrer"><%= doc.file_name || t('doc.kind.' + doc.kind) %></a>
          <span class="pill <%= doc.kind === 'annulation' ? 'warn' : '' %>"><%= t('doc.kind.' + doc.kind) %></span>
          <span class="muted" style="font-size:11.5px">
            <%- include('../partials/icon', { name: 'external-link', size: 12 }) %>
            <%= doc.kind === 'dce' ? t('doc.viaRequest') : t('detail.onPortal') %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>



<%- include('../partials/shell-close') %>
