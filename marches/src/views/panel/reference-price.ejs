<%- include('../partials/shell-open', { title: t('referencePrice.title') }) %>

<%
  /*
    Article 44 of décret n° 2-22-431, rendered.

    The one thing this page has to make obvious is that the cheapest bid does
    not win: the commission drops the outliers, averages what is left with the
    buyer's own estimate, and awards the market to whoever sits closest *under*
    that number. So the winner is called out first, the reference price second,
    and the offers table shows every offer's distance from it — including the
    ones that were thrown out, because knowing you were excluded is the whole
    reason to run this before submitting rather than after.
  */
  // This screen works in centimes throughout; the shared helper takes units
  // and adds the currency, which is what a price on a page needs.
  const dh = function (centimes) {
    return centimes === null || centimes === undefined ? '—' : money(centimes / 100)
  }
  const signed = function (value) {
    if (value === null || value === undefined) return '—'
    return (value > 0 ? '+' : '') + value.toLocaleString('fr-MA', { maximumFractionDigits: 2 })
  }
  const KINDS = ['travaux', 'fournitures', 'services', 'etudes']
%>

<div class="page-head">
  <h1><%- include('../partials/icon', { name: 'calculator', size: 19 }) %> <%= t('referencePrice.title') %></h1>
</div>

<div class="card">
  <p class="muted" style="margin:0 0 8px; font-size:12.5px"><%= t('referencePrice.intro') %></p>
</div>

<% if (error) { %><div class="error"><%= t(error) %></div><% } %>

<% if (result) { %>
  <%
    const band = result.band
    const winnerName = result.winner && result.winner.name ? result.winner.name : t('referencePrice.unnamed')
  %>

  <% if (!band) { %>
    <%# Études are carved out of article 44 entirely, so there is no band to
        apply and no reference price to claim. Saying so beats printing a
        number the decree does not authorise. %>
    <div class="card">
      <h2><%- include('../partials/icon', { name: 'circle-help', size: 15 }) %><%= t('referencePrice.result') %></h2>
      <p class="muted" style="margin:0"><%= t('referencePrice.noBand') %></p>
    </div>
  <% } else if (result.infructueux) { %>
    <div class="card">
      <h2><%- include('../partials/icon', { name: 'triangle-alert', size: 15 }) %><%= t('referencePrice.result') %></h2>
      <p style="margin:0; color:var(--warn)"><%= t('referencePrice.infructueux') %></p>
    </div>
  <% } else { %>
    <div class="grid" style="margin-bottom:18px">
      <div class="stat">
        <b class="ltr" style="font-size:17px"><%= winnerName %></b>
        <span><%- include('../partials/icon', { name: 'award', size: 13 }) %><%= t('referencePrice.winner') %></span>
      </div>
      <div class="stat">
        <b class="ltr"><%= dh(result.winner.amountCentimes) %></b>
        <span><%= t('referencePrice.winningOffer') %></span>
      </div>
      <div class="stat" title="<%= t('referencePrice.referenceHint') %>">
        <b class="ltr"><%= dh(result.referenceCentimes) %></b>
        <span><%= t('referencePrice.reference') %></span>
      </div>
      <div class="stat">
        <b class="ltr"><%= dh(result.meanRetainedCentimes) %></b>
        <span><%= t('referencePrice.meanRetained') %></span>
      </div>
      <div class="stat">
        <b class="ltr"><%= result.retainedCount %> / <%= result.retainedCount + result.excludedCount %></b>
        <span><%= t('referencePrice.retained') %></span>
      </div>
      <div class="stat" title="<%= t('referencePrice.bandHint') %>">
        <% const bandPrice = dh(result.bounds.lowCentimes) + ' – ' + dh(result.bounds.highCentimes) %>
        <b class="ltr money figure-value <%= priceClass(bandPrice) %>"><%= bandPrice %></b>
        <span><%= t('referencePrice.band', { low: band.lowPercent, high: band.highPercent }) %></span>
      </div>
    </div>

    <% if (result.winnerSide === 'above') { %>
      <div class="card" style="border-color:#f0d9bd">
        <p style="margin:0; color:var(--warn)"><%= t('referencePrice.aboveOnly') %></p>
      </div>
    <% } %>

    <div class="card">
      <h2><%- include('../partials/icon', { name: 'list-checks', size: 15 }) %><%= t('referencePrice.ranking') %></h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th><%= t('referencePrice.rank') %></th>
              <th><%= t('referencePrice.bidder') %></th>
              <th><%= t('referencePrice.amount') %></th>
              <th title="<%= t('referencePrice.vsEstimateHint') %>"><%= t('referencePrice.vsEstimate') %></th>
              <th title="<%= t('referencePrice.vsReferenceHint') %>"><%= t('referencePrice.vsReference') %></th>
              <th><%= t('referencePrice.status') %></th>
            </tr>
          </thead>
          <tbody>
            <%
              /* Ranked offers first and in order, then the excluded ones —
                 the classement is the answer, the exclusions are the audit. */
              const ordered = result.offers.slice().sort(function (a, b) {
                if (a.rank !== null && b.rank !== null) return a.rank - b.rank
                if (a.rank !== null) return -1
                if (b.rank !== null) return 1
                return b.amountCentimes - a.amountCentimes
              })
            %>
            <% ordered.forEach(function (offer) { %>
              <tr>
                <td class="ltr"><%= offer.rank === null ? '—' : offer.rank %></td>
                <td><%= offer.name || t('referencePrice.unnamed') %></td>
                <td class="ltr money"><%= dh(offer.amountCentimes) %></td>
                <td class="ltr"><%= signed(offer.deltaPercent) %> %</td>
                <td class="ltr"><%= offer.gapCentimes === null ? '—' : signed(offer.gapCentimes / 100) %></td>
                <td>
                  <% if (offer.status === 'retained') { %>
                    <span class="pill ok"><%- include('../partials/icon', { name: 'circle-check', size: 13 }) %><%= t('referencePrice.status.retained') %></span>
                  <% } else if (offer.status === 'abnormally_low') { %>
                    <span class="pill urgent"><%- include('../partials/icon', { name: 'circle-x', size: 13 }) %><%= t('referencePrice.status.abnormally_low') %></span>
                  <% } else { %>
                    <span class="pill warn"><%- include('../partials/icon', { name: 'circle-x', size: 13 }) %><%= t('referencePrice.status.excessive') %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin:12px 0 0; font-size:12px"><%= t('referencePrice.rankingHint') %></p>
    </div>
  <% } %>
<% } %>

<form method="post" action="/panel/reference-price?lang=<%= locale %>">
  <input type="hidden" name="sourceId" value="<%= form.sourceId === null ? '' : form.sourceId %>">
  <div class="card">
    <h2><%- include('../partials/icon', { name: 'file-text', size: 15 }) %><%= t('referencePrice.market') %></h2>


    <% if (source) { %>
      <p class="muted" style="margin:-4px 0 14px; font-size:12.5px">
        <%= t('referencePrice.from') %>
        <a href="/panel/consultations/<%= source.id %>?lang=<%= locale %>"><%= source.objet || source.reference %></a>
      </p>
    <% } %>

    <div class="cols-2">
      <div>
        <label for="estimate"><%= t('referencePrice.estimate') %></label>
        <input id="estimate" name="estimate" value="<%= form.estimate %>" dir="ltr" inputmode="decimal"
               placeholder="<%= t('referencePrice.estimatePlaceholder') %>" required>
        <p class="muted" style="margin:5px 0 0; font-size:11.5px"><%= t('referencePrice.estimateHint') %></p>
      </div>
      <div>
        <label for="kind"><%= t('referencePrice.kind') %></label>
        <select id="kind" name="kind" required>
          <option value=""><%= t('referencePrice.kindPrompt') %></option>
          <% KINDS.forEach(function (kind) { %>
            <option value="<%= kind %>" <%= form.kind === kind ? 'selected' : '' %>><%= t('referencePrice.kind.' + kind) %></option>
          <% }) %>
        </select>
        <p class="muted" style="margin:5px 0 0; font-size:11.5px"><%= t('referencePrice.kindHint') %></p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2><%- include('../partials/icon', { name: 'users', size: 15 }) %><%= t('referencePrice.offers') %></h2>
    <div class="table-wrap">
      <table id="offers">
        <thead>
          <tr>
            <th style="width:38px">#</th>
            <th><%= t('referencePrice.bidder') %></th>
            <th><%= t('referencePrice.amount') %></th>
          </tr>
        </thead>
        <tbody>
          <% form.offers.forEach(function (offer, index) { %>
            <tr>
              <td class="ltr muted"><%= index + 1 %></td>
              <td><input name="name" value="<%= offer.name %>" placeholder="<%= t('referencePrice.bidderPlaceholder') %>"></td>
              <td><input name="amount" value="<%= offer.amount %>" dir="ltr" inputmode="decimal" placeholder="0,00"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p style="margin:14px 0 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
      <button type="submit"><%- include('../partials/icon', { name: 'calculator', size: 15 }) %><%= t('referencePrice.submit') %></button>
      <button type="button" class="secondary" id="add-row"><%= t('referencePrice.addRow') %></button>
      <span class="muted" style="font-size:12px"><%= t('referencePrice.offersHint') %></span>
    </p>
  </div>
</form>

<div class="card">
  <h2><%- include('../partials/icon', { name: 'circle-help', size: 15 }) %><%= t('referencePrice.method') %></h2>
  <p class="muted" style="margin:0 0 8px; font-size:12.5px"><%= t('referencePrice.method1') %></p>
  <p class="muted" style="margin:0 0 8px; font-size:12.5px"><%= t('referencePrice.method2') %></p>
  <p class="muted" style="margin:0 0 8px; font-size:12.5px"><%= t('referencePrice.method3') %></p>
  <p class="muted" style="margin:0; font-size:11.5px"><%= t('referencePrice.disclaimer') %></p>
</div>

<script>
  // One more competitor row, cloned from the last one. The server accepts any
  // number of them; this only saves a round trip. Everything that decides the
  // result is computed server-side from what is submitted.
  document.getElementById('add-row').addEventListener('click', () => {
    const body = document.querySelector('#offers tbody')
    const row = body.rows[body.rows.length - 1].cloneNode(true)
    row.cells[0].textContent = body.rows.length + 1
    row.querySelectorAll('input').forEach((input) => { input.value = '' })
    body.appendChild(row)
  })
</script>

<%- include('../partials/shell-close') %>
