<%# A severity roll-up and its individual checks.

    Shared by the dashboard's crawler canary and the System screen, so the two
    read the same way: one badge for the worst thing, then every check with the
    fact it was judged on rather than just a colour. %>
<div class="card" style="border-inline-start:4px solid <%= report.severity === 'fail' ? '#a4262c' : report.severity === 'warn' ? 'var(--warn)' : 'var(--ok)' %>">
  <h2>
    <%- include('icon', { name: report.severity === 'ok' ? 'circle-check' : 'triangle-alert', size: 15 }) %>
    <%= title %>
    <span class="pill <%= report.severity === 'ok' ? 'ok' : 'warn' %>"><%= t('health.' + report.severity) %></span>
  </h2>
  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr))">
    <% report.checks.forEach(function (c) { %>
      <div>
        <label>
          <%- include('icon', { name: c.severity === 'ok' ? 'circle-check' : 'circle-x', size: 12 }) %>
          <%= t('health.check.' + c.id) %>
        </label>
        <span class="<%= c.severity === 'ok' ? 'muted' : '' %>" style="<%= c.severity === 'ok' ? '' : 'color:var(--warn); font-weight:600' %>"><%= c.detail %></span>
      </div>
    <% }) %>
  </div>
  <% if (typeof note !== 'undefined' && note) { %>
    <p class="muted" style="margin:12px 0 0; font-size:11.5px"><%= note %></p>
  <% } %>
</div>
