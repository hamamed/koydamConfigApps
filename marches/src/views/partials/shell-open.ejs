<!doctype html>
<html lang="<%= locale %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= siteName %></title>
<style>
  :root {
    --bg:#f6f8fb; --card:#fff; --line:#e5e9f0; --text:#111827; --muted:#6b7280;
    --accent:#0b5394; --accent-soft:#eaf1fa; --ok:#116b3a; --ok-soft:#e7f5ec;
    --warn:#9a4a06; --warn-soft:#fdf1e4; --star:#d99400;
    --sidebar:#0f2c4d; --sidebar-muted:#9db4cd; --radius:10px;
  }
  * { box-sizing:border-box; }
  html, body { height:100%; }
  body { margin:0; font:14px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif; background:var(--bg); color:var(--text); }
  /* The Latin stack carries no Arabic glyphs. */
  body[dir="rtl"] { font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic","Geeza Pro",sans-serif; }
  a { color:var(--accent); text-decoration:none; }
  a:hover { text-decoration:underline; }
  .ic { flex:none; vertical-align:-.18em; }

  /* Sidebar + content. `grid-template-columns` with a logical order means the
     whole shell mirrors itself under dir="rtl" with no extra rules. */
  .shell { display:grid; grid-template-columns:238px 1fr; min-height:100%; }
  /* `height:100vh` with no overflow simply clips: the items past the fold
     become unreachable, and the account and sign-out at the bottom go with
     them. It scrolls instead, and the scrollbar is drawn dark so it does not
     cut a light stripe down a navy sidebar. */
  .side { background:var(--sidebar); color:#fff; display:flex; flex-direction:column; padding:18px 12px; gap:4px;
          position:sticky; top:0; height:100vh; overflow-y:auto; scrollbar-width:thin;
          scrollbar-color:rgba(255,255,255,.26) transparent; }
  .side::-webkit-scrollbar { width:9px; }
  .side::-webkit-scrollbar-track { background:transparent; }
  .side::-webkit-scrollbar-thumb { background:rgba(255,255,255,.22); border-radius:999px;
                                   border:2px solid transparent; background-clip:content-box; }
  .side::-webkit-scrollbar-thumb:hover { background:rgba(255,255,255,.38); background-clip:content-box; }
  /* The bottom block is pushed down by `margin-top:auto`, which in a scrolling
     flex column would otherwise let it sit on top of the last nav item. */
  .side nav { flex:none; }
  .brand { display:flex; align-items:center; gap:10px; padding:6px 10px 16px; font-weight:600; font-size:15px; }
  .brand small { display:block; font-weight:400; font-size:11px; color:var(--sidebar-muted); }
  .side nav { display:flex; flex-direction:column; gap:2px; }
  .side nav a { display:flex; align-items:center; gap:11px; padding:9px 11px; border-radius:8px; color:var(--sidebar-muted); font-size:13.5px; }
  .side nav a:hover { background:rgba(255,255,255,.08); color:#fff; text-decoration:none; }
  .side nav a.on { background:#fff; color:var(--sidebar); font-weight:600; }
  /* A count on a nav item, for a queue that needs working. */
  .side nav .badge { margin-inline-start:auto; background:#fff; color:var(--sidebar);
                     border-radius:999px; padding:0 7px; font-size:11px; font-weight:700; }
  .side nav a.on .badge { background:var(--accent); color:#fff; }
  .side nav .sep { margin:12px 11px 6px; font-size:10.5px; letter-spacing:.09em; text-transform:uppercase; color:#5f7c9c; }
  .side .bottom { margin-top:auto; display:flex; flex-direction:column; gap:8px; padding-top:14px; border-top:1px solid rgba(255,255,255,.12); }
  .side .who { padding:0 11px; font-size:12px; color:var(--sidebar-muted); overflow-wrap:anywhere; }
  .side .who b { display:block; color:#fff; font-weight:600; font-size:12.5px; }
  /* Leaving this space. Styled like a nav item rather than a button: it is
     navigation, and it sits with the account and the language picker because
     that is where somebody looks when they are done here. */
  .side .switch { display:flex; align-items:center; gap:10px; padding:9px 11px; border-radius:8px;
                  color:var(--sidebar-muted); font-size:13.5px; }
  .side .switch:hover { background:rgba(255,255,255,.08); color:#fff; text-decoration:none; }
  .side button.out { display:flex; align-items:center; gap:10px; width:100%; background:none; border:0; color:var(--sidebar-muted); padding:9px 11px; border-radius:8px; font:inherit; font-size:13.5px; cursor:pointer; }
  .side button.out:hover { background:rgba(255,255,255,.08); color:#fff; }

  /* ---- language menu ------------------------------------------------- */
  .lang { position:relative; }
  .lang > summary { display:flex; align-items:center; gap:8px; cursor:pointer; list-style:none;
                    padding:8px 11px; border-radius:8px; font-size:13px; }
  .lang > summary::-webkit-details-marker { display:none; }
  .lang .caret { margin-inline-start:auto; transition:transform .15s ease; }
  .lang[open] .caret { transform:rotate(180deg); }
  .lang-list { position:absolute; inset-block-end:calc(100% + 6px); inset-inline-start:0; min-width:170px;
               background:var(--card); border:1px solid var(--line); border-radius:10px; padding:5px;
               box-shadow:0 10px 30px rgba(15,44,77,.22); z-index:40; }
  .lang-list a { display:flex; align-items:center; gap:9px; padding:8px 10px; border-radius:7px;
                 color:var(--text); font-size:13.5px; }
  .lang-list a:hover { background:var(--accent-soft); text-decoration:none; }
  .lang-list a.on { background:var(--accent-soft); color:var(--accent); font-weight:600; }
  .lang-list .code { font-size:10.5px; letter-spacing:.06em; color:var(--muted);
                     border:1px solid var(--line); border-radius:5px; padding:1px 5px; min-width:26px; text-align:center; }
  .lang-dark > summary { color:var(--sidebar-muted); border:1px solid rgba(255,255,255,.18); }
  .lang-dark > summary:hover { background:rgba(255,255,255,.08); color:#fff; }

  main { padding:26px 30px 60px; min-width:0; }
  .page-head { display:flex; align-items:center; gap:12px; margin:0 0 20px; flex-wrap:wrap; }
  .page-head h1 { margin:0; font-size:20px; font-weight:650; }
  .page-head .spacer { margin-inline-start:auto; }

  .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; margin-bottom:18px; }
  /* A wide table scrolls inside its own card rather than pushing the whole
     document sideways — on a phone that takes the sidebar and every other card
     with it, and reading one column means scrolling the page.

     No min-width on the table: forcing one gave every narrow card a scrollbar
     it had no use for, because the Insights rankings sit in 330px grid columns
     and the profile cards in half-width ones. The table sizes itself, so the
     wrapper scrolls only when the content really is wider than the card. Header
     cells stay on one line, which is what pushes a genuinely wide table past a
     phone's width in the first place — see `th` below, which already sets it. */
  .table-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  .card > h2 { margin:0 0 14px; font-size:15px; font-weight:650; display:flex; align-items:center; gap:8px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:14px; }
  .stat { background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:15px 16px; }
  .stat b { display:block; font-size:24px; font-weight:650; letter-spacing:-.01em; }
  .stat span { display:flex; align-items:center; gap:6px; color:var(--muted); font-size:11.5px; text-transform:uppercase; letter-spacing:.05em; margin-top:3px; }

  table { width:100%; border-collapse:collapse; font-size:13px; }
  th, td { text-align:start; padding:9px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { background:#f2f5f9; font-weight:600; font-size:12px; color:#43506a; white-space:nowrap; }
  tbody tr:hover { background:#fafbfd; }
  .pill { display:inline-flex; align-items:center; gap:5px; padding:2px 9px; border-radius:999px; font-size:11.5px; background:var(--accent-soft); color:var(--accent); }
  .pill.ok { background:var(--ok-soft); color:var(--ok); }
  .pill.warn { background:var(--warn-soft); color:var(--warn); }
  /* A deadline inside three days is the one thing on the row that should catch
     the eye before anything else. */
  .pill.urgent { background:#fdeaea; color:#a4262c; font-weight:600; }

  button, .btn { display:inline-flex; align-items:center; gap:7px; background:var(--accent); color:#fff; border:0; border-radius:8px; padding:8px 13px; font:inherit; font-size:13px; cursor:pointer; }
  .btn:hover { text-decoration:none; }
  button.secondary, .btn.secondary { background:#fff; color:var(--accent); border:1px solid #c6d5e6; }
  button.danger { background:#fff; color:#a4262c; border:1px solid #e7c3c5; }
  button.icon { padding:6px; border-radius:7px; }
  button:disabled { opacity:.55; cursor:progress; }
  .star-btn { background:none; border:0; padding:4px; cursor:pointer; color:#c2c8d2; border-radius:6px; }
  .star-btn:hover { color:var(--star); background:#fdf6e6; }
  .star-btn[aria-pressed="true"] { color:var(--star); }

  input, select, textarea { padding:8px 10px; border:1px solid #d6dde7; border-radius:8px; font:inherit; width:100%; background:#fff; }
  input:focus, select:focus { outline:2px solid var(--accent-soft); border-color:var(--accent); }
  form.filters { display:grid; grid-template-columns:repeat(auto-fit,minmax(175px,1fr)); gap:12px; align-items:end; }
  /* Two per row, not as many as fit. A settings field is read and considered
     one at a time, so wide fields with room to breathe beat a dense grid of
     narrow ones — and the values here are long: a user agent, an address. */
  .cols-2 { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px 20px; align-items:start; }
  @media (max-width: 720px) { .cols-2 { grid-template-columns:1fr; } }
  label { display:block; font-size:12px; color:var(--muted); margin-bottom:4px; font-weight:500; }
  .error { background:#fdecec; color:#a4262c; padding:10px 12px; border-radius:8px; margin-bottom:14px; }
  .notice { background:var(--ok-soft); color:var(--ok); padding:10px 12px; border-radius:8px; margin-bottom:14px; }
  .muted { color:var(--muted); }
  .empty { padding:26px 10px; text-align:center; color:var(--muted); }
  /* References, dates and counts stay LTR on an RTL page: the bidi algorithm
     otherwise renders "6/2026" as "2026/6".

     Direction and isolation only — no `display`. This class is on table cells,
     and `display:inline-block` on a <td> takes it out of the table layout, so
     every cell carrying it dropped out of its column and the values bunched up
     under whichever header came before them. */
  .ltr { direction:ltr; unicode-bidi:isolate; }
  /* Buttons inside a cell go in their own flex row: laying the <td> out as flex
     has the same effect as inline-block — it stops being a table cell. */
  .row-actions { display:flex; gap:6px; align-items:center; }
  /* Why an avis was cancelled, on the listing itself. The motifs the portal
     publishes run from "VICE DE PROCEDURE" to a 180-character sentence, so the
     line is clamped and carries the full text in its `title`. An explicit
     max-width rather than the cell's: this table is not `table-layout:fixed`,
     so a max-width on a <td> is only advisory and the ellipsis never fires. */
  /* A proportion bar. The width is set inline because it is data, not style —
     the value differs on every render and no class can carry it. */
  .meter { height:7px; border-radius:999px; background:var(--line); overflow:hidden; }
  .meter span { display:block; height:100%; border-radius:999px; }
  .cancel-note { display:block; max-width:44ch; margin-top:4px; font-size:12px; color:var(--warn);
                 overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  /* Direction-bearing icons mirror on an RTL page; "back" points the other way
     in Arabic, and an unflipped chevron sends the reader the wrong direction. */
  body[dir="rtl"] .flip-rtl { transform:scaleX(-1); }
  code { direction:ltr; unicode-bidi:isolate; display:inline-block; background:#f2f5f9; padding:1px 6px; border-radius:5px; font-size:12.5px; }

  /* ---- small screens --------------------------------------------------
     The sidebar was laid out as a wrapping row here, which was tolerable with
     six items and is not with twelve: it filled most of a phone screen before
     the content began. It becomes a drawer instead — closed by default, opened
     by a button in a sticky bar — built from <details> for the same reason the
     language menu is, so it needs no script under the CSP. */
  .topbar { display:none; }

  @media (max-width: 860px) {
    .shell { grid-template-columns:1fr; }

    .topbar { display:flex; align-items:center; gap:10px; position:sticky; top:0; z-index:30;
              background:var(--sidebar); color:#fff; padding:10px 14px; cursor:pointer; list-style:none; }
    .topbar::-webkit-details-marker { display:none; }
    .topbar .brand { padding:0; font-size:14.5px; }
    .menu-toggle { display:flex; align-items:center; gap:8px; margin-inline-start:auto;
                   padding:7px 11px; border-radius:8px; border:1px solid rgba(255,255,255,.22); font-size:13px; }
    .drawer[open] .menu-toggle { background:rgba(255,255,255,.14); }

    .side { position:static; height:auto; padding:6px 10px 14px; display:none; }
    /* The drawer and the shell are siblings, so opening one reveals the other
       with a sibling selector — and the whole thing needs no JavaScript, which
       matters under a CSP that allows no inline script. */
    .drawer[open] ~ .shell .side { display:flex; }
    .side .brand { display:none; }
    .side nav a { padding:11px 12px; font-size:14.5px; }
    .side .bottom { padding-top:12px; }

    main { padding:18px 14px 48px; }
    .page-head h1 { font-size:18px; }
    .card { padding:14px 14px; }
    /* Full-bleed cards read better than 14px gutters on a narrow screen. */
    .card[style*="padding:0"] { border-radius:10px; }
    .grid { grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; }
    .stat b { font-size:20px; }
    form.filters { grid-template-columns:1fr; }
    .lang-list { inset-inline-start:auto; inset-inline-end:0; }
  }

  @media (max-width: 460px) {
    main { padding:14px 11px 40px; }
    .card { padding:12px 11px; }
    .grid { grid-template-columns:1fr 1fr; }
  }
</style>
</head>
<body dir="<%= dir %>">
<%# On a phone the sidebar is a drawer behind this bar; on a desktop the bar is
    display:none and the sidebar is simply always there. One markup, two
    layouts, no script. %>
<details class="drawer">
  <summary class="topbar">
    <span class="brand">
      <%- include('icon', { name: 'file-text', size: 19 }) %>
      <span><%= siteName %></span>
    </span>
    <span class="menu-toggle">
      <%- include('icon', { name: 'menu', size: 17 }) %><%= t('nav.menu') %>
    </span>
  </summary>
</details>
<div class="shell">
  <aside class="side">
    <div class="brand">
      <%- include('icon', { name: 'file-text', size: 20 }) %>
      <span><%= siteName %><small><%= t('app.subtitle') %></small></span>
    </div>

    <nav>
      <a href="/panel/today" class="<%= active === 'today' ? 'on' : '' %>"><%- include('icon', { name: 'calendar' }) %><%= t('nav.today') %></a>
      <a href="/panel" class="<%= active === 'projects' ? 'on' : '' %>"><%- include('icon', { name: 'search' }) %><%= t('nav.projects') %></a>
      <a href="/panel/reference-price" class="<%= active === 'referencePrice' ? 'on' : '' %>"><%- include('icon', { name: 'calculator' }) %><%= t('nav.referencePrice') %></a>
      <a href="/panel/exclusions" class="<%= active === 'exclusions' ? 'on' : '' %>"><%- include('icon', { name: 'triangle-alert' }) %><%= t('nav.exclusions') %></a>
      <a href="/panel/invoices" class="<%= active === 'invoices' ? 'on' : '' %>"><%- include('icon', { name: 'receipt' }) %><%= t('nav.invoices') %></a>
      <a href="/panel/alerts" class="<%= active === 'alerts' ? 'on' : '' %>"><%- include('icon', { name: 'bell' }) %><%= t('nav.alerts') %></a>
      <a href="/panel/favorites" class="<%= active === 'favorites' ? 'on' : '' %>"><%- include('icon', { name: 'star', fill: active === 'favorites' ? 'currentColor' : 'none' }) %><%= t('nav.favorites') %></a>

      <% if (user.role === 'admin') { %>
        <div class="sep"><%= t('nav.administration') %></div>
        <a href="/panel/dashboard" class="<%= active === 'dashboard' ? 'on' : '' %>"><%- include('icon', { name: 'layout-dashboard' }) %><%= t('nav.dashboard') %></a>
        <a href="/panel/system" class="<%= active === 'system' ? 'on' : '' %>"><%- include('icon', { name: 'server' }) %><%= t('nav.system') %></a>
        <%# `inbox`, not `user-plus`: this sits directly above Users, whose icon is the
    same two figures, and at sidebar size the pair was indistinguishable. %>
        <a href="/panel/requests" class="<%= active === 'requests' ? 'on' : '' %>"><%- include('icon', { name: 'inbox' }) %><%= t('nav.requests') %><% if (pendingRequests > 0) { %><span class="badge ltr"><%= pendingRequests %></span><% } %></a>
        <a href="/panel/users" class="<%= active === 'users' ? 'on' : '' %>"><%- include('icon', { name: 'users' }) %><%= t('nav.users') %></a>
        <a href="/panel/settings" class="<%= active === 'settings' ? 'on' : '' %>"><%- include('icon', { name: 'settings' }) %><%= t('nav.settings') %></a>
      <% } %>
    </nav>

    <div class="bottom">
      <%# The two services are separate applications on separate procedures, so
          the way between them is an explicit link rather than a shared menu.
          The portal is where the choice is made and where the session lives. %>
      <a class="switch" href="<%= siblingUrl %>"><%- include('icon', { name: 'arrow-left-right' }) %><%= t('nav.sibling') %></a>
      <a class="switch" href="<%= portalUrl %>"><%- include('icon', { name: 'layout-grid' }) %><%= t('nav.portal') %></a>
      <div class="who"><b><%= user.fullName || user.email %></b><%= user.role === 'admin' ? t('users.role.admin') : t('users.role.user') %></div>
      <%- include('lang-menu', { variant: 'dark' }) %>
      <form method="post" action="/logout"><button type="submit" class="out"><%- include('icon', { name: 'log-out' }) %><%= t('nav.logout') %></button></form>
    </div>
  </aside>

  <main>
