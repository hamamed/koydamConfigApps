NODE_ENV=production
PORT=3500
PUBLIC_URL=https://portail.civictrust.ma

# The shared session. All three services — portail, bdc, marches — must carry
# the SAME JWT_SECRET: the portal signs the token and the other two verify it.
# Change it here and you have signed everyone out of all three.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=12h

# The leading dot is what makes one sign-in reach the other services: a cookie
# with no Domain goes back only to the host that set it. Every service that
# should accept the session needs this exact value.
AUTH_COOKIE_DOMAIN=.civictrust.ma

SQLITE_FILE=/opt/portail/data/portail.sqlite
# DATABASE_URL=postgres://portail:CHANGE_ME@127.0.0.1:5432/portail

# Where the chooser sends people.
SERVICE_BDC_URL=https://bdc.civictrust.ma/panel
SERVICE_MARCHES_URL=https://marches.civictrust.ma/panel
PORTAL_SERVICES=bdc,marches

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=portail@civictrust.ma

LOG_LEVEL=info
