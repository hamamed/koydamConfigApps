# Server
PORT=3000
# Loopback only — nginx proxies to it. Change this and the app is exposed without TLS.
HOST=127.0.0.1
NODE_ENV=production

# Public base URL. Used to build the absolute preview_url / template_url the iOS app fetches,
# so it MUST match how clients actually reach this server (scheme and host included).
PUBLIC_URL=https://vps.yourdomain.com

# Sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created on `npm run migrate` if no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Universal links. Both must match the shipping iOS app or deep links silently fall back to
# Safari. Team ID is in the Apple Developer portal under Membership.
APPLE_TEAM_ID=TEAMID
IOS_BUNDLE_ID=koydam.skincraft.for.roblox

# Storage
DATA_DIR=./data
STORAGE_DIR=./storage

# Uploads
MAX_UPLOAD_MB=12

# Comma-separated origins allowed to call the public API. Leave blank to allow all,
# which is what you want for a mobile client (apps send no Origin header).
CORS_ORIGINS=

# ── AI skin design (optional) ───────────────────────────────────────────────
#
# Off unless a key is set. Speaks the OpenAI images API, which several
# providers implement - so pointing the base URL elsewhere switches provider
# without a code change. Anthropic models do not generate images, which is why
# this is deliberately somebody else's API.
#
# Each generation costs money: 1 image on "simple", 3 on "detailed".

# AI_IMAGE_API_KEY=sk-...
# AI_IMAGE_BASE_URL=https://api.openai.com/v1
# AI_IMAGE_MODEL=gpt-image-1
# The planner suggests ideas and writes the design in words before anything is
# drawn, so you can read and change its reasoning while it still costs only
# text tokens. On by default once an image key is set; AI_TEXT_MODEL=off turns
# it off. Image generation is unaffected either way.
# AI_TEXT_MODEL=gpt-4o-mini
