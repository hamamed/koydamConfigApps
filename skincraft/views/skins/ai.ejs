<%- include('../partials/head', { title }) %>
<div class="ad-shell">
  <%- include('../partials/sidebar') %>
  <div class="ad-scrim" id="scScrim"></div>

  <main class="ad-main">
    <%- include('../partials/topbar', {
      heading: 'Design with AI',
      subheading: 'Describe a design; it is composed into a Roblox template as a draft'
    }) %>

      <div class="ad-content">
    <%- include('../partials/flash') %>

    <% if (!available) { %>
      <div class="alert alert-warning">
        <strong>Not switched on.</strong>
        Set <code>AI_IMAGE_API_KEY</code> in the panel, or in
        <code>/opt/skincraft/.env</code>. Nothing else is needed — the rest is
        already here.
      </div>
    <% } else if (!planningAvailable) { %>
      <div class="alert alert-info">
        <strong>The planner is off.</strong>
        Generation still works, but nothing suggests ideas or writes the design
        out in words first. Clear <code>Planner model</code> back to the default
        under <em>AI design</em> in the panel to see what it intends — and
        change its mind — before paying for images.
      </div>
    <% } %>

    <div class="row g-3">
      <!-- Prompt -->
      <div class="col-12 col-xl-7">
        <div class="ad-card ad-card-pad">
          <h2 class="h6 mb-3">Describe the design</h2>

          <form method="post" action="/admin/skins/ai" data-ai-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <% if (planningAvailable) { %>
              <!--
                The blank textarea is the hardest part of this screen. Ideas are
                text tokens and draw nothing, so this is the cheap end of the
                process and the right place to be generous with options.
              -->
              <div class="ad-ideas" data-ideas>
                <div class="ad-ideas-ask">
                  <i data-lucide="lightbulb" class="ad-ideas-icon"></i>
                  <input class="form-control form-control-sm" data-ideas-theme maxlength="200"
                         placeholder="A theme, or leave blank — “autumn”, “deep sea”, “90s arcade”"
                         <%= available ? '' : 'disabled' %>>
                  <button class="btn btn-sm btn-kd-outline" type="button" data-ideas-go
                          <%= available ? '' : 'disabled' %>>
                    Suggest ideas
                  </button>
                </div>
                <div class="ad-ideas-list" data-ideas-list hidden></div>
              </div>
            <% } %>

            <div class="mb-3">
              <label class="form-label" for="description">What should it look like?</label>
              <textarea class="form-control" id="description" name="description"
                        rows="3" maxlength="500" required
                        placeholder="A deep blue galaxy with purple nebula clouds and small white stars"
                        <%= available ? '' : 'disabled' %>></textarea>
              <div class="form-text">
                Describe the <em>artwork</em>, not the garment. “Blue galaxy
                pattern”, not “a shirt with a galaxy on it” — asking for a shirt
                gets you a picture of a shirt, printed on a shirt.
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6 col-md-4">
                <label class="form-label" for="category">Garment</label>
                <select class="form-select" id="category" name="category"
                        <%= available ? '' : 'disabled' %>>
                  <option value="shirt">Shirt</option>
                  <option value="pants">Pants</option>
                  <option value="tshirt">T-shirt</option>
                  <option value="avatar">Full body</option>
                </select>
              </div>

              <div class="col-6 col-md-4">
                <label class="form-label" for="quality">Detail</label>
                <select class="form-select" id="quality" name="quality"
                        <%= available ? '' : 'disabled' %>>
                  <option value="simple">Simple — 1 image</option>
                  <option value="standard" selected>Standard — 2 images</option>
                  <option value="detailed">Detailed — 3 images</option>
                </select>
                <div class="form-text">Each image costs a generation.</div>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label" for="title">Title</label>
                <input class="form-control" id="title" name="title"
                       maxlength="80" placeholder="Optional"
                       <%= available ? '' : 'disabled' %>>
              </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
              <% if (planningAvailable) { %>
                <button class="btn btn-kd-outline" type="button" data-ai-plan
                        <%= available ? '' : 'disabled' %>>
                  <i data-lucide="message-square"></i>
                  Plan it first
                </button>
              <% } %>
              <button class="btn btn-kd" type="submit" data-ai-submit <%= available ? '' : 'disabled' %>>
                Generate as draft
              </button>
              <span class="small" style="color:var(--kd-faint);">
                A minute or two, longer on Detailed. It arrives unpublished.
              </span>
            </div>

            <!--
              Progress lives here rather than in the tab spinner. Generation is
              one to several minutes of nothing visible: without this the page
              looks frozen, and the honest question "is it working?" has no
              answer on screen. Hidden until the script takes over, so with
              JavaScript off the plain form post still works and this never
              appears claiming something that is not happening.
            -->
            <div class="ad-ai-status" data-ai-status hidden>
              <span class="ad-spin" aria-hidden="true">
                <i data-lucide="loader-circle"></i>
              </span>
              <div class="ad-ai-status-text">
                <strong data-ai-status-title>Generating…</strong>
                <span class="d-block small" data-ai-status-detail></span>
              </div>
            </div>

            <div class="alert alert-danger ad-ai-error" data-ai-error hidden>
              <i data-lucide="circle-alert" class="me-1"></i>
              <span data-ai-error-text></span>
            </div>

            <!--
              The planner's reasoning, written before anything is drawn.
              Hidden until asked for: planning costs text tokens, and someone
              who just wants a skin should not have to read an essay first.
            -->
            <div class="ad-plan" data-ai-plan-panel hidden>
              <div class="ad-plan-head">
                <span class="ad-spin" data-ai-plan-spinner hidden aria-hidden="true">
                  <i data-lucide="loader-circle"></i>
                </span>
                <i data-lucide="message-square" class="ad-plan-icon" data-ai-plan-icon></i>
                <strong>What it's planning</strong>
                <span class="small ms-auto" style="color:var(--kd-faint);"
                      data-ai-plan-model></span>
              </div>

              <!-- aria-live so the streamed text is announced as it arrives
                   rather than sitting silently for a screen reader. -->
              <div class="ad-plan-body" data-ai-plan-text aria-live="polite"></div>

              <div class="ad-plan-foot">
                <input class="form-control form-control-sm" data-ai-plan-reply
                       maxlength="300" placeholder="Change something — “colder colours, no stars”">
                <button class="btn btn-sm btn-kd-outline" type="button" data-ai-plan-send>
                  Send
                </button>
                <button class="btn btn-sm btn-kd" type="button" data-ai-plan-accept>
                  Generate from this plan
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Guidance -->
      <div class="col-12 col-xl-5">
        <div class="ad-card ad-card-pad mb-3">
          <h2 class="h6 mb-3">Before you publish</h2>
          <ul class="mb-0 ps-3 small">
            <% checklist.forEach(function (item) { %>
              <li class="mb-1"><%= item %></li>
            <% }); %>
          </ul>
        </div>

        <div class="ad-card ad-card-pad">
          <h2 class="h6 mb-2">How the sheet is built</h2>
          <p class="small" style="color:var(--kd-faint);">
            The model draws flat artwork; this places it into the 585 × 559
            layout Roblox expects. Each colour is one face of the avatar — the
            artwork is scaled and shaded into those exact rectangles.
          </p>
          <img src="/admin/skins/ai/layout-proof.png?category=shirt"
               alt="Every face of the template rendered in its own colour"
               class="img-fluid border rounded">
          <p class="small mb-0 mt-2" style="color:var(--kd-faint);">
            Red is the front, blue the back, green and yellow the sides. If a
            face ever landed in the wrong rectangle, it would show here.
          </p>
        </div>
      </div>
    </div>
      </div>
  </main>
</div>
<%- include('../partials/foot') %>
