<%- include('../partials/head', { title }) %>
<div class="sc-shell">
  <%- include('../partials/sidebar') %>
  <div class="sc-scrim d-none" id="scScrim"></div>

  <main class="sc-main">
    <%
      const isCreate = mode === 'create';
      const action = isCreate ? '/admin/skins' : `/admin/skins/${skin.id}`;
    %>
    <%- include('../partials/topbar', {
      heading: isCreate ? 'Upload skin' : 'Edit skin',
      subheading: isCreate
        ? 'Add a new template to the catalogue'
        : skin.title,
      actions: isCreate ? '' : `<a class="btn btn-sc-ghost" href="/admin/skins/${skin.id}">
                  <i data-lucide="eye" width="15" height="15" class="me-1"></i>View</a>`
    }) %>

    <% if (errors.length) { %>
      <div class="alert alert-danger mb-4" role="alert">
        <div class="d-flex align-items-center gap-2 mb-1">
          <i data-lucide="circle-alert" width="17" height="17"></i>
          <strong>Please fix the following</strong>
        </div>
        <ul class="mb-0 ps-4 small">
          <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="<%= action %>" enctype="multipart/form-data" id="scSkinForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3">
        <!-- Files -->
        <div class="col-12 col-lg-5">
          <div class="sc-card sc-card-pad mb-3">
            <h2 class="h6 mb-1">Template</h2>
            <p class="small mb-3" style="color:var(--sc-text-dim);">
              The PNG people download and upload to Roblox. Classic clothing is 585 × 559.
            </p>

            <label class="sc-dropzone d-block" data-dropzone data-preview="templatePreview">
              <input type="file" name="template" accept="image/png,image/jpeg,image/webp"
                     <%= isCreate ? 'required' : '' %>>
              <img class="sc-dropzone-preview mb-2 d-none" id="templatePreview" alt="">
              <div data-dropzone-empty>
                <i data-lucide="image-up" width="26" height="26" style="color:var(--sc-accent-soft);"></i>
                <p class="small mb-0 mt-2 fw-semibold">
                  <%= isCreate ? 'Drop a template or click to choose' : 'Replace template' %>
                </p>
                <p class="mb-0" style="font-size:0.74rem;color:var(--sc-text-dim);">PNG, JPEG or WebP</p>
              </div>
            </label>

            <% if (!isCreate) { %>
              <div class="d-flex align-items-center justify-content-between mt-3 small">
                <span style="color:var(--sc-text-dim);">Current</span>
                <span class="fw-semibold">
                  <%= skin.template_w %> × <%= skin.template_h %> · <%= formatBytes(skin.file_bytes) %>
                </span>
              </div>
            <% } %>
          </div>

          <div class="sc-card sc-card-pad">
            <h2 class="h6 mb-1">Card artwork</h2>
            <p class="small mb-3" style="color:var(--sc-text-dim);">
              Optional. Leave empty and we'll generate one from the template's front face.
            </p>

            <label class="sc-dropzone d-block" data-dropzone data-preview="previewPreview">
              <input type="file" name="preview" accept="image/png,image/jpeg,image/webp">
              <img class="sc-dropzone-preview mb-2 d-none" id="previewPreview" alt=""
                   style="image-rendering:auto;">
              <div data-dropzone-empty>
                <i data-lucide="image" width="24" height="24" style="color:var(--sc-text-dim);"></i>
                <p class="small mb-0 mt-2">Drop card artwork (optional)</p>
              </div>
            </label>

            <% if (!isCreate) { %>
              <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="regeneratePreview"
                       name="regeneratePreview" checked>
                <label class="form-check-label small" for="regeneratePreview">
                  Regenerate artwork when the template is replaced
                </label>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Details -->
        <div class="col-12 col-lg-7">
          <div class="sc-card sc-card-pad mb-3">
            <h2 class="h6 mb-3">Details</h2>

            <div class="mb-3">
              <label class="form-label" for="title">Title</label>
              <input class="form-control" id="title" name="title" type="text" maxlength="80" required
                     value="<%= skin.title %>" placeholder="Cyberpunk Neon Hoodie">
            </div>

            <div class="mb-3">
              <label class="form-label" for="category">Category</label>
              <select class="form-select" id="category" name="category" required>
                <% categories.forEach((category) => { %>
                  <option value="<%= category %>" <%= skin.category === category ? 'selected' : '' %>>
                    <%= categoryLabels[category] %>
                  </option>
                <% }) %>
              </select>
              <div class="form-text">
                Shirts and T-shirts paint the torso and arms, pants the legs, and avatar textures the whole body.
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="description">Description</label>
              <textarea class="form-control" id="description" name="description" rows="3"
                        maxlength="500" placeholder="What makes this one worth downloading?"><%= skin.description || '' %></textarea>
            </div>

            <div class="mb-1">
              <label class="form-label" for="tags">Tags</label>
              <input class="form-control" id="tags" name="tags" type="text"
                     value="<%= (skin.tags || []).join(', ') %>"
                     placeholder="cyberpunk, neon, streetwear">
              <div class="form-text">Comma separated. These power search and the Explore tab.</div>
            </div>

            <% if (knownTags.length) { %>
              <div class="d-flex flex-wrap gap-1 mt-2">
                <% knownTags.slice(0, 14).forEach((tag) => { %>
                  <button class="sc-tag border-0" type="button" data-tag-suggestion="<%= tag.name %>">
                    + <%= tag.name %>
                  </button>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="sc-card sc-card-pad mb-3">
            <h2 class="h6 mb-3">Visibility</h2>

            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" role="switch" id="isPublished"
                     name="isPublished" <%= skin.isPublished !== false ? 'checked' : '' %>>
              <label class="form-check-label" for="isPublished">
                <span class="fw-semibold small">Published</span>
                <span class="d-block form-text mt-0">Visible in the app catalogue.</span>
              </label>
            </div>

            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="isFeatured"
                     name="isFeatured" <%= skin.isFeatured ? 'checked' : '' %>>
              <label class="form-check-label" for="isFeatured">
                <span class="fw-semibold small">Featured</span>
                <span class="d-block form-text mt-0">Shows in the app's Featured carousel.</span>
              </label>
            </div>
          </div>

          <div class="d-flex gap-2">
            <button class="btn btn-sc-primary px-4" type="submit">
              <i data-lucide="check" width="16" height="16" class="me-1"></i>
              <%= isCreate ? 'Publish skin' : 'Save changes' %>
            </button>
            <a class="btn btn-sc-ghost" href="<%= isCreate ? '/admin/skins' : `/admin/skins/${skin.id}` %>">
              Cancel
            </a>
          </div>
        </div>
      </div>
    </form>
  </main>
</div>
<%- include('../partials/foot') %>
