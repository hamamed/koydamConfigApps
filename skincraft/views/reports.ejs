<%- include('partials/head', { title }) %>
<div class="sc-shell">
  <%- include('partials/sidebar') %>
  <div class="sc-scrim d-none" id="scScrim"></div>

  <main class="sc-main">
    <%
      const statuses = [['open','Open'],['resolved','Resolved'],['dismissed','Dismissed'],['all','All']];
      const picker = `<div class="sc-range">${statuses.map(([value, label]) =>
        `<a href="/admin/reports?status=${value}" class="${value === filters.status ? 'active' : ''}">${label}</a>`
      ).join('')}</div>`;
    %>
    <%- include('partials/topbar', {
      heading: 'Reports',
      subheading: `${pagination.total} ${filters.status === 'all' ? 'total' : filters.status}`,
      actions: picker
    }) %>

    <%- include('partials/flash') %>

    <% if (reports.length === 0) { %>
      <div class="sc-card sc-empty">
        <div class="sc-empty-icon"><i data-lucide="shield-check" width="28" height="28"></i></div>
        <h2 class="h6 mb-1">Nothing to review</h2>
        <p class="small mb-0" style="color:var(--sc-text-dim);">
          <%= filters.status === 'open' ? 'No open reports — the catalogue is clean.' : 'No reports with that status.' %>
        </p>
      </div>
    <% } else { %>
      <div class="sc-card overflow-hidden">
        <% reports.forEach((report, index) => { %>
          <div class="sc-report-row <%= report.isUrgent ? 'urgent' : '' %> p-3
                      <%= index < reports.length - 1 ? 'border-bottom' : '' %>"
               style="border-color: var(--sc-hairline) !important;">
            <div class="d-flex gap-3 align-items-start flex-wrap">
              <a href="/admin/skins/<%= report.skin_id %>" class="flex-shrink-0">
                <img src="/storage/previews/<%= report.preview_file %>" alt="" width="46" height="58"
                     style="border-radius:8px;object-fit:cover;display:block;" loading="lazy">
              </a>

              <div class="flex-grow-1" style="min-width:220px;">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                  <span class="sc-reason <%= report.isUrgent ? 'urgent' : '' %>">
                    <% if (report.isUrgent) { %><i data-lucide="triangle-alert" width="11" height="11"></i><% } %>
                    <%= report.reasonLabel %>
                  </span>
                  <span class="sc-badge category"><%= categoryLabels[report.category] %></span>
                  <% if (!report.is_published) { %><span class="sc-badge draft">Draft</span><% } %>
                  <% if (report.status !== 'open') { %>
                    <span class="sc-badge"><%= report.status %></span>
                  <% } %>
                </div>

                <a class="fw-semibold text-decoration-none text-body" href="/admin/skins/<%= report.skin_id %>">
                  <%= report.title %>
                </a>

                <% if (report.note) { %>
                  <p class="small mb-1 mt-1" style="color:var(--sc-text-muted);">“<%= report.note %>”</p>
                <% } %>

                <div style="font-size:0.72rem;color:var(--sc-text-dim);">
                  <%= timeAgo(report.created_at) %>
                  <% if (report.resolver) { %> · handled by <%= report.resolver %><% } %>
                </div>
              </div>

              <div class="d-flex gap-2 align-items-center ms-auto">
                <a class="btn btn-sc-ghost btn-sm" href="/admin/skins/<%= report.skin_id %>/edit">
                  <i data-lucide="pencil" width="14" height="14" class="me-1"></i>Fix
                </a>
                <% if (report.status === 'open') { %>
                  <form method="post" action="/admin/reports/<%= report.id %>/status" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="resolved">
                    <button class="btn btn-sc-primary btn-sm" type="submit">
                      <i data-lucide="check" width="14" height="14" class="me-1"></i>Resolve
                    </button>
                  </form>
                  <form method="post" action="/admin/reports/<%= report.id %>/status" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="dismissed">
                    <button class="sc-icon-btn" type="submit" title="Dismiss" aria-label="Dismiss">
                      <i data-lucide="x" width="14" height="14"></i>
                    </button>
                  </form>
                <% } else { %>
                  <form method="post" action="/admin/reports/<%= report.id %>/status" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="open">
                    <button class="btn btn-sc-ghost btn-sm" type="submit">Reopen</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <%- include('partials/pagination', { basePath: '/admin/reports', filters }) %>
    <% } %>
  </main>
</div>
<%- include('partials/foot') %>
