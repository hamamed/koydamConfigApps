<div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
  <div class="d-flex align-items-center gap-2">
    <button class="ad-icon-btn ad-menu-toggle" id="scMenuToggle" type="button" aria-label="Open menu">
      <i data-lucide="menu" width="16" height="16"></i>
    </button>
    <div>
      <h1 class="ad-page-title"><%= heading %></h1>
      <% if (typeof subheading !== 'undefined' && subheading) { %>
        <p class="ad-page-sub"><%= subheading %></p>
      <% } %>
    </div>
  </div>
  <div class="d-flex align-items-center gap-2">
    <%# Who is signed in, as a chip. The design reference puts identity in the
        topbar; the sidebar foot is for destinations. %>
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="kd-tag d-none d-md-inline" title="<%= user.role %>"><%= user.username %></span>
    <% } %>
    <% if (typeof actions !== 'undefined' && actions) { %><%- actions %><% } %>
  </div>
</div>
