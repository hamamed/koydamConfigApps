<%
  // `currentPath` is the path within the admin router, so the dashboard is '/' not '/admin'.
  const nav = [
    { section: 'Catalogue', items: [
      { href: '/admin',       icon: 'layout-dashboard', label: 'Dashboard',
        active: currentPath === '/' },
      { href: '/admin/skins', icon: 'shirt',            label: 'Skins',
        active: currentPath.startsWith('/skins')
                && currentPath !== '/skins/new' && currentPath !== '/skins/ai'
                && currentPath !== '/skins/from-picture' },
      { href: '/admin/tags',  icon: 'tags',             label: 'Tags',
        active: currentPath.startsWith('/tags') },
    ]},
    { section: 'Insight', items: [
      { href: '/admin/analytics', icon: 'activity', label: 'Analytics',
        active: currentPath.startsWith('/analytics') },
      { href: '/admin/reports',   icon: 'flag',       label: 'Reports',
        active: currentPath.startsWith('/reports'), badge: openReports },
    ]},
  ];
%>
<aside class="ad-sidebar" id="scSidebar">
  <!-- The Koydam mark, as on every other panel. Delivered by the platform
       overlay, so all three serve the same file. -->
  <a class="ad-brand" href="/admin">
    <img class="kd-brand-mark" src="/assets/logo/logo.png" alt=""
         width="23" height="26">
    <span class="ad-brand-name">SkinCraft<small>Skin catalogue</small></span>
  </a>

  <nav class="ad-nav">
    <% nav.forEach((group) => { %>
      <div class="ad-nav-label"><%= group.section %></div>
      <% group.items.forEach((item) => { %>
        <a class="ad-nav-link <%= item.active ? 'is-active' : '' %>" href="<%= item.href %>">
          <i data-lucide="<%= item.icon %>" width="17" height="17"></i>
          <span><%= item.label %></span>
          <% if (item.badge) { %><span class="ad-badge"><%= item.badge %></span><% } %>
        </a>
      <% }) %>
    <% }) %>

    <div class="ad-nav-label">Create</div>
    <a class="ad-nav-link <%= currentPath === '/skins/new' ? 'is-active' : '' %>" href="/admin/skins/new">
      <i data-lucide="upload" width="17" height="17"></i>
      <span>Upload skin</span>
    </a>
    <a class="ad-nav-link <%= currentPath === '/skins/design' ? 'is-active' : '' %>" href="/admin/skins/design">
      <i data-lucide="wand-sparkles" width="17" height="17"></i>
      <span>Design a skin</span>
    </a>
    <a class="ad-nav-link <%= currentPath === '/skins/ai' ? 'is-active' : '' %>" href="/admin/skins/ai">
      <i data-lucide="sparkles" width="17" height="17"></i>
      <span>Design with AI</span>
    </a>
    <a class="ad-nav-link <%= currentPath === '/skins/from-picture' ? 'is-active' : '' %>"
       href="/admin/skins/from-picture">
      <i data-lucide="image-plus" width="17" height="17"></i>
      <span>From a picture</span>
    </a>
  </nav>

  <!-- A destination and a way out, as on every other panel. Who you are
       signed in as belongs in the topbar. -->
  <div class="ad-sidebar-foot">
    <a class="ad-nav-link" href="/" target="_blank" rel="noopener">
      <i data-lucide="external-link" width="17" height="17"></i>
      <span>View site</span>
    </a>
    <form method="post" action="/admin/logout" class="m-0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="ad-nav-link w-100 border-0 bg-transparent text-start" type="submit">
        <i data-lucide="log-out" width="17" height="17"></i>
        <span>Sign out</span>
      </button>
    </form>
  </div>
</aside>
