<div class="ad-skin-card-wrap position-relative">
  <a class="ad-skin-card" href="/admin/skins/<%= skin.id %>">
    <!--
      The derived preview stays as the markup: it is what a person sees with
      JavaScript off, while the template loads, or if the canvas fails. The
      renderer paints the garment on a body over the top and only then hides
      this, so a card is never blank.
    -->
    <div class="ad-skin-thumb" data-avatar-card='<%- JSON.stringify({
      texture: skin.templateUrl,
      category: skin.category
    }) %>'>
      <img class="ad-skin-flat" src="<%= skin.previewUrl %>" alt="" loading="lazy" width="320" height="400">
    </div>
    <div class="ad-skin-body">
      <p class="ad-skin-title"><%= skin.title %></p>
      <div class="ad-skin-meta">
        <i data-lucide="download" width="12" height="12"></i>
        <span><%= formatNumber(skin.downloads) %></span>
        <% if (skin.likes || skin.dislikes) { %>
          <span>·</span>
          <i data-lucide="thumbs-up" width="12" height="12"></i>
          <span><%= formatNumber(skin.likes) %></span>
          <% if (skin.dislikes) { %>
            <i data-lucide="thumbs-down" width="12" height="12" class="ms-1"></i>
            <span><%= formatNumber(skin.dislikes) %></span>
          <% } %>
        <% } %>
        <span>·</span>
        <span><%= categoryLabels[skin.category] %></span>
      </div>
    </div>
  </a>

  <!-- Outside the card's link, like the other controls, so ticking it does
       not also open the skin. -->
  <label class="ad-skin-pick" title="Select <%= skin.title %>">
    <input type="checkbox" name="ids" value="<%= skin.id %>" form="scBulk"
           aria-label="Select <%= skin.title %>">
  </label>

  <div class="ad-skin-flags">
    <% if (skin.isFeatured) { %>
      <span class="ad-badge featured"><i data-lucide="sparkles" width="10" height="10"></i> Featured</span>
    <% } %>
    <% if (!skin.isPublished) { %>
      <span class="ad-badge draft">Draft</span>
    <% } %>
  </div>

  <div class="ad-skin-actions">
    <form method="post" action="/admin/skins/<%= skin.id %>/feature" class="m-0" data-quick-action>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="ad-icon-btn <%= skin.isFeatured ? 'is-on' : '' %>" type="submit"
              title="<%= skin.isFeatured ? 'Remove from Featured' : 'Add to Featured' %>"
              aria-label="Toggle featured">
        <i data-lucide="star" width="14" height="14"
           <%= skin.isFeatured ? 'fill="currentColor"' : '' %>></i>
      </button>
    </form>
    <a class="ad-icon-btn" href="/admin/skins/<%= skin.id %>/edit" title="Edit"
       aria-label="Edit <%= skin.title %>">
      <i data-lucide="pencil" width="14" height="14"></i>
    </a>
    <!--
      Deliberately a real form post, not the background request the star uses.
      Removing a skin deletes its files as well, so it should reload and show
      the flash that says it happened, rather than a card quietly vanishing.
    -->
    <form method="post" action="/admin/skins/<%= skin.id %>/delete" class="m-0"
          data-confirm="Delete “<%= skin.title %>”? This removes the files too and can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="ad-icon-btn ad-icon-btn-danger" type="submit" title="Delete"
              aria-label="Delete <%= skin.title %>">
        <i data-lucide="trash-2" width="14" height="14"></i>
      </button>
    </form>
  </div>
</div>
