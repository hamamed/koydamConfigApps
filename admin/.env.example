NODE_ENV=production
PORT=3600
PUBLIC_URL=https://admin.civictrust.ma

# The console verifies the portal's session; it never signs one. Same
# JWT_SECRET as portail, bdc and marches, or nobody gets in.
JWT_SECRET=CHANGE_ME
PORTAL_URL=https://portail.civictrust.ma

# The services it administers, reached over their own /admin/api.
SERVICE_BDC_API=https://bdc.civictrust.ma
SERVICE_BDC_URL=https://bdc.civictrust.ma/panel
SERVICE_MARCHES_API=https://marches.civictrust.ma
SERVICE_MARCHES_URL=https://marches.civictrust.ma/panel

# How long to wait on a service before reporting it unreachable.
ADMIN_REQUEST_TIMEOUT_MS=8000

LOG_LEVEL=info
