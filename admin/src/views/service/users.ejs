<%- include('../layout-open', { title: service.label + ' — comptes' }) %>
<%- include('_nav') %>

<%# Read-only on purpose. The portal owns accounts now; what a service holds is
    a local row created the first time somebody signed in, and editing it here
    would change nothing anybody experiences. %>
<p class="muted" style="margin:0 0 14px; font-size:13px">
  Les comptes sont gérés sur le portail. Ce qui suit est ce que ce service a vu :
  une ligne locale créée à la première visite, utilisée pour ses favoris et ses alertes.
</p>

<% if (data) { %>
  <table>
    <thead><tr><th>Adresse</th><th>Nom</th><th>Rôle</th><th>Dernière visite</th></tr></thead>
    <tbody>
      <% (Array.isArray(data) ? data : []).forEach(function (u) { %>
        <tr>
          <td class="ltr"><%= u.email %></td>
          <td><%= u.full_name || '—' %></td>
          <td><span class="pill <%= u.role === 'admin' ? '' : 'ok' %>"><%= u.role %></span></td>
          <td class="ltr"><%= u.last_login_at || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('../layout-close') %>
