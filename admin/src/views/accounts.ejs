<%- include('layout-open', { title: 'Comptes' }) %>

<div class="tabs">
  <a href="/">Vue d’ensemble</a>
  <% config.services.forEach(function (s) { %>
    <a href="/s/<%= s.key %>/dashboard"><%= s.label %></a>
  <% }) %>
  <a class="on" href="/comptes">Comptes</a>
</div>

<%
  const rows = Array.isArray(accounts) ? accounts : []
  const active = rows.filter((row) => row.isActive)
  const admins = rows.filter((row) => row.role === 'admin')
  const label = { bdc: 'Bons de commande', marches: 'Marchés' }
%>

<% if (error) { %><div class="down"><%= error %></div><% } %>

<div class="box">
  <h2><%- include('icon', { name: 'shield-check', size: 16 }) %>Comptes<span class="count">une seule liste, pour les deux espaces</span></h2>
  <p class="muted" style="margin:-4px 0 14px; font-size:12.5px">
    Les comptes vivent sur le portail : c’est là que le mot de passe est vérifié
    et que se décide qui peut ouvrir quel espace. bdc et marchés ne conservent
    qu’une ligne locale créée à la première visite, pour leurs favoris et leurs
    alertes — elle dit qui est venu, pas qui a accès.
  </p>

  <div class="tiles" style="margin:0 0 16px">
    <div class="metric"><b class="ltr"><%= rows.length %></b><span class="k">comptes</span></div>
    <div class="metric"><b class="ltr"><%= active.length %></b><span class="k">actifs</span></div>
    <div class="metric"><b class="ltr"><%= admins.length %></b><span class="k">administrateurs</span></div>
    <% config.services.forEach(function (s) { %>
      <div class="metric">
        <b class="ltr"><%= rows.filter((row) => (row.services || []).includes(s.key)).length %></b>
        <span class="k">accès <%= s.label.toLowerCase() %></span>
      </div>
    <% }) %>
  </div>

  <table>
    <thead>
      <tr><th>Adresse</th><th>Nom</th><th>Rôle</th><th>Espaces</th><th>État</th><th>Dernière connexion</th></tr>
    </thead>
    <tbody>
      <% rows.forEach(function (row) { %>
        <tr>
          <td class="ltr"><%= row.email %></td>
          <td><%= row.fullName || '—' %></td>
          <td><span class="pill <%= row.role === 'admin' ? '' : 'ok' %>"><%= row.role %></span></td>
          <td>
            <%# Which spaces the account may open, named. This is the fact the
                portal owns and neither service can answer. %>
            <% (row.services || []).forEach(function (key) { %>
              <span class="pill" style="margin-inline-end:4px"><%= label[key] || key %></span>
            <% }) %>
            <% if ((row.services || []).length === 0) { %><span class="pill warn">aucun</span><% } %>
          </td>
          <td><span class="pill <%= row.isActive ? 'ok' : 'bad' %>"><%= row.isActive ? 'actif' : 'désactivé' %></span></td>
          <td class="ltr"><%= row.lastLoginAt || 'jamais' %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0 && !error) { %>
        <tr><td colspan="6" class="muted">Aucun compte.</td></tr>
      <% } %>
    </tbody>
  </table>

  <p class="muted" style="margin:14px 0 0; font-size:12.5px">
    <%# Read-only, and saying so beats a disabled button. Creating an account
        and setting a password happen on the box, where the plaintext is shown
        once and never stored. %>
    Lecture seule. Un compte se crée sur le serveur&nbsp;:
    <code class="ltr">node bin/users.js add &lt;adresse&gt; &lt;mot de passe&gt; --role=admin</code>
    dans <code class="ltr">/opt/portail</code>.
  </p>
</div>
<%- include('layout-close') %>
