<!doctype html>
<html lang="fr" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Administration CivicTrust</title>
<style>
  :root {
    --bg:#0f2c4d; --ink:#111827; --muted:#6b7280; --line:#e5e9f0; --card:#fff;
    --accent:#0b5394; --accent-soft:#eaf1fa; --radius:12px;
  }
  * { box-sizing:border-box; }
  html,body { height:100%; }
  body { margin:0; font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif; color:var(--ink);
         background:var(--bg);
         background-image:radial-gradient(1200px 500px at 50% -10%, #1d4a7d 0%, transparent 60%);
         display:flex; flex-direction:column; }
  a { color:var(--accent); text-decoration:none; }
  a:hover { text-decoration:underline; }
  .ic { flex:none; vertical-align:-.18em; }

  header.top { padding:22px 26px; display:flex; align-items:center; gap:12px; color:#fff; }
  header.top .brand { display:flex; align-items:center; gap:10px; font-weight:650; font-size:16px; }
  header.top .brand small { display:block; font-weight:400; font-size:11.5px; color:#9db4cd; }
  header.top .spacer { margin-inline-start:auto; }
  header.top form { display:inline; }
  header.top button, header.top .btn-ghost {
    background:rgba(255,255,255,.10); color:#fff; border:1px solid rgba(255,255,255,.22);
    border-radius:9px; padding:8px 13px; font:inherit; font-size:13.5px; cursor:pointer; }
  header.top button:hover, header.top .btn-ghost:hover { background:rgba(255,255,255,.18); text-decoration:none; }

  main { flex:1; display:flex; align-items:flex-start; justify-content:center; padding:10px 20px 48px; }
  .sheet { width:100%; max-width:1120px; }
  .panel { background:var(--card); border-radius:var(--radius); padding:30px 32px;
           box-shadow:0 24px 60px rgba(6,22,40,.30); }
  .panel.narrow { max-width:420px; margin:0 auto; }
  h1 { margin:0 0 6px; font-size:24px; font-weight:660; letter-spacing:-.01em; }
  .lede { margin:0 0 22px; color:var(--muted); font-size:14.5px; }

  label { display:block; font-size:12.5px; color:var(--muted); margin:0 0 5px; font-weight:500; }
  input { width:100%; padding:11px 12px; border:1px solid #d6dde7; border-radius:9px; font:inherit; background:#fff; }
  input:focus { outline:2px solid var(--accent-soft); border-color:var(--accent); }
  .field { margin-bottom:15px; }
  button.primary { width:100%; background:var(--accent); color:#fff; border:0; border-radius:9px;
                   padding:12px 14px; font:inherit; font-size:15px; font-weight:550; cursor:pointer; }
  button.primary:hover { background:#0a4880; }
  .error { background:#fdecec; color:#a4262c; padding:11px 13px; border-radius:9px; margin-bottom:16px; font-size:14px; }

  /* The chooser. Two cards, and it must stay obvious which is which — they are
     different legal procedures, not two views of one list. */
  .choices { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px; margin-top:4px; }
  .choice { display:block; border:1px solid var(--line); border-radius:var(--radius); padding:20px;
            color:var(--ink); background:#fff; transition:border-color .12s, box-shadow .12s, transform .12s; }
  .choice:hover { border-color:var(--accent); box-shadow:0 10px 26px rgba(11,83,148,.14);
                  text-decoration:none; transform:translateY(-2px); }
  .choice .head { display:flex; align-items:center; gap:11px; margin-bottom:9px; }
  .choice .head b { font-size:16.5px; font-weight:650; }
  .choice .ico { width:38px; height:38px; border-radius:10px; background:var(--accent-soft); color:var(--accent);
                 display:flex; align-items:center; justify-content:center; flex:none; }
  .choice p { margin:0 0 10px; color:var(--muted); font-size:13.5px; }
  .choice .rule { font-size:12px; color:var(--accent); background:var(--accent-soft);
                  border-radius:999px; padding:3px 10px; display:inline-block; }

  /* What each space actually does. A list rather than a paragraph: somebody
     deciding which of two doors to open is scanning, not reading. */
  .choice .does { margin:0 0 12px; padding:0 0 0 17px; color:var(--muted); font-size:12.5px; line-height:1.7; }
  .choice .does li { margin:0; }
  .note { display:flex; gap:9px; align-items:flex-start; margin:22px 0 0; padding:13px 15px;
          background:var(--accent-soft); border-radius:10px; color:#123a63; font-size:13px; }
  .note .ic { margin-top:2px; color:var(--accent); }
  header.top .whoami { color:#cfe0f2; font-size:13px; }
  /* The service switcher. Two entries today; it is a row of links rather than
     a dropdown because with two it would be a dropdown you always open. */
  .tabs { display:flex; gap:6px; flex-wrap:wrap; margin:0 0 18px; }
  .tabs a { padding:8px 13px; border-radius:9px; background:rgba(255,255,255,.10); color:#dbe7f5;
            border:1px solid rgba(255,255,255,.16); font-size:13.5px; }
  .tabs a:hover { background:rgba(255,255,255,.18); text-decoration:none; }
  .tabs a.on { background:#fff; color:var(--accent); border-color:#fff; font-weight:600; }
  .screens { display:flex; gap:6px; flex-wrap:wrap; margin:0 0 18px; border-bottom:1px solid var(--line); padding-bottom:14px; }
  .screens a { padding:7px 12px; border-radius:8px; color:var(--muted); font-size:13.5px; }
  .screens a:hover { background:var(--accent-soft); text-decoration:none; }
  .screens a.on { background:var(--accent-soft); color:var(--accent); font-weight:600; }
  table { width:100%; border-collapse:collapse; font-size:13.5px; }
  th, td { text-align:start; padding:9px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { background:#f2f5f9; font-weight:600; font-size:12px; color:#43506a; white-space:nowrap; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
  .tile { border:1px solid var(--line); border-radius:10px; padding:14px 15px; }
  .tile b { display:block; font-size:22px; font-weight:650; letter-spacing:-.01em; }
  .tile span { display:block; color:var(--muted); font-size:11.5px; text-transform:uppercase; letter-spacing:.05em; margin-top:3px; }
  .pill { display:inline-flex; align-items:center; gap:5px; padding:2px 9px; border-radius:999px; font-size:11.5px; background:var(--accent-soft); color:var(--accent); }
  .pill.ok { background:#e7f5ec; color:#116b3a; }
  .pill.warn { background:#fdf1e4; color:#9a4a06; }
  .pill.bad { background:#fdeaea; color:#a4262c; }
  .down { background:#fdeaea; color:#a4262c; padding:11px 13px; border-radius:9px; margin-bottom:16px; font-size:13.5px; }
  .ltr { direction:ltr; unicode-bidi:isolate; }
  .muted { color:var(--muted); }
  .notice { background:#e7f5ec; color:#116b3a; padding:10px 12px; border-radius:9px; margin-bottom:16px; }
  .row-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:16px; }
  button.small { width:auto; padding:8px 13px; font-size:13.5px; }
  .foot { margin-top:26px; padding-top:16px; border-top:1px solid var(--line); color:var(--muted); font-size:12.5px; }
  .who { color:var(--muted); font-size:13px; margin:0 0 18px; }
  .who b { color:var(--ink); }
  footer.bottom { color:#9db4cd; font-size:12.5px; text-align:center; padding:0 20px 26px; }
  footer.bottom a { color:#cfe0f2; }
  @media (max-width:560px) { .panel { padding:24px 20px; } h1 { font-size:21px; } }
</style>
</head>
<body>
<header class="top">
  <span class="brand">
    <%- include('icon', { name: 'shield-check', size: 22 }) %>
    <span>CivicTrust<small>Administration</small></span>
  </span>
  <span class="spacer"></span>
  <% if (typeof user !== 'undefined' && user) { %>
    <a class="btn-ghost" href="<%= config.auth.portalUrl %>">Portail</a>
    <span class="whoami"><%= user.fullName || user.email %></span>
  <% } %>
</header>
<main><div class="sheet">
