{
  "name": "skincraft-vps",
  "version": "1.0.0",
  "description": "SkinCraft for Roblox \u2014 catalogue API and admin panel",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "create-admin": "node src/db/create-admin.js",
    "backfill-colors": "node src/db/backfill-colors.js",
    "regenerate-previews": "node src/db/regenerate-previews.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
