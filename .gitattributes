# Shell scripts run on Linux. A CRLF shebang fails with "bad interpreter",
# which reads as a missing file rather than a line-ending problem — this has
# cost real debugging time, so it is pinned rather than left to autocrlf.
*.sh        text eol=lf
*.service   text eol=lf
manifest    text eol=lf

# Served verbatim to browsers; no reason to differ per checkout.
*.css       text eol=lf
*.js        text eol=lf
*.sql       text eol=lf
