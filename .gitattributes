# Shell scripts run on Linux. A CRLF shebang fails with "bad interpreter",
# which reads as a missing file rather than a line-ending problem.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
manifest    text eol=lf

*.css       text eol=lf
*.js        text eol=lf
*.sql       text eol=lf
