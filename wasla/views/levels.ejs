<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'Levels', subheading: 'Published levels reach the app in this order' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body">
          <form method="post" action="/admin/levels" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-kd" type="submit">
              <i data-lucide="plus" width="15" height="15" class="me-1"></i>Add level <%= levels.length + 1 %>
            </button>
            <span class="small kd-faint">Levels have no names: they are numbered in the order below. A new level goes at the end, as a draft.</span>
          </form>
        </div>
      </div>

      <%# One question from each ticked category, only from questions no level uses. %>
      <% if (categories.length >= minCategories) { %>
        <form class="ad-card mb-3" method="post" action="/admin/levels/generate" data-generator>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="ad-card-head d-flex align-items-center gap-2">
            <i data-lucide="wand-sparkles" width="16" height="16"></i>
            <span class="fw-semibold">Generate levels</span>
            <span class="small kd-faint ms-auto">One question from each category you tick</span>
          </div>
          <div class="ad-card-body d-grid gap-3">
            <div>
              <div class="ad-section-label">Categories</div>
              <div class="wz-generate-categories">
                <% categories.forEach((c) => { %>
                  <label class="wz-generate-category">
                    <input class="form-check-input" type="checkbox" name="categories" value="<%= c.name %>"
                           data-generator-category
                           data-free-any="<%= c.total %>" data-free-easy="<%= c.easy %>"
                           data-free-medium="<%= c.medium %>" data-free-hard="<%= c.hard %>">
                    <span class="wz-ar"><%= c.name %></span>
                    <span class="kd-tag" data-generator-free><%= c.total %></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <div class="d-flex flex-wrap align-items-end gap-3">
              <label class="wz-generate-field">
                <span class="ad-section-label">Difficulty</span>
                <select class="form-select form-select-sm" name="difficulty" data-generator-difficulty>
                  <option value="">Any</option>
                  <% difficulties.forEach((d) => { %><option value="<%= d %>"><%= d[0].toUpperCase() + d.slice(1) %></option><% }) %>
                </select>
              </label>
              <label class="wz-generate-field">
                <span class="ad-section-label">How many levels</span>
                <input class="form-control form-control-sm" type="number" name="count" value="5" min="1" max="20">
              </label>
              <label class="form-check mb-1">
                <input class="form-check-input" type="checkbox" name="publish" value="1">
                <span class="form-check-label">Publish straight away</span>
              </label>
              <button class="btn btn-kd ms-auto" type="submit">
                <i data-lucide="wand-sparkles" width="15" height="15" class="me-1"></i>Generate
              </button>
            </div>
            <p class="small kd-faint m-0">
              Each level takes one free question from every ticked category, and only words that cross are kept.
              A question already in a level is never reused. The number beside a category is how many it has free.
            </p>
          </div>
        </form>
      <% } %>

      <% if (levels.length > 1) { %>
        <form method="post" action="/admin/levels/order-by-difficulty" class="d-flex flex-wrap align-items-center gap-2 mb-3"
              data-confirm="Reorder all levels by difficulty? Easy levels move first, then medium, then hard; within each, levels with fewer words come first. This changes the level numbers players see.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-kd-outline" type="submit">
            <i data-lucide="arrow-up-down" width="14" height="14" class="me-1"></i>Order by difficulty
          </button>
          <span class="small kd-faint">All levels: easy → medium → hard, then fewer words, then the current order.</span>
        </form>
      <% } %>

      <% if (!levels.length) { %>
        <div class="ad-card ad-empty">
          <i data-lucide="grid-3x3"></i>
          <p class="mb-0">No levels yet.</p>
        </div>
      <% } else { %>
        <div class="ad-card">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th>Level</th><th>In the app</th><th>Difficulty</th><th>Words</th><th>Grid</th><th>State</th><th>Order</th><th></th></tr></thead>
              <tbody>
                <% levels.forEach((l, i) => { %>
                  <tr>
                    <td><a class="fw-semibold text-nowrap" href="/admin/levels/<%= l.id %>">Level <%= l.number %></a></td>
                    <td class="kd-faint text-nowrap"><% if (!l.published) { %>—<% } else if (l.publishedNumber !== l.number) { %><span class="kd-tag" title="Drafts before it are skipped in the app">Level <%= l.publishedNumber %></span><% } else { %>same<% } %></td>
                    <td><%- include('partials/difficulty', { difficulty: l.difficulty }) %></td>
                    <td><%= l.wordCount %><% if (l.unplacedCount) { %> <span class="kd-tag kd-tag-warn"><%= l.unplacedCount %> not crossing</span><% } %></td>
                    <td class="kd-faint"><%= l.rows %> × <%= l.cols %></td>
                    <td><span class="ad-status <%= l.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= l.published ? 'Published' : 'Draft' %></span></td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <% [['up', 'arrow-up', i === 0], ['down', 'arrow-down', i === levels.length - 1]].forEach(([dir, glyph, disabled]) => { %>
                          <form method="post" action="/admin/levels/<%= l.id %>/move" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="direction" value="<%= dir %>">
                            <button class="btn btn-sm btn-kd-ghost" type="submit" <%= disabled ? 'disabled' : '' %> aria-label="Move <%= dir %>">
                              <i data-lucide="<%= glyph %>" width="14" height="14"></i>
                            </button>
                          </form>
                        <% }) %>
                      </div>
                    </td>
                    <td class="text-end text-nowrap"><a class="btn btn-sm btn-kd-ghost" href="/admin/levels/<%= l.id %>/preview" aria-label="Preview level <%= l.number %>"><i data-lucide="smartphone" width="14" height="14" class="me-1"></i>Preview</a> <a class="btn btn-sm btn-kd-outline" href="/admin/levels/<%= l.id %>">Open</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%# wasla.js holds the generator's difficulty counts. %>
<script src="/assets/js/wasla.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
