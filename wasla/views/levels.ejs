<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الألغاز', subheading: 'الألغاز المنشورة تصل إلى التطبيق بهذا الترتيب' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body">
          <form method="post" action="/admin/levels" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-kd" type="submit">
              <span class="me-1"><%- icon('plus', 15) %></span>أضف اللغز <%= levels.length + 1 %>
            </button>
            <span class="small kd-faint">الألغاز بلا أسماء: تُرقَّم بالترتيب أدناه. اللغز الجديد يُضاف في النهاية كمسودة.</span>
          </form>
        </div>
      </div>

      <%# Ten questions a level, categories drawn at random, معلومات عامة twice. %>
      <% if (categories.length >= minCategories) { %>
        <form class="ad-card mb-3" method="post" action="/admin/levels/generate" data-generator>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="ad-card-head d-flex align-items-center gap-2">
            <%- icon('wand-sparkles', 16) %>
            <span class="fw-semibold">توليد ألغاز</span>
            <span class="small kd-faint ms-auto">الفئات تُسحب عشوائياً، <span class="wz-ar"><%= mainCategory %></span> مرتين في كل لغز</span>
          </div>
          <div class="ad-card-body d-grid gap-3">
            <div>
              <div class="ad-section-label d-flex align-items-center gap-2">
                <span>الفئات المسموح السحب منها</span>
                <span class="small kd-faint">اترك الكل دون تحديد لاستعمالها جميعاً</span>
                <button class="btn btn-kd-ghost btn-sm ms-auto" type="button" data-generator-all>
                  تحديد الكل <span class="wz-category-count" data-generator-all-count><%= categories.length %></span></button>
                <button class="btn btn-kd-ghost btn-sm" type="button" data-generator-clear>إلغاء</button>
              </div>
              <div class="wz-generate-categories">
                <% categories.forEach((c) => { %>
                  <label class="wz-generate-category">
                    <input class="form-check-input" type="checkbox" name="categories" value="<%= c.name %>"
                           data-generator-category
                           data-free-any="<%= c.total %>" data-free-easy="<%= c.easy %>"
                           data-free-medium="<%= c.medium %>" data-free-hard="<%= c.hard %>">
                    <span class="wz-ar"><%= c.name %></span>
                    <span class="kd-tag" data-generator-free><%= c.total %></span>
                  </label>
                <% }) %>
              </div>
            </div>
            <div class="d-flex flex-wrap align-items-end gap-3">
              <%# Every field here is a label over one row of controls, so they
                  all line up on the same baseline. The notes go under the row. %>
              <div class="wz-generate-field">
                <span class="ad-section-label">الصعوبة</span>
                <%# Tick as many as you like: the run is split between them, in
                    this order. None ticked is all three, as it always was. %>
                <div class="wz-grades">
                  <% difficulties.forEach((d) => { %>
                    <label class="wz-grade">
                      <input class="form-check-input" type="checkbox" name="difficulty" value="<%= d %>" data-generator-difficulty>
                      <span><%= { easy: 'سهل', medium: 'متوسط', hard: 'صعب' }[d] || d %></span>
                    </label>
                  <% }) %>
                </div>
              </div>

              <%# Or: every level holds all three grades at once. The toggle is a
                  chip beside the amounts, so the whole row is one height. %>
              <div class="wz-generate-field" data-mix>
                <span class="ad-section-label">الخلط داخل كل لغز</span>
                <div class="wz-grades">
                  <label class="wz-grade" for="mixMode">
                    <input class="form-check-input" type="checkbox" id="mixMode" name="mixMode" value="1" data-mix-toggle>
                    <span>اخلط</span>
                  </label>
                  <span class="wz-grades" data-mix-fields>
                    <% [['easy', 'سهل', 4], ['medium', 'متوسط', 3], ['hard', 'صعب', 3]].forEach(([key, label, value]) => { %>
                      <label class="wz-grade">
                        <span><%= label %></span>
                        <input class="wz-mix-count" type="number" name="mix_<%= key %>"
                               value="<%= value %>" min="0" max="<%= maxLevelSize %>" data-mix-count
                               aria-label="عدد أسئلة <%= label %> في اللغز">
                      </label>
                    <% }) %>
                  </span>
                </div>
              </div>
              <label class="wz-generate-field">
                <span class="ad-section-label">كم لغزاً</span>
                <input class="wz-generate-num" type="number" name="count" value="10" min="1" max="<%= maxGenerated %>">
              </label>
              <label class="wz-generate-field">
                <span class="ad-section-label">أسئلة في اللغز</span>
                <input class="wz-generate-num" type="number" name="size" value="<%= levelSize %>"
                       min="<%= minCategories %>" max="<%= maxLevelSize %>">
              </label>
              <label class="form-check mb-1">
                <input class="form-check-input" type="checkbox" name="publish" value="1">
                <span class="form-check-label">انشر مباشرة</span>
              </label>
              <button class="btn btn-kd ms-auto" type="submit">
                <span class="me-1"><%- icon('wand-sparkles', 15) %></span>ولّد
              </button>
            </div>
            <div class="d-flex flex-wrap gap-3 small kd-faint">
              <span data-generator-grades>الكل — سهل ثم متوسط ثم صعب</span>
              <span data-mix-total>المجموع يجب أن يساوي عدد أسئلة اللغز</span>
            </div>
            <p class="small kd-faint m-0">
              يأخذ كل لغز <%= mainSlots %> أسئلة من <span class="wz-ar"><%= mainCategory %></span> والباقي
              من فئات تُسحب عشوائياً، فلا يتشابه لغزان في خليطهما. ولا تُحفظ إلا الكلمات التي تتقاطع،
              ولا يُعاد استعمال سؤال في لغز آخر. والرقم بجانب الفئة هو ما تبقّى فيها حرّاً.
            </p>
          </div>
        </form>
      <% } %>

      <% if (levels.length > 1) { %>
        <form method="post" action="/admin/levels/order-by-difficulty" class="d-flex flex-wrap align-items-center gap-2 mb-3"
              data-confirm="إعادة ترتيب كل الألغاز حسب الصعوبة؟ السهلة أولاً ثم المتوسطة ثم الصعبة، وداخل كل مجموعة الأقل كلمات أولاً. هذا يغيّر أرقام الألغاز التي يراها اللاعبون.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-kd-outline" type="submit">
            <span class="me-1"><%- icon('arrow-up-down', 14) %></span>رتّب حسب الصعوبة
          </button>
          <span class="small kd-faint">كل الألغاز: سهل ← متوسط ← صعب، ثم الأقل كلمات، ثم الترتيب الحالي.</span>
        </form>
      <% } %>

      <% if (!levels.length) { %>
        <div class="ad-card ad-empty">
          <%- icon('grid-3x3', 28) %>
          <p class="mb-0">لا ألغاز بعد.</p>
        </div>
      <% } else { %>
        <%# Tick levels in the table, then act on all of them at once. %>
        <form id="levelBulk" class="ad-card wz-bulk mb-3" method="post" action="/admin/levels/bulk" data-level-bulk>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <strong class="small me-1"><span data-bulk-count>0</span> محدَّد</strong>
            <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="publish" data-bulk-button>
              <span class="me-1"><%- icon('upload', 14) %></span>نشر</button>
            <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="unpublish" data-bulk-button>
              <span class="me-1"><%- icon('download', 14) %></span>إلغاء النشر</button>
            <div class="wz-bulk-group">
              <select class="form-select form-select-sm wz-bulk-field" name="difficulty" aria-label="الصعوبة">
                <% difficulties.forEach((d) => { %><option value="<%= d %>"><%= { easy: 'سهل', medium: 'متوسط', hard: 'صعب' }[d] || d %></option><% }) %>
              </select>
              <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="difficulty" data-bulk-button>
                <span class="me-1"><%- icon('gauge', 14) %></span>تعيين الصعوبة</button>
            </div>
            <button class="btn btn-kd-danger btn-sm" type="submit" name="action" value="delete" data-bulk-button
                    data-bulk-delete-button data-bulk-delete-ask="حذف %n لغزاً؟ تبقى أسئلتها في البنك.">
              <span class="me-1"><%- icon('trash-2', 14) %></span>حذف</button>
            <button class="btn btn-kd-ghost btn-sm ms-auto" type="button" data-bulk-select-all>
              تحديد الكل <span class="wz-category-count"><%= levels.length %></span></button>
            <button class="btn btn-kd-ghost btn-sm" type="button" data-bulk-clear>إلغاء</button>
          </div>
        </form>
        <div class="ad-card">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th class="wz-check"><input class="form-check-input" type="checkbox" data-bulk-all aria-label="تحديد الكل"></th><th>اللغز</th><th>في التطبيق</th><th>الصعوبة</th><th>الكلمات</th><th>الشبكة</th><th>الحالة</th><th>الترتيب</th><th></th></tr></thead>
              <tbody>
                <% levels.forEach((l, i) => { %>
                  <tr>
                    <td><input class="form-check-input" type="checkbox" name="ids" value="<%= l.id %>" form="levelBulk"
                               data-bulk-row aria-label="تحديد اللغز <%= l.number %>"></td>
                    <td><a class="fw-semibold text-nowrap" href="/admin/levels/<%= l.id %>">اللغز <%= l.number %></a></td>
                    <td class="kd-faint text-nowrap"><% if (!l.published) { %>—<% } else if (l.publishedNumber !== l.number) { %><span class="kd-tag" title="المسودات قبله تُتخطى في التطبيق">اللغز <%= l.publishedNumber %></span><% } else { %>نفسه<% } %></td>
                    <td><%- include('partials/difficulty', { difficulty: l.difficulty }) %></td>
                    <td><%= l.wordCount %><% if (l.unplacedCount) { %> <span class="kd-tag kd-tag-warn"><%= l.unplacedCount %> بلا تقاطع</span><% } %></td>
                    <td class="kd-faint"><%= l.rows %> × <%= l.cols %></td>
                    <td><span class="ad-status <%= l.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= l.published ? 'منشور' : 'مسودة' %></span></td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <% [['up', 'arrow-up', i === 0], ['down', 'arrow-down', i === levels.length - 1]].forEach(([dir, glyph, disabled]) => { %>
                          <form method="post" action="/admin/levels/<%= l.id %>/move" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="direction" value="<%= dir %>">
                            <button class="btn btn-sm btn-kd-ghost" type="submit" <%= disabled ? 'disabled' : '' %> aria-label="نقل <%= dir %>">
                              <%- icon(glyph, 14) %>
                            </button>
                          </form>
                        <% }) %>
                      </div>
                    </td>
                    <td class="text-end text-nowrap"><a class="btn btn-sm btn-kd-ghost" href="/admin/levels/<%= l.id %>/preview" aria-label="معاينة اللغز <%= l.number %>"><span class="me-1"><%- icon('smartphone', 14) %></span>معاينة</a> <a class="btn btn-sm btn-kd-outline" href="/admin/levels/<%= l.id %>">فتح</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%# wasla.js holds the generator's difficulty counts. %>
<script src="/assets/js/wasla.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
