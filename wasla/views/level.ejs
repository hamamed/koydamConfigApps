<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: level.title,
          subheading: (level.published ? 'Level ' + number + ' in the app' : 'Draft — not in the app') + ' · ' + level.words.length + ' words · ' + level.rows + ' × ' + level.cols
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body d-flex flex-wrap gap-2 align-items-end">
          <form method="post" action="/admin/levels/<%= level.id %>/title" class="d-flex gap-2 align-items-end flex-grow-1">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="flex-grow-1">
              <label class="form-label small fw-semibold" for="title">Title</label>
              <input class="form-control wz-ar" id="title" name="title" dir="rtl" value="<%= level.title %>" maxlength="80" required>
            </div>
            <button class="btn btn-kd-accent" type="submit">Save</button>
          </form>

          <form method="post" action="/admin/levels/<%= level.id %>/details" class="d-flex gap-2 align-items-end m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
              <label class="form-label small fw-semibold" for="packId">Pack</label>
              <select class="form-select" id="packId" name="packId">
                <option value="">عام — general</option>
                <% packs.forEach((p) => { %>
                  <option value="<%= p.id %>" <%= level.packId === p.id ? 'selected' : '' %>><%= p.title %> — <%= p.slug %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="form-label small fw-semibold" for="difficulty">Difficulty</label>
              <select class="form-select" id="difficulty" name="difficulty">
                <% difficulties.forEach((d) => { %>
                  <option value="<%= d %>" <%= level.difficulty === d ? 'selected' : '' %>><%= d[0].toUpperCase() + d.slice(1) %></option>
                <% }) %>
              </select>
            </div>
            <button class="btn btn-kd-accent" type="submit">Save</button>
          </form>

          <span class="ad-status <%= level.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= level.published ? 'Published' : 'Draft' %></span>

          <form method="post" action="/admin/levels/<%= level.id %>/shuffle" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-kd-outline" type="submit" <%= level.words.length < 2 ? 'disabled' : '' %>>
              <i data-lucide="shuffle" width="15" height="15" class="me-1"></i>Shuffle grid
            </button>
          </form>

          <form method="post" action="/admin/levels/<%= level.id %>/publish" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="published" value="<%= level.published ? '0' : '1' %>">
            <button class="btn <%= level.published ? 'btn-kd-outline' : 'btn-kd' %>" type="submit">
              <%= level.published ? 'Unpublish' : 'Publish' %>
            </button>
          </form>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-xl-7">
          <div class="ad-card mb-3">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="grid-3x3" width="16" height="16"></i>
              <span class="fw-semibold">Grid preview</span>
              <span class="kd-faint small ms-auto">as the app draws it — right to left</span>
            </div>
            <div class="ad-card-body">
              <% if (!level.words.length) { %>
                <div class="ad-empty">
                  <i data-lucide="grid-3x3"></i>
                  <p class="mb-0">Pick at least two questions that share letters, then build the grid.</p>
                </div>
              <% } else { %>
                <div class="wz-board">
                  <div class="wz-grid" style="--wz-rows: <%= level.rows %>; --wz-cols: <%= level.cols %>">
                    <% cells.forEach((cell) => { %>
                      <span class="wz-cell" style="grid-row: <%= cell.row + 1 %>; grid-column: <%= cell.col + 1 %>">
                        <% if (cell.starts.length) { %><small><%= cell.starts.join('/') %></small><% } %><%= cell.letter %>
                      </span>
                    <% }) %>
                  </div>
                </div>
              <% } %>

              <% if (level.unplaced.length) { %>
                <div class="alert alert-warning mt-3 mb-0 small">
                  These words share no letter with the rest of the grid, so the level cannot be published:
                  <% level.unplaced.forEach((w) => { %><span class="kd-tag wz-answer"><%= w.answer %></span> <% }) %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="list" width="16" height="16"></i>
              <span class="fw-semibold me-auto">Clues</span>
            </div>
            <div class="ad-card-body p-0">
              <div class="ad-table-wrap">
                <table class="ad-table">
                  <tbody>
                    <% level.words.forEach((w, i) => { %>
                      <tr>
                        <td class="kd-faint"><%= i + 1 %></td>
                        <td><%- include('partials/qimage', { q: w, size: 'sm' }) %></td>
                        <td><span class="wz-answer"><%= w.answer %></span><% if (w.playAnswer !== w.answer) { %> <span class="kd-faint small">→ <span class="wz-answer"><%= w.playAnswer %></span></span><% } %></td>
                        <td class="wz-ar"><%= w.clue %></td>
                        <td class="kd-faint small text-nowrap"><%= w.direction === 'across' ? 'Across ←' : 'Down ↓' %></td>
                        <td class="text-end"><a class="btn btn-sm btn-kd-ghost" href="/admin/questions/<%= w.id %>">Edit</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-5">
          <form class="ad-card" method="post" action="/admin/levels/<%= level.id %>/words" data-picker>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="list-checks" width="16" height="16"></i>
              <span class="fw-semibold">Questions in this level</span>
              <span class="kd-tag kd-tag-accent ms-auto" data-picker-count><%= chosen.size %></span>
            </div>
            <div class="ad-card-body d-grid gap-2">
              <div class="d-flex gap-2">
                <input class="form-control form-control-sm" type="search" placeholder="Filter" dir="auto" data-picker-filter>
                <a class="btn btn-sm btn-kd-outline text-nowrap" href="/admin/questions/new?level=<%= level.id %>">New question</a>
              </div>
              <div class="wz-picker">
                <% if (!questions.length) { %>
                  <p class="kd-faint small m-0">No questions in the bank yet.</p>
                <% } %>
                <% questions.forEach((q) => { %>
                  <label class="wz-pick" data-picker-item data-text="<%= q.answer %> <%= q.clue %> <%= q.category %>">
                    <input class="form-check-input" type="checkbox" name="questions" value="<%= q.id %>" <%= chosen.has(q.id) ? 'checked' : '' %>>
                    <%- include('partials/qimage', { q, size: 'xs' }) %>
                    <span class="min-w-0">
                      <span class="wz-answer d-block"><%= q.answer %></span>
                      <span class="wz-ar small kd-faint d-block text-truncate"><%= q.clue %></span>
                    </span>
                    <% if (q.levelCount && !chosen.has(q.id)) { %><span class="kd-tag ms-auto">in <%= q.levelCount %></span><% } %>
                  </label>
                <% }) %>
              </div>
              <button class="btn btn-kd-accent" type="submit">Save and build grid</button>
            </div>
          </form>

          <form method="post" action="/admin/levels/<%= level.id %>/delete" class="mt-3"
                onsubmit="return confirm('Delete this level? Its questions stay in the bank.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-kd-danger" type="submit">Delete level</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/assets/js/wasla.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
