<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'اللغز ' + level.number,
          subheading: (level.published ? 'اللغز ' + level.publishedNumber + ' في التطبيق' : 'مسودة — ليست في التطبيق') + ' · ' + level.words.length + ' كلمة · ' + level.rows + ' × ' + level.cols
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body d-flex flex-wrap gap-2 align-items-end">
          <form method="post" action="/admin/levels/<%= level.id %>/details" class="d-flex gap-2 align-items-end m-0 me-auto">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div>
              <label class="form-label small fw-semibold" for="difficulty">الصعوبة</label>
              <select class="form-select" id="difficulty" name="difficulty">
                <% difficulties.forEach((d) => { %>
                  <option value="<%= d %>" <%= level.difficulty === d ? 'selected' : '' %>><%= { easy: 'سهل', medium: 'متوسط', hard: 'صعب' }[d] || d %></option>
                <% }) %>
              </select>
            </div>
            <button class="btn btn-kd-accent" type="submit">حفظ</button>
          </form>

          <span class="ad-status <%= level.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= level.published ? 'Published' : 'Draft' %></span>

          <a class="btn btn-kd-outline <%= level.words.length ? '' : 'disabled' %>" href="/admin/levels/<%= level.id %>/preview">
            <span class="me-1"><%- icon('smartphone', 15) %></span>معاينة
          </a>

          <form method="post" action="/admin/levels/<%= level.id %>/shuffle" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-kd-outline" type="submit" <%= level.words.length < 2 ? 'disabled' : '' %>>
              <span class="me-1"><%- icon('shuffle', 15) %></span>إعادة ترتيب الشبكة
            </button>
          </form>

          <form method="post" action="/admin/levels/<%= level.id %>/publish" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="published" value="<%= level.published ? '0' : '1' %>">
            <button class="btn <%= level.published ? 'btn-kd-outline' : 'btn-kd' %>" type="submit">
              <%= level.published ? 'Unpublish' : 'Publish' %>
            </button>
          </form>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-xl-7">
          <div class="ad-card mb-3">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('grid-3x3', 16) %>
              <span class="fw-semibold">معاينة الشبكة</span>
              <span class="kd-faint small ms-auto">كما يرسمها التطبيق — من اليمين إلى اليسار</span>
            </div>
            <div class="ad-card-body">
              <% if (!level.words.length) { %>
                <div class="ad-empty">
                  <%- icon('grid-3x3', 28) %>
                  <p class="mb-0">اختر سؤالين على الأقل تشترك أجوبتهما في حرف، ثم ابنِ الشبكة.</p>
                </div>
              <% } else { %>
                <div class="wz-board">
                  <div class="wz-grid" style="--wz-rows: <%= level.rows %>; --wz-cols: <%= level.cols %>">
                    <% cells.forEach((cell) => { %>
                      <span class="wz-cell" style="grid-row: <%= cell.row + 1 %>; grid-column: <%= cell.col + 1 %>">
                        <% if (cell.starts.length) { %><small><%= cell.starts.join('/') %></small><% } %><%= cell.letter %>
                      </span>
                    <% }) %>
                  </div>
                </div>
              <% } %>

              <% if (level.unplaced.length) { %>
                <div class="alert alert-warning mt-3 mb-0 small">
                  هذه الكلمات لا تشترك بحرف مع بقية الشبكة، فلا يمكن نشر اللغز:
                  <% level.unplaced.forEach((w) => { %><span class="kd-tag wz-answer"><%= w.answer %></span> <% }) %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('list', 16) %>
              <span class="fw-semibold me-auto">الأدلة</span>
            </div>
            <div class="ad-card-body p-0">
              <div class="ad-table-wrap">
                <table class="ad-table">
                  <tbody>
                    <% level.words.forEach((w, i) => { %>
                      <tr>
                        <td class="kd-faint"><%= i + 1 %></td>
                        <td><%- include('partials/qimage', { q: w, size: 'sm' }) %></td>
                        <td><% if (w.title) { %><span class="kd-tag wz-ar"><%= w.title %></span><% } %></td>
                        <td><span class="wz-answer"><%= w.answer %></span><% if (w.playAnswer !== w.answer) { %> <span class="kd-faint small">→ <span class="wz-answer"><%= w.playAnswer %></span></span><% } %></td>
                        <td class="wz-ar"><%= w.clue %></td>
                        <td class="kd-faint small text-nowrap"><%= w.direction === 'across' ? 'Across ←' : 'Down ↓' %></td>
                        <td class="text-end"><a class="btn btn-sm btn-kd-ghost" href="/admin/questions/<%= w.id %>">تعديل</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-5">
          <form class="ad-card" method="post" action="/admin/levels/<%= level.id %>/words" data-picker>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('list-checks', 16) %>
              <span class="fw-semibold">الأسئلة</span>
              <span class="kd-tag kd-tag-accent ms-auto" data-picker-count><%= chosen.size %></span>
            </div>
            <div class="ad-card-body d-grid gap-2">
              <div class="d-flex gap-2">
                <input class="form-control form-control-sm" type="search" placeholder="تصفية" dir="auto" data-picker-filter>
                <a class="btn btn-sm btn-kd-outline text-nowrap" href="/admin/questions/new?level=<%= level.id %>">سؤال جديد</a>
              </div>
              <%
                // One chip per category among the questions offered here, biggest first, so a
                // level can be built from one category without reading the whole list.
                const counts = new Map();
                questions.forEach((q) => { if (q.title) counts.set(q.title, (counts.get(q.title) ?? 0) + 1); });
                const categories = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ar'));
              %>
              <% if (categories.length > 1) { %>
                <nav class="wz-categories" data-picker-categories aria-label="الفئات">
                  <button class="btn btn-sm btn-kd" type="button" data-picker-category="" aria-pressed="true">
                    All <span class="wz-category-count"><%= questions.length %></span></button>
                  <% categories.forEach(([name, count]) => { %>
                    <button class="btn btn-sm btn-kd-outline wz-ar" type="button" data-picker-category="<%= name %>" aria-pressed="false">
                      <%= name %> <span class="wz-category-count"><%= count %></span></button>
                  <% }) %>
                </nav>
              <% } %>
              <%
                const pickItem = (q) => { %>
                  <label class="wz-pick" data-picker-item data-title="<%= q.title %>" data-text="<%= q.answer %> <%= q.clue %> <%= q.title %>">
                    <input class="form-check-input" type="checkbox" name="questions" value="<%= q.id %>" <%= chosen.has(q.id) ? 'checked' : '' %>>
                    <%- include('partials/qimage', { q, size: 'xs' }) %>
                    <span class="min-w-0">
                      <span class="d-flex align-items-center gap-2"><span class="wz-answer"><%= q.answer %></span><% if (q.title) { %><span class="kd-tag wz-ar text-truncate"><%= q.title %></span><% } %></span>
                      <span class="wz-ar small kd-faint d-block text-truncate"><%= q.clue || (q.type === 'image' ? 'صورة' : q.type === 'audio' ? 'صوت' : q.type === 'emoji' ? (q.emoji || 'إيموجي') : '') %></span>
                    </span>
                  </label>
              <% };
                const inLevel = questions.filter((q) => chosen.has(q.id));
                const available = questions.filter((q) => !chosen.has(q.id));
              %>
              <div class="wz-picker">
                <div class="wz-pick-group" data-picker-group="in">
                  <div class="ad-section-label d-flex align-items-center">في هذا اللغز <span class="kd-tag ms-auto" data-picker-group-count><%= inLevel.length %></span></div>
                  <p class="kd-faint small m-0 wz-pick-empty" data-picker-empty data-empty-filtered="None from this category — its words are listed below."
                     <%= inLevel.length ? 'hidden' : '' %>>لا شيء بعد — حدّد أسئلة من الأسفل لإضافتها.</p>
                  <% inLevel.forEach(pickItem) %>
                </div>
                <div class="wz-pick-group" data-picker-group="available">
                  <div class="ad-section-label d-flex align-items-center">متاح للإضافة <span class="kd-tag kd-tag-accent ms-auto" data-picker-group-count><%= available.length %></span></div>
                  <p class="kd-faint small m-0 wz-pick-empty" data-picker-empty data-empty-filtered="No free question matches this filter."
                     <%= available.length ? 'hidden' : '' %>>لا أسئلة حرة: كل سؤال داخل لغز. أضف سؤالاً جديداً.</p>
                  <% available.forEach(pickItem) %>
                </div>
                <p class="kd-faint small m-0">الأسئلة المستعملة في ألغاز أخرى لا تظهر هنا.</p>
              </div>
              <button class="btn btn-kd-accent" type="submit">احفظ وابنِ الشبكة</button>
            </div>
          </form>

          <form method="post" action="/admin/levels/<%= level.id %>/delete" class="mt-3"
                onsubmit="return confirm('Delete this level? Its questions stay in the bank.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-kd-danger" type="submit">حذف اللغز</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/assets/js/wasla.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
