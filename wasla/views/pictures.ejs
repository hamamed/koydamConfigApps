<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'صور فقاعات الكلمات',
          subheading: counts.published + ' من ' + counts.total + ' صورة منشورة · كل صورة ومعها من ' + min + ' إلى ' + max + ' كلمات تخصّها، تُقطَّع إلى مقاطع',
          actions: '<a class="btn btn-kd btn-sm" href="/admin/pictures/new">صورة جديدة</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <% if (groups.length > 1) { %>
        <div class="ad-card mb-3">
          <div class="ad-card-body d-flex flex-wrap gap-2">
            <a class="kd-tag <%= chosen ? '' : 'kd-tag-accent' %>" href="/admin/pictures">الكل (<%= counts.total %>)</a>
            <% groups.forEach((g) => { %>
              <a class="kd-tag <%= chosen === g.name ? 'kd-tag-accent' : '' %> wz-ar"
                 href="/admin/pictures?category=<%= encodeURIComponent(g.name) %>"><%= g.name || 'بلا تصنيف' %> (<%= g.total %>)</a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (!rounds.length) { %>
        <div class="ad-card ad-empty">
          <%- icon('image', 28) %>
          <p class="mb-2">لا صور بعد — فقاعات الكلمات تأخذ موضوعاً من بنك الأسئلة حتى تضيف أول صورة.</p>
          <a class="btn btn-kd btn-sm" href="/admin/pictures/new">صورة جديدة</a>
        </div>
      <% } else { %>
        <div class="ad-card">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th>الصورة</th><th>الاسم</th><th>التصنيف</th><th>كلماتها</th><th>الحالة</th><th></th></tr></thead>
              <tbody>
                <% rounds.forEach((r) => { %>
                  <tr>
                    <td><%- include('partials/qimage', { q: r, size: 'sm' }) %></td>
                    <td><span class="wz-answer"><%= r.title %></span></td>
                    <td class="wz-ar text-nowrap"><% if (r.category) { %><span class="kd-tag"><%= r.category %></span><% } else { %><span class="kd-muted small">—</span><% } %></td>
                    <td class="wz-ar"><%= r.words.join('، ') %></td>
                    <td class="text-nowrap">
                      <span class="ad-status <%= r.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= r.published ? 'منشورة' : 'مسودة' %></span>
                    </td>
                    <td class="text-end text-nowrap">
                      <form class="d-inline m-0" method="post" action="/admin/pictures/<%= r.id %>/published">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="published" value="<%= r.published ? '0' : '1' %>">
                        <button class="btn btn-sm btn-kd-outline" type="submit"><%= r.published ? 'إخفاء' : 'نشر' %></button>
                      </form>
                      <a class="btn btn-sm btn-kd-ghost" href="/admin/pictures/<%= r.id %>">تعديل</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
