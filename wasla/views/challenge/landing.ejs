<%- include('_head') %>
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="<%= url %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="شبّك">
  <meta property="og:locale" content="ar_AR">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= url %>">
  <meta property="og:image" content="<%= image %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= image %>">
</head>
<body class="wz-challenge-body">
  <main class="wz-challenge">
    <div class="wz-challenge-brand">
      <img src="/assets/logo/logo.png" alt="" width="40" height="46">
      <span>شبّك</span>
    </div>

    <section class="wz-challenge-card">
      <p class="wz-challenge-kicker">تحداك صديق</p>
      <h1 class="wz-challenge-title">لغز رقم <%= level %></h1>

      <% if (time !== null || stars !== null) { %>
        <div class="wz-challenge-score">
          <% if (time !== null) { %>
            <div class="wz-challenge-stat">
              <span class="wz-challenge-stat-value" dir="ltr"><%= time %></span>
              <span class="wz-challenge-stat-label">وقت صديقك</span>
            </div>
          <% } %>
          <% if (stars !== null) { %>
            <div class="wz-challenge-stat">
              <span class="wz-challenge-stars" aria-label="<%= stars %> من 3 نجوم">
                <% for (let i = 0; i < 3; i++) { %><span class="wz-challenge-star <%= i < stars ? 'is-earned' : '' %>">★</span><% } %>
              </span>
              <span class="wz-challenge-stat-label">نجوم صديقك</span>
            </div>
          <% } %>
        </div>
      <% } %>

      <p class="wz-challenge-text"><%= time !== null ? 'هل تستطيع حل اللغز أسرع؟' : 'هل تستطيع حل اللغز؟' %></p>

      <div class="wz-challenge-actions">
        <a class="wz-challenge-btn wz-challenge-btn-primary" href="<%= appUrl %>">افتح في شبّك</a>
        <% if (appStoreUrl) { %>
          <a class="wz-challenge-btn wz-challenge-btn-store" href="<%= appStoreUrl %>" rel="noopener">حمّل شبّك من App Store</a>
        <% } %>
      </div>
    </section>

    <footer class="wz-challenge-foot">
      <a href="/privacy">الخصوصية</a> · <a href="/support">الدعم</a>
    </footer>
  </main>
</body>
</html>
