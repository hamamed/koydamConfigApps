<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'يوم \u2066' + date + '\u2069',
          subheading: weekdayAr + ' · ' + (allPlanned ? 'كل شيء مخطَّط' : 'بعض الألعاب تلقائية'),
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/api/v1/daily-games?date=' + date + '" target="_blank" rel="noopener">ألعاب اليوم JSON</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-sm btn-kd-ghost" href="/admin/days"><%- icon('arrow-left', 14) %> التقويم</a>
        <a class="btn btn-sm btn-kd-ghost" href="/admin/days/<%= previous %>">← <%= previous %></a>
        <a class="btn btn-sm btn-kd-ghost" href="/admin/days/<%= next %>"><%= next %> →</a>
        <span class="kd-tag kd-tag-accent wz-ar"><%= weekdayAr %></span>
        <span class="kd-tag kd-tag-ok wz-ar" title="الدرجة الأخيرة من سُلّم هذا اليوم — وهي وحدها التي تُكافئ؛ الباقي للتمرين"><%- icon('star', 12) %> الدرجة الأخيرة: <%= dayKindTitle %></span>
        <% if (event) { %><span class="kd-tag wz-ar" title="مناسبة موسمية: يستعمل البحث موضوعها ما لم يُخطَّط اليوم"><%- icon('moon', 12) %> <%= event %></span><% } %>
        <div class="ms-auto">
          <% if (past) { %>
            <span class="kd-tag">يوم مضى · للعرض فقط</span>
          <% } else if (!allPlanned) { %>
            <form method="post" action="/admin/days/<%= date %>/plan" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-kd" type="submit">خطّط هذا اليوم</button>
            </form>
          <% } else { %>
            <span class="ad-status ad-status-published">مخطَّط</span>
          <% } %>
        </div>
      </div>
      <% if (!past) { %>
        <div class="ad-card mb-3">
          <div class="ad-card-body d-flex flex-wrap align-items-end gap-3">
            <form method="post" action="/admin/days/<%= date %>/copy" class="d-flex flex-wrap align-items-end gap-2 m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div>
                <label class="form-label small mb-1" for="copy-from">انسخ يوماً إلى هنا</label>
                <input class="form-control form-control-sm wz-date" type="date" id="copy-from" name="from" value="<%= previous %>" required>
              </div>
              <button class="btn btn-sm btn-kd-outline" type="submit">انسخ ألعابه</button>
            </form>
            <form method="post" action="/admin/days/<%= date %>/clear" class="ms-auto m-0" data-confirm="إعادة كل ألعاب هذا اليوم إلى التلقائي؟">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-kd-ghost" type="submit"><%- icon('rotate-ccw', 14) %> أعد اليوم تلقائياً</button>
            </form>
          </div>
        </div>
      <% } %>
      <p class="small kd-muted">
        <strong>التلقائية</strong> تتبع أسئلتك وقوائم الكلمات، فقد تتغير إلى أن يُخطَّط اليوم.
        <strong>المخطَّطة</strong> و<strong>المكتوبة</strong> ثابتة: يحصل اللاعبون على ما تراه تماماً. عدّل أي لعبة أدناه — يبدأ الصندوق بما في اليوم الآن.
      </p>

      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
          <%- icon('list-ordered', 16) %>
          <span class="fw-semibold me-auto">سُلّم هذا اليوم</span>
          <span class="small kd-muted">تُلعب بالترتيب، وكل درجة تفتح التي بعدها — والأخيرة هي لعبة اليوم</span>
        </div>
        <div class="ad-card-body">
          <div class="wz-ladder">
            <% ladder.forEach((rung, i) => { %>
              <a class="kd-tag <%= i === ladder.length - 1 ? 'kd-tag-accent' : '' %> wz-ar"
                 href="#<%= rung.kind %>"><%= i + 1 %>. <%= rung.title %></a>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="ad-card mb-3" id="wordsearch">
        <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
          <%- icon('search', 16) %>
          <span class="fw-semibold me-auto"><span class="wz-ar">البحث عن الكلمات</span></span>
          <% if (wordSearch.day) { %>
            <span class="kd-tag <%= wordSearch.day.source === 'custom' ? 'kd-tag-accent' : 'kd-tag-ok' %>"><%= wordSearch.day.source === 'custom' ? 'مكتوب' : 'مخطَّط' %></span>
          <% } else { %>
            <span class="kd-tag">تلقائي</span>
          <% } %>
          <% if (!past) { %><a class="btn btn-sm btn-kd-outline" href="/admin/daily/<%= date %>/edit">تعديل البحث</a><% } %>
        </div>
        <div class="ad-card-body">
          <% if (wordSearch.board) { %>
            <div class="ws-layout">
              <%- include('partials/ws-board', { board: wordSearch.board, compact: true }) %>
              <div class="ws-side">
                <div class="d-flex flex-wrap gap-2">
                  <span class="kd-tag kd-tag-accent wz-ar"><%= wordSearch.board.theme %></span>
                  <span class="kd-tag"><%= wordSearch.board.size %> × <%= wordSearch.board.size %></span>
                  <span class="kd-tag"><%= wordSearch.board.words.length %> كلمات</span>
                </div>
                <p class="wz-ar mt-2 mb-0"><%= wordSearch.board.words.map((w) => w.display).join('، ') %></p>
              </div>
            </div>
          <% } else { %>
            <p class="small kd-muted mb-0">لا شبكة لهذا اليوم: لا موضوع فيه كلمات كافية. <a href="/admin/daily/<%= date %>/edit">اكتب الكلمات بنفسك</a>.</p>
          <% } %>
        </div>
      </div>

      <% if (dayKind === 'marathon') { %>
        <div class="ad-card mb-3">
          <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
            <%- icon('zap', 16) %>
            <span class="fw-semibold me-auto">ماراثون الجمعة</span>
            <% if (marathon) { %><span class="kd-tag kd-tag-accent"><%= marathon.rounds.length %> جولات · <%= marathon.bonus %> عملة</span><% } %>
          </div>
          <div class="ad-card-body">
            <% if (!marathon) { %>
              <p class="small kd-muted mb-0">لا جولات كافية لهذا اليوم: تحتاج لعبتين على الأقل من ألعاب اليوم.</p>
            <% } else { %>
              <p class="small kd-muted mb-2">الجولات نفسها المعروضة أدناه، مختصرة، واحدة تلو الأخرى بساعة واحدة.</p>
              <ol class="wz-marathon mb-0">
                <% marathon.rounds.forEach((r) => { %>
                  <li><span class="wz-ar fw-semibold"><%= kindNames[r.kind] %></span>
                    <span class="small kd-muted wz-ar"><%= r.kind === 'bubbles' ? r.game.words.length + ' كلمات · ' + r.game.theme
                      : r.kind === 'connect' ? r.game.words.length + ' كلمات · ' + r.game.rows.length + '×' + r.game.cols
                      : r.kind === 'wheel' ? r.game.words.length + ' كلمات · ' + [...r.game.letters].join(' ')
                      : r.kind === 'guess' ? r.game.words.map((w) => w.display).join('، ') + ' · ' + r.game.tries + ' محاولات'
                      : r.game.size + '×' + r.game.size + ' · ' + r.game.theme %></span></li>
                <% }) %>
              </ol>
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="row g-3">
        <% games.forEach((g) => { %>
          <div class="col-xl-6" id="<%= g.kind %>">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
                <%- icon(g.label.icon, 16) %>
                <span class="fw-semibold me-auto"><span class="wz-ar"><%= g.label.ar %></span>
                  <% if (g.isDayGame) { %><span class="kd-tag kd-tag-ok" title="الدرجة الأخيرة من سُلّم هذا اليوم">الدرجة الأخيرة</span><% } %></span>
                <span class="kd-tag <%= g.source === 'typed' ? 'kd-tag-accent' : g.source ? 'kd-tag-ok' : '' %>"><%= g.source === 'typed' ? 'مكتوب' : g.source ? 'مخطَّط' : 'تلقائي' %></span>
                <% if (!past) { %>
                  <form method="post" action="/admin/days/<%= date %>/games/<%= g.kind %>/again" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-kd-outline" type="submit"
                            title="يسحب اللعبة من جديد من البنك، ويثبّت هذا الاختيار لهذا اليوم">
                      <%- icon('shuffle', 14) %> اختيار آخر
                    </button>
                  </form>
                <% } %>
              </div>
              <div class="ad-card-body">
                <% if (!g.game) { %>
                  <p class="small kd-muted">لا شيء للعب: أضف أسئلة (أو مدخلات للقائمة)، أو اكتب هذه اللعبة أدناه.</p>
                <% } else if (g.kind === 'bubbles') { %>
                  <p class="mb-2"><span class="kd-tag kd-tag-accent wz-ar"><%= g.game.theme %></span> <span class="wz-ar"><%= g.game.words.map((w) => w.display + ' (' + w.parts.join('·') + ')').join('، ') %></span></p>
                <% } else if (g.kind === 'connect') { %>
                  <p class="mb-2 d-flex flex-wrap align-items-center gap-2">
                    <% if (g.game.image) { %>
                      <span class="wz-frame wz-sm"
                            style="--wz-zoom: <%= g.game.image.zoom %>; --wz-x: <%= (g.game.image.focusX * 100).toFixed(1) %>%; --wz-y: <%= (g.game.image.focusY * 100).toFixed(1) %>%">
                        <img src="<%= g.game.image.url %>" alt="" loading="lazy"></span>
                    <% } %>
                    <% if (g.game.emoji) { %><span class="wz-emoji"><%= g.game.emoji %></span><% } %>
                    <% if (g.game.theme) { %><span class="kd-tag kd-tag-accent wz-ar"><%= g.game.theme %></span><% } %>
                    <% if (g.game.ask) { %><span class="small kd-muted wz-ar"><%= g.game.ask %></span><% } %>
                    <span class="wz-ar"><%= g.game.words.map((w) => w.display).join('، ') %></span></p>
                  <% if (g.game.words.some((w) => w.clue)) { %>
                    <ul class="small kd-muted wz-ar mb-2">
                      <% g.game.words.forEach((w) => { %>
                        <li><% if (w.emoji) { %><span class="wz-emoji"><%= w.emoji %></span> <% } %><%= w.clue %> — <span class="fw-semibold"><%= w.display %></span></li>
                      <% }) %>
                    </ul>
                  <% } %>
                  <div class="wz-board mb-2">
                    <div class="wz-grid" style="--wz-cols: <%= g.game.cols %>; --wz-rows: <%= g.game.rows.length %>">
                      <% g.game.rows.forEach((row) => { [...row].forEach((letter) => { %>
                        <span class="wz-cell"><%= letter %></span>
                      <% }) }) %>
                    </div>
                  </div>
                <% } else if (g.kind === 'wheel') { %>
                  <p class="mb-2"><span class="kd-tag kd-tag-accent wz-ar"><%= [...g.game.letters].join(' ') %></span> <span class="wz-ar"><%= g.game.words.join('، ') %></span></p>
                <% } else if (g.kind === 'guess') { %>
                  <p class="mb-2"><span class="wz-ar fw-semibold fs-4"><%= (g.game.words ?? [{ display: g.game.display }]).map((w) => w.display).join('  ·  ') %></span>
                    <span class="small kd-muted"><%= g.game.tries %> محاولات للكلمتين</span></p>
                <% } %>

                <% if (!past && g.text === null) { %>
                  <p class="small kd-muted mb-0"><%= g.label.hint %></p>
                <% } %>

                <% if (!past && g.text !== null) { %>
                  <details <%= g.isOpen ? 'open' : '' %>>
                    <summary class="small fw-semibold">تعديل <%= g.label.ar %></summary>
                    <p class="small kd-muted mt-2 mb-1"><%= g.label.hint %></p>
                    <% if (g.errors.length) { %>
                      <ul class="small text-danger mb-2"><% g.errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
                    <% } %>
                    <form method="post" action="/admin/days/<%= date %>/games/<%= g.kind %>" class="d-grid gap-2">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <textarea class="form-control wz-ar ws-words-input" name="text" rows="<%= g.kind === 'guess' || g.kind === 'wheel' ? 2 : 6 %>" spellcheck="false"><%= g.text %></textarea>
                      <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-kd-accent" type="submit">حفظ</button>
                      </div>
                    </form>
                    <% if (g.source) { %>
                      <form method="post" action="/admin/days/<%= date %>/games/<%= g.kind %>/auto" class="mt-2 m-0" data-confirm="إعادة هذه اللعبة إلى التلقائي؟">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-kd-ghost" type="submit">عُد إلى التلقائي</button>
                      </form>
                    <% } %>
                  </details>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
