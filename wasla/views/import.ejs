<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'استيراد', subheading: 'أسئلة كثيرة دفعة واحدة: الصقها من موقع، أو ارفع ملف CSV بالصور والأصوات' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <form class="ad-card mb-3" method="post" action="/admin/import/paste" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('clipboard-paste', 16) %>
          <span class="fw-semibold">لصق من موقع</span>
          <span class="small kd-faint ms-auto">لا يُضاف شيء قبل التأكيد.</span>
        </div>
        <div class="ad-card-body row g-3">
          <div class="col-lg-8">
            <label class="form-label small fw-semibold" for="pasteText">الأسئلة</label>
            <textarea class="form-control wz-ar wz-paste" id="pasteText" name="text" rows="12" dir="rtl" required maxlength="<%= maxPaste %>"
                      placeholder="# عواصم&#10;ما عاصمة مصر؟ القاهرة&#10;1- عاصمة المغرب - الرباط&#10;س: أكبر محيط في العالم&#10;ج: الهادي&#10;حيوان يلقب بملك الغابة&#10;الأسد"></textarea>
            <div class="form-text">انسخ الأسئلة من أي صفحة والصقها هنا — سؤال في كل سطر
              (<span class="kd-mono">دليل - جواب</span>، أو <span class="kd-mono">دليل: جواب</span>، أو مسافة جدولة، أو <span class="kd-mono">…؟ جواب</span>)،
              <span class="kd-mono">س:</span>/<span class="kd-mono">ج:</span> أزواج، أو سطر دليل يليه سطر جوابه.
              Numbers and bullets are ignored. A line starting with <span class="kd-mono">#</span> يحدّد فئة السطور التي تليه.</div>
          </div>
          <div class="col-lg-4 d-grid gap-3 align-content-start">
            <div>
              <label class="form-label small fw-semibold" for="pasteTitle">الفئة</label>
              <input class="form-control wz-ar" id="pasteTitle" name="title" list="pasteTitles" maxlength="40" dir="auto" placeholder="e.g. حيوانات">
              <datalist id="pasteTitles"><% titles.forEach((t) => { %><option value="<%= t %>"><% }) %></datalist>
              <div class="form-text">تُستعمل ما لم يعطِ سطر <span class="kd-mono">#</span> فئة أخرى.</div>
            </div>
            <div>
              <label class="form-label small fw-semibold" for="pasteOrder">أي جانب هو الجواب؟</label>
              <select class="form-select" id="pasteOrder" name="order">
                <option value="auto">خمّن (الجانب الذي فيه ؟ هو السؤال)</option>
                <option value="clue-first">السؤال أولاً ثم الجواب</option>
                <option value="answer-first">الجواب أولاً ثم السؤال</option>
              </select>
            </div>
            <div>
              <label class="form-label small fw-semibold" for="pasteLevel">أضف إلى اللغز</label>
              <input class="form-control" id="pasteLevel" name="level" type="number" min="1" max="<%= levelCount + 1 %>" placeholder="بلا">
              <div class="form-text">اختياري. <%= levelCount + 1 %> يصنع لغزاً جديداً.</div>
            </div>
            <button class="btn btn-kd" type="submit">معاينة</button>
          </div>
        </div>
      </form>

      <div class="row g-3">
        <div class="col-xl-6">
          <form class="ad-card" method="post" action="/admin/import" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('file-up', 16) %>
              <span class="fw-semibold">رفع ملف CSV</span>
            </div>
            <div class="ad-card-body d-grid gap-3">
              <div>
                <label class="form-label small fw-semibold" for="csv">ملف CSV</label>
                <input class="form-control" type="file" id="csv" name="csv" accept=".csv,text/csv" required>
                <div class="form-text">UTF-8، مفصول بفواصل، مع صف عناوين.</div>
              </div>
              <div>
                <label class="form-label small fw-semibold" for="media">صور وأصوات</label>
                <input class="form-control" type="file" id="media" name="media" multiple accept=".png,.jpg,.jpeg,.webp,.mp3,.m4a,.aac,.wav">
                <div class="form-text">Up to <%= maxMedia %> من الملفات. أعمدة <span class="kd-mono">image</span> and <span class="kd-mono">audio</span> تسمّيها.</div>
              </div>
              <div class="d-flex gap-2 align-items-center">
                <button class="btn btn-kd" type="submit">ارفع وعايِن</button>
                <span class="small kd-faint">لا يُضاف شيء قبل التأكيد.</span>
              </div>
            </div>
          </form>
        </div>

        <div class="col-xl-6">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('table', 16) %>
              <span class="fw-semibold">الأعمدة</span>
              <a class="btn btn-sm btn-kd-outline ms-auto" href="/assets/import-example.csv" download="wasla-import-example.csv">
                <span class="me-1"><%- icon('download', 14) %></span>مثال CSV
              </a>
            </div>
            <div class="ad-card-body p-0">
              <table class="ad-table">
                <tbody>
                  <% [
                       ['answer', 'مطلوب. كما يُكتب، مثل أسد — ويُلعب اسد.'],
                       ['clue', 'السؤال الذي يقرأه اللاعب. مطلوب للأسئلة النصية؛ وأسئلة الصور والأصوات والإيموجي يمكن أن تتركه فارغاً وتكتفي بالفئة.'],
                       ['title', 'مطلوب. تظهر فوق السؤال في التطبيق، حتى 40 حرفاً، مثل حيوانات. ويُستعمل عمود category القديم إذا كان فارغاً.'],
                       ['type', 'text أو image أو emoji أو audio. الفراغ: يتبع الوسيط.'],
                       ['emoji', 'من 1 إلى 8 إيموجي، لأسئلة الإيموجي.'],
                       ['image', 'اسم ملف صورة مرفوعة مع الملف.'],
                       ['zoom', 'من 1 إلى 5. الفراغ = 1.'],
                       ['focus_x', 'من 0 إلى 1، مركز التقريب. الفراغ = 0.5.'],
                       ['focus_y', 'من 0 إلى 1. الفراغ = 0.5.'],
                       ['blurred', 'yes أو 1 أو true لتبدأ الصورة مموّهة.'],
                       ['audio', 'اسم ملف صوت مرفوع مع الملف.'],
                       ['difficulty', 'easy أو medium أو hard. الفراغ: غير محدَّدة.'],
                       ['image_author', 'من التقط الصورة — يظهر في صفحة الشكر.'],
                       ['image_licence', 'رخصة الصورة، مثل CC BY-SA 4.0.'],
                       ['image_source', 'الرابط الذي جاءت منه الصورة.'],
                       ['level', 'رقم اللغز الذي يُضاف إليه السؤال (1، 2، 3 … كما في صفحة الألغاز). تُضاف ألغاز جديدة إذا تتابعت أرقامها بعد آخر لغز بلا فجوة — ويمكن لملف واحد أن يضيف عدة ألغاز (مثل 4 و5 و6 بعد اللغز 3). الفراغ: بلا لغز.'],
                     ].forEach(([name, text]) => { %>
                    <tr><td class="kd-mono small"><%= name %></td><td class="small"><%= text %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
