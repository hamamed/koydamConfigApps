<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'لغز اليوم',
          subheading: 'البحث عن الكلمات، مخطَّطاً يوماً بيوم',
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/admin/wordsearch">مواضيع البحث</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="row g-3 mb-3">
        <div class="col-lg-7">
          <div class="ad-card ad-kpi h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
              <%- icon('calendar-range', 17) %>
              <span class="ad-kpi-label">مخطَّط مسبقاً</span>
            </div>
            <% if (summary.lastDate) { %>
              <div class="ad-kpi-value">مجدول حتى <span class="kd-mono"><%= summary.lastDate %></span></div>
              <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <span class="kd-tag <%= summary.low ? 'kd-tag-warn' : 'kd-tag-ok' %>"><%= summary.daysAhead %> يوماً مقدّماً</span>
                <% if (summary.low) { %><span class="kd-tag kd-tag-warn">أقل من <%= lowDays %> أيام متبقية — أضف المزيد</span><% } %>
                <% if (summary.gaps) { %><span class="kd-tag kd-tag-warn"><%= summary.gaps %> تاريخاً غير مخطَّط بينها (تلقائي)</span><% } %>
              </div>
            <% } else { %>
              <div class="ad-kpi-value">لا شيء مخطَّط</div>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <span class="kd-tag kd-tag-warn">كل يوم تلقائي — أضف أياماً لتخطيطها</span>
              </div>
            <% } %>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="ad-card ad-kpi h-100">
            <div class="d-flex align-items-center gap-2 mb-2">
              <%- icon('calendar-check', 17) %>
              <span class="ad-kpi-label">اليوم · <span class="kd-mono"><%= today %></span> UTC</span>
            </div>
            <div class="ad-kpi-value"><span class="wz-ar"><%= todayTheme ?? '—' %></span></div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
              <% if (summary.todayScheduled) { %>
                <span class="ad-status ad-status-published">مجدول</span>
              <% } else if (todayTheme) { %>
                <span class="ad-status ad-status-draft">تلقائي</span>
              <% } else { %>
                <span class="ad-status ad-status-archived">لا لغز</span>
              <% } %>
              <a class="small ms-auto" href="/admin/daily/<%= today %>">عرض شبكة اليوم</a>
            </div>
          </div>
        </div>
      </div>

      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
          <%- icon('calendar-plus', 16) %>
          <span class="fw-semibold me-auto">إضافة أيام</span>
          <form method="get" action="/admin/daily/plan" class="d-flex gap-2 m-0">
            <input class="form-control form-control-sm" type="date" name="date" min="<%= today %>" required aria-label="تاريخ للتخطيط">
            <button class="btn btn-sm btn-kd-outline text-nowrap" type="submit">خطّط تاريخاً</button>
          </form>
        </div>
        <div class="ad-card-body">
          <form method="post" action="/admin/daily/add" class="d-flex flex-wrap align-items-center gap-2 m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% addChoices.forEach((n) => { %>
              <button class="btn btn-kd" type="submit" name="days" value="<%= n %>" <%= playableCount ? '' : 'disabled' %>>أضف <%= n %> يوماً</button>
            <% }) %>
            <span class="small kd-muted ms-lg-2">
              <% if (playableCount) { %>
                من <%= summary.lastDate ? 'اليوم التالي لـ ' + summary.lastDate : 'اليوم' %>. يأخذ كل يوم الموضوع التالي في الدورة
                (<%= playableCount %> مستعملة، ولا يتكرر موضوع اليوم السابق ما دام غيره يصلح) وحجم يومه، الاثنين 7 ← الأحد 10.
                تُجمَّد الشبكة لحظة إضافتها.
              <% } else { %>
                لا موضوع مستعمل بعد — أضف أسئلة في <a href="/admin/wordsearch">مواضيع البحث</a>، أو خطّط تاريخاً بكلمات مكتوبة.
              <% } %>
            </span>
          </form>
        </div>
      </div>

      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('calendar-days', 16) %>
          <span class="fw-semibold me-auto">المجدول من اليوم</span>
          <span class="kd-faint small"><%= upcoming.length %> يوماً</span>
        </div>
        <% if (!upcoming.length) { %>
          <div class="ad-empty">
            <%- icon('calendar-x', 28) %>
            <p class="mb-0">لا يوم مخطَّط. التواريخ غير المخطَّطة تأخذ الشبكة التلقائية، وهي تتغير مع تغيّر الأسئلة.</p>
          </div>
        <% } else { %>
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th>التاريخ</th><th>الموضوع</th><th class="text-end">الحجم</th><th class="text-end">الكلمات</th><th>المصدر</th><th></th></tr></thead>
              <tbody>
                <% upcoming.forEach((d) => { %>
                  <tr>
                    <td class="text-nowrap">
                      <a class="kd-mono" href="/admin/daily/<%= d.date %>"><%= d.date %></a>
                      <span class="wz-ar small kd-muted ms-1"><%= d.weekdayAr %></span>
                      <% if (d.date === today) { %><span class="kd-tag kd-tag-accent ms-1">اليوم</span><% } %>
                    </td>
                    <td><span class="wz-ar fw-semibold"><%= d.theme %></span></td>
                    <td class="text-end"><%= d.size %> × <%= d.size %></td>
                    <td class="text-end"><%= d.wordCount %></td>
                    <td><span class="kd-tag"><%= d.source === 'custom' ? 'typed words' : 'theme' %></span></td>
                    <td class="text-end text-nowrap">
                      <a class="btn btn-sm btn-kd-ghost" href="/admin/daily/<%= d.date %>">معاينة</a>
                      <a class="btn btn-sm btn-kd-outline" href="/admin/daily/<%= d.date %>/edit">تعديل</a>
                      <form method="post" action="/admin/daily/<%= d.date %>/delete" class="d-inline m-0" data-confirm="حذف لغز <%= d.date %>؟ يعود ذلك اليوم إلى الشبكة التلقائية.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-kd-danger" type="submit">حذف</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <details class="ad-card ws-past">
        <summary class="ad-card-head d-flex align-items-center gap-2">
          <span class="ws-past-chevron"><%- icon('chevron-right', 16) %></span>
          <span class="fw-semibold me-auto">أيام مضت</span>
          <span class="kd-faint small"><%= past.length %><%= past.length >= 60 ? '+' : '' %> · للعرض فقط</span>
        </summary>
        <% if (!past.length) { %>
          <p class="small kd-faint m-3">لم يمضِ أي يوم مخطَّط بعد.</p>
        <% } else { %>
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th>التاريخ</th><th>الموضوع</th><th class="text-end">الحجم</th><th class="text-end">الكلمات</th><th></th></tr></thead>
              <tbody>
                <% past.forEach((d) => { %>
                  <tr>
                    <td class="text-nowrap"><span class="kd-mono"><%= d.date %></span> <span class="wz-ar small kd-muted ms-1"><%= d.weekdayAr %></span></td>
                    <td><span class="wz-ar"><%= d.theme %></span></td>
                    <td class="text-end"><%= d.size %> × <%= d.size %></td>
                    <td class="text-end"><%= d.wordCount %></td>
                    <td class="text-end"><a class="btn btn-sm btn-kd-ghost" href="/admin/daily/<%= d.date %>">عرض</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </details>

      <p class="small kd-faint mt-3 mb-0">
        التواريخ بتقويم اللاعب نفسه. لغز الكلمات المتقاطعة اليومي القديم (<span class="kd-mono">/api/v1/daily</span>) ما زال يجيب
        نسخ التطبيق الأقدم من البحث عن الكلمات، لكنه لم يعد يُخطَّط هنا.
      </p>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
