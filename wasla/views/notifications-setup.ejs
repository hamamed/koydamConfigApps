<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الإشعارات', subheading: 'مصادقة APNs بالمفتاح: ملف ‎.p8 من حساب Apple للمطوّرين' }) %>
    <div class="ad-content">
      <%- include('partials/notifications-tabs', { active: 'setup' }) %>
      <%- include('partials/flash') %>

      <div class="row g-3">
        <div class="col-xl-6">
          <form class="ad-card" method="post" action="/admin/notifications/setup" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('key-round', 16) %>
              <span class="fw-semibold me-auto">مفتاح APNs</span>
              <% if (apns.configured) { %>
                <span class="ad-status ad-status-published">المفتاح مرفوع (Key ID <%= apns.keyId %>)</span>
              <% } else if (apns.hasKey) { %>
                <span class="ad-status ad-status-draft">ملف المفتاح موجود، وKey ID ناقص</span>
              <% } else { %>
                <span class="ad-status ad-status-draft">غير مُعَدّ</span>
              <% } %>
            </div>
            <div class="ad-card-body d-grid gap-3">
              <div>
                <label class="form-label small fw-semibold" for="key"><%= apns.hasKey ? 'Replace the .p8 key (optional)' : '.p8 key file' %></label>
                <input class="form-control" type="file" id="key" name="key" accept=".p8" <%= apns.hasKey ? '' : 'required' %>>
                <div class="form-text">Certificates, Identifiers &amp; Profiles ← Keys ← مفتاح بخدمة Apple Push Notifications. يُحفظ على الخادم فقط (data/apns، لا يقرأه غير الخدمة)، ولا يُعرض مرة أخرى.</div>
              </div>
              <div>
                <label class="form-label small fw-semibold" for="keyId">Key ID</label>
                <input class="form-control font-monospace" id="keyId" name="keyId" maxlength="10" required value="<%= values.keyId %>" placeholder="ABC123DEFG" autocomplete="off">
              </div>
              <div class="row g-2">
                <div class="col-sm-5">
                  <label class="form-label small fw-semibold" for="teamId">Team ID</label>
                  <input class="form-control font-monospace" id="teamId" name="teamId" maxlength="10" value="<%= values.teamId %>" placeholder="<%= defaults.teamId %>">
                </div>
                <div class="col-sm-7">
                  <label class="form-label small fw-semibold" for="topic">Topic (معرّف الحزمة)</label>
                  <input class="form-control font-monospace" id="topic" name="topic" value="<%= values.topic %>" placeholder="<%= defaults.topic %>">
                </div>
              </div>
              <div>
                <button class="btn btn-kd-accent" type="submit"><%= apns.hasKey ? 'حفظ' : 'رفع المفتاح' %></button>
              </div>
            </div>
          </form>
        </div>

        <div class="col-xl-6">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('info', 16) %>
              <span class="fw-semibold me-auto">كيف يتم الإرسال</span>
            </div>
            <div class="ad-card-body small d-grid gap-2">
              <p class="mb-0">يُرسَل كل جهاز إلى خادم Apple الموافق لنسخته: نسخ App Store وTestFlight إلى production، ونسخ Xcode إلى sandbox. المفتاح نفسه يكفي للاثنين.</p>
              <p class="mb-0">أي رمز تُبلغ Apple أنه لم يعد صالحاً (410 أو BadDeviceToken أو Unregistered) يُعطَّل فتتخطاه الإرسالات التالية. أما الأخطاء الأخرى فتُحصى ويُعاد المحاولة لاحقاً.</p>
              <% if (apns.uploadedAt) { %><p class="mb-0 kd-faint">Key uploaded <%= apns.uploadedAt.replace('T', ' ').slice(0, 16) %> UTC.</p><% } %>
              <% if (apns.hasKey) { %>
                <form method="post" action="/admin/notifications/setup/remove" class="m-0 mt-2" data-confirm="حذف مفتاح APNs؟ لن يمكن الإرسال حتى يُرفع مفتاح جديد.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-sm btn-kd-danger" type="submit">حذف المفتاح</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
