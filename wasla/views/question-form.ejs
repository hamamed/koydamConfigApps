<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: question.id ? 'تعديل السؤال' : 'سؤال جديد',
          subheading: question.id ? 'التعديل يصل إلى كل لغز يستعمله' : 'كلمة ودليلها، وصورة اختيارية',
          actions: question.id ? '<a class="btn btn-sm btn-kd-outline" href="/admin/questions/' + question.id + '/preview">انظر ما يراه اللاعب</a>' : ''
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <form method="post" enctype="multipart/form-data"
            action="<%= question.id ? '/admin/questions/' + question.id : '/admin/questions' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (levelId) { %><input type="hidden" name="level" value="<%= levelId %>"><% } %>

        <div class="row g-3">
          <div class="col-lg-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('type', 16) %>
                <span class="fw-semibold me-auto">الكلمة والدليل</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <div>
                  <label class="form-label small fw-semibold" for="answer">الجواب</label>
                  <input class="form-control wz-answer-input" id="answer" name="answer" dir="rtl" lang="ar"
                         value="<%= question.answer %>" maxlength="40" required data-letters="#answerLetters" data-play="#answerPlay">
                  <div class="form-text">حروف عربية فقط، من 2 إلى 20 (المسافات بين الكلمات لا تُحسب). تُزال الحركات؛ واسم مثل نجيب محفوظ يحتفظ بمسافته. <span id="answerLetters" class="wz-letters"></span></div>
                  <div class="wz-play" id="answerPlay" lang="ar" dir="rtl" aria-live="polite">
                    <% if (question.answer) { %>يُلعب: <span class="wz-answer"><%= question.playAnswer %></span><% } %>
                  </div>
                  <% if (question.id && question.playAnswer !== question.answer) { %>
                    <div class="wz-fold-note" data-fold-note>
                      <%- icon('info', 14) %>
                      تُكتب <span class="wz-answer"><%= question.answer %></span>، وتُلعب <span class="wz-answer"><%= question.playAnswer %></span>: تُوحَّد صور الهمزة والألف داخل الشبكة، ويعرض التطبيق الكتابة الأصلية بعد حل الكلمة.
                    </div>
                  <% } %>
                </div>
                <div>
                  <label class="form-label small fw-semibold" for="title">الفئة</label>
                  <input class="form-control wz-ar" id="title" name="title" dir="rtl" list="known-titles" value="<%= question.title %>" maxlength="<%= maxTitle %>" placeholder="حيوانات، عواصم…" required>
                  <datalist id="known-titles"><% titles.forEach((t) => { %><option value="<%= t %>"></option><% }) %></datalist>
                  <div class="form-text">تظهر فوق السؤال في التطبيق. حتى <%= maxTitle %> حرفاً؛ اختر واحدة موجودة لإعادة استعمالها.</div>
                </div>
                <div>
                  <label class="form-label small fw-semibold" for="difficulty">الصعوبة</label>
                  <select class="form-select" id="difficulty" name="difficulty">
                    <option value="" <%= !question.difficulty ? 'selected' : '' %>>غير محدَّدة</option>
                    <option value="easy" <%= question.difficulty === 'easy' ? 'selected' : '' %>>سهل</option>
                    <option value="medium" <%= question.difficulty === 'medium' ? 'selected' : '' %>>متوسط</option>
                    <option value="hard" <%= question.difficulty === 'hard' ? 'selected' : '' %>>صعب</option>
                  </select>
                </div>
                <div>
                  <label class="form-label small fw-semibold" for="clue">السؤال / الدليل</label>
                  <textarea class="form-control wz-ar" id="clue" name="clue" dir="rtl" rows="3" maxlength="200"><%= question.clue %></textarea>
                  <div class="form-text">ما يقرأه اللاعب. اختياري لأسئلة الصورة والصوت والإيموجي — تكفيها الفئة وحدها.</div>
                </div>
                <div class="row g-2">
                  <div class="col-sm-6">
                    <label class="form-label small fw-semibold" for="type">نوع السؤال</label>
                    <select class="form-select" id="type" name="type" data-type-select>
                      <option value="" <%= question.id ? '' : 'selected' %>>تلقائي — حسب الوسيط</option>
                      <% types.forEach((t) => { %>
                        <option value="<%= t %>" <%= question.id && question.type === t ? 'selected' : '' %>><%= { text: 'نص', image: 'صورة', emoji: 'إيموجي', audio: 'صوت' }[t] %></option>
                      <% }) %>
                    </select>
                    <div class="form-text">ما يعرضه التطبيق فوق الدليل.</div>
                  </div>
                  <div class="col-sm-6">
                    <label class="form-label small fw-semibold" for="emoji">إيموجي</label>
                    <input class="form-control wz-emoji-input" id="emoji" name="emoji" value="<%= question.emoji || '' %>" maxlength="80" placeholder="🦁👑" data-emoji>
                    <div class="form-text">1 to <%= maxEmoji %> إيموجي، بلا حروف. لأسئلة الإيموجي.</div>
                  </div>
                </div>
                <% if (levels.length) { %>
                  <div class="small kd-muted">
                    مستعمل في:
                    <% levels.forEach((l) => { %><a class="kd-tag" href="/admin/levels/<%= l.id %>"><%= l.name %></a> <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="ad-card h-100" data-zoom-editor <%= question.imageFile ? 'data-has-file' : '' %>>
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('image', 16) %>
                <span class="fw-semibold">صورة</span>
                <span class="kd-faint small ms-auto">اختياري</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <input class="form-control" type="file" name="image" accept=".png,.jpg,.jpeg,.webp" data-zoom-file>
                <div class="form-text mt-n2">PNG أو JPEG أو WebP، حتى <%= maxImageMb %> ميغابايت. اختيار صورة جديدة يستبدل الحالية.</div>

                <div class="wz-editor <%= question.imageFile ? '' : 'd-none' %>" data-zoom-panes>
                  <div>
                    <div class="small fw-semibold mb-1">الصورة كاملة <span class="kd-faint fw-normal">— اضغط لتحديد مركز التركيز</span></div>
                    <div class="wz-source" data-zoom-source>
                      <img src="<%= question.imageFile ? imageUrl(question.imageFile) : '' %>" alt="" data-zoom-img>
                      <span class="wz-dot" data-zoom-dot></span>
                    </div>
                  </div>
                  <div>
                    <div class="small fw-semibold mb-1">ما يراه اللاعب</div>
                    <span class="wz-frame wz-lg" data-zoom-preview
                          style="--wz-zoom: <%= question.zoom %>; --wz-x: <%= question.focusX * 100 %>%; --wz-y: <%= question.focusY * 100 %>%">
                      <img src="<%= question.imageFile ? imageUrl(question.imageFile) : '' %>" alt="" data-zoom-img>
                    </span>
                  </div>
                </div>

                <div class="<%= question.imageFile ? '' : 'd-none' %>" data-zoom-controls>
                  <label class="form-label small fw-semibold d-flex" for="zoom">
                    التقريب <span class="ms-auto kd-mono" data-zoom-value>×<%= question.zoom %></span>
                  </label>
                  <input class="form-range" type="range" id="zoom" name="zoom" min="1" max="<%= maxZoom %>" step="0.1" value="<%= question.zoom %>">
                  <div class="form-text">×1 تعرض الصورة كاملة. الأعلى لقطة قريبة — سؤال «خمّن الصورة المقرَّبة».</div>
                  <input type="hidden" name="focusX" value="<%= question.focusX %>">
                  <input type="hidden" name="focusY" value="<%= question.focusY %>">
                  <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="blurred" name="blurred" value="1" <%= question.blurred ? 'checked' : '' %> data-blur-toggle>
                    <label class="form-check-label small" for="blurred">ابدأ مموّهة <span class="kd-faint">— يمكن للاعب دفع مساعدة لتوضيحها</span></label>
                  </div>
                  <div class="mt-3">
                    <div class="small fw-semibold mb-1">نسبة الصورة <span class="kd-faint fw-normal">— تظهر في ‎/credits وفي التطبيق</span></div>
                    <input class="form-control form-control-sm mb-1" name="imageAuthor" maxlength="160" dir="auto"
                           value="<%= question.imageAuthor || '' %>" placeholder="المصوّر، مثلاً وكالة تسنيم">
                    <input class="form-control form-control-sm mb-1" name="imageLicence" maxlength="160" dir="auto"
                           value="<%= question.imageLicence || '' %>" placeholder="الرخصة، مثلاً CC BY-SA 4.0">
                    <input class="form-control form-control-sm" name="imageSource" maxlength="160" type="url" dir="ltr"
                           value="<%= question.imageSource || '' %>" placeholder="https://commons.wikimedia.org/wiki/File:…">
                    <div class="form-text">مطلوبة لصور CC BY و CC BY-SA. اتركها فارغة لصورك الخاصة.</div>
                  </div>
                  <% if (question.imageFile) { %>
                    <div class="form-check mt-2">
                      <input class="form-check-input" type="checkbox" id="removeImage" name="removeImage" value="1">
                      <label class="form-check-label small" for="removeImage">حذف الصورة</label>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="ad-card h-100" data-audio-editor <%= question.audioFile ? 'data-has-file' : '' %>>
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('audio-lines', 16) %>
                <span class="fw-semibold">الصوت</span>
                <span class="kd-faint small ms-auto">اختياري</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <input class="form-control" type="file" name="audio" accept=".mp3,.m4a,.aac,.wav,audio/mpeg,audio/mp4,audio/aac,audio/wav" data-audio-file>
                <div class="form-text mt-n2">MP3 أو M4A أو AAC أو WAV، حتى <%= maxAudioMb %> ميغابايت. لأسئلة «ما مصدر هذا الصوت؟».</div>
                <audio class="wz-audio <%= question.audioFile ? '' : 'd-none' %>" controls preload="none" data-audio-preview
                       <% if (question.audioFile) { %>src="<%= audioUrl(question.audioFile) %>"<% } %>></audio>
                <%# A clip chosen in the sound library travels with the form, so a
                    new question keeps it without the file being uploaded again. %>
                <% if (question.audioFile) { %>
                  <input type="hidden" name="audioFile" value="<%= question.audioFile %>">
                <% } %>
                <% if (question.audioFile) { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="removeAudio" name="removeAudio" value="1">
                    <label class="form-check-label small" for="removeAudio">حذف الصوت</label>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2 mt-3">
          <button class="btn btn-kd-accent" type="submit"><%= question.id ? 'حفظ التعديلات' : (levelId ? 'احفظ وأضف إلى اللغز' : 'حفظ السؤال') %></button>
          <a class="btn btn-kd-ghost" href="<%= levelId ? '/admin/levels/' + levelId : '/admin/questions' %>">إلغاء</a>
        </div>
      </form>

      <% if (question.id) { %>
        <form method="post" action="/admin/questions/<%= question.id %>/delete" class="mt-4"
              data-confirm="حذف هذا السؤال؟">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-kd-danger" type="submit" <%= levels.length ? 'disabled' : '' %>>حذف السؤال</button>
          <% if (levels.length) { %><span class="small kd-faint ms-2">أخرجه من ألغازه أولاً.</span><% } %>
        </form>
      <% } %>
    </div>
  </main>
</div>
<script src="/assets/js/wasla.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
