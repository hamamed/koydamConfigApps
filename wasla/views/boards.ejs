<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'المتصدرون',
          subheading: 'اللوحات الأربع كما يراها اللاعبون في التطبيق',
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/api/v1/leaderboards/' + board.id + '" target="_blank" rel="noopener">هذه اللوحة JSON</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <% boards.forEach((b) => { %>
          <a class="btn btn-sm <%= b.id === board.id ? 'btn-kd' : 'btn-kd-outline' %>"
             href="/admin/boards?board=<%= b.id %><%= b.unit === 'time' ? '&date=' + date : '' %>">
            <span class="wz-ar"><%= b.ar %></span>
          </a>
        <% }) %>
        <% if (board.unit === 'time') { %>
          <form method="get" action="/admin/boards" class="d-flex align-items-center gap-2 ms-auto m-0">
            <input type="hidden" name="board" value="<%= board.id %>">
            <input class="form-control form-control-sm wz-date" type="date" name="date" value="<%= date %>" max="<%= today %>">
            <button class="btn btn-sm btn-kd-outline" type="submit">عرض</button>
          </form>
        <% } %>
      </div>

      <div class="ad-card">
        <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
          <%- icon('trophy', 16) %>
          <span class="fw-semibold me-auto"><%= board.note %><% if (board.unit === 'time') { %> · <%= date %><% } %></span>
          <span class="kd-tag"><%= data ? data.total : 0 %> على اللوحة</span>
        </div>
        <% if (!data || !data.entries.length) { %>
          <div class="ad-empty">
            <% if (board.unit === 'time') { %>
              لم ينهِ أحد <%= date === today ? 'لغز اليوم' : 'لغز ذلك اليوم' %> بعد.
            <% } else { %>
              لا نتيجة لأي لاعب على هذه اللوحة بعد.
            <% } %>
          </div>
        <% } else { %>
          <div class="ad-table-wrap">
            <table class="table ad-table align-middle">
              <thead>
                <tr>
                  <th class="wz-rank-col">#</th>
                  <th>اللاعب</th>
                  <th>النجوم</th>
                  <th><%= board.unit === 'time' ? 'الوقت' : board.unit === 'days' ? 'الأيام' : board.unit === 'stars' ? 'النجوم' : 'النقاط' %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% data.entries.forEach((row) => { %>
                  <tr>
                    <td class="fw-semibold"><%= row.rank %></td>
                    <td>
                      <span class="wz-ar fw-semibold"><%= row.username %></span>
                      <% if (row.frame) { %><span class="kd-tag"><%= row.frame %></span><% } %>
                    </td>
                    <td class="kd-muted"><%= row.stars ?? 0 %></td>
                    <td class="fw-semibold"><%= board.unit === 'time' ? clockText(row.value) : row.value.toLocaleString('en') %></td>
                    <td class="text-end">
                      <a class="btn btn-sm btn-kd-ghost" href="/admin/profiles?q=<%= encodeURIComponent(row.username) %>">فتح الحساب</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="ad-card-body small kd-muted">
            تُعرض أفضل <%= size %>. المحظورون لا يظهرون هنا ولا في التطبيق.
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
