<%
  const targetLabel = { all: 'All devices', sandbox: 'Sandbox devices', device: 'One device (test)' };
%>
<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الإشعارات', subheading: 'أرسل رسالة إلى اللاعبين الذين فعّلوا الإشعارات' }) %>
    <div class="ad-content">
      <%- include('partials/notifications-tabs', { active: 'compose' }) %>
      <%- include('partials/flash') %>

      <% if (!apns.configured) { %>
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
          <span class="flex-shrink-0"><%- icon('key-round', 17) %></span>
          <span class="me-auto">لم تُعدّ APNs بعد، فلا يمكن الإرسال. ارفع مفتاح ‎.p8 أولاً.</span>
          <a class="btn btn-sm btn-kd" href="/admin/notifications/setup">إعداد APNs</a>
        </div>
      <% } %>

      <div class="row g-3 mb-3">
        <% [
             ['أجهزة مسجَّلة', counts.total, 'smartphone'],
             ['الإشعارات مفعّلة', counts.enabled, 'bell-ring'],
             ['production', counts.production, 'store'],
             ['sandbox', counts.sandbox, 'flask-conical'],
           ].forEach(([label, value, glyph]) => { %>
          <div class="col-6 col-xl-3">
            <div class="ad-card ad-kpi">
              <div class="d-flex align-items-center gap-2 mb-2">
                <%- icon(glyph, 17) %>
                <span class="ad-kpi-label"><%= label %></span>
              </div>
              <div class="ad-kpi-value"><%= value %></div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="row g-3">
        <div class="col-xl-6">
          <form class="ad-card" method="post" action="/admin/notifications/confirm" data-compose>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('send', 16) %>
              <span class="fw-semibold me-auto">إشعار جديد</span>
            </div>
            <div class="ad-card-body d-grid gap-3">
              <div>
                <label class="form-label small fw-semibold d-flex" for="title">العنوان <span class="ms-auto kd-faint" data-count-for="title"></span></label>
                <input class="form-control wz-ar" id="title" name="title" maxlength="<%= maxTitle %>" required dir="auto" value="<%= values.title %>" data-max="<%= maxTitle %>">
              </div>
              <div>
                <label class="form-label small fw-semibold d-flex" for="body">الرسالة <span class="ms-auto kd-faint" data-count-for="body"></span></label>
                <textarea class="form-control wz-ar" id="body" name="body" rows="3" maxlength="<%= maxBody %>" required dir="auto" data-max="<%= maxBody %>"><%= values.body %></textarea>
              </div>
              <div>
                <label class="form-label small fw-semibold" for="level">فتح لغز (اختياري)</label>
                <input class="form-control wz-level-input" id="level" name="level" type="number" min="1" <% if (publishedCount) { %>max="<%= publishedCount %>"<% } %> step="1" value="<%= values.level %>" placeholder="—">
                <div class="form-text">الضغط يفتح هذا اللغز إن كان مفتوحاً عند اللاعب، وإلا فالشاشة الرئيسية. الألغاز المنشورة: 1–<%= publishedCount || 0 %>.</div>
              </div>
              <fieldset>
                <legend class="form-label small fw-semibold">الإرسال إلى</legend>
                <div class="d-grid gap-2">
                  <label class="form-check d-flex align-items-center gap-2">
                    <input class="form-check-input m-0" type="radio" name="target" value="all" <%= values.target === 'all' ? 'checked' : '' %>>
                    <span>كل الأجهزة التي فعّلت الإشعارات</span>
                    <span class="kd-tag kd-tag-accent ms-auto" data-audience="all"><%= counts.enabled %></span>
                  </label>
                  <label class="form-check d-flex align-items-center gap-2">
                    <input class="form-check-input m-0" type="radio" name="target" value="sandbox" <%= values.target === 'sandbox' ? 'checked' : '' %>>
                    <span>sandbox فقط (نسخ Xcode، للتجربة)</span>
                    <span class="kd-tag ms-auto" data-audience="sandbox"><%= counts.sandbox %></span>
                  </label>
                  <label class="form-check d-flex align-items-center gap-2">
                    <input class="form-check-input m-0" type="radio" name="target" value="device" <%= values.target === 'device' ? 'checked' : '' %>>
                    <span>إرسال تجربة إلى جهاز واحد</span>
                    <span class="kd-tag ms-auto" data-audience="device">—</span>
                  </label>
                  <input class="form-control form-control-sm font-monospace" name="device" value="<%= values.device %>" placeholder="معرّف الجهاز، مثل 8a1f5b2e-3c4d-4e5f-9a0b-1c2d3e4f5a6b" aria-label="معرّف الجهاز" data-device-input>
                </div>
              </fieldset>
              <button class="btn btn-kd" type="submit" <%= apns.configured ? '' : 'disabled' %>>راجع وأرسل</button>
            </div>
          </form>
        </div>

        <div class="col-xl-6">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('history', 16) %>
              <span class="fw-semibold me-auto">أُرسلت</span>
            </div>
            <div class="ad-card-body p-0">
              <% if (!history.length) { %>
                <div class="ad-empty">
                  <%- icon('bell', 28) %>
                  <p class="mb-0">لم يُرسل شيء بعد.</p>
                </div>
              <% } else { %>
                <div class="ad-table-wrap">
                  <table class="ad-table">
                    <thead><tr><th>الرسالة</th><th>To</th><th class="text-end">أُرسلت</th><th class="text-end">فشلت</th><th class="text-end">معطّلة</th><th>متى</th></tr></thead>
                    <tbody>
                      <% history.forEach((n) => { %>
                        <tr>
                          <td class="wz-notification-cell">
                            <div class="fw-semibold wz-ar"><%= n.title %></div>
                            <div class="small kd-muted wz-ar"><%= n.body %></div>
                            <% if (n.level) { %><span class="kd-tag mt-1">Level <%= n.level %></span><% } %>
                          </td>
                          <td class="small text-nowrap"><%= targetLabel[n.target] || n.target %><% if (n.device) { %><div class="kd-faint font-monospace text-truncate wz-device-id"><%= n.device %></div><% } %></td>
                          <td class="text-end"><%= n.sent %>/<%= n.total %></td>
                          <td class="text-end"><% if (n.failed) { %><span class="kd-tag kd-tag-warn" title="<%= Object.entries(n.errors).map(([r, c]) => r + ' ×' + c).join(', ') %>"><%= n.failed %></span><% } else { %>0<% } %></td>
                          <td class="text-end"><%= n.disabled %></td>
                          <td class="small kd-faint text-nowrap"><%= n.createdAt %> UTC<% if (n.createdBy) { %><div><%= n.createdBy %></div><% } %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/assets/js/notifications.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
