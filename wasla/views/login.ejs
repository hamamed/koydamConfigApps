<%- include('partials/head') %>
<div class="kd-auth">
  <div class="kd-auth-card">
    <div class="mb-3"><%- include('partials/brand', { size: 48 }) %></div>
    <h1 class="kd-h4 mb-1">لوحة تحكم شبّك</h1>
    <p class="kd-muted small mb-4">ألغاز الكلمات المتقاطعة وأسئلتها وصورها.</p>

    <%- include('partials/flash') %>

    <% if (platformUrl) { %>
      <a class="btn btn-kd w-100 mb-3" href="<%= platformUrl %>/sso/wasla">
        <span class="me-1"><%- icon('log-in', 16) %></span>
        الدخول عبر Koydam
      </a>
      <div class="kd-divider my-3"><span>or</span></div>
    <% } %>

    <form method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-2">
        <label class="form-label small fw-semibold" for="username">اسم المستخدم</label>
        <input class="form-control" id="username" name="username" autocomplete="username" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label small fw-semibold" for="password">كلمة المرور</label>
        <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-kd-outline w-100" type="submit">دخول</button>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
