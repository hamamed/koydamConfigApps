<%# The game's logo, drawn rather than fetched: three pieces, tilted and overlapping,
    over the tagline ribbon — the way LogoView draws them in the app. `size` is a
    piece's side in pixels; pass `tagline: false` where there is no room for it. %>
<span class="wz-logo-wrap" style="--wz-tile: <%= typeof size === 'undefined' ? 26 : size %>px"
      role="img" aria-label="شبّك · لعبة كلمات متقاطعة">
  <span class="wz-logo">
    <span class="wz-logo-tile wz-logo-a">ش</span>
    <span class="wz-logo-tile wz-logo-b">بّ</span>
    <span class="wz-logo-tile wz-logo-c">ك</span>
  </span>
  <% if (typeof tagline === 'undefined' || tagline) { %>
    <span class="wz-logo-tagline">لعبة كلمات متقاطعة</span>
  <% } %>
</span>
