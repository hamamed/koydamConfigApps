<header class="ad-topbar">
  <button class="btn btn-kd-ghost btn-sm d-lg-none" id="mbMenuToggle" type="button" aria-label="فتح القائمة">
    <%- icon('menu', 16) %>
  </button>

  <span class="wz-page-icon"><%- icon(typeof pageIcon === 'undefined' ? 'layout-dashboard' : pageIcon, 22) %></span>

  <div class="min-w-0">
    <h1 class="ad-page-title mb-0"><%= heading %></h1>
    <% if (typeof subheading !== 'undefined' && subheading) { %>
      <div class="ad-page-sub text-truncate"><%= subheading %></div>
    <% } %>
  </div>

  <div class="ms-auto d-flex align-items-center gap-2">
    <% if (typeof user !== 'undefined' && user) { %>
      <span class="kd-tag d-none d-md-inline"><%= user.username %></span>
    <% } %>
    <% if (typeof actions !== 'undefined' && actions) { %><%- actions %><% } %>
  </div>
</header>
<% if (typeof panelNote !== 'undefined' && panelNote) { %>
  <%# «ملاحظاتي»: one note under the header of every page; it opens to type in and saves itself. %>
  <section class="wz-note" data-note data-note-csrf="<%= csrfToken %>" aria-label="ملاحظاتي">
    <button class="wz-note-bar" type="button" data-note-toggle aria-expanded="false" aria-controls="wzNoteBody">
      <%- icon('sticky-note', 16) %>
      <span class="wz-note-title">ملاحظاتي</span>
      <span class="wz-note-preview" data-note-preview dir="auto"><%= panelNote.text.split('\n').find((line) => line.trim()) || 'اكتب هنا ما تريد أن تتذكّره…' %></span>
      <span class="wz-note-state" data-note-state aria-live="polite"></span>
      <span class="wz-note-chevron"><%- icon('chevron-down', 16) %></span>
    </button>
    <div class="wz-note-body" id="wzNoteBody" hidden>
      <textarea class="wz-note-text" data-note-text dir="auto" rows="4" maxlength="<%= maxNoteLength %>"
                placeholder="اكتب هنا ما تريد أن تتذكّره أو تفعله… يُحفظ وحده ويظهر في كل الصفحات." aria-label="نص الملاحظة"><%= panelNote.text %></textarea>
    </div>
  </section>
<% } %>
