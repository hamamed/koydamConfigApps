<% if (flash) { %>
  <div class="alert alert-<%= flash.type === 'warning' ? 'warning' : flash.type === 'danger' || flash.type === 'error' ? 'danger' : 'success' %> d-flex align-items-start gap-2 mb-4" role="alert">
    <span class="flex-shrink-0 mt-1"><%- icon(flash.type === 'warning' ? 'triangle-alert' : flash.type === 'danger' || flash.type === 'error' ? 'triangle-alert' : 'check', 17) %></span>
    <span><%= flash.message %></span>
  </div>
<% } %>
