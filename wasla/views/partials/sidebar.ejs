<aside class="ad-sidebar" id="mbSidebar">
  <%# The pieces spell the name; a wordmark beside them would say it twice. %>
  <a class="ad-brand wz-brand" href="/admin" aria-label="شبّك · لوحة التحكم">
    <%- include('brand', { size: 34 }) %>
  </a>

  <nav class="ad-nav">
    <div class="ad-nav-label">عام</div>
    <a class="ad-nav-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/admin">
      <%- icon('layout-dashboard', 17) %>
      <span>الرئيسية</span>
    </a>

    <div class="ad-nav-label">محتوى اللعبة</div>
    <a class="ad-nav-link <%= currentPath.startsWith('/levels') ? 'is-active' : '' %>" href="/admin/levels">
      <%- icon('grid-3x3', 17) %>
      <span>الألغاز</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/questions') ? 'is-active' : '' %>" href="/admin/questions">
      <%- icon('message-circle-question', 17) %>
      <span>الأسئلة</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/titles') ? 'is-active' : '' %>" href="/admin/titles">
      <%- icon('tag', 17) %>
      <span>الفئات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/days') || currentPath === '/daily' || currentPath.startsWith('/daily/') ? 'is-active' : '' %>" href="/admin/days">
      <%- icon('calendar-days', 17) %>
      <span>لغز اليوم</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/daily-games') ? 'is-active' : '' %>" href="/admin/daily-games">
      <%- icon('list', 17) %>
      <span>قوائم الكلمات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/pictures') ? 'is-active' : '' %>" href="/admin/pictures">
      <%- icon('image', 17) %>
      <span>صِل بالصورة</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/lab') ? 'is-active' : '' %>" href="/admin/lab">
      <%- icon('flask-conical', 17) %>
      <span>ألعاب المختبر</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/wordsearch') ? 'is-active' : '' %>" href="/admin/wordsearch">
      <%- icon('tags', 17) %>
      <span>مواضيع البحث</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/events') ? 'is-active' : '' %>" href="/admin/events">
      <%- icon('moon', 17) %>
      <span>المناسبات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/import') ? 'is-active' : '' %>" href="/admin/import">
      <%- icon('file-up', 17) %>
      <span>استيراد</span>
    </a>

    <div class="ad-nav-label">اللاعبون</div>
    <a class="ad-nav-link <%= currentPath.startsWith('/players') ? 'is-active' : '' %>" href="/admin/players">
      <%- icon('users', 17) %>
      <span>الأجهزة</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/profiles') ? 'is-active' : '' %>" href="/admin/profiles">
      <%- icon('user-round', 17) %>
      <span>الحسابات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/boards') ? 'is-active' : '' %>" href="/admin/boards">
      <%- icon('trophy', 17) %>
      <span>المتصدرون</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/badges') ? 'is-active' : '' %>" href="/admin/badges">
      <%- icon('award', 17) %>
      <span>الشارات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/avatars') ? 'is-active' : '' %>" href="/admin/avatars">
      <%- icon('smile', 17) %>
      <span>الصور والإطارات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/stats') ? 'is-active' : '' %>" href="/admin/stats">
      <%- icon('chart-column', 17) %>
      <span>الإحصاءات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/notifications') ? 'is-active' : '' %>" href="/admin/notifications">
      <%- icon('bell', 17) %>
      <span>الإشعارات</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/settings') ? 'is-active' : '' %>" href="/admin/settings">
      <%- icon('settings', 17) %>
      <span>الإعدادات</span>
    </a>
  </nav>

  <div class="ad-sidebar-foot">
    <a class="ad-nav-link" href="/api/v1/levels" target="_blank" rel="noopener">
      <%- icon('external-link', 17) %>
      <span>واجهة الـAPI</span>
    </a>
    <a class="ad-nav-link" href="/privacy" target="_blank" rel="noopener">
      <%- icon('shield', 17) %>
      <span>سياسة الخصوصية</span>
    </a>
    <a class="ad-nav-link" href="/support" target="_blank" rel="noopener">
      <%- icon('life-buoy', 17) %>
      <span>صفحة الدعم</span>
    </a>
    <form method="post" action="/admin/logout" class="m-0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="ad-nav-link w-100 border-0 bg-transparent text-start" type="submit">
        <%- icon('log-out', 17) %>
        <span>تسجيل الخروج</span>
      </button>
    </form>
  </div>
</aside>
