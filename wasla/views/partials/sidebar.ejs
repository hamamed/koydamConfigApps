<aside class="ad-sidebar" id="mbSidebar">
  <a class="ad-brand" href="/admin">
    <img class="kd-brand-mark" src="/assets/logo/logo.png" alt="" width="23" height="26">
    <span class="ad-brand-name">Wasla<small>Crossword levels</small></span>
  </a>

  <nav class="ad-nav">
    <div class="ad-nav-label">Overview</div>
    <a class="ad-nav-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/admin">
      <i data-lucide="layout-dashboard" width="17" height="17"></i>
      <span>Dashboard</span>
    </a>

    <div class="ad-nav-label">Game content</div>
    <a class="ad-nav-link <%= currentPath.startsWith('/levels') ? 'is-active' : '' %>" href="/admin/levels">
      <i data-lucide="grid-3x3" width="17" height="17"></i>
      <span>Levels</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/questions') ? 'is-active' : '' %>" href="/admin/questions">
      <i data-lucide="message-circle-question" width="17" height="17"></i>
      <span>Questions</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/daily') ? 'is-active' : '' %>" href="/admin/daily">
      <i data-lucide="calendar-days" width="17" height="17"></i>
      <span>Daily puzzle</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/wordsearch') ? 'is-active' : '' %>" href="/admin/wordsearch">
      <i data-lucide="tags" width="17" height="17"></i>
      <span>Word themes</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/import') ? 'is-active' : '' %>" href="/admin/import">
      <i data-lucide="file-up" width="17" height="17"></i>
      <span>Import</span>
    </a>

    <div class="ad-nav-label">Players</div>
    <a class="ad-nav-link <%= currentPath.startsWith('/players') ? 'is-active' : '' %>" href="/admin/players">
      <i data-lucide="users" width="17" height="17"></i>
      <span>Players</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/stats') ? 'is-active' : '' %>" href="/admin/stats">
      <i data-lucide="chart-column" width="17" height="17"></i>
      <span>Stats</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/notifications') ? 'is-active' : '' %>" href="/admin/notifications">
      <i data-lucide="bell" width="17" height="17"></i>
      <span>Notifications</span>
    </a>
    <a class="ad-nav-link <%= currentPath.startsWith('/settings') ? 'is-active' : '' %>" href="/admin/settings">
      <i data-lucide="settings" width="17" height="17"></i>
      <span>Settings</span>
    </a>
  </nav>

  <div class="ad-sidebar-foot">
    <a class="ad-nav-link" href="/api/v1/levels" target="_blank" rel="noopener">
      <i data-lucide="external-link" width="17" height="17"></i>
      <span>View the API</span>
    </a>
    <a class="ad-nav-link" href="/privacy" target="_blank" rel="noopener">
      <i data-lucide="shield" width="17" height="17"></i>
      <span>Privacy policy</span>
    </a>
    <a class="ad-nav-link" href="/support" target="_blank" rel="noopener">
      <i data-lucide="life-buoy" width="17" height="17"></i>
      <span>Support page</span>
    </a>
    <form method="post" action="/admin/logout" class="m-0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="ad-nav-link w-100 border-0 bg-transparent text-start" type="submit">
        <i data-lucide="log-out" width="17" height="17"></i>
        <span>Sign out</span>
      </button>
    </form>
  </div>
</aside>
