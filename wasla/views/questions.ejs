<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'Questions',
          subheading: questions.length + ' of ' + total + ' question' + (total === 1 ? '' : 's') + (titleFilter ? ' · ' + titleFilter : '') + (unused ? ' · not in any level' : ''),
          actions: '<a class="btn btn-kd btn-sm" href="/admin/questions/new">New question</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <form class="ad-toolbar d-flex flex-wrap gap-2 align-items-center mb-3" method="get" action="/admin/questions">
        <input class="form-control wz-search" name="q" value="<%= search %>" placeholder="Search answers, clues, titles" dir="auto">
        <div class="form-check m-0">
          <input class="form-check-input" type="checkbox" id="unused" name="unused" value="1" <%= unused ? 'checked' : '' %>>
          <label class="form-check-label small" for="unused">Only questions not in a level</label>
        </div>
        <button class="btn btn-kd-outline btn-sm" type="submit">Search</button>
      </form>

      <%# One category at a time; the counts say how big each is. %>
      <nav class="wz-categories mb-3" aria-label="Categories">
        <% const link = (title) => '/admin/questions?title=' + encodeURIComponent(title) + (search ? '&q=' + encodeURIComponent(search) : '') + (unused ? '&unused=1' : ''); %>
        <% categories.forEach((c) => { %>
          <a class="btn btn-sm wz-ar <%= c.name === titleFilter ? 'btn-kd' : 'btn-kd-outline' %>" href="<%= link(c.name) %>"
             <%= c.name === titleFilter ? 'aria-current=page' : '' %>><%= c.name %> <span class="wz-category-count"><%= c.count %></span></a>
        <% }) %>
        <a class="btn btn-sm <%= showAll ? 'btn-kd' : 'btn-kd-ghost' %>" href="<%= link(allTitles) %>" <%= showAll ? 'aria-current=page' : '' %>>
          All <span class="wz-category-count"><%= total %></span></a>
      </nav>

      <% if (!questions.length) { %>
        <div class="ad-card ad-empty">
          <i data-lucide="message-circle-question"></i>
          <p class="mb-2">No questions<%= search || unused || titleFilter ? ' match' : ' yet' %>.</p>
          <a class="btn btn-kd btn-sm" href="/admin/questions/new">Add the first one</a>
        </div>
      <% } else { %>
        <form id="bulkForm" class="ad-card wz-bulk mb-3" method="post" action="/admin/questions/bulk" data-question-bulk>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="q" value="<%= search %>">
          <% if (unused) { %><input type="hidden" name="unused" value="1"><% } %>
          <% if (titleFilter) { %><input type="hidden" name="titleFilter" value="<%= titleFilter %>"><% } %>
          <% if (showAll) { %><input type="hidden" name="showAll" value="1"><% } %>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <strong class="small me-1"><span data-bulk-count>0</span> selected</strong>
            <div class="wz-bulk-group">
              <select class="form-select form-select-sm wz-bulk-field" name="level" aria-label="Level">
                <option value="">Level…</option>
                <% levels.forEach((l) => { %>
                  <option value="<%= l.id %>"><%= l.name %><%= l.published ? '' : ' (draft)' %></option>
                <% }) %>
              </select>
              <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="move" data-bulk-button>
                <i data-lucide="arrow-right-left" width="14" height="14" class="me-1"></i>Move</button>
            </div>
            <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="new-level" data-bulk-button>
              <i data-lucide="grid-3x3" width="14" height="14" class="me-1"></i>New level</button>
            <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="remove" data-bulk-button>
              <i data-lucide="log-out" width="14" height="14" class="me-1"></i>Out of levels</button>
            <div class="wz-bulk-group">
              <select class="form-select form-select-sm wz-bulk-field wz-ar" name="title" aria-label="New title">
                <option value="">اختر العنوان</option>
                <% categories.forEach((c) => { %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
              </select>
              <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="title" data-bulk-button>
                <i data-lucide="tag" width="14" height="14" class="me-1"></i>Set title</button>
            </div>
            <button class="btn btn-kd-danger btn-sm" type="submit" name="action" value="delete" data-bulk-button data-bulk-delete-button>
              <i data-lucide="trash-2" width="14" height="14" class="me-1"></i>Delete</button>
            <button class="btn btn-kd-ghost btn-sm ms-auto" type="button" data-bulk-clear>Clear</button>
          </div>
        </form>
        <div class="ad-card">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th class="wz-check"><input class="form-check-input" type="checkbox" data-bulk-all aria-label="Select all"></th><th>Picture</th><th>Answer</th><th>Type</th><th>Title</th><th>Clue</th><th>Levels</th><th></th></tr></thead>
              <tbody>
                <% questions.forEach((q) => { %>
                  <tr>
                    <td class="wz-check"><input class="form-check-input" type="checkbox" name="ids" value="<%= q.id %>" form="bulkForm"
                        data-bulk-row aria-label="Select <%= q.answer %>"></td>
                    <td><%- include('partials/qimage', { q, size: 'sm' }) %></td>
                    <td><span class="wz-answer"><%= q.answer %></span> <span class="kd-faint small"><%= [...q.answer].length %></span></td>
                    <td class="text-nowrap">
                      <span class="kd-tag"><%= { text: 'Text', image: 'Picture', emoji: 'Emoji', audio: 'Audio' }[q.type] %></span>
                      <% if (q.type === 'emoji' && q.emoji) { %><span class="wz-emoji"><%= q.emoji %></span><% } %>
                      <% if (q.blurred) { %><span class="kd-tag kd-tag-accent">blurred</span><% } %>
                    </td>
                    <td class="text-nowrap">
                      <% if (q.title) { %><span class="kd-tag wz-ar"><%= q.title %></span><% } else { %><span class="kd-tag kd-tag-warn">no title</span><% } %>
                      <% if (q.difficulty) { %><span class="kd-tag wz-diff <%= { easy: 'kd-tag-ok', medium: 'kd-tag-accent', hard: 'wz-tag-hard' }[q.difficulty] %>"><%= { easy: 'سهل', medium: 'متوسط', hard: 'صعب' }[q.difficulty] %></span><% } %>
                    </td>
                    <td class="wz-ar"><%= q.clue %></td>
                    <td><%= q.levelCount ? q.levelCount : '—' %></td>
                    <td class="text-end"><a class="btn btn-sm btn-kd-ghost" href="/admin/questions/<%= q.id %>">Edit</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
