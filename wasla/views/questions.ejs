<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'الأسئلة',
          subheading: questions.length + ' من ' + total + ' سؤالاً' + (titleFilter ? ' · ' + titleFilter : '') + (unused ? ' · خارج الألغاز' : ''),
          actions: '<a class="btn btn-kd btn-sm" href="/admin/questions/new">سؤال جديد</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <form class="wz-toolbar d-flex flex-wrap gap-2 align-items-center mb-3" method="get" action="/admin/questions">
        <input class="form-control wz-search" name="q" value="<%= search %>" placeholder="ابحث في الأجوبة والأدلة والفئات" dir="auto">
        <div class="form-check m-0">
          <input class="form-check-input" type="checkbox" id="unused" name="unused" value="1" <%= unused ? 'checked' : '' %>>
          <label class="form-check-label small" for="unused">الأسئلة خارج الألغاز فقط</label>
        </div>
        <button class="btn btn-kd-outline btn-sm" type="submit">بحث</button>
      </form>

      <% const here = '/admin/questions' + (showAll ? '?title=' + encodeURIComponent(allTitles) : titleFilter ? '?title=' + encodeURIComponent(titleFilter) : ''); %>
      <%# One category at a time; the counts say how big each is. %>
      <nav class="wz-categories mb-3" aria-label="Categories">
        <% const link = (title) => '/admin/questions?title=' + encodeURIComponent(title) + (search ? '&q=' + encodeURIComponent(search) : '') + (unused ? '&unused=1' : ''); %>
        <% categories.forEach((c) => { %>
          <a class="btn btn-sm wz-ar <%= c.name === titleFilter ? 'btn-kd' : 'btn-kd-outline' %>" href="<%= link(c.name) %>"
             <%= c.name === titleFilter ? 'aria-current=page' : '' %>><%= c.name %> <span class="wz-category-count"><%= c.count %></span></a>
        <% }) %>
        <a class="btn btn-sm <%= showAll ? 'btn-kd' : 'btn-kd-ghost' %>" href="<%= link(allTitles) %>" <%= showAll ? 'aria-current=page' : '' %>>
          الكل <span class="wz-category-count"><%= total %></span></a>
      </nav>

      <% if (!questions.length) { %>
        <div class="ad-card ad-empty">
          <%- icon('message-circle-question', 28) %>
          <p class="mb-2">لا أسئلة<%= search || unused || titleFilter ? ' match' : ' yet' %>.</p>
          <a class="btn btn-kd btn-sm" href="/admin/questions/new">أضف الأول</a>
        </div>
      <% } else { %>
        <form id="bulkForm" class="ad-card wz-bulk mb-3" method="post" action="/admin/questions/bulk" data-question-bulk>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="q" value="<%= search %>">
          <% if (unused) { %><input type="hidden" name="unused" value="1"><% } %>
          <% if (titleFilter) { %><input type="hidden" name="titleFilter" value="<%= titleFilter %>"><% } %>
          <% if (showAll) { %><input type="hidden" name="showAll" value="1"><% } %>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <strong class="small me-1"><span data-bulk-count>0</span> محدَّد</strong>
            <div class="wz-bulk-group">
              <select class="form-select form-select-sm wz-bulk-field" name="level" aria-label="Level">
                <option value="">اللغز…</option>
                <% levels.forEach((l) => { %>
                  <option value="<%= l.id %>"><%= l.name %><%= l.published ? '' : ' (draft)' %></option>
                <% }) %>
              </select>
              <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="move" data-bulk-button>
                <span class="me-1"><%- icon('arrow-right-left', 14) %></span>نقل</button>
            </div>
            <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="new-level" data-bulk-button>
              <span class="me-1"><%- icon('grid-3x3', 14) %></span>لغز جديد</button>
            <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="remove" data-bulk-button>
              <span class="me-1"><%- icon('log-out', 14) %></span>إخراج من الألغاز</button>
            <div class="wz-bulk-group">
              <select class="form-select form-select-sm wz-bulk-field wz-ar" name="title" aria-label="New title">
                <option value="">اختر العنوان</option>
                <% categories.forEach((c) => { %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
              </select>
              <button class="btn btn-kd-outline btn-sm" type="submit" name="action" value="title" data-bulk-button>
                <span class="me-1"><%- icon('tag', 14) %></span>تعيين الفئة</button>
            </div>
            <button class="btn btn-kd-danger btn-sm" type="submit" name="action" value="delete" data-bulk-button data-bulk-delete-button>
              <span class="me-1"><%- icon('trash-2', 14) %></span>حذف</button>
            <button class="btn btn-kd-ghost btn-sm ms-auto" type="button" data-bulk-select-all>
              تحديد الكل <span class="wz-category-count"><%= questions.length %></span></button>
            <button class="btn btn-kd-ghost btn-sm" type="button" data-bulk-clear>إلغاء</button>
          </div>
        </form>
        <div class="ad-card">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead><tr><th class="wz-check"><input class="form-check-input" type="checkbox" data-bulk-all aria-label="تحديد all"></th><th>الصورة</th><th>الجواب</th><th>النوع</th><th>الفئة</th><th>الدليل</th><th>الألغاز</th><th></th></tr></thead>
              <tbody>
                <% questions.forEach((q) => { %>
                  <tr>
                    <td class="wz-check"><input class="form-check-input" type="checkbox" name="ids" value="<%= q.id %>" form="bulkForm"
                        data-bulk-row aria-label="تحديد <%= q.answer %>"></td>
                    <td>
                      <% if (q.needsPicture) { %>
                        <form method="post" action="/admin/questions/<%= q.id %>/picture" enctype="multipart/form-data" class="m-0">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="back" value="<%= here %>">
                          <label class="btn btn-sm btn-kd-outline wz-upload">
                            <%- icon('image-plus', 14) %>رفع
                            <input type="file" name="image" accept=".png,.jpg,.jpeg,.webp" data-auto-submit class="visually-hidden">
                          </label>
                          <noscript><button class="btn btn-sm btn-kd" type="submit">حفظ</button></noscript>
                        </form>
                      <% } else { %>
                        <%- include('partials/qimage', { q, size: 'sm' }) %>
                      <% } %>
                    </td>
                    <td><span class="wz-answer"><%= q.answer %></span> <span class="kd-faint small"><%= [...q.answer].length %></span></td>
                    <td class="text-nowrap">
                      <span class="kd-tag"><%= { text: 'نص', image: 'صورة', emoji: 'إيموجي', audio: 'صوت' }[q.type] %></span>
                      <% if (q.needsPicture) { %><span class="kd-tag kd-tag-warn">تحتاج صورة</span><% } %>
                      <% if (q.type === 'emoji' && q.emoji) { %><span class="wz-emoji"><%= q.emoji %></span><% } %>
                      <% if (q.blurred) { %><span class="kd-tag kd-tag-accent">مموّهة</span><% } %>
                    </td>
                    <td class="text-nowrap">
                      <% if (q.title) { %><span class="kd-tag wz-ar"><%= q.title %></span><% } else { %><span class="kd-tag kd-tag-warn">بلا فئة</span><% } %>
                      <% if (q.difficulty) { %><span class="kd-tag wz-diff <%= { easy: 'kd-tag-ok', medium: 'kd-tag-accent', hard: 'wz-tag-hard' }[q.difficulty] %>"><%= { easy: 'سهل', medium: 'متوسط', hard: 'صعب' }[q.difficulty] %></span><% } %>
                    </td>
                    <td class="wz-ar"><%= q.clue %></td>
                    <td><%= q.levelCount ? q.levelCount : '—' %></td>
                    <td class="text-end text-nowrap">
                      <a class="btn btn-sm btn-kd-ghost" href="/admin/questions/<%= q.id %>/preview" title="انظر ما يراه اللاعب" aria-label="معاينة <%= q.answer %>">
                        <%- icon('smartphone', 14) %>
                      </a>
                      <a class="btn btn-sm btn-kd-ghost" href="/admin/questions/<%= q.id %>">تعديل</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
