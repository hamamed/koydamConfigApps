<%- include('partials/head') %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@500;700;800&display=swap" rel="stylesheet">
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: (day ? 'Edit ' : 'Plan ') + date,
          subheading: weekdayAr + ' · ' + (day ? 'شبكة مخطَّطة؛ الحفظ يستبدلها' : 'غير مخطَّط بعد: الشبكة التلقائية معبّأة مسبقاً'),
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-sm btn-kd-ghost" href="/admin/days/<%= date %>"><%- icon('arrow-left', 14) %> العودة إلى اليوم</a>
        <span class="kd-tag kd-tag-accent"><%= date %> · <span class="wz-ar"><%= weekdayAr %></span></span>
        <% if (date === today) { %><span class="kd-tag kd-tag-warn">اليوم — قد تكون هذه الشبكة عند اللاعبين بالفعل</span><% } %>
      </div>

      <form id="dailyEditor" method="post" action="/admin/daily/<%= date %>/edit" data-preview-url="/admin/daily/<%= date %>/preview" class="row g-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="seed" value="<%= state.seed %>">

        <div class="col-xl-5 d-grid gap-3 align-content-start">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('tags', 16) %>
              <span class="fw-semibold me-auto">الكلمات</span>
              <div class="btn-group btn-group-sm" role="group" aria-label="مصدر الموضوع">
                <input type="radio" class="btn-check" name="source" id="sourceTheme" value="theme" <%= state.source === 'theme' ? 'checked' : '' %>>
                <label class="btn btn-kd-outline" for="sourceTheme">من موضوع</label>
                <input type="radio" class="btn-check" name="source" id="sourceCustom" value="custom" <%= state.source === 'custom' ? 'checked' : '' %>>
                <label class="btn btn-kd-outline" for="sourceCustom">كلمات مكتوبة</label>
              </div>
            </div>

            <div class="ad-card-body <%= state.source === 'theme' ? '' : 'd-none' %>" data-source-panel="theme">
              <% if (!groups.length) { %>
                <p class="small kd-muted mb-0">لا فئة أسئلة فيها <%= minWords %> كلمات صالحة بعد. استعمل كلمات مكتوبة، أو أضف أسئلة في <a href="/admin/wordsearch">مواضيع البحث</a>.</p>
              <% } else { %>
                <label class="form-label small fw-semibold" for="themeTitle">الموضوع</label>
                <select class="form-select mb-2" id="themeTitle" name="themeTitle">
                  <% if (!groups.some((g) => g.selected)) { %><option value="">اختر موضوعاً</option><% } %>
                  <% groups.forEach((g) => { %>
                    <option value="<%= g.title %>" <%= g.title === state.themeTitle ? 'selected' : '' %>><%= g.title %>&lrm; — <%= g.words.length %> words<%= g.excluded ? ' (excluded from the rotation)' : '' %><%= g.stale ? ' (saved; no longer a theme)' : '' %></option>
                  <% }) %>
                </select>
                <p class="form-text mt-0">Tick <%= minWords %>–<%= maxWords %> كلمات. الكلمة الأطول من حجم الشبكة لا تدخل.</p>
                <% groups.forEach((g) => { const on = g.title === state.themeTitle; %>
                  <div class="wz-pick-group <%= on ? '' : 'd-none' %>" data-theme-group="<%= g.title %>">
                    <% if (g.stale) { %><p class="small kd-faint mb-1">الكلمات المحفوظة؛ لم يعد في هذه الفئة <%= minWords %> أسئلة صالحة.</p><% } %>
                    <% g.words.forEach((w) => { %>
                      <label class="wz-pick">
                        <input class="form-check-input" type="checkbox" name="wordIds" value="<%= w.id %>" <%= g.ticked.has(w.id) ? 'checked' : '' %> <%= on ? '' : 'disabled' %>>
                        <span class="min-w-0 d-flex align-items-center gap-2">
                          <span class="wz-answer"><%= w.display %></span>
                          <% if (w.display !== w.word) { %><span class="kd-faint small wz-ar">يُلعب: <%= w.word %></span><% } %>
                        </span>
                        <span class="kd-tag"><%= [...w.word].length %> حروف</span>
                      </label>
                    <% }) %>
                  </div>
                <% }) %>
              <% } %>
            </div>

            <div class="ad-card-body <%= state.source === 'custom' ? '' : 'd-none' %>" data-source-panel="custom">
              <label class="form-label small fw-semibold" for="customTheme">اسم الموضوع</label>
              <input class="form-control wz-ar mb-3" type="text" id="customTheme" name="customTheme" maxlength="40" dir="rtl" value="<%= state.customTheme %>" placeholder="مثلاً: ألوان">
              <label class="form-label small fw-semibold" for="customWords">الكلمات، واحدة في كل سطر</label>
              <textarea class="form-control wz-ar ws-words-input" id="customWords" name="customWords" rows="10" dir="rtl" placeholder="أحمر&#10;أزرق&#10;أخضر"><%= state.customWords %></textarea>
              <p class="form-text mb-0">
                <%= minWords %>–<%= maxWords %> كلمات من 3 إلى 8 حروف عربية، كل واحدة مرة واحدة، ولا تُقرأ إحداها داخل أخرى. تُزال الحركات و
                hamza forms are played folded, as for question answers. These words belong to no question.
              </p>
            </div>
          </div>

          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('grid-3x3', 16) %>
              <span class="fw-semibold me-auto">الشبكة</span>
            </div>
            <div class="ad-card-body">
              <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                  <label class="form-label small fw-semibold" for="size">الحجم</label>
                  <select class="form-select" id="size" name="size">
                    <% sizes.forEach((s) => { %>
                      <option value="<%= s %>" <%= s === state.size ? 'selected' : '' %>><%= s %> × <%= s %><%= s === weekdaySize ? ' (weekday size)' : '' %></option>
                    <% }) %>
                  </select>
                </div>
                <button class="btn btn-kd-outline" type="submit" name="action" value="preview" data-preview>معاينة</button>
                <button class="btn btn-kd-ghost" type="submit" name="action" value="shuffle" data-shuffle>
                  <%- icon('shuffle', 14) %> إعادة ترتيب
                </button>
                <button class="btn btn-kd-accent ms-auto" type="submit" name="action" value="save" data-save <%= composed.canSave ? '' : 'disabled' %>>حفظ الشبكة</button>
              </div>
              <p class="form-text mb-0 mt-2">إعادة الترتيب توزّع الكلمات نفسها من جديد. الحفظ يجمّد الشبكة المعروضة تماماً.</p>
            </div>
          </div>
        </div>

        <div class="col-xl-7">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('eye', 16) %>
              <span class="fw-semibold me-auto">معاينة</span>
            </div>
            <div class="ad-card-body" id="dailyPreview" aria-live="polite">
              <%- include('partials/daily-preview') %>
            </div>
          </div>
        </div>
      </form>
    </div>
  </main>
</div>
<script src="/assets/js/wasla-daily.js?v=<%= assetVersion %>"></script>
<%- include('partials/foot') %>
