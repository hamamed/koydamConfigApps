<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'Import preview',
          subheading: fileName + ' · ' + plan.length + ' rows · ' + valid + ' ready · ' + (plan.length - valid) + ' with errors · ' + mediaCount + ' media files'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body d-flex flex-wrap gap-2 align-items-center">
          <button class="btn btn-kd-outline" type="submit" form="importRows" name="then" value="save">
            <i data-lucide="check" width="14" height="14" class="me-1"></i>Save changes
          </button>
          <button class="btn btn-kd" type="submit" form="importRows" name="then" value="confirm"
                  data-confirm-click="Save your changes and import the valid rows? Rows with errors are skipped.">
            Save and import the valid rows (<%= valid %>)
          </button>
          <form method="post" action="/admin/import/<%= id %>/cancel" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-kd-ghost" type="submit">Cancel import</button>
          </form>
          <span class="small kd-faint ms-md-2">
            Edit any row below, or remove it with <i data-lucide="x" width="13" height="13"></i>. Nothing is added until you import.
            <% if (plan.length - valid) { %><strong><%= plan.length - valid %> row(s) still have errors</strong> and will be skipped unless you fix them.<% } %>
          </span>
        </div>
      </div>

      <% if (fileErrors.length || unused.length) { %>
        <div class="alert alert-warning small">
          <% fileErrors.forEach((f) => { %><div><strong><%= f.name %></strong>: <%= f.error %></div><% }) %>
          <% if (unused.length) { %>
            <div>Not named by any valid row, and removed on import: <% unused.forEach((m) => { %><span class="kd-tag"><%= m.name %></span> <% }) %></div>
          <% } %>
        </div>
      <% } %>

      <form id="importRows" class="ad-card" method="post" action="/admin/import/<%= id %>/rows" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <datalist id="importTitles"><% titles.forEach((t) => { %><option value="<%= t %>"><% }) %></datalist>
        <div class="ad-table-wrap">
          <table class="ad-table wz-import">
            <thead><tr><th>Row</th><th>Status</th><th>Answer</th><th>Title</th><th>Clue</th><th>Type</th><th>Media</th><th>Level</th></tr></thead>
            <tbody>
              <% plan.forEach((p) => { const v = values.get(p.row) || {}; %>
                <tr class="<%= p.error ? 'wz-row-error' : '' %>">
                  <td class="kd-faint text-nowrap">
                    <button class="btn btn-sm btn-kd-ghost wz-row-remove" type="submit" name="remove" value="<%= p.row %>"
                            title="Remove row <%= p.row %>" aria-label="Remove row <%= p.row %>">
                      <i data-lucide="x" width="14" height="14"></i>
                    </button>
                    <%= p.row %>
                  </td>
                  <td>
                    <% if (p.error) { %>
                      <span class="kd-tag wz-tag-hard">Error</span>
                      <div class="small wz-error-text"><%= p.error %></div>
                    <% } else { %>
                      <span class="kd-tag kd-tag-ok">Ready</span>
                    <% } %>
                  </td>
                  <td>
                    <input class="form-control form-control-sm wz-ar wz-import-answer" name="answer_<%= p.row %>" value="<%= v.answer ?? '' %>"
                           dir="rtl" aria-label="Answer, row <%= p.row %>">
                    <% if (!p.error && p.playAnswer !== p.storedAnswer) { %><div class="small kd-faint wz-ar" dir="rtl">يُلعب: <span class="wz-answer"><%= p.playAnswer %></span></div><% } %>
                  </td>
                  <td>
                    <input class="form-control form-control-sm wz-ar wz-import-title" name="title_<%= p.row %>" value="<%= v.title ?? '' %>"
                           list="importTitles" maxlength="40" dir="auto" aria-label="Title, row <%= p.row %>">
                  </td>
                  <td>
                    <textarea class="form-control form-control-sm wz-ar wz-import-clue" name="clue_<%= p.row %>" rows="2" dir="rtl"
                              aria-label="Clue, row <%= p.row %>"><%= v.clue ?? '' %></textarea>
                  </td>
                  <td class="text-nowrap">
                    <% if (!p.error) { %><span class="kd-tag"><%= { text: 'Text', image: 'Picture', emoji: 'Emoji', audio: 'Audio' }[p.type] %></span><% } %>
                    <% if (!p.error && p.type === 'emoji') { %><div class="wz-emoji mt-1"><%= p.input.emoji %></div><% } %>
                    <% if (!p.error && p.input.imageFile && ['1', 'true', 'on', 'yes'].includes(String(p.input.blurred ?? '').toLowerCase())) { %><div><span class="kd-tag kd-tag-accent mt-1">blurred</span></div><% } %>
                  </td>
                  <td>
                    <% if (!p.error && p.input.imageFile) { %>
                      <%- include('partials/qimage', { q: { imageFile: p.input.imageFile, zoom: Number(p.input.zoom ?? 1), focusX: Number(p.input.focusX ?? 0.5), focusY: Number(p.input.focusY ?? 0.5) }, size: 'sm' }) %>
                    <% } %>
                    <% if (!p.error && p.input.audioFile) { %>
                      <audio class="wz-audio-sm" controls preload="none" src="<%= audioUrl(p.input.audioFile) %>"></audio>
                    <% } %>
                  </td>
                  <td>
                    <input class="form-control form-control-sm wz-import-level" name="level_<%= p.row %>" value="<%= v.level ?? '' %>"
                           inputmode="numeric" placeholder="—" aria-label="Level, row <%= p.row %>">
                    <% if (!p.error && p.levelIsNew) { %><span class="kd-tag kd-tag-accent mt-1">new</span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </form>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
