<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'معاينة الاستيراد',
          subheading: fileName + ' · ' + plan.length + ' صف · ' + valid + ' جاهز · ' + (plan.length - valid) + ' بأخطاء · ' + mediaCount + ' ملف وسائط'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body d-flex flex-wrap gap-2 align-items-center">
          <button class="btn btn-kd-outline" type="submit" form="importRows" name="then" value="save">
            <i data-lucide="check" width="14" height="14" class="me-1"></i>حفظ التعديلات
          </button>
          <button class="btn btn-kd-outline" type="submit" form="importRows" name="then" value="selected" data-import-selected disabled>
            <i data-lucide="list-checks" width="14" height="14" class="me-1"></i>استورد المحدَّد (<span data-import-count>0</span>)</button>
          <button class="btn btn-kd" type="submit" form="importRows" name="then" value="confirm"
                  data-confirm-click="Save your changes and import the valid rows? Rows with errors are skipped.">
            احفظ واستورد كل الصفوف الصالحة (<%= valid %>)
          </button>
          <form method="post" action="/admin/import/<%= id %>/cancel" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-kd-ghost" type="submit">إلغاء الاستيراد</button>
          </form>
          <span class="small kd-faint ms-md-2">
            عدّل أي صف، أو استورده وحده بـ <i data-lucide="check" width="13" height="13"></i>، أو حدّد صفوفاً لاستيراد بعضها،
            or remove one with <i data-lucide="x" width="13" height="13"></i>. لا يُضاف شيء حتى تستورد.
            <% if (plan.length - valid) { %><strong><%= plan.length - valid %> صفاً ما زال فيه أخطاء</strong> وستُتخطى ما لم تصلحها.<% } %>
          </span>
        </div>
      </div>

      <% if (fileErrors.length || unused.length) { %>
        <div class="alert alert-warning small">
          <% fileErrors.forEach((f) => { %><div><strong><%= f.name %></strong>: <%= f.error %></div><% }) %>
          <% if (unused.length) { %>
            <div>لم يسمّها أي صف صالح، وستُحذف عند الاستيراد: <% unused.forEach((m) => { %><span class="kd-tag"><%= m.name %></span> <% }) %></div>
          <% } %>
        </div>
      <% } %>

      <form id="importRows" class="ad-card" method="post" action="/admin/import/<%= id %>/rows" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <datalist id="importTitles"><% titles.forEach((t) => { %><option value="<%= t %>"><% }) %></datalist>
        <div class="ad-table-wrap">
          <table class="ad-table wz-import">
            <thead><tr><th class="wz-check"><input class="form-check-input" type="checkbox" data-import-all aria-label="تحديد كل الصفوف"></th><th>Row</th><th>الحالة</th><th>الجواب</th><th>الفئة</th><th>الدليل</th><th>النوع</th><th>الوسائط</th><th>اللغز</th></tr></thead>
            <tbody>
              <% plan.forEach((p) => { const v = values.get(p.row) || {}; %>
                <tr class="<%= p.error ? 'wz-row-error' : '' %>">
                  <td class="wz-check">
                    <input class="form-check-input" type="checkbox" name="pick" value="<%= p.row %>" data-import-pick
                           aria-label="تحديد الصف <%= p.row %>">
                  </td>
                  <td class="kd-faint text-nowrap">
                    <button class="btn btn-sm btn-kd-ghost wz-row-remove" type="submit" name="remove" value="<%= p.row %>"
                            title="حذف الصف <%= p.row %>" aria-label="حذف الصف <%= p.row %>">
                      <i data-lucide="x" width="14" height="14"></i>
                    </button>
                    <%= p.row %>
                  </td>
                  <td class="wz-import-status">
                    <% if (!p.error) { %>
                      <button class="btn btn-sm btn-kd-outline wz-row-import" type="submit" name="importRow" value="<%= p.row %>"
                              title="استيراد الصف <%= p.row %> الآن" aria-label="استيراد الصف <%= p.row %> now">
                        <i data-lucide="check" width="14" height="14"></i>
                      </button>
                    <% } %>
                    <% if (p.error) { %>
                      <span class="kd-tag wz-tag-hard">خطأ</span>
                      <div class="small wz-error-text"><%= p.error %></div>
                    <% } else { %>
                      <span class="kd-tag kd-tag-ok">جاهز</span>
                    <% } %>
                  </td>
                  <td>
                    <input class="form-control form-control-sm wz-ar wz-import-answer" name="answer_<%= p.row %>" value="<%= v.answer ?? '' %>"
                           dir="rtl" aria-label="الجواب، الصف <%= p.row %>">
                    <% if (!p.error && p.playAnswer !== p.storedAnswer) { %><div class="small kd-faint wz-ar" dir="rtl">يُلعب: <span class="wz-answer"><%= p.playAnswer %></span></div><% } %>
                  </td>
                  <td>
                    <input class="form-control form-control-sm wz-ar wz-import-title" name="title_<%= p.row %>" value="<%= v.title ?? '' %>"
                           list="importTitles" maxlength="40" dir="auto" aria-label="الفئة، الصف <%= p.row %>">
                  </td>
                  <td>
                    <textarea class="form-control form-control-sm wz-ar wz-import-clue" name="clue_<%= p.row %>" rows="2" dir="rtl"
                              aria-label="الدليل، الصف <%= p.row %>"><%= v.clue ?? '' %></textarea>
                  </td>
                  <td class="wz-import-status">
                    <% if (!p.error) { %><span class="kd-tag"><%= { text: 'نص', image: 'صورة', emoji: 'إيموجي', audio: 'صوت' }[p.type] %></span><% } %>
                    <% if (!p.error && p.type === 'emoji') { %><div class="wz-emoji mt-1"><%= p.input.emoji %></div><% } %>
                    <% if (!p.error && p.input.imageFile && ['1', 'true', 'on', 'yes'].includes(String(p.input.blurred ?? '').toLowerCase())) { %><div><span class="kd-tag kd-tag-accent mt-1">مموّهة</span></div><% } %>
                  </td>
                  <td>
                    <% if (!p.error && p.input.imageFile) { %>
                      <%- include('partials/qimage', { q: { imageFile: p.input.imageFile, zoom: Number(p.input.zoom ?? 1), focusX: Number(p.input.focusX ?? 0.5), focusY: Number(p.input.focusY ?? 0.5) }, size: 'sm' }) %>
                    <% } %>
                    <% if (!p.error && p.input.audioFile) { %>
                      <audio class="wz-audio-sm" controls preload="none" src="<%= audioUrl(p.input.audioFile) %>"></audio>
                    <% } %>
                  </td>
                  <td>
                    <input class="form-control form-control-sm wz-import-level" name="level_<%= p.row %>" value="<%= v.level ?? '' %>"
                           inputmode="numeric" placeholder="—" aria-label="اللغز، الصف <%= p.row %>">
                    <% if (!p.error && p.levelIsNew) { %><span class="kd-tag kd-tag-accent mt-1">new</span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </form>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
