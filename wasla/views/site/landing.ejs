<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%- include('../partials/seo-head', { seo }) %>
  <meta name="theme-color" content="#e9f6f3">
  <link rel="icon" href="/assets/favicon.png?v=<%= assetVersion %>" type="image/png">
  <%# iOS masks this itself, so it is the square icon rather than the rounded one. %>
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Lalezar&display=swap" rel="stylesheet">
  <link href="/assets/css/wasla.css?v=<%= assetVersion %>" rel="stylesheet">
  <link href="/assets/css/site.css?v=<%= assetVersion %>" rel="stylesheet">
</head>
<body class="wz-site wz-ground">

<header class="wz-hero">
  <div class="wz-hero-text">
    <h1 class="wz-hero-title">كلمات متقاطعة… بالعربي</h1>
    <p class="wz-hero-lede">
      ألغاز مكتوبة بأيدينا، ولعبة جديدة كل يوم من أيام الأسبوع، ولوحات للمتصدرين.
      مجانية، ويُلعب بلا حساب.
    </p>

    <%- include('stores') %>

    <ul class="wz-hero-points">
      <% [['star', 'ألغاز بثلاث نجوم'], ['gamepad-2', 'لعبة كل يوم'], ['trophy', 'لوحات متصدرين']].forEach(([glyph, text]) => { %>
        <li>
          <% if (hasIcons) { %><img src="<%= iconUrl(glyph) %>" alt="" width="24" height="24" loading="lazy"><% } %>
          <span><%= text %></span>
        </li>
      <% }) %>
    </ul>

    <p class="wz-hero-note">مجانية · بالعربية · للآيفون والآيباد</p>
  </div>

  <%# The icon itself, not the drawn lockup: it is what someone will look for
      in the App Store, so it is what the page leads with. %>
  <div class="wz-hero-mark">
    <figure class="wz-appicon">
      <img src="/assets/site/app-icon.png?v=<%= assetVersion %>" alt="أيقونة تطبيق شبّك"
           width="176" height="176" fetchpriority="high">
      <figcaption>شبّك</figcaption>
    </figure>
  </div>
</header>

<section class="wz-numbers">
  <% [
       [levels, 'لغزاً منشوراً', 'grid-3x3'],
       [questions, 'سؤالاً في البنك', 'message-circle-question'],
       [rungs, 'درجات في سُلّم كل يوم', 'calendar-days'],
       [boards.length, 'لوحات متصدرين', 'trophy'],
     ].forEach(([value, label, glyph]) => { %>
    <div class="wz-number">
      <% if (hasIcons) { %><img class="wz-number-icon" src="<%= iconUrl(glyph) %>" alt="" width="34" height="34" loading="lazy"><% } %>
      <span class="wz-number-value"><%= value.toLocaleString('en') %></span>
      <span class="wz-number-label"><%= label %></span>
    </div>
  <% }) %>
</section>

<section class="wz-features">
  <h2 class="wz-h2">ماذا في اللعبة؟</h2>
  <div class="wz-feature-grid">
    <% [
         ['الألغاز', 'شبكة كلمات متقاطعة: اسحب إصبعك على الشبكة لتختار سؤالاً، واضغط حروف جوابه. في كل لغز نحو عشرة أسئلة من فئات مختلفة، وثلاث نجوم لمن يُنهيه دون مساعدة.', 'grid-3x3'],
         ['لغز اليوم', 'سُلّم من خمس درجات كل يوم، تُلعب بالترتيب وكل درجة تفتح التي بعدها: فقاعات الكلمات، ووصّل الحروف، وعجلة الحروف، وخمّن الكلمة، والبحث عن الكلمات — والجمعة ماراثون يجمعها كلها.', 'calendar-days'],
         ['سلسلة الأيام', 'العب كل يوم لتكبر سلسلتك ومكافأتها، ولك حماية تشتريها بالعملات إذا فاتك يوم.', 'fire'],
         ['المتصدرون', `${boards.length} لوحات كما في التطبيق: ${boards.join('، ')}. لوحة لغز اليوم تبدأ من جديد كل يوم، والبقية تجمع ما لعبته كله.`, 'trophy'],
         ['أسئلة يكتبها بشر', 'أكثر من عشرين فئة: معلومات عامة، أمثال عربية، إسلاميات، خرائط، شعارات، أطباق، نحو وإعراب، وغيرها — لا أسئلة مولّدة بلا مراجعة.', 'message-circle-question'],
         ['بلا حساب', 'لا بريد ولا كلمة سر. اسم اللاعب اختياري، ويكفي أن تفتح اللعبة لتلعب.', 'shield'],
       ].forEach(([title, text, glyph]) => { %>
      <article class="wz-feature">
        <% if (hasIcons) { %>
          <span class="wz-feature-icon"><img src="<%= iconUrl(glyph) %>" alt="" width="30" height="30" loading="lazy"></span>
        <% } %>
        <h3><%= title %></h3>
        <p><%= text %></p>
      </article>
    <% }) %>
  </div>
</section>

<%# The store screenshots, at the size the page draws them; width and height are
    set so nothing jumps while they load. %>
<section class="wz-shots-section">
  <h2 class="wz-h2">من داخل اللعبة</h2>
  <p class="wz-shots-hint">اسحب لرؤية المزيد</p>
  <div class="wz-gallery">
    <%# The arrows are for a mouse; a finger swipes the strip itself. In a page
        that reads right to left, «previous» is the one on the right. %>
    <button class="wz-gallery-arrow" type="button" data-gallery-prev aria-label="الصورة السابقة" aria-controls="wzShots">›</button>
    <div class="wz-shots" id="wzShots" data-gallery tabindex="0" role="group"
         aria-roledescription="معرض" aria-label="صور من داخل اللعبة">
    <% [
      ['shot-1', 'شبّك — عالم من الذكاء: رحلة تفاعلية تجمع بين الألغاز والمعرفة'],
      ['shot-2', 'لغز اليوم: خمس ألعاب تُلعب بالترتيب، وجوائز على إكمالها'],
      ['shot-3', 'شبكة الكلمات المتقاطعة وأنت تملؤها بإصبعك'],
      ['shot-4', 'أسئلة إسلاميات: أكمل الآية'],
      ['shot-5', 'أسئلة الصور: ما الذي في الصورة؟'],
      ['shot-6', 'أسئلة الخرائط والدول'],
      ['shot-7', 'البحث عن الكلمات في شبكة الحروف'],
    ].forEach(([file, alt], index) => { %>
      <%# The first two are on screen at once on a wide page, so they are not lazy. %>
      <%# WebP is about a third of the JPEG's weight; the JPEG stays for anything that cannot read it. %>
      <picture>
        <source srcset="/assets/site/<%= file %>.webp?v=<%= assetVersion %>" type="image/webp">
        <img src="/assets/site/<%= file %>.jpg?v=<%= assetVersion %>" alt="<%= alt %>"
             width="260" height="565" decoding="async"
             loading="<%= index < 2 ? 'eager' : 'lazy' %>">
      </picture>
      <% }) %>
    </div>
    <button class="wz-gallery-arrow" type="button" data-gallery-next aria-label="الصورة التالية" aria-controls="wzShots">‹</button>
  </div>
  <div class="wz-gallery-dots" data-gallery-dots></div>
</section>

<section class="wz-cta">
  <h2 class="wz-h2">جاهز؟</h2>
  <%- include('stores') %>
</section>

<footer class="wz-site-foot">
  <a href="/privacy">سياسة الخصوصية</a>
  <a href="/support">الدعم</a>
  <a href="/credits">شكر الصور</a>
  <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
  <span class="wz-site-copy">© <%= new Date().getFullYear() %> Koydam</span>
</footer>

<script src="/assets/js/site.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
