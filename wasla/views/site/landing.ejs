<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="شبّك لعبة كلمات متقاطعة عربية: ألغاز مرسومة بخط اليد، ولعبة جديدة كل يوم، ولوحات متصدرين. حمّلها مجاناً.">
  <meta name="theme-color" content="#e9f6f3">
  <link rel="icon" href="/assets/favicon.png?v=<%= assetVersion %>" type="image/png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="شبّك">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="ألغاز كلمات متقاطعة عربية، ولعبة جديدة كل يوم.">
  <meta property="og:locale" content="ar_AR">
  <meta property="og:image" content="/assets/site/screen-home.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Lalezar&display=swap" rel="stylesheet">
  <link href="/assets/css/wasla.css?v=<%= assetVersion %>" rel="stylesheet">
  <link href="/assets/css/site.css?v=<%= assetVersion %>" rel="stylesheet">
</head>
<body class="wz-site">

<header class="wz-hero">
  <div class="wz-hero-text">
    <h1 class="wz-hero-title">كلمات متقاطعة… بالعربي</h1>
    <p class="wz-hero-lede">
      ألغاز مكتوبة بأيدينا، ولعبة جديدة كل يوم من أيام الأسبوع، ولوحات متصدرين تتجدد كل يوم.
      بلا إعلانات، ويُلعب بلا حساب.
    </p>

    <%- include('stores') %>

    <ul class="wz-hero-points">
      <% [['star', 'ألغاز بثلاث نجوم'], ['gamepad-2', 'لعبة كل يوم'], ['trophy', 'لوحات متصدرين']].forEach(([glyph, text]) => { %>
        <li>
          <% if (hasIcons) { %><img src="<%= iconUrl(glyph) %>" alt="" width="24" height="24" loading="lazy"><% } %>
          <span><%= text %></span>
        </li>
      <% }) %>
    </ul>

    <p class="wz-hero-note">مجانية · بالعربية · للآيفون والآيباد</p>
  </div>

  <div class="wz-hero-mark">
    <%- include('../partials/brand', { size: 'clamp(76px, 11vw, 148px)' }) %>
  </div>
</header>

<section class="wz-numbers">
  <% [
       [levels || 150, 'لغزاً منشوراً', 'grid-3x3'],
       [questions || 4400, 'سؤالاً في البنك', 'message-circle-question'],
       [7, 'أيام، ولكل يوم لعبته', 'calendar-days'],
       [5, 'لوحات متصدرين', 'trophy'],
     ].forEach(([value, label, glyph]) => { %>
    <div class="wz-number">
      <% if (hasIcons) { %><img class="wz-number-icon" src="<%= iconUrl(glyph) %>" alt="" width="34" height="34" loading="lazy"><% } %>
      <span class="wz-number-value"><%= value.toLocaleString('en') %></span>
      <span class="wz-number-label"><%= label %></span>
    </div>
  <% }) %>
</section>

<section class="wz-features">
  <h2 class="wz-h2">ماذا في اللعبة؟</h2>
  <div class="wz-feature-grid">
    <% [
         ['الألغاز', 'شبكة كلمات متقاطعة، تُختار حروفها بسحب الإصبع. كل لغز عشرة أسئلة من فئات مختلفة، وثلاث نجوم لمن يُنهيه دون مساعدة.', 'grid-3x3'],
         ['لغز اليوم', 'لكل يوم لعبته: البحث عن الكلمات، وفقاعات الكلمات على صورة، وعجلة الحروف، وخمّن الكلمتين — والجمعة ماراثون يجمعها كلها.', 'calendar-days'],
         ['سلسلة الأيام', 'العب كل يوم لتكبر سلسلتك ومكافأتها، ولك حماية تشتريها بالعملات إذا فاتك يوم.', 'fire'],
         ['المتصدرون', 'خمس لوحات: أسرع من أنهى لعبة اليوم، وأسرع بحث، وأطول سلسلة، وأكثر نقاطاً، وأكثر نجوماً.', 'trophy'],
         ['أسئلة يكتبها بشر', 'أكثر من عشرين فئة: معلومات عامة، أمثال عربية، إسلاميات، خرائط، شعارات، أطباق، نحو وإعراب، وغيرها — لا أسئلة مولّدة بلا مراجعة.', 'message-circle-question'],
         ['بلا إعلانات', 'لا إعلانات ولا متابعة. اسم اللاعب اختياري، ويكفي أن تفتح اللعبة لتلعب.', 'shield'],
       ].forEach(([title, text, glyph]) => { %>
      <article class="wz-feature">
        <% if (hasIcons) { %>
          <span class="wz-feature-icon"><img src="<%= iconUrl(glyph) %>" alt="" width="30" height="30" loading="lazy"></span>
        <% } %>
        <h3><%= title %></h3>
        <p><%= text %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="wz-shots">
  <img src="/assets/site/screen-home.png?v=<%= assetVersion %>" alt="شاشة الألغاز في شبّك" width="260" loading="lazy">
  <img src="/assets/site/screen-daily.png?v=<%= assetVersion %>" alt="لغز اليوم وألعابه الست" width="260" loading="lazy">
  <img src="/assets/site/screen-level.png?v=<%= assetVersion %>" alt="شبكة لغز داخل اللعبة" width="260" loading="lazy">
</section>

<section class="wz-cta">
  <h2 class="wz-h2">جاهز؟</h2>
  <%- include('stores') %>
</section>

<footer class="wz-site-foot">
  <a href="/privacy">سياسة الخصوصية</a>
  <a href="/support">الدعم</a>
  <a href="/credits">شكر الصور</a>
  <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
  <span class="wz-site-copy">© <%= new Date().getFullYear() %> Koydam</span>
</footer>

</body>
</html>
