<%
  const k = home.kpis;
  const n = (v) => Number(v || 0).toLocaleString('en');
  const pct = (rate) => (rate == null ? '—' : Math.round(rate * 100) + '٪');
  const sum = (rows, key) => rows.reduce((s, r) => s + r[key], 0);
  /** A headline number: label, value, what it is measured against, icon. */
  const tiles = [
    ['لعبوا اليوم', n(k.today), 'أجهزة فتحت اللعبة اليوم', 'users'],
    ['هذا الأسبوع', n(k.week), 'آخر 7 أيام', 'calendar-days'],
    ['هذا الشهر', n(k.month), 'آخر 30 يوماً', 'calendar-range'],
    ['لاعبون جدد اليوم', n(k.newToday), n(k.newMonth) + ' جديداً هذا الشهر', 'user-plus'],
    ['بأسماء في المتصدرين', n(home.named.total), n(home.named.month) + ' هذا الشهر · ' + n(home.named.today) + ' اليوم', 'trophy'],
    ['يعودون في اليوم التالي', pct(home.retention.d1.rate), 'وبعد أسبوع ' + pct(home.retention.d7.rate), 'repeat'],
    ['ألغاز انتهت اليوم', n(k.levelsCompletedToday), n(k.questionsSolvedToday) + ' سؤالاً محلولاً اليوم', 'grid-3x3'],
    ['بلاغات مفتوحة', reportCounts ? n(reportCounts.open) : '—', reportCounts ? n(reportCounts.week) + ' هذا الأسبوع' : '', 'triangle-alert'],
  ];
  const chartCard = (title, sub, svg, total) => ({ title, sub, svg, total });
  const perDayCards = [
    chartCard('اللاعبون كل يوم', 'أجهزة مختلفة، آخر 30 يوماً', charts.players, null),
    chartCard('اللاعبون الجدد كل يوم', 'أول مرة يفتح الجهاز اللعبة', charts.newPlayers, n(sum(home.newPerDay, 'players')) + ' في 30 يوماً'),
    chartCard('الألغاز المنتهية كل يوم', 'دون لغز اليوم', charts.levels, n(sum(home.activity, 'levels')) + ' في 30 يوماً'),
    chartCard('الأسئلة المحلولة كل يوم', 'في الألغاز', charts.questions, n(sum(home.activity, 'questions')) + ' في 30 يوماً'),
  ];
  const funnelRows = home.funnel.rows.slice(0, 10).map((r) => ({
    label: 'اللغز ' + r.number, value: r.completed,
    text: n(r.completed) + (r.completedShare == null ? '' : ' · ' + Math.round(r.completedShare * 100) + '٪'),
  }));
%>
<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الرئيسية', subheading: 'من يلعب شبّك، ومتى، وأين يتوقفون · الأيام بتوقيت GMT' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <%# What the app has sent: every event a phone reported — questions opened
          and solved, helps, levels and daily games finished — by day, week and month. %>
      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('activity', 16) %>
          <span class="fw-semibold me-auto">الأحداث المحفوظة</span>
          <a class="small" href="/admin/stats">إحصاءات الأسئلة</a>
        </div>
        <div class="ad-card-body">
          <div class="row g-3 mb-3">
            <% [
                 ['اليوم', home.events.today],
                 ['هذا الأسبوع', home.events.week],
                 ['هذا الشهر', home.events.month],
                 ['الكل', home.events.total],
               ].forEach(([label, value]) => { %>
              <div class="col-6 col-md-3">
                <div class="ad-kpi-label"><%= label %></div>
                <div class="ad-kpi-value"><%= n(value) %></div>
              </div>
            <% }) %>
          </div>
          <p class="small kd-faint mb-2">كل ما يرسله التطبيق: فتح سؤال وحلّه، والمساعدات، وإنهاء الألغاز وألعاب اليوم — كل يوم، آخر 30 يوماً. تُحفظ 180 يوماً.</p>
          <div class="wz-chart-wrap"><%- charts.events %></div>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <% tiles.forEach(([label, value, note, glyph]) => { %>
          <div class="col-6 col-lg-3">
            <div class="ad-card ad-kpi h-100">
              <div class="d-flex align-items-center gap-2 mb-2">
                <%- icon(glyph, 17) %>
                <span class="ad-kpi-label"><%= label %></span>
              </div>
              <div class="ad-kpi-value"><%= value %></div>
              <% if (note) { %><div class="wz-kpi-note"><%= note %></div><% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <%
        const f = home.frontier;
        const days = (d) => (d == null ? '—' : d === 0 ? 'أنهى الكل' : d === 1 ? 'يوم' : d === 2 ? 'يومان' : d + ' أيام');
        const who = (p) => p.username || 'جهاز …' + p.device.slice(-4);
      %>
      <%# Who is furthest through the levels, and how long what is left lasts them at
          their pace — the number to watch before adding more levels. %>
      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('flag', 16) %>
          <span class="fw-semibold me-auto">من سيصل إلى آخر الألغاز</span>
          <a class="small" href="/admin/levels">الألغاز</a>
        </div>
        <div class="ad-card-body">
          <% if (f.soonest != null && f.soonest <= 7) { %>
            <div class="alert alert-warning d-flex align-items-center gap-2 small mb-3" role="status">
              <%- icon('triangle-alert', 16) %>
              <span>أسرع لاعب سينهي كل الألغاز خلال <strong><%= days(f.soonest) %></strong> بسرعته الحالية — أضف ألغازاً جديدة.</span>
            </div>
          <% } %>
          <div class="row g-3 mb-3">
            <% [
                 ['ألغاز منشورة', n(f.total)],
                 ['أنهوا كل الألغاز', n(f.finishedAll)],
                 ['على بعد ' + 20 + ' لغزاً أو أقل', n(f.nearEnd)],
                 ['أقرب من ينفد لديه', f.soonest == null ? '—' : days(f.soonest)],
               ].forEach(([label, value]) => { %>
              <div class="col-6 col-md-3">
                <div class="ad-kpi-label"><%= label %></div>
                <div class="ad-kpi-value wz-kpi-small"><%= value %></div>
              </div>
            <% }) %>
          </div>
          <div class="row g-3">
            <div class="col-xl-7">
              <% if (f.top.length) { %>
                <div class="ad-table-wrap">
                  <table class="ad-table">
                    <thead><tr><th>#</th><th>اللاعب</th><th>أبعد لغز</th><th>آخر 7 أيام</th><th>يبقى</th><th>ينفد خلال</th></tr></thead>
                    <tbody>
                      <% f.top.forEach((p, i) => { %>
                        <tr>
                          <td class="kd-faint"><%= i + 1 %></td>
                          <td class="fw-semibold text-nowrap"><%= who(p) %></td>
                          <td class="text-nowrap"><span class="wz-ltr"><%= p.highest %> / <%= f.total %></span></td>
                          <td><%= p.weekLevels %> لغزاً</td>
                          <td><%= p.remaining %></td>
                          <td class="text-nowrap"><span class="<%= p.daysLeft != null && p.daysLeft <= 7 && p.remaining > 0 ? 'kd-tag kd-tag-warn' : '' %>"><%= days(p.daysLeft) %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
                <p class="small kd-faint mb-0 mt-2">«ينفد خلال»: الألغاز الباقية بسرعة اللاعب في آخر 7 أيام. — تعني أنه لم ينهِ لغزاً هذا الأسبوع.</p>
              <% } else { %>
                <p class="small kd-muted mb-0">لم ينهِ أحد لغزاً بعد.</p>
              <% } %>
            </div>
            <div class="col-xl-5">
              <div class="ad-kpi-label mb-2">اللاعبون حسب أبعد لغز أنهوه (<%= n(f.players) %>)</div>
              <%- include('partials/hbars', { rows: f.buckets.map((b) => ({ label: 'الألغاز ' + b.label, value: b.players })) }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <% perDayCards.forEach((c) => { %>
          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('chart-column', 16) %>
                <span class="fw-semibold"><%= c.title %></span>
                <% if (c.total) { %><span class="kd-tag ms-auto"><%= c.total %></span><% } %>
              </div>
              <div class="ad-card-body">
                <p class="small kd-faint mb-2"><%= c.sub %></p>
                <div class="wz-chart-wrap"><%- c.svg %></div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-xl-6">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('clock', 16) %>
              <span class="fw-semibold">متى يلعبون</span>
            </div>
            <div class="ad-card-body">
              <p class="small kd-faint mb-2">لاعبون مختلفون في كل ساعة من اليوم، آخر 7 أيام، بتوقيت GMT (المغرب GMT+1).</p>
              <div class="wz-chart-wrap"><%- charts.hours %></div>
            </div>
          </div>
        </div>
        <div class="col-xl-6">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('route', 16) %>
              <span class="fw-semibold me-auto">إلى أين يصلون</span>
              <a class="small" href="/admin/players">التفاصيل</a>
            </div>
            <div class="ad-card-body">
              <p class="small kd-faint mb-3">من أنهى كل لغز من أول عشرة، ونسبتهم ممن فتحوا اللغز الأول (<%= n(home.funnel.base) %>).</p>
              <% if (funnelRows.length) { %><%- include('partials/hbars', { rows: funnelRows }) %><% } else { %><p class="small kd-muted mb-0">لا ألغاز منشورة.</p><% } %>
            </div>
          </div>
        </div>
      </div>

      <% if (builds) { const pct = (x) => Math.round(x * 100) + '%'; %>
        <div class="row g-3 mb-3">
          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('smartphone', 16) %>
                <span class="fw-semibold me-auto">إصدارات التطبيق</span>
                <% if (builds.total) { %>
                  <span class="kd-tag <%= builds.oldShare <= 0.05 ? '' : 'kd-tag-warn' %>">على النطاق القديم: <%= pct(builds.oldShare) %></span>
                <% } %>
              </div>
              <div class="ad-card-body">
                <p class="small kd-faint mb-3">كل هاتف مرة واحدة، بآخر إصدار لعب به في آخر <%= builds.days %> أيام (<%= n(builds.total) %> لاعباً). الإصداران 1.1 و1.2 يتصلان بـ<span dir="ltr"><%= oldDomain %></span>، و1.3 وما بعده بـchabbek.com.</p>
                <% if (builds.versions.length) { %>
                  <%- include('partials/hbars', { rows: builds.versions.map((v) => ({
                        label: v.version + (v.old ? ' · النطاق القديم' : ''),
                        value: v.players,
                        text: n(v.players) + ' (' + pct(builds.total ? v.players / builds.total : 0) + ')',
                      })) }) %>
                <% } else { %>
                  <p class="small kd-muted mb-0">لا أرقام بعد: تبدأ من أول لعب بعد هذا التحديث.</p>
                <% } %>
                <p class="small kd-faint mt-3 mb-0">
                  يمكن حذف <span dir="ltr"><%= oldDomain %></span> حين تبقى النسبة تحت 5% أسبوعين متتاليين.
                  <% if (builds.since) { %>الأرقام منذ <span dir="ltr"><%= builds.since %></span>.<% } %>
                </p>
              </div>
            </div>
          </div>
          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('chart-column', 16) %>
                <span class="fw-semibold">على النطاق القديم كل يوم</span>
              </div>
              <div class="ad-card-body">
                <p class="small kd-faint mb-2">لاعبون بإصدار يتصل بالنطاق القديم، آخر 14 يوماً.</p>
                <div class="wz-chart-wrap"><%- charts.oldDomain %></div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <div class="row g-3 mb-3">
        <div class="col-xl-6">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('calendar-days', 16) %>
              <span class="fw-semibold me-auto">ألعاب لغز اليوم</span>
              <span class="kd-tag"><%= n(home.dailyGames.total) %> في 30 يوماً</span>
            </div>
            <div class="ad-card-body">
              <%- include('partials/hbars', { rows: home.dailyGames.rows.map((g) => ({ label: gameLabels[g.game] || g.game, value: g.count })) }) %>
            </div>
          </div>
        </div>
        <div class="col-xl-6">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('lightbulb', 16) %>
              <span class="fw-semibold me-auto">المساعدات</span>
              <span class="kd-tag"><%= n(home.helps.total) %> في 30 يوماً</span>
            </div>
            <div class="ad-card-body">
              <%- include('partials/hbars', { rows: home.helps.rows.map((h) => ({ label: helpLabels[h.help] || h.help, value: h.count })) }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <% if (reportCounts) { %>
          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('triangle-alert', 16) %>
                <span class="fw-semibold me-auto">البلاغات</span>
                <a class="small" href="/admin/reports">افتحها</a>
              </div>
              <div class="ad-card-body">
                <div class="row g-3 mb-2">
                  <div class="col-4"><div class="ad-kpi-label">مفتوحة</div><div class="ad-kpi-value"><%= reportCounts.open %></div></div>
                  <div class="col-4"><div class="ad-kpi-label">هذا الأسبوع</div><div class="ad-kpi-value"><%= reportCounts.week %></div></div>
                  <div class="col-4"><div class="ad-kpi-label">الكل</div><div class="ad-kpi-value"><%= reportCounts.total %></div></div>
                </div>
                <% if (reportCounts.total) { %>
                  <div class="d-flex flex-wrap gap-1">
                    <% Object.entries(reasons).forEach(([key, label]) => { if (reportCounts.byReason[key]) { %>
                      <a class="kd-tag" href="/admin/reports?status=all&reason=<%= key %>"><%= label %> <%= reportCounts.byReason[key] %></a>
                    <% } }) %>
                  </div>
                <% } else { %>
                  <p class="small kd-muted mb-0">لا بلاغات بعد.</p>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
        <div class="col-xl-6">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('library', 16) %>
              <span class="fw-semibold me-auto">المحتوى</span>
              <a class="small" href="/admin/stats">إحصاءات الأسئلة</a>
            </div>
            <div class="ad-card-body">
              <div class="row g-3">
                <% [
                     ['ألغاز منشورة', n(counts.published) + ' / ' + n(counts.levels)],
                     ['الأسئلة', n(counts.questions)],
                     ['بصورة', n(counts.withImages)],
                     ['خارج الألغاز', n(counts.unused)],
                   ].forEach(([label, value]) => { %>
                  <div class="col-6 col-md-3">
                    <div class="ad-kpi-label"><%= label %></div>
                    <div class="ad-kpi-value wz-kpi-small"><%= value %></div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
