<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الرئيسية', subheading: 'ما يقدّمه تطبيق شبّك الآن' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="row g-3 mb-3">
        <% [
             ['ألغاز منشورة', counts.published + ' / ' + counts.levels, 'grid-3x3'],
             ['الأسئلة', counts.questions, 'message-circle-question'],
             ['بصورة', counts.withImages, 'image'],
             ['خارج الألغاز', counts.unused, 'inbox'],
           ].forEach(([label, value, glyph]) => { %>
          <div class="col-6 col-xl-3">
            <div class="ad-card ad-kpi">
              <div class="d-flex align-items-center gap-2 mb-2">
                <%- icon(glyph, 17) %>
                <span class="ad-kpi-label"><%= label %></span>
              </div>
              <div class="ad-kpi-value"><%= value %></div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="ad-card">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('grid-3x3', 16) %>
          <span class="fw-semibold">الألغاز</span>
          <div class="ms-auto d-flex gap-2">
            <a class="btn btn-sm btn-kd-outline" href="/admin/questions/new">سؤال جديد</a>
            <a class="btn btn-sm btn-kd" href="/admin/levels">إدارة الألغاز</a>
          </div>
        </div>
        <div class="ad-card-body p-0">
          <% if (!levels.length) { %>
            <div class="ad-empty">
              <%- icon('grid-3x3', 28) %>
              <p class="mb-0">لا ألغاز بعد. أضف بعض الأسئلة ثم كوّن منها لغزاً.</p>
            </div>
          <% } else { %>
            <div class="ad-table-wrap">
              <table class="ad-table">
                <thead><tr><th>اللغز</th><th>الكلمات</th><th>الشبكة</th><th>الحالة</th></tr></thead>
                <tbody>
                  <% levels.forEach((l) => { %>
                    <tr>
                      <td><a class="fw-semibold text-nowrap" href="/admin/levels/<%= l.id %>"><%= l.name %></a></td>
                      <td><%= l.wordCount %><% if (l.unplacedCount) { %> <span class="kd-tag kd-tag-warn"><%= l.unplacedCount %> بلا تقاطع</span><% } %></td>
                      <td class="kd-faint"><%= l.rows %> × <%= l.cols %></td>
                      <td><span class="ad-status <%= l.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= l.published ? 'منشور' : 'مسودة' %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
