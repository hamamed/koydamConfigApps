<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الرئيسية', subheading: 'ما يقدّمه تطبيق شبّك الآن' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="row g-3 mb-3">
        <% [
             ['ألغاز منشورة', counts.published + ' / ' + counts.levels, 'grid-3x3'],
             ['الأسئلة', counts.questions, 'message-circle-question'],
             ['بصورة', counts.withImages, 'image'],
             ['خارج الألغاز', counts.unused, 'inbox'],
           ].forEach(([label, value, glyph]) => { %>
          <div class="col-6 col-xl-3">
            <div class="ad-card ad-kpi">
              <div class="d-flex align-items-center gap-2 mb-2">
                <%- icon(glyph, 17) %>
                <span class="ad-kpi-label"><%= label %></span>
              </div>
              <div class="ad-kpi-value"><%= value %></div>
            </div>
          </div>
        <% }) %>
      </div>

      <%# What players are doing, and what they say is wrong with it. %>
      <div class="row g-3 mb-3">
        <div class="col-xl-7">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('chart-column', 16) %>
              <span class="fw-semibold me-auto">اللعب</span>
              <a class="small" href="/admin/stats">كل الإحصاءات</a>
            </div>
            <div class="ad-card-body">
              <div class="row g-3">
                <% [
                     ['أجهزة لعبت', play.devices || 0],
                     ['أجهزة هذا الأسبوع', play.devicesWeek || 0],
                     ['أحداث مسجَّلة', play.events || 0],
                   ].forEach(([label, value]) => { %>
                  <div class="col-4">
                    <div class="ad-kpi-label"><%= label %></div>
                    <div class="ad-kpi-value"><%= value.toLocaleString('en') %></div>
                  </div>
                <% }) %>
              </div>
              <p class="small kd-faint mb-0 mt-3">
                <% if (play.since) { %>منذ <%= String(play.since).slice(0, 10) %><% } else { %>لا أحداث بعد.<% } %>
              </p>
            </div>
          </div>
        </div>

        <% if (reportCounts) { %>
          <div class="col-xl-5">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('triangle-alert', 16) %>
                <span class="fw-semibold me-auto">البلاغات</span>
                <a class="small" href="/admin/reports">افتحها</a>
              </div>
              <div class="ad-card-body">
                <div class="row g-3 mb-2">
                  <div class="col-4"><div class="ad-kpi-label">مفتوحة</div><div class="ad-kpi-value"><%= reportCounts.open %></div></div>
                  <div class="col-4"><div class="ad-kpi-label">هذا الأسبوع</div><div class="ad-kpi-value"><%= reportCounts.week %></div></div>
                  <div class="col-4"><div class="ad-kpi-label">الكل</div><div class="ad-kpi-value"><%= reportCounts.total %></div></div>
                </div>
                <% if (reportCounts.total) { %>
                  <div class="d-flex flex-wrap gap-1">
                    <% Object.entries(reasons).forEach(([key, label]) => { if (reportCounts.byReason[key]) { %>
                      <a class="kd-tag" href="/admin/reports?status=all&reason=<%= key %>"><%= label %> <%= reportCounts.byReason[key] %></a>
                    <% } }) %>
                  </div>
                <% } else { %>
                  <p class="small kd-muted mb-0">لا بلاغات بعد.</p>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <div class="ad-card">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('grid-3x3', 16) %>
          <span class="fw-semibold">الألغاز</span>
          <div class="ms-auto d-flex gap-2">
            <a class="btn btn-sm btn-kd-outline" href="/admin/questions/new">سؤال جديد</a>
            <a class="btn btn-sm btn-kd" href="/admin/levels">إدارة الألغاز</a>
          </div>
        </div>
        <div class="ad-card-body p-0">
          <% if (!levels.length) { %>
            <div class="ad-empty">
              <%- icon('grid-3x3', 28) %>
              <p class="mb-0">لا ألغاز بعد. أضف بعض الأسئلة ثم كوّن منها لغزاً.</p>
            </div>
          <% } else { %>
            <div class="ad-table-wrap">
              <table class="ad-table">
                <thead><tr><th>اللغز</th><th>الكلمات</th><th>الشبكة</th><th>الحالة</th></tr></thead>
                <tbody>
                  <% levels.forEach((l) => { %>
                    <tr>
                      <td><a class="fw-semibold text-nowrap" href="/admin/levels/<%= l.id %>"><%= l.name %></a></td>
                      <td><%= l.wordCount %><% if (l.unplacedCount) { %> <span class="kd-tag kd-tag-warn"><%= l.unplacedCount %> بلا تقاطع</span><% } %></td>
                      <td class="kd-faint"><%= l.rows %> × <%= l.cols %></td>
                      <td><span class="ad-status <%= l.published ? 'ad-status-published' : 'ad-status-draft' %>"><%= l.published ? 'منشور' : 'مسودة' %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
