<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الإعدادات', subheading: 'أرقام اللعبة التي يقرأها التطبيق عند التشغيل من ‎/api/v1/config' }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <form method="post" action="/admin/settings">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row g-3">
          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('coins', 16) %>
                <span class="fw-semibold">المكافآت</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <div>
                  <span class="form-label small fw-semibold d-block">مكافأة الدخول اليومي، بحسب يوم دورة الـ<%= rewardDays %> أيام</span>
                  <div class="wz-reward-days">
                    <% for (let i = 0; i < rewardDays; i++) { %>
                      <label class="wz-reward-day">
                        <small>اليوم <%= i + 1 %></small>
                        <input class="form-control" type="number" name="dailyRewards" min="0" step="1" required
                               value="<%= values.dailyRewards?.[i] ?? '' %>" placeholder="<%= defaults.dailyRewards[i] %>">
                      </label>
                    <% } %>
                  </div>
                </div>
                <% [
                     ['dailyPuzzleCoins', 'عملات حل لغز اليوم', values.dailyPuzzleCoins, defaults.dailyPuzzleCoins],
                     ['streakBonusPerDay', 'مكافأة السلسلة لكل يوم', values.streakBonusPerDay, defaults.streakBonusPerDay],
                     ['streakBonusMax', 'أقصى مكافأة للسلسلة', values.streakBonusMax, defaults.streakBonusMax],
                     ['streakFreezeCost', 'تكلفة حماية السلسلة (عملات لإبقائها بعد تفويت يوم، 0 = معطّلة)', values.streakFreezeCost, defaults.streakFreezeCost],
                     ['dailyGameCoins', 'عملات لعبة اليوم (لعبة واحدة لكل يوم)', values.dailyGameCoins, defaults.dailyGameCoins],
                     ['dailyAllGamesBonus', 'مكافأة ماراثون الجمعة', values.dailyAllGamesBonus, defaults.dailyAllGamesBonus],
                   ].forEach(([name, label, value, fallback]) => { %>
                  <div class="row g-2 align-items-center">
                    <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                    <div class="col-sm-5">
                      <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="0" <% if (name === 'streakFreezeCost') { %>max="<%= maxStreakFreezeCost %>"<% } %> step="1" required value="<%= value %>">
                      <div class="form-text">الافتراضي <%= fallback %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('grid-3x3', 16) %>
                <span class="fw-semibold">عملات الألغاز</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <p class="kd-faint small m-0">ما يربحه اللاعب في الألغاز وما تكلّفه المساعدات. الإعادة لا تدفع شيئاً، ومكافأة الإنهاء لأول مرة فقط. تصل التغييرات مع التحديث القادم للتطبيق.</p>
                <%
                  const cc = values.crosswordCoins || defaults.crosswordCoins;
                  const cd = defaults.crosswordCoins;
                %>
                <% [
                     ['crosswordAnswer', 'عملات الجواب الصحيح (بلا مساعدة)', cc.answer, cd.answer],
                     ['crosswordLostPerHelp', 'ما تُنقصه كل مساعدة مدفوعة من عملات الجواب', cc.lostPerHelp, cd.lostPerHelp],
                     ['crosswordLevelFinish', 'عملات إنهاء اللغز (أول مرة، 0 = لا شيء)', cc.levelFinish, cd.levelFinish],
                     ['crosswordHelpRevealLetter', 'سعر «كشف حرف»', cc.helpCosts.revealLetter, cd.helpCosts.revealLetter],
                     ['crosswordHelpRemoveLetters', 'سعر «حذف 3 أحرف»', cc.helpCosts.removeLetters, cd.helpCosts.removeLetters],
                     ['crosswordHelpSolveWord', 'سعر «حل الكلمة»', cc.helpCosts.solveWord, cd.helpCosts.solveWord],
                     ['crosswordHelpUnzoomImage', 'سعر «تصغير الصورة»', cc.helpCosts.unzoomImage, cd.helpCosts.unzoomImage],
                     ['crosswordHelpUnblurImage', 'سعر «وضّح الصورة»', cc.helpCosts.unblurImage, cd.helpCosts.unblurImage],
                   ].forEach(([name, label, value, fallback]) => { %>
                  <div class="row g-2 align-items-center">
                    <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                    <div class="col-sm-5">
                      <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="0" <% if (name.startsWith('crosswordHelp')) { %>max="<%= maxCrosswordHelpCost %>"<% } %> step="1" required value="<%= value %>">
                      <div class="form-text">الافتراضي <%= fallback %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('timer', 16) %>
                <span class="fw-semibold">المؤقّت والتذكير</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <% [
                     ['timerSecondsPerWord', 'ثوانٍ لكل كلمة في الوضع المؤقّت', values.timer?.secondsPerWord, defaults.timer.secondsPerWord, 1, 600],
                     ['timerBonusCoins', 'عملات إضافية عند سبق المؤقّت', values.timer?.bonusCoins, defaults.timer.bonusCoins, 0, null],
                     ['reminderHour', 'ساعة التذكير اليومي (بتوقيت اللاعب، 0–23)', values.reminderHour, defaults.reminderHour, 0, 23],
                   ].forEach(([name, label, value, fallback, min, max]) => { %>
                  <div class="row g-2 align-items-center">
                    <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                    <div class="col-sm-5">
                      <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="<%= min %>" <% if (max !== null) { %>max="<%= max %>"<% } %> step="1" required value="<%= value %>">
                      <div class="form-text">الافتراضي <%= fallback %></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('star', 16) %>
                <span class="fw-semibold">فتح الألغاز</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <div class="row g-2 align-items-center">
                  <label class="col-sm-7 small fw-semibold" for="starsPerLevel">نجوم لكل لغز</label>
                  <div class="col-sm-5">
                    <input class="form-control" type="number" id="starsPerLevel" name="starsPerLevel" min="0" max="<%= maxStarsPerLevel %>" step="1" required value="<%= values.starsPerLevel %>">
                    <div class="form-text">الافتراضي <%= defaults.starsPerLevel %></div>
                  </div>
                  <div class="col-12 form-text">عدد النجوم اللازم لكل لغز لفتح ما بعده: اللغز N يحتاج (N−1) × هذا العدد من النجوم إجمالاً. الصفر يفتح كل الألغاز.</div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('search', 16) %>
                <span class="fw-semibold">مساعدات البحث عن الكلمات</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <% [
                     ['wordSearchRevealLetter', 'كشف حرف (عملات)', values.wordSearchHelpCosts?.revealLetter, defaults.wordSearchHelpCosts.revealLetter],
                     ['wordSearchRevealWord', 'كشف كلمة (عملات)', values.wordSearchHelpCosts?.revealWord, defaults.wordSearchHelpCosts.revealWord],
                   ].forEach(([name, label, value, fallback]) => { %>
                  <div class="row g-2 align-items-center">
                    <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                    <div class="col-sm-5">
                      <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="0" max="<%= maxWordSearchHelpCost %>" step="1" required value="<%= value %>">
                      <div class="form-text">الافتراضي <%= fallback %></div>
                    </div>
                  </div>
                <% }) %>
                <div class="form-text">عملات المساعدات في البحث اليومي. الصفر يخفي تلك المساعدة في التطبيق.</div>
              </div>
            </div>
          </div>

          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('link', 16) %>
                <span class="fw-semibold">روابط المتجرين</span>
              </div>
              <div class="ad-card-body d-grid gap-2">
                <label class="small fw-semibold" for="appStoreUrl">رابط App Store</label>
                <input class="form-control" type="url" id="appStoreUrl" name="appStoreUrl" value="<%= appStoreUrl %>" placeholder="https://apps.apple.com/app/id…">
                <div class="form-text">يظهر شعار App Store في الصفحة الرئيسية للموقع، وكزر في صفحات التحدي (‎/c/3). ليس جزءاً من ‎/api/v1/config.<% if (envAppStoreUrl) { %> الفراغ يستعمل APP_STORE_URL من البيئة: <%= envAppStoreUrl %>.<% } else { %> الفراغ يخفي الزر ويكتب «قريباً».<% } %></div>

                <label class="small fw-semibold mt-2" for="playUrl">رابط Google Play</label>
                <input class="form-control" type="url" id="playUrl" name="playUrl" value="<%= playUrl %>" placeholder="https://play.google.com/store/apps/details?id=…">
                <div class="form-text">يظهر شعار Google Play في الصفحة الرئيسية حين يُملأ. اتركه فارغاً ما دامت اللعبة ليست على المتجر — Google لا تسمح بعرض شعارها لتطبيق غير منشور عندها.</div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="ad-card">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('megaphone', 16) %>
                <span class="fw-semibold">الإعلانات</span>
                <span class="small kd-faint ms-auto">يقرأها التطبيق من ‎/api/v1/config</span>
              </div>
              <div class="ad-card-body d-grid gap-3">
                <div class="row g-3">
                  <div class="col-12 d-flex flex-wrap gap-4">
                    <div class="form-check form-switch m-0">
                      <input class="form-check-input" type="checkbox" role="switch" id="adsEnabled" name="adsEnabled" value="on" <% if (values.ads?.enabled) { %>checked<% } %>>
                      <label class="form-check-label small fw-semibold" for="adsEnabled">تشغيل الإعلانات</label>
                    </div>
                    <div class="form-check form-switch m-0">
                      <input class="form-check-input" type="checkbox" role="switch" id="adsTestMode" name="adsTestMode" value="on" <% if (values.ads?.testMode) { %>checked<% } %>>
                      <label class="form-check-label small fw-semibold" for="adsTestMode">وضع الاختبار</label>
                    </div>
                    <span class="small kd-muted">
                      المفتاح الأول يوقف كل الإعلانات دفعةً واحدة. وضع الاختبار يرسل للتطبيق وحدات Google التجريبية
                      بدل وحداتك — تظهر الإعلانات ويُجرَّب الشكل والعدّ دون عرض إعلان حقيقي ودون تعريض حساب AdMob للخطر.
                      ما تكتبه هنا يبقى كما هو، ويعود العمل به فور إطفاء وضع الاختبار.
                    </span>
                  </div>

                  <div class="col-12">
                    <label class="small fw-semibold" for="adsAppId">معرّف التطبيق في AdMob</label>
                    <input class="form-control kd-mono" type="text" id="adsAppId" name="adsAppId" dir="ltr"
                           value="<%= values.ads?.appId ?? '' %>" placeholder="ca-app-pub-0000000000000000~0000000000">
                    <div class="form-text">
                      بعلامة ‎~‎ لا ‎/‎. للمرجع فقط: حزمة Google تقرأ هذا المعرّف من ملف التطبيق نفسه وقت البناء
                      (‎<span class="kd-mono">GADApplicationIdentifier</span>‎ في Xcode)، فلا يكفي كتابته هنا.
                      أمّا معرّفات الوحدات فيقرأها التطبيق من هذه الصفحة عند كل تشغيل.
                    </div>
                  </div>

                  <div class="col-lg-6 col-xxl-3">
                    <div class="d-grid gap-2">
                      <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="adsBannerEnabled" name="adsBannerEnabled" value="on" <% if (values.ads?.banner?.enabled) { %>checked<% } %>>
                        <label class="form-check-label small fw-semibold" for="adsBannerEnabled">شريط أسفل صفحة السؤال</label>
                      </div>
                      <label class="small fw-semibold" for="adsBannerUnitId">معرّف وحدة الشريط</label>
                      <input class="form-control kd-mono" type="text" id="adsBannerUnitId" name="adsBannerUnitId" dir="ltr"
                             value="<%= values.ads?.banner?.unitId ?? '' %>" placeholder="ca-app-pub-…/…">
                      <div class="form-text">يظهر أسفل صفحة السؤال وحدها، وينزلق خارجها عند الخروج ويعود عند الرجوع. الفراغ يُطفئه.</div>
                    </div>
                  </div>

                  <div class="col-lg-6 col-xxl-3">
                    <div class="d-grid gap-2">
                      <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="adsInterstitialEnabled" name="adsInterstitialEnabled" value="on" <% if (values.ads?.interstitial?.enabled) { %>checked<% } %>>
                        <label class="form-check-label small fw-semibold" for="adsInterstitialEnabled">إعلان بيني عند الخروج من السؤال</label>
                      </div>
                      <label class="small fw-semibold" for="adsInterstitialUnitId">معرّف الوحدة البينية</label>
                      <input class="form-control kd-mono" type="text" id="adsInterstitialUnitId" name="adsInterstitialUnitId" dir="ltr"
                             value="<%= values.ads?.interstitial?.unitId ?? '' %>" placeholder="ca-app-pub-…/…">
                      <% [
                           ['adsInterstitialEvery', 'يظهر بعد كل كم خروج من السؤال', values.ads?.interstitial?.everyQuestions, defaults.ads.interstitial.everyQuestions, 1, maxAdsEveryQuestions],
                           ['adsInterstitialMinSeconds', 'أقل مهلة بين إعلانين (ثانية)', values.ads?.interstitial?.minSecondsBetween, defaults.ads.interstitial.minSecondsBetween, 0, maxAdsSecondsBetween],
                           ['adsInterstitialMaxPerDay', 'حد أقصى في اليوم (٠ = بلا حد)', values.ads?.interstitial?.maxPerDay, defaults.ads.interstitial.maxPerDay, 0, maxAdsPerDay],
                         ].forEach(([name, label, value, fallback, min, max]) => { %>
                        <div class="row g-2 align-items-center">
                          <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                          <div class="col-sm-5">
                            <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="<%= min %>" max="<%= max %>" step="1" required value="<%= value %>">
                            <div class="form-text">الافتراضي <%= fallback %></div>
                          </div>
                        </div>
                      <% }) %>
                      <div class="form-text">يُعدّ كل خروج من صفحة السؤال، سواء حُلّت الكلمة أو رجع اللاعب دون حل.</div>
                    </div>
                  </div>

                  <div class="col-lg-6 col-xxl-3">
                    <div class="d-grid gap-2">
                      <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="adsRewardedEnabled" name="adsRewardedEnabled" value="on" <% if (values.ads?.rewarded?.enabled) { %>checked<% } %>>
                        <label class="form-check-label small fw-semibold" for="adsRewardedEnabled">فيديو بمكافأة (عملات للمساعدات)</label>
                      </div>
                      <label class="small fw-semibold" for="adsRewardedUnitId">معرّف وحدة الفيديو</label>
                      <input class="form-control kd-mono" type="text" id="adsRewardedUnitId" name="adsRewardedUnitId" dir="ltr"
                             value="<%= values.ads?.rewarded?.unitId ?? '' %>" placeholder="ca-app-pub-…/…">
                      <% [
                           ['adsRewardedCoins', 'عملات لكل فيديو يُشاهد كاملاً', values.ads?.rewarded?.coins, defaults.ads.rewarded.coins, 0, maxRewardedCoins],
                           ['adsRewardedMaxPerDay', 'حد أقصى في اليوم (٠ = بلا حد)', values.ads?.rewarded?.maxPerDay, defaults.ads.rewarded.maxPerDay, 0, maxRewardedPerDay],
                         ].forEach(([name, label, value, fallback, min, max]) => { %>
                        <div class="row g-2 align-items-center">
                          <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                          <div class="col-sm-5">
                            <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="<%= min %>" max="<%= max %>" step="1" required value="<%= value %>">
                            <div class="form-text">الافتراضي <%= fallback %></div>
                          </div>
                        </div>
                      <% }) %>
                      <div class="form-text">زر «شاهد فيديو» تحت المساعدات في صفحة السؤال. لا تُدفع العملات إلا بعد مشاهدة الفيديو كاملاً.</div>
                    </div>
                  </div>

                  <div class="col-lg-6 col-xxl-3">
                    <div class="d-grid gap-2">
                      <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="adsAppOpenEnabled" name="adsAppOpenEnabled" value="on" <% if (values.ads?.appOpen?.enabled) { %>checked<% } %>>
                        <label class="form-check-label small fw-semibold" for="adsAppOpenEnabled">إعلان عند العودة إلى التطبيق</label>
                      </div>
                      <label class="small fw-semibold" for="adsAppOpenUnitId">معرّف وحدة إعلان الفتح</label>
                      <input class="form-control kd-mono" type="text" id="adsAppOpenUnitId" name="adsAppOpenUnitId" dir="ltr"
                             value="<%= values.ads?.appOpen?.unitId ?? '' %>" placeholder="ca-app-pub-…/…">
                      <% [
                           ['adsAppOpenMinBackground', 'أقل مدة غياب تستحق إعلاناً (ثانية)', values.ads?.appOpen?.minBackgroundSeconds, defaults.ads.appOpen.minBackgroundSeconds, 0, maxAdBackgroundSeconds],
                           ['adsAppOpenMinSeconds', 'أقل مهلة بين إعلانين (ثانية)', values.ads?.appOpen?.minSecondsBetween, defaults.ads.appOpen.minSecondsBetween, 0, maxAdsSecondsBetween],
                           ['adsAppOpenMaxPerDay', 'حد أقصى في اليوم (٠ = بلا حد)', values.ads?.appOpen?.maxPerDay, defaults.ads.appOpen.maxPerDay, 0, maxAdsPerDay],
                         ].forEach(([name, label, value, fallback, min, max]) => { %>
                        <div class="row g-2 align-items-center">
                          <label class="col-sm-7 small fw-semibold" for="<%= name %>"><%= label %></label>
                          <div class="col-sm-5">
                            <input class="form-control" type="number" id="<%= name %>" name="<%= name %>" min="<%= min %>" max="<%= max %>" step="1" required value="<%= value %>">
                            <div class="form-text">الافتراضي <%= fallback %></div>
                          </div>
                        </div>
                      <% }) %>
                      <div class="form-text">
                        يظهر حين يترك اللاعب التطبيق ثم يعود إليه. لا يظهر عند أول تشغيل، ولا أثناء اللعب،
                        ولا إذا كان الغياب أقصر من المدة أعلاه — خروج لحظي للإشعارات لا يستحق إعلاناً.
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2 mt-3">
          <button class="btn btn-kd-accent" type="submit">حفظ الإعدادات</button>
          <a class="btn btn-kd-ghost" href="/api/v1/config" target="_blank" rel="noopener">عرض JSON</a>
        </div>
      </form>

      <%# Outside the settings form: each of these is a form of its own, and a
          form inside a form is not markup any browser will honour. %>
      <div class="ad-card mt-3">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('triangle-alert', 16) %>
          <span class="fw-semibold">الصيانة</span>
          <span class="small kd-faint ms-auto">لا رجوع عن هذه</span>
        </div>
        <div class="ad-card-body d-grid gap-3">
          <div class="d-flex flex-wrap align-items-center gap-2">
            <form method="post" action="/admin/settings/stats/reset" class="m-0"
                  data-confirm="تصفير كل الإحصاءات؟ يُحذف كل حدث مسجَّل ولا يمكن استرجاعه. الأسئلة والألغاز والحسابات لا تتأثر.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-kd-danger btn-sm" type="submit">
                <span class="me-1"><%- icon('rotate-ccw', 14) %></span>صفّر الإحصاءات
              </button>
            </form>
            <span class="small kd-muted">
              يمسح كل حدث لعب مسجَّل، فتبدأ صفحة <a href="/admin/stats">الإحصاءات</a> من الصفر.
              الأسئلة والألغاز والحسابات لا تتأثر.
            </span>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <form method="post" action="/admin/settings/reports/clear" class="m-0"
                  data-confirm="حذف البلاغات المعالَجة؟ المفتوحة تبقى.">
