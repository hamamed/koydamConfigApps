<%
  const pct = (n) => (n === null || n === undefined ? '—' : `${Math.round(n * 100)}%`);
  const duration = (s) => (s === null || s === undefined ? '—' : `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`);
  const dropAt = (i, stage) => funnel.drop && funnel.drop.index === i && funnel.drop.stage === stage;
%>
<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'الأجهزة', subheading: 'من أحداث لعب مجهولة · الأيام بتوقيت UTC · اليوم هو ' + today }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="row g-3 mb-3">
        <% [
             ['لاعبو اليوم', kpis.today, 'user-check'],
             ['آخر 7 أيام', kpis.week, 'users'],
             ['آخر 30 يوماً', kpis.month, 'users-round'],
             ['ألغاز أُنهيت اليوم', kpis.levelsCompletedToday, 'trophy'],
             ['ألغاز اليوم المنتهية', kpis.dailyCompletedToday, 'calendar-check'],
             ['الإشعارات مفعّلة', kpis.notificationsEnabled, 'bell-ring'],
           ].forEach(([label, value, glyph]) => { %>
          <div class="col-6 col-md-4 col-xl-2">
            <div class="ad-card ad-kpi wz-kpi h-100">
              <div class="d-flex align-items-center gap-2 mb-2">
                <%- icon(glyph, 17) %>
                <span class="ad-kpi-label"><%= label %></span>
              </div>
              <div class="ad-kpi-value"><%= value %></div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex align-items-center gap-2">
          <%- icon('chart-column', 16) %>
          <span class="fw-semibold">اللاعبون يومياً</span>
          <span class="kd-faint small ms-auto">أجهزة مختلفة، آخر 30 يوماً</span>
        </div>
        <div class="ad-card-body">
          <div class="wz-chart-wrap"><%- chart %></div>
          <details class="mt-2">
            <summary class="small kd-muted">عرض كجدول</summary>
            <div class="ad-table-wrap mt-2">
              <table class="ad-table">
                <thead><tr><th>اليوم</th><th class="text-end">اللاعبون</th></tr></thead>
                <tbody>
                  <% [...perDay].reverse().forEach((d) => { %>
                    <tr><td><%= d.date %></td><td class="text-end"><%= d.players %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-xl-7">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('filter', 16) %>
              <span class="fw-semibold">مسار الألغاز</span>
              <span class="kd-faint small ms-auto">أجهزة مختلفة، كل الأحداث المحفوظة</span>
            </div>
            <div class="ad-card-body p-0">
              <% if (!funnel.rows.length) { %>
                <div class="ad-empty"><%- icon('filter', 28) %><p class="mb-0">لا ألغاز منشورة.</p></div>
              <% } else { %>
                <% if (funnel.drop) { %>
                  <p class="small mx-3 mt-3 mb-2">
                    <span class="kd-tag kd-tag-warn">أكبر تسرّب</span>
                    <%= funnel.drop.lost %> لاعب
                    <%= funnel.drop.stage === 'within'
                        ? 'opened level ' + funnel.rows[funnel.drop.index].number + ' and did not complete it'
                        : 'completed level ' + funnel.rows[funnel.drop.index].number + ' and did not open level ' + (funnel.rows[funnel.drop.index].number + 1) %>.
                  </p>
                <% } %>
                <div class="ad-table-wrap">
                  <table class="ad-table">
                    <thead><tr><th>اللغز</th><th class="text-end">فُتح</th><th class="text-end">أُنهي</th><th class="wz-funnel-col">ممن فتحوا اللغز 1</th></tr></thead>
                    <tbody>
                      <% funnel.rows.forEach((r, i) => { %>
                        <tr class="<%= dropAt(i, 'within') || dropAt(i, 'between') ? 'wz-drop-row' : '' %>">
                          <td class="text-nowrap">اللغز <%= r.number %></td>
                          <td class="text-end <%= dropAt(i - 1, 'between') ? 'wz-drop-cell' : '' %>"><%= r.opened %> <span class="kd-faint small"><%= pct(r.openedShare) %></span></td>
                          <td class="text-end <%= dropAt(i, 'within') ? 'wz-drop-cell' : '' %>"><%= r.completed %> <span class="kd-faint small"><%= pct(r.completedShare) %></span></td>
                          <td class="wz-funnel-col">
                            <span class="wz-funnel" title="فُتح <%= pct(r.openedShare) %>، أُنهي <%= pct(r.completedShare) %>">
                              <span class="wz-funnel-open" style="--wz-share: <%= Math.round((r.openedShare || 0) * 100) %>%"></span>
                              <span class="wz-funnel-done" style="--wz-share: <%= Math.round((r.completedShare || 0) * 100) %>%"></span>
                            </span>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-xl-5 d-grid gap-3 align-content-start">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('life-buoy', 16) %>
              <span class="fw-semibold">المساعدات</span>
              <span class="kd-faint small ms-auto"><%= helps.total %> استُعملت، آخر 30 يوماً</span>
            </div>
            <div class="ad-card-body d-grid gap-2">
              <% helps.rows.forEach((h) => { %>
                <div class="wz-help-row">
                  <span class="small"><%= helpLabels[h.help] || h.help %></span>
                  <span class="ad-meter"><span class="ad-meter-fill wz-share-fill" style="--wz-share: <%= Math.round(h.share * 100) %>%"></span></span>
                  <span class="small text-end"><%= h.count %> <span class="kd-faint"><%= pct(h.share) %></span></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('repeat', 16) %>
              <span class="fw-semibold me-auto">العودة</span>
            </div>
            <div class="ad-card-body">
              <div class="row g-3">
                <% [['اليوم 1', retention.d1], ['اليوم 7', retention.d7]].forEach(([label, r]) => { %>
                  <div class="col-6">
                    <div class="ad-kpi-label"><%= label %></div>
                    <div class="ad-kpi-value"><%= pct(r.rate) %></div>
                    <div class="small kd-faint"><%= r.returned %> of <%= r.cohort %> من اللاعبين الجدد عادوا في اليوم <%= r.days %></div>
                  </div>
                <% }) %>
              </div>
              <p class="small kd-muted mt-3 mb-0">لاعبون ظهروا أول مرة في اليوم X ولعبوا مجدداً في اليوم X + 1 (أو X + 7)، على آخر 30 يوماً انتهى يوم عودتها. «أول ظهور» هو أقدم حدث محفوظ (<%= retentionDays %> يوماً).</p>
            </div>
          </div>

          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <%- icon('search', 16) %>
              <span class="fw-semibold">البحث عن الكلمات</span>
              <span class="kd-faint small ms-auto">آخر <%= wordSearch.days %> يوماً · <%= kpis.wordSearchCompletedToday %> أُنهي اليوم</span>
            </div>
            <div class="ad-card-body">
              <div class="row g-3">
                <% [
                     ['أُنهيت', wordSearch.completed, wordSearch.started + ' بدأت · ' + pct(wordSearch.completionRate) + ' أُنهيت'],
                     ['اللاعبون', wordSearch.players, 'أنهى واحدة على الأقل'],
                     ['متوسط الوقت', duration(wordSearch.avgSeconds), 'لكل شبكة منتهية'],
                     ['متوسط النجوم', wordSearch.avgStars === null ? '—' : wordSearch.avgStars.toFixed(1), wordSearch.wordsFound + ' كلمة وُجدت'],
                   ].forEach(([label, value, note]) => { %>
                  <div class="col-6">
                    <div class="ad-kpi-label"><%= label %></div>
                    <div class="ad-kpi-value"><%= value %></div>
                    <div class="small kd-faint"><%= note %></div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
