<%
  const targetLabel = { all: 'all devices with notifications on', sandbox: 'sandbox devices', device: 'one device (test)' };
%>
<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', { heading: 'إرسال الإشعار؟', subheading: 'راجعه مرة أخيرة — الإشعار لا يُسترجع' }) %>
    <div class="ad-content">
      <%- include('partials/notifications-tabs', { active: 'compose' }) %>
      <div class="row g-3">
        <div class="col-xl-6">
          <div class="ad-card">
            <div class="ad-card-body d-grid gap-3">
              <div class="wz-push-preview" dir="rtl">
                <img src="/assets/logo/logo.png" alt="" width="34" height="38">
                <div class="min-w-0">
                  <div class="wz-push-title"><%= message.title %></div>
                  <div class="wz-push-body"><%= message.body %></div>
                </div>
              </div>
              <dl class="row small mb-0">
                <dt class="col-4">يذهب إلى</dt>
                <dd class="col-8"><strong><%= audience %></strong> <%= targetLabel[message.target] %><% if (message.device) { %> <span class="font-monospace"><%= message.device %></span><% } %></dd>
                <dt class="col-4">يفتح</dt>
                <dd class="col-8"><%= message.level ? 'Level ' + message.level : 'The home screen' %></dd>
              </dl>
              <form method="post" action="/admin/notifications/send" class="d-flex gap-2 m-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="confirmed" value="1">
                <% ['title', 'body', 'target', 'device'].forEach((key) => { %>
                  <input type="hidden" name="<%= key %>" value="<%= message[key] ?? '' %>">
                <% }) %>
                <input type="hidden" name="level" value="<%= message.level ?? '' %>">
                <button class="btn btn-kd" type="submit">أرسل إلى <%= audience %> جهازاً</button>
                <a class="btn btn-kd-ghost" href="/admin/notifications">إلغاء</a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
