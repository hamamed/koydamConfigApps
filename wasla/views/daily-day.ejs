<%- include('partials/head') %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@500;700;800&display=swap" rel="stylesheet">
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'لغز اليوم · ' + date,
          subheading: weekdayAr + ' · ' + (day ? 'شبكة مخطَّطة' : 'شبكة تلقائية'),
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/api/v1/wordsearch?date=' + date + '" target="_blank" rel="noopener">عرض JSON</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-sm btn-kd-ghost" href="/admin/daily"><%- icon('arrow-left', 14) %> الجدول</a>
        <a class="btn btn-sm btn-kd-ghost" href="/admin/daily/<%= previous %>">← <%= previous %></a>
        <a class="btn btn-sm btn-kd-ghost" href="/admin/daily/<%= next %>"><%= next %> →</a>
        <div class="ms-auto d-flex gap-2">
          <% if (past) { %>
            <span class="kd-tag">يوم مضى · للعرض فقط</span>
          <% } else if (day) { %>
            <a class="btn btn-sm btn-kd-outline" href="/admin/daily/<%= date %>/edit">تعديل</a>
            <form method="post" action="/admin/daily/<%= date %>/delete" class="m-0" data-confirm="حذف لغز <%= date %>؟ يعود ذلك اليوم إلى الشبكة التلقائية.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-kd-danger" type="submit">حذف</button>
            </form>
          <% } else { %>
            <a class="btn btn-sm btn-kd" href="/admin/daily/<%= date %>/edit">خطّط هذا التاريخ</a>
          <% } %>
        </div>
      </div>

      <div class="ad-card">
        <div class="ad-card-body">
          <% if (!board) { %>
            <div class="ad-empty">
              <%- icon('search-x', 28) %>
              <p class="mb-0">لا شبكة لـ <%= date %>: nothing is planned and no theme has enough usable words.</p>
            </div>
          <% } else { %>
            <div class="ws-layout">
              <%- include('partials/ws-board', { board }) %>
              <div class="ws-side">
                <div class="d-flex flex-wrap gap-2 mb-2">
                  <span class="kd-tag kd-tag-accent"><%= date %> · <span class="wz-ar"><%= weekdayAr %></span></span>
                  <span class="kd-tag"><%= board.size %> × <%= board.size %></span>
                  <span class="kd-tag"><%= board.words.length %> words</span>
                  <span class="kd-tag"><%= coins %> coins</span>
                  <% if (day) { %>
                    <span class="ad-status ad-status-published">مجدول</span>
                    <span class="kd-tag"><%= day.source === 'custom' ? 'typed words' : 'theme' %></span>
                  <% } else { %>
                    <span class="ad-status ad-status-draft">تلقائي</span>
                    <% if (board.size !== weekdaySize) { %><span class="kd-tag kd-tag-warn">حجم يوم الأسبوع <%= weekdaySize %> لا تناسب أي موضوع</span><% } %>
                  <% } %>
                </div>
                <p class="small kd-muted">
                  <% if (day) { %>
                    جُمّدت لحظة حفظها (آخر <span class="kd-mono"><%= day.updatedAt %></span> بتوقيت UTC): تعديل الأسئلة لا يغيّرها.
                  <% } else { %>
                    غير مخطَّط: تتبع هذه الشبكة الدورة وتتغير إذا تغيّرت أسئلة الموضوع.<% if (!past) { %> خطّط التاريخ لتجميدها.<% } %>
                  <% } %>
                </p>
                <%- include('partials/ws-words', { board, customBase }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
