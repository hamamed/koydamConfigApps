<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'لغز اليوم',
          subheading: 'لعبة واحدة لكل يوم من أيام الأسبوع، والجمعة ماراثون. افتح يوماً لتغيير أيٍّ منها.',
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/admin/daily-games">قوائم الكلمات</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="ad-card mb-3">
        <div class="ad-card-body d-flex flex-wrap align-items-center gap-2">
          <%- icon('calendar-plus', 18) %>
          <span class="fw-semibold">خطّط مسبقاً</span>
          <span class="small kd-muted me-auto">يحفظ الاختيار التلقائي الحالي لكل يوم ولعبة لم تُخطَّط بعد — ثم تعدّل ما تشاء فقط.</span>
          <% planChoices.forEach((n) => { %>
            <form method="post" action="/admin/days/plan" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="count" value="<%= n %>">
              <button class="btn btn-sm <%= n === 7 ? 'btn-kd' : 'btn-kd-outline' %>" type="submit">خطّط <%= n %> يوماً</button>
            </form>
          <% }) %>
        </div>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a class="btn btn-sm btn-kd-ghost" href="/admin/days?from=<%= previous %>">→ أقدم</a>
        <% if (!isCurrent) { %><a class="btn btn-sm btn-kd-outline" href="/admin/days">من اليوم</a><% } %>
        <a class="btn btn-sm btn-kd-ghost" href="/admin/days?from=<%= next %>">أحدث ←</a>
        <span class="small kd-muted ms-auto"><%= planned %> من <%= days.length %> يوماً مخطّطة بالكامل ·
          <span class="kd-tag kd-tag-ok">مخطَّط</span> <span class="kd-tag kd-tag-accent">مكتوب</span> <span class="kd-tag">تلقائي</span></span>
      </div>

      <div class="ad-card mb-3">
        <div class="ad-card-head d-flex flex-wrap align-items-center gap-2">
          <%- icon('calendar-days', 16) %>
          <span class="fw-semibold me-auto">أسبوع اللعبة</span>
          <span class="kd-tag">لعبة واحدة كل يوم — وهي وحدها التي تُكافئ</span>
        </div>
        <div class="ad-card-body">
          <div class="wz-week">
            <% week.forEach((d) => { %>
              <div class="wz-week-day<%= d.kind === 'marathon' ? ' is-marathon' : '' %>">
                <span class="wz-week-name wz-ar"><%= d.name %></span>
                <span class="wz-week-game wz-ar"><%= d.title %></span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="ad-card">
        <div class="ad-card-body p-0">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <thead>
                <tr>
                  <th>اليوم</th>
                  <th>لعبة اليوم</th>
                  <th>البحث عن الكلمات</th>
                  <% kinds.forEach((k) => { %><th class="wz-ar"><%= labels[k].ar %></th><% }) %>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% days.forEach((d) => { %>
                  <tr>
                    <td class="text-nowrap">
                      <a class="fw-semibold kd-mono" href="/admin/days/<%= d.date %>"><%= d.date %></a>
                      <div class="small kd-muted"><%= d.weekday %> · <span class="wz-ar"><%= d.weekdayAr %></span><% if (d.isToday) { %> · <strong>اليوم</strong><% } %></div>
                      <% if (d.event) { %><span class="kd-tag wz-ar" title="مناسبة موسمية"><%- icon('moon', 12) %> <%= d.event %></span><% } %>
                    </td>
                    <td class="text-nowrap">
                      <span class="kd-tag kd-tag-accent wz-ar" title="اللعبة التي تُكافئ في هذا اليوم"><%= d.kindTitle %></span>
                    </td>
                    <td>
                      <% if (d.wordSearch) { %>
                        <span class="kd-tag <%= d.wordSearch.source === 'custom' ? 'kd-tag-accent' : 'kd-tag-ok' %> wz-ar"><%= d.wordSearch.theme %></span>
                      <% } else { %>
                        <span class="kd-tag">تلقائي</span>
                      <% } %>
                    </td>
                    <% kinds.forEach((k) => { const s = d.games[k]; %>
                      <td><span class="kd-tag <%= s === 'typed' ? 'kd-tag-accent' : s ? 'kd-tag-ok' : '' %>"><%= s === 'typed' ? 'مكتوب' : s ? 'مخطَّط' : 'تلقائي' %></span></td>
                    <% }) %>
                    <td class="text-end"><a class="btn btn-sm <%= d.isPast ? 'btn-kd-ghost' : 'btn-kd-outline' %>" href="/admin/days/<%= d.date %>"><%= d.isPast ? 'عرض' : 'فتح' %></a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
