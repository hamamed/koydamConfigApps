<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'ألعاب اليوم · ' + date,
          subheading: 'الألعاب الخمس إلى جانب البحث عن الكلمات، واحدة لكل اللاعبين في التاريخ نفسه',
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/api/v1/daily-games?date=' + date + '" target="_blank" rel="noopener">عرض JSON</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-sm btn-kd-ghost" href="/admin/daily-games?date=<%= previous %>">← <%= previous %></a>
        <% if (date !== today) { %><a class="btn btn-sm btn-kd-outline" href="/admin/daily-games">اليوم</a><% } %>
        <a class="btn btn-sm btn-kd-ghost" href="/admin/daily-games?date=<%= next %>"><%= next %> →</a>
        <span class="small kd-muted ms-auto">رتّب الحروف وفقاعات الكلمات وصِل المجموعات تأتي من الأسئلة وفئاتها؛ وعجلة الحروف وخمّن الكلمة من القوائم أدناه.</span>
      </div>

      <% if (!set) { %>
        <div class="ad-card mb-3"><div class="ad-card-body">
          <div class="ad-empty"><%- icon('gamepad-2', 28) %><p class="mb-0">لا يمكن بناء أي لعبة لـ <%= date %> yet.</p></div>
        </div></div>
      <% } else { %>
        <div class="row g-3 mb-3">
          <div class="col-xl-4 col-md-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2"><%- icon('shuffle', 16) %><span class="fw-semibold"><span class="wz-ar">رتّب الحروف</span></span></div>
              <div class="ad-card-body">
                <% if (!set.scramble) { %><p class="small kd-muted mb-0">يحتاج 5 أسئلة بدليل وجواب من 3 إلى 7 حروف.</p><% } else { %>
                  <ul class="list-unstyled d-grid gap-2 mb-0">
                    <% set.scramble.words.forEach((w) => { %>
                      <li><span class="wz-ar fw-semibold"><%= w.display %></span> <span class="kd-tag wz-ar"><%= w.letters %></span><div class="small kd-muted wz-ar"><%= w.clue %></div></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-xl-4 col-md-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2"><%- icon('circle-dot', 16) %><span class="fw-semibold"><span class="wz-ar">فقاعات الكلمات</span></span></div>
              <div class="ad-card-body">
                <% if (!set.bubbles) { %><p class="small kd-muted mb-0">يحتاج فئة فيها 5 أجوبة من 4 إلى 8 حروف.</p><% } else { %>
                  <div class="mb-2"><span class="kd-tag kd-tag-accent wz-ar"><%= set.bubbles.theme %></span></div>
                  <ul class="list-unstyled d-grid gap-1 mb-2">
                    <% set.bubbles.words.forEach((w) => { %>
                      <li><span class="wz-ar fw-semibold"><%= w.display %></span> <span class="kd-faint small wz-ar"><%= w.parts.join(' · ') %></span></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-xl-4 col-md-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2"><%- icon('layout-grid', 16) %><span class="fw-semibold"><span class="wz-ar">صِل المجموعات</span></span></div>
              <div class="ad-card-body">
                <% if (!set.groups) { %><p class="small kd-muted mb-0">يحتاج 4 فئات، في كل واحدة 4 أجوبة مختلفة من 3 إلى 8 حروف.</p><% } else { %>
                  <ul class="list-unstyled d-grid gap-2 mb-0">
                    <% set.groups.groups.forEach((g) => { %>
                      <li><span class="kd-tag kd-tag-accent wz-ar"><%= g.title %></span> <span class="wz-ar"><%= g.words.map((w) => w.display).join('، ') %></span></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-xl-4 col-md-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2"><%- icon('circle-dashed', 16) %><span class="fw-semibold"><span class="wz-ar">عجلة الحروف</span></span></div>
              <div class="ad-card-body">
                <% if (!set.wheel) { %><p class="small kd-muted mb-0">قائمة عجلة الحروف فارغة.</p><% } else { %>
                  <div class="mb-2"><span class="kd-tag kd-tag-accent wz-ar"><%= [...set.wheel.letters].join(' ') %></span></div>
                  <div class="wz-ar"><%= set.wheel.words.join('، ') %></div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-xl-4 col-md-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2"><%- icon('square-asterisk', 16) %><span class="fw-semibold"><span class="wz-ar">خمّن الكلمة</span></span></div>
              <div class="ad-card-body">
                <% if (!set.guess) { %><p class="small kd-muted mb-0">قائمة خمّن الكلمة فارغة.</p><% } else { %>
                  <div class="wz-ar fw-semibold fs-4"><%= set.guess.display %></div>
                  <div class="small kd-muted"><%= set.guess.tries %> محاولات</div>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-xl-4 col-md-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2"><%- icon('coins', 16) %><span class="fw-semibold">المكافآت</span></div>
              <div class="ad-card-body small">
                <p class="mb-1"><strong><%= set.coins %></strong> عملة لكل لعبة، مرة في اليوم.</p>
                <p class="mb-1"><strong><%= set.allBonus %></strong> عملة إضافية عند إنهاء البحث والألعاب الخمس.</p>
                <p class="kd-muted mb-0">غيّرهما من <a href="/admin/settings">الإعدادات</a>.</p>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <div class="row g-3">
        <% ['guess', 'wheel'].forEach((name) => { const list = lists[name]; %>
          <div class="col-xl-6">
            <div class="ad-card h-100">
              <div class="ad-card-head d-flex align-items-center gap-2">
                <%- icon('list', 16) %>
                <span class="fw-semibold me-auto"><%= labels[name] %></span>
                <span class="kd-faint small"><%= list.count %> مستعملة · <%= list.edited ? 'محرَّرة' : 'مدمجة' %></span>
              </div>
              <div class="ad-card-body">
                <p class="small kd-muted">
                  <% if (name === 'guess') { %>كلمة في كل سطر، خمسة حروف بالضبط بعد توحيد الهمزات (أ ← ا). كلمة واحدة كل يوم، بترتيب مخلوط ثابت.<% } else { %>مجموعة في كل سطر: <span class="kd-mono">حروف: كلمة كلمة كلمة</span>. من 4 إلى 7 حروف، ومن 3 إلى 8 كلمات، كلٌّ منها يُكتب من تلك الحروف.<% } %>
                </p>
                <% if (list.problems.length) { %>
                  <ul class="small text-danger mb-2">
                    <% list.problems.slice(0, 12).forEach((p) => { %><li>السطر <%= p.line %> <span class="wz-ar">“<%= p.text %>”</span>: <%= p.reason %></li><% }) %>
                  </ul>
                <% } %>
                <form method="post" action="/admin/daily-games/lists/<%= name %>" class="d-grid gap-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <textarea class="form-control wz-ar ws-words-input" name="body" rows="14" spellcheck="false"><%= list.text %></textarea>
                  <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-kd-accent" type="submit">حفظ</button>
                  </div>
                </form>
                <% if (list.edited) { %>
                  <form method="post" action="/admin/daily-games/lists/<%= name %>/reset" class="mt-2" data-confirm="استبدال هذه القائمة بالمدمجة؟">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-kd-ghost" type="submit">العودة إلى القائمة المدمجة</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
