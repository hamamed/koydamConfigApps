<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'مواضيع البحث',
          subheading: 'فئات الأسئلة التي يُبنى منها البحث اليومي عن الكلمات',
          actions: '<a class="btn btn-sm btn-kd" href="/admin/daily">جدول لغز اليوم</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <p class="small kd-muted">
        الفئة التي فيها على الأقل <%= minWords %> أجوبة مختلفة من 3 إلى 8 حروف تصلح موضوعاً. زر <strong>إضافة أيام</strong> في
        صفحة <a href="/admin/daily">لغز اليوم</a> يأخذ المواضيع بترتيب الفئات، ويتخطى المستبعدة، ويجمّد كل شبكة لحظة إضافتها —
        فتعديل الأسئلة هنا لا يغيّر يوماً مخطَّطاً. أما التواريخ غير المخطَّطة فتأخذ شبكة تلقائية من الدورة نفسها، وهي تتبع تعديلات الأسئلة.
      </p>

      <div class="row g-3">
        <div class="col-xl-7">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="tags" width="16" height="16"></i>
              <span class="fw-semibold">المواضيع</span>
              <span class="kd-faint small ms-auto"><%= playableCount %> مستعملة · <%= eligible.length - playableCount %> مستبعدة</span>
            </div>
            <div class="ad-card-body p-0">
              <% if (!eligible.length) { %>
                <div class="ad-empty"><i data-lucide="tags"></i><p class="mb-0">لا فئة فيها <%= minWords %> أجوبة صالحة بعد.</p></div>
              <% } else { %>
                <div class="ad-table-wrap">
                  <table class="ad-table">
                    <thead><tr><th>الموضوع</th><th class="text-end">الكلمات</th><th>الحالة</th><th></th></tr></thead>
                    <tbody>
                      <% eligible.forEach((t) => { %>
                        <tr>
                          <td>
                            <a class="wz-ar fw-semibold" href="/admin/questions?q=<%= encodeURIComponent(t.title) %>"><%= t.title %></a>
                            <% if (t.skipped.length) { %>
                              <div class="small kd-faint" title="<%= t.skipped.map((s) => s.display + ' (' + s.reason + ')').join(', ') %>"><%= t.skipped.length %> جواباً غير صالح</div>
                            <% } %>
                          </td>
                          <td class="text-end"><%= t.words.length %></td>
                          <td>
                            <% if (t.excluded) { %><span class="ad-status ad-status-archived">مستبعدة</span><% } else { %><span class="ad-status ad-status-published">مستعملة</span><% } %>
                          </td>
                          <td class="text-end">
                            <form method="post" action="/admin/wordsearch/exclude" class="m-0">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <input type="hidden" name="title" value="<%= t.title %>">
                              <input type="hidden" name="excluded" value="<%= t.excluded ? '0' : '1' %>">
                              <button class="btn btn-sm <%= t.excluded ? 'btn-kd-outline' : 'btn-kd-ghost' %>" type="submit"><%= t.excluded ? 'إدراج' : 'استبعاد' %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-xl-5 d-grid gap-3 align-content-start">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="list-plus" width="16" height="16"></i>
              <span class="fw-semibold me-auto">تكاد تصلح</span>
            </div>
            <div class="ad-card-body">
              <% if (!close.length) { %>
                <p class="small kd-muted mb-0">لا فئة فيها 4 أو 5 أجوبة صالحة.</p>
              <% } else { %>
                <ul class="list-unstyled d-grid gap-2 mb-0">
                  <% close.forEach((t) => { %>
                    <li class="d-flex align-items-center gap-2">
                      <a class="wz-ar fw-semibold" href="/admin/questions?q=<%= encodeURIComponent(t.title) %>"><%= t.title %></a>
                      <span class="kd-faint small"><%= t.words.length %> كلمات</span>
                      <span class="kd-tag kd-tag-warn ms-auto">تحتاج <%= t.missing %> سؤالاً آخر</span>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
