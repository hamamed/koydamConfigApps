<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'Word themes',
          subheading: 'The question titles the daily word search is built from',
          actions: '<a class="btn btn-sm btn-kd" href="/admin/daily">Daily puzzle schedule</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <p class="small kd-muted">
        A question title with at least <%= minWords %> different answers of 3–8 letters is a theme. <strong>Add days</strong> on the
        <a href="/admin/daily">Daily puzzle</a> page takes the themes in title order, skipping excluded ones, and freezes each board when
        it is added — so editing questions here never changes a planned day. Dates that are not planned get an automatic board from the
        same rotation, which does follow question edits.
      </p>

      <div class="row g-3">
        <div class="col-xl-7">
          <div class="ad-card h-100">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="tags" width="16" height="16"></i>
              <span class="fw-semibold">Themes</span>
              <span class="kd-faint small ms-auto"><%= playableCount %> in use · <%= eligible.length - playableCount %> excluded</span>
            </div>
            <div class="ad-card-body p-0">
              <% if (!eligible.length) { %>
                <div class="ad-empty"><i data-lucide="tags"></i><p class="mb-0">No title has <%= minWords %> usable answers yet.</p></div>
              <% } else { %>
                <div class="ad-table-wrap">
                  <table class="ad-table">
                    <thead><tr><th>Theme</th><th class="text-end">Words</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                      <% eligible.forEach((t) => { %>
                        <tr>
                          <td>
                            <a class="wz-ar fw-semibold" href="/admin/questions?q=<%= encodeURIComponent(t.title) %>"><%= t.title %></a>
                            <% if (t.skipped.length) { %>
                              <div class="small kd-faint" title="<%= t.skipped.map((s) => s.display + ' (' + s.reason + ')').join(', ') %>"><%= t.skipped.length %> answer(s) not usable</div>
                            <% } %>
                          </td>
                          <td class="text-end"><%= t.words.length %></td>
                          <td>
                            <% if (t.excluded) { %><span class="ad-status ad-status-archived">Excluded</span><% } else { %><span class="ad-status ad-status-published">In use</span><% } %>
                          </td>
                          <td class="text-end">
                            <form method="post" action="/admin/wordsearch/exclude" class="m-0">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <input type="hidden" name="title" value="<%= t.title %>">
                              <input type="hidden" name="excluded" value="<%= t.excluded ? '0' : '1' %>">
                              <button class="btn btn-sm <%= t.excluded ? 'btn-kd-outline' : 'btn-kd-ghost' %>" type="submit"><%= t.excluded ? 'Include' : 'Exclude' %></button>
                            </form>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-xl-5 d-grid gap-3 align-content-start">
          <div class="ad-card">
            <div class="ad-card-head d-flex align-items-center gap-2">
              <i data-lucide="list-plus" width="16" height="16"></i>
              <span class="fw-semibold me-auto">Almost themes</span>
            </div>
            <div class="ad-card-body">
              <% if (!close.length) { %>
                <p class="small kd-muted mb-0">No title has 4 or 5 usable answers.</p>
              <% } else { %>
                <ul class="list-unstyled d-grid gap-2 mb-0">
                  <% close.forEach((t) => { %>
                    <li class="d-flex align-items-center gap-2">
                      <a class="wz-ar fw-semibold" href="/admin/questions?q=<%= encodeURIComponent(t.title) %>"><%= t.title %></a>
                      <span class="kd-faint small"><%= t.words.length %> words</span>
                      <span class="kd-tag kd-tag-warn ms-auto">needs <%= t.missing %> more question<%= t.missing === 1 ? '' : 's' %></span>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
