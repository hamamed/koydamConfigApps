<%- include('partials/head') %>
<div class="ad-shell">
  <%- include('partials/sidebar') %>
  <main class="ad-main">
    <%- include('partials/topbar', {
          heading: 'الأجوبة',
          subheading: total + ' جواباً · ' + withArticle + ' منها تبدأ بـ«ال»',
          actions: '<a class="btn btn-sm btn-kd-ghost" href="/admin/questions">الأسئلة</a>'
        }) %>
    <div class="ad-content">
      <%- include('partials/flash') %>

      <form class="ad-card mb-3" method="get" action="/admin/answers">
        <div class="ad-card-body d-flex flex-wrap align-items-end gap-3">
          <label class="wz-generate-field">
            <span class="ad-section-label">«ال»</span>
            <select class="form-select form-select-sm" name="article">
              <% Object.entries(filters).forEach(([key, label]) => { %>
                <option value="<%= key %>" <%= article === key ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </label>
          <label class="wz-generate-field">
            <span class="ad-section-label">الفئة</span>
            <select class="form-select form-select-sm" name="title">
              <option value="">كل الفئات</option>
              <% titles.forEach((t) => { %>
                <option value="<%= t %>" <%= chosenTitle === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </label>
          <label class="wz-generate-field">
            <span class="ad-section-label">بحث</span>
            <input class="form-control form-control-sm wz-ar" type="search" name="q" value="<%= search %>"
                   dir="rtl" placeholder="جواب أو دليل">
          </label>
          <button class="btn btn-kd-outline btn-sm" type="submit">صفِّ</button>
          <% if (article !== 'all' || chosenTitle || search) { %>
            <a class="btn btn-kd-ghost btn-sm" href="/admin/answers">إلغاء</a>
          <% } %>
          <span class="small kd-faint ms-auto">
            <%= matched %> نتيجة<% if (matched > shown) { %> · تُعرض أول <%= shown %>، ضيّق التصفية لترى الباقي<% } %>
          </span>
        </div>
      </form>

      <%# One form for the whole table: tick rows and strip them together, or use
          a row's own button, which sends that row alone through `only`. %>
      <form class="ad-card wz-bulk" method="post" action="/admin/answers/strip" data-answer-bulk>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= currentUrl %>">
        <% if (strippable) { %>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <strong class="small me-1"><span data-bulk-count>0</span> محدَّد</strong>
            <button class="btn btn-kd-ghost btn-sm" type="button" data-bulk-select-all>حدّد الكل (<%= strippable %>)</button>
            <button class="btn btn-kd-ghost btn-sm" type="button" data-bulk-clear>إلغاء</button>
            <button class="btn btn-kd-outline btn-sm" type="submit" data-bulk-button
                    data-confirm-click="حذف «ال» من الأجوبة المحدَّدة؟">
              <span class="me-1"><%- icon('type', 14) %></span>احذف «ال» من المحدَّد</button>
            <span class="small kd-faint ms-auto">
              الأجوبة الموسومة <span class="kd-tag kd-tag-warn">اسم علم</span> أو
              <span class="kd-tag kd-tag-warn">آية أو سورة</span> أو
              <span class="kd-tag kd-tag-warn">كلمة من مثل</span> «ال» فيها غالباً جزء من الجواب — راجعها قبل حذفها.
            </span>
          </div>
        <% } %>
        <div class="ad-card-body p-0">
          <% if (!rows.length) { %>
            <div class="ad-empty"><%- icon('message-circle-question', 28) %><p class="mb-0">لا أجوبة بهذا التصفية.</p></div>
          <% } else { %>
            <div class="ad-table-wrap">
              <table class="ad-table">
                <thead><tr>
                  <th class="wz-check">
                    <% if (strippable) { %>
                      <input class="form-check-input" type="checkbox" data-bulk-all aria-label="حدّد الكل">
                    <% } %>
                  </th>
                  <th>الجواب</th><th>الفئة</th><th>الصعوبة</th><th>في ألغاز</th><th></th>
                </tr></thead>
                <tbody>
                  <% rows.forEach((r) => { %>
                    <tr>
                      <td class="wz-check">
                        <% if (r.bare) { %>
                          <input class="form-check-input" type="checkbox" name="ids" value="<%= r.id %>"
                                 data-bulk-row aria-label="<%= r.answer %>">
                        <% } %>
                      </td>
                      <td>
                        <a class="wz-ar fw-semibold" href="/admin/questions/<%= r.id %>"><%= r.answer %></a>
                        <% if (r.playAnswer !== r.answer) { %>
                          <span class="small kd-faint wz-ar" title="الشكل الذي يُلعب في الشبكة"><%= r.playAnswer %></span>
                        <% } %>
                      </td>
                      <td><% if (r.title) { %><span class="kd-tag wz-ar"><%= r.title %></span><% } else { %><span class="kd-faint">—</span><% } %></td>
                      <td><%- r.difficulty ? include('partials/difficulty', { difficulty: r.difficulty }) : '<span class="kd-faint">—</span>' %></td>
                      <td><% if (r.levelCount) { %><span class="kd-tag kd-tag-ok"><%= r.levelCount %></span><% } else { %><span class="kd-faint">—</span><% } %></td>
                      <td class="text-end">
                        <%# A button of its own inside the table's form: it sends this
                            row alone, whatever else is ticked. %>
                        <% if (r.bare) { %>
                          <% if (r.note) { %>
                            <span class="kd-tag kd-tag-warn" title="«ال» غالباً جزء من الجواب هنا"><%= r.note %></span>
                          <% } %>
                          <button class="btn btn-sm <%= r.note ? 'btn-kd-ghost' : 'btn-kd-outline' %> wz-ar" type="submit"
                                  name="only" value="<%= r.id %>"
                                  data-confirm-click="«<%= r.answer %>» ← «<%= r.bare %>»؟<%= r.note ? ' (' + r.note + ')' : '' %>">← <%= r.bare %></button>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </form>
    </div>
  </main>
</div>
<%- include('partials/foot') %>
