# Wasla crossword service.
NODE_ENV=production
PORT=3400
HOST=127.0.0.1
PUBLIC_URL=https://wassla.hamaprojects.com

SESSION_SECRET=change-me

DATA_DIR=./data
IMAGES_DIR=./storage/questions
# Largest question picture accepted, in bytes.
MAX_IMAGE_BYTES=8388608
AUDIO_DIR=./storage/audio
# Largest question sound accepted, in bytes (mp3, m4a, aac, wav).
MAX_AUDIO_BYTES=5242880
# Gameplay events older than this many days are deleted, daily.
EVENT_RETENTION_DAYS=180

# Platform single sign-on.
PLATFORM_URL=https://config.hamaprojects.com
PLATFORM_APP_SLUG=wasla
SERVICE_TOKEN=
